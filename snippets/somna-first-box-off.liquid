{%- doc -%}
  Somna V2 — first Subscribe & Save box discount for one variant, in cents (0 when none).
  Mirrors the Shopify automatic discounts "Subscribe & Save, first box, …" (Shopify doesn't give themes
  automatic discounts). Set once in Theme settings → Somna one-time sale → First-box discount.
  Usage:
    capture fb
      render 'somna-first-box-off', product: p, variant: v
    endcapture
    assign sub_first = alloc.price | minus: fb
  @param {object} product
  @param {object} variant
{%- enddoc -%}
{%- liquid
  assign fb_cents = 0
  assign fb_found = false
  for fp in settings.somna_first_box_products
    if fp.handle == product.handle
      assign fb_found = true
    endif
  endfor
  if fb_found
    assign fb_lines = settings.somna_first_box_off | default: '' | newline_to_br | split: '<br />'
    for fb_ln in fb_lines
      assign fb_parts = fb_ln | split: '='
      if fb_parts.size == 2
        assign fb_name = fb_parts[0] | strip
        if fb_name == variant.title
          assign fb_cents = fb_parts[1] | strip | times: 100 | round
        endif
      endif
    endfor
  endif
  echo fb_cents
-%}
