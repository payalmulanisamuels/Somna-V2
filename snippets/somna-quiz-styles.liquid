cart-drawer-component .quantity-selector :is(button, input) { color: #fff; background: transparent !important; }
cart-drawer-component :is(.cart-items__remove, .cart-item__remove, button[class*="remove"]) { background: transparent !important; }
cart-drawer-component :is(.cart-items__remove, .cart-item__remove, button[class*="remove"]) * { color: #c9c7df !important; }
cart-drawer-component .hz-minicart-upsell__card, cart-drawer-component .hz-minicart-upsell__media { background: #16162b; border-color: #2a2a45; color: #fff; }
