{%- comment -%}
  Somna — subscribe an email to Shopify email marketing (2026-11-17).
  Posts Shopify's own customer form (/contact, form_type=customer). Shopify creates or updates the
  customer with email marketing consent = subscribed, which starts the Shopify Messaging
  "Customer subscribed to email marketing" automations (Welcome Series).
  window.somnaShopifySubscribe(email, tags) resolves to 'ok' | 'challenge' | 'error'.
  'challenge': Shopify asked for a spam check; the helper then submits the form normally so the
  visitor sees Shopify's check page and returns here afterwards.
  Rendered by blocks/somna-klaviyo-signup.liquid and sections/somna-scratch-popup.liquid.
{%- endcomment -%}
<script>
  if (!window.somnaShopifySubscribe) {
    window.somnaShopifySubscribe = async function (email, tags) {
      var fields = {
        form_type: 'customer',
        utf8: '✓',
        'contact[email]': email,
        'contact[tags]': tags || 'newsletter'
      };
      function nativeSubmit() {
        var f = document.createElement('form');
        f.method = 'post';
        f.action = '{{ routes.root_url | append: "/contact" | replace: "//", "/" }}';
        f.style.display = 'none';
        Object.keys(fields).forEach(function (k) {
          var i = document.createElement('input');
          i.type = 'hidden'; i.name = k; i.value = fields[k];
          f.appendChild(i);
        });
        document.body.appendChild(f);
        f.submit();
      }
      try {
        var body = new FormData();
        Object.keys(fields).forEach(function (k) { body.append(k, fields[k]); });
        var res = await fetch('{{ routes.root_url | append: "/contact" | replace: "//", "/" }}', {
          method: 'POST', body: body, credentials: 'same-origin', redirect: 'follow'
        });
        var url = res.url || '';
        if (url.indexOf('/challenge') > -1) { nativeSubmit(); return 'challenge'; }
        if (url.indexOf('customer_posted=true') > -1) return 'ok';
        if (res.ok) {
          var html = await res.text();
          if (html.indexOf('customer_posted=true') > -1) return 'ok';
        }
        return 'error';
      } catch (e) {
        return 'error';
      }
    };
  }
</script>
