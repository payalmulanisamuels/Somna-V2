{%- comment -%}
  Somna V2 — global scroll reveal (approved option A · Soft fade-up).
  Styles only; the logic is in assets/somna-reveal.js. Nothing is hidden by CSS alone: the script
  arms elements below the fold (adds .somna-r) and reveals them as they reach 85% of the screen.
  Opt an element (and everything inside it) out with data-no-reveal.
{%- endcomment -%}
<style>
  @media screen and (min-width: 750px) and (prefers-reduced-motion: no-preference) {
    .somna-r {
      opacity: 0;
      translate: 0 var(--somna-r-y, 24px);
    }

    .somna-r--image {
      --somna-r-y: 20px;
      scale: 0.97;
    }

    .somna-r--item {
      --somna-r-y: 20px;
    }

    .somna-r.is-in {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      transition:
        opacity var(--somna-r-d, 0.6s) var(--somna-r-e, cubic-bezier(0.25, 0.46, 0.45, 0.94)) var(--somna-r-delay, 0s),
        translate var(--somna-r-d, 0.6s) var(--somna-r-e, cubic-bezier(0.25, 0.46, 0.45, 0.94)) var(--somna-r-delay, 0s),
        scale var(--somna-r-d, 0.6s) var(--somna-r-e, cubic-bezier(0.25, 0.46, 0.45, 0.94)) var(--somna-r-delay, 0s);
    }
  }
</style>
<script src="{{ 'somna-reveal.js' | asset_url }}" defer></script>
