{%- doc -%}
  Somna V2 — one set of 24px line icons, shared by the Somna icon block and the page sections.
  @param {string} name - icon name (users, star, shield, leaf, moon, refresh, play, truck, question, mail, lock, gift, chat, clock, box)
  @param {string} [class] - class for the svg
  @param {number} [stroke] - stroke width, default 1.4
{%- enddoc -%}
<svg class="{{ class | default: 'somna-line-icon' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke | default: 1.4 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {%- case name -%}
        {%- when 'users' -%}
          <circle cx="12" cy="8" r="3.2"/><path d="M5.5 20v-1.5A4.5 4.5 0 0 1 10 14h4a4.5 4.5 0 0 1 4.5 4.5V20"/><circle cx="5.3" cy="9.6" r="2.3"/><path d="M1.5 19v-1a3.3 3.3 0 0 1 3.3-3.3"/><circle cx="18.7" cy="9.6" r="2.3"/><path d="M22.5 19v-1a3.3 3.3 0 0 0-3.3-3.3"/>
        {%- when 'star' -%}
          <path d="M12 3.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6.1L12 16.8l-5.4 3 1.2-6.1-4.5-4.2 6.1-.7z"/>
        {%- when 'shield' -%}
          <path d="M12 3l7.5 2.8v5.6c0 4.6-3.2 8.2-7.5 9.6-4.3-1.4-7.5-5-7.5-9.6V5.8z"/><path d="M8.6 12.1l2.3 2.3 4.6-4.6"/>
        {%- when 'leaf' -%}
          <path d="M5 19c8 0 14-5 14-14-9 0-14 5-14 14z"/><path d="M5 19l7-7"/>
        {%- when 'moon' -%}
          <path d="M19 14.5A7.5 7.5 0 1 1 9.5 5a6 6 0 0 0 9.5 9.5z"/>
        {%- when 'refresh' -%}
          <path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6"/><path d="M18 3v4h-4M6 21v-4h4"/>
        {%- when 'play' -%}
          <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none"/>

        {%- when 'truck' -%}
          <path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4l3 3.4v3.1h-7z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
        {%- when 'question' -%}
          <circle cx="12" cy="12" r="9"/><path d="M9.6 9.4a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.7"/><circle cx="12" cy="17" r=".6" fill="currentColor"/>
        {%- when 'mail' -%}
          <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6.3L20.5 7"/>
        {%- when 'lock' -%}
          <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/>
        {%- when 'gift' -%}
          <rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5v8h14v-8M12 8.5v12"/><path d="M12 8.5C10.5 5 7 4.6 7 6.6S10.5 8.5 12 8.5zM12 8.5c1.5-3.5 5-3.9 5-1.9S13.5 8.5 12 8.5z"/>
        {%- when 'chat' -%}
          <path d="M4 5.5h16v10.5H9.5L5 19.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>
        {%- when 'clock' -%}
          <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>
        {%- when 'box' -%}
          <path d="M12 3l8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4M12 11v10"/>
      {%- endcase -%}
</svg>
