{%- comment -%} SOMNA quiz v6 logic: only rendered by sections/somna-quiz.liquid {%- endcomment -%}
<script>
(function () {
  var root = document.getElementById('sq-{{ sid }}');
  if (!root || root.dataset.sqReady) return;              // never initialise twice
  root.dataset.sqReady = '1';

  var $ = function (s, el) { return (el || root).querySelector(s); };
  var $$ = function (s, el) { return [].slice.call((el || root).querySelectorAll(s)); };
  var cfg = {}, PRODUCTS = {};
  try { cfg = JSON.parse(root.parentNode.querySelector('[data-sq-config]').textContent); } catch (e) {}
  try { PRODUCTS = JSON.parse(root.parentNode.querySelector('[data-sq-products]').textContent); } catch (e) {}
  var BUY = cfg.buy || {};
  var ROOT_URL = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  var screens = $$('.sq-s');
  var qScreens = {}; screens.forEach(function (s) { if (s.dataset.q) qScreens[s.dataset.q] = s; });
  var top = $('[data-sq-top]'), back = $('[data-sq-back]'), progf = $('[data-sq-progf]'), prog = $('[data-sq-prog]');
  var step = $('[data-sq-step]'), live = $('[data-sq-live]');
  var TOTAL = 6;
  // progress bar per screen (PDF mockups); the result page has no bar
  var PROG = { q1: 12, q2: 25, q3: 38, q4: 50, story: 58, q5: 70, multi6: 85, analyze: 100 };

  // ---- state ----
  var i = 0, answers = {}, busy = false, timer = null, run = 0;

  function opt(q) { var s = qScreens[q]; return answers[q] == null || !s ? null : s.querySelectorAll('.sq-opt')[answers[q]]; }
  function key(q) { var o = opt(q); return o ? o.getAttribute('data-key') : ''; }

  // ---- scoring (S = snoring/nose, T = mouth breathing; Q1–Q4 decide, Q5–Q6 personalise) ----
  function score() {
    var S = 0, T = 0, who = 'self';
    for (var q = 1; q <= 4; q++) {
      var o = opt(q); if (!o) continue;
      S += parseInt(o.getAttribute('data-s') || '0', 10);
      T += parseInt(o.getAttribute('data-t') || '0', 10);
      if (q === 1) who = o.getAttribute('data-tag');
    }
    var tried = (answers[6] || []).map(function (k) { return qScreens[6].querySelectorAll('.sq-opt')[k].getAttribute('data-tried'); });
    // Sleep Bundle only when Q2 = "Both" (nose and mouth); otherwise the higher score wins: Tape if mouth > nose,
    // else Nasal Strips (also ties and low scores).
    var result = key(2) === 'both' ? 'bundle' : (T > S ? 'tape' : 'strips');
    return { S: S, T: T, who: who, partner: who === 'partner', result: result, tried: tried,
      problem: key(2), nose: key(3), mouth: key(4), energy: key(5) };
  }
  function trend() { return score().result; }

  // ---- "Finding your match…" checklist (their own answers) ----
  var TXT = {
    problem: { snoring: ['Snoring is your biggest problem', 'Snoring is their biggest problem'],
      nose: ['A blocked nose is your biggest problem', 'A blocked nose is their biggest problem'],
      mouth: ['Dry mouth is your biggest problem', 'Dry mouth is their biggest problem'],
      tired: ['Waking up tired, even after a full night', 'Waking up tired, even after a full night'],
      both: ['Your nose and your mouth, both', 'Their nose and their mouth, both'] },
    nose: { blocked: 'Nose blocked most nights', stuffy: 'Nose stuffy with a cold or allergies', clear: 'Nose clear at night' },
    energy: { '1': 'Running on empty during the day', '2': '3pm crash, every day', '3': 'Foggy until coffee', '4': 'Pretty good during the day' },
    tried: { strips: 'cheap nasal strips', tape: 'mouth tape', pills: 'melatonin', earlier: 'sleeping earlier', spray: 'nasal spray', other: 'other' }
  };
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }

  // Q1 "My partner" switches you/your to they/their. "Me" and "Both of us" keep the self wording.
  function applyWording() {
    var partner = score().partner;
    $$('[data-self][data-partner]').forEach(function (e) {
      var v = e.getAttribute(partner ? 'data-partner' : 'data-self');
      if (e.hasAttribute('data-html')) e.innerHTML = v; else e.textContent = v;
    });
  }

  function screenKey(sc) { var t = sc.getAttribute('data-type'); return t === 'q' ? 'q' + sc.dataset.q : (t === 'multi' ? 'multi' + sc.dataset.q : t); }

  function show(n, focus) {
    clearTimeout(timer); busy = false; i = n; run++;
    screens.forEach(function (s, k) { s.classList.toggle('is-on', k === n); });
    var sc = screens[n], ty = sc.getAttribute('data-type'), q = +sc.dataset.step || 0, pk = screenKey(sc);
    if (ty !== 'story') rcStop();
    if (ty !== 'result') rvStop();
    $$('.sq-s:not(.is-on) video').forEach(function (v) { try { v.pause(); } catch (e) {} });
    root.classList.toggle('sq--wide', ty === 'result');       // result page uses the wide layout on desktop
    applyWording();
    var hasBar = PROG[pk] != null;
    prog.hidden = !hasBar;
    if (hasBar) { progf.style.width = PROG[pk] + '%'; prog.setAttribute('aria-valuenow', PROG[pk]); }
    back.hidden = n === 0 || ty === 'analyze';                // result page: Back returns to Q6 with its answers (Retake is separate)
    step.hidden = !q; step.textContent = q ? 'Question ' + q + ' of ' + TOTAL : '';
    top.hidden = !hasBar && back.hidden && step.hidden;
    live.textContent = q ? 'Question ' + q + ' of ' + TOTAL : '';
    if (ty === 'q') {
      var a = answers[sc.dataset.q];
      $$('.sq-opt', sc).forEach(function (o, k) { o.setAttribute('aria-pressed', a === k ? 'true' : 'false'); });
      var nx = $('[data-sq-next]', sc); if (nx) nx.hidden = a == null;
    }
    if (ty === 'multi') syncMulti();
    if (ty === 'story') renderStory();
    if (ty === 'analyze') runAnalyze();
    if (ty === 'result') renderResult();
    sticky(ty === 'result');
    var h = sc.querySelector('.sq-res:not([hidden]) [tabindex="-1"]') || sc.querySelector('[tabindex="-1"]');
    if (focus && h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
    if (root.getBoundingClientRect().top < 0 || window.scrollY > root.offsetTop) { try { window.scrollTo({ top: root.offsetTop, behavior: reduce ? 'auto' : 'smooth' }); } catch (e) { window.scrollTo(0, root.offsetTop); } }
  }
  function go(n) { show(n, true); }

  // ---- single-select questions: tap lights up, moves on after 0.3s; repeat taps ignored ----
  screens.forEach(function (sc, si) {
    if (sc.getAttribute('data-type') !== 'q') return;
    $$('.sq-opt', sc).forEach(function (o, k) {
      o.addEventListener('click', function () {
        if (busy || screens[i] !== sc) return;
        busy = true;
        answers[sc.dataset.q] = k;
        $$('.sq-opt', sc).forEach(function (x) { x.setAttribute('aria-pressed', x === o ? 'true' : 'false'); });
        timer = setTimeout(function () { go(si + 1); }, 300);
      });
    });
  });
  screens.forEach(function (sc, si) {
    if (sc.getAttribute('data-type') !== 'q') return;
    var nx = el('button', 'sq-cta', 'Continue →'); nx.type = 'button'; nx.setAttribute('data-sq-next', ''); nx.hidden = true;
    nx.addEventListener('click', function () { if (!busy && answers[sc.dataset.q] != null) { busy = true; go(si + 1); } });
    sc.appendChild(nx);
  });
  // Back: previous step, skipping the auto screens (reviews break, matching) so it never bounces forward again.
  var AUTO = { story: 1, analyze: 1 };
  back.addEventListener('click', function () {
    for (var k = i - 1; k >= 0; k--) if (!AUTO[screens[k].getAttribute('data-type')]) { go(k); return; }
  });
  $('[data-sq-story-next]').addEventListener('click', function () { if (!busy) { busy = true; go(i + 1); } });

  // ---- swipe rows with dots (reviews break: 2 stacked reviews per page; result: review cards) ----
  function pager(track, dotsBox) {
    var dots = [], pageW = function () { return track.clientWidth || 1; };
    function pages() { return Math.max(1, Math.round(track.scrollWidth / pageW())); }
    var idx = 0, auto = false;  // page we are on (kept here: reading scrollLeft mid-scroll or on a half last page gives the wrong page)
    function fromScroll() { var max = track.scrollWidth - track.clientWidth; return max > 0 && track.scrollLeft >= max - 2 ? pages() - 1 : Math.round(track.scrollLeft / pageW()); }
    function cur() { return idx; }
    function sync() { if (!auto) idx = fromScroll(); var c = idx; dots.forEach(function (d, j) { d.setAttribute('aria-current', j === c ? 'true' : 'false'); }); }
    function goTo(k, smooth) { var n = pages(); k = (k + n) % n; idx = k; auto = !!smooth; clearTimeout(autoT); autoT = setTimeout(function () { auto = false; }, 900); track.scrollTo({ left: k * pageW(), behavior: smooth && !reduce ? 'smooth' : 'auto' }); dots.forEach(function (d, j) { d.setAttribute('aria-current', j === k ? 'true' : 'false'); }); }
    function build() {
      if (!dotsBox) return; dotsBox.innerHTML = ''; dots = [];
      for (var k = 0; k < pages(); k++) (function (k) {
        var d = el('button', 'sq-rc-dot', null); d.type = 'button'; d.setAttribute('aria-label', 'Page ' + (k + 1));
        d.addEventListener('click', function () { goTo(k, true); if (api.onUser) api.onUser(); }); dotsBox.appendChild(d); dots.push(d);
      })(k);
      dotsBox.parentNode.hidden = dots.length < 2; sync();
    }
    var t, autoT; track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(sync, 80); }, { passive: true });
    var api = { build: build, goTo: goTo, cur: cur, pages: pages, onUser: null };
    return api;
  }

  // ---- reviews break: reviews for the product their answers trend to first; autoplay every 1.5s ----
  var AUTOPLAY_MS = 1500, AUTOPLAY_PAUSE_MS = 4000;
  var rc = $('[data-sq-rc]'), rcTrack = rc && $('[data-sq-rc-track]', rc), rcPager = rc ? pager(rcTrack, $('[data-sq-rc-dots]', rc)) : null, rcTimer = null, rcResumeT = null;
  function rcStop() { clearInterval(rcTimer); rcTimer = null; clearTimeout(rcResumeT); }
  function rcStart() { rcStop(); if (!rcPager || rcPager.pages() < 2 || screens[i].getAttribute('data-type') !== 'story') return; rcTimer = setInterval(function () { if (!document.hidden) rcPager.goTo(rcPager.cur() + 1, true); }, AUTOPLAY_MS); }
  function rcPause() { rcStop(); rcResumeT = setTimeout(rcStart, AUTOPLAY_PAUSE_MS); }
  // result page "Real SOMNA sleepers": same autoplay (only while the result is on screen)
  var rvTimer = null, rvResumeT = null;
  function rvStop() { clearInterval(rvTimer); rvTimer = null; clearTimeout(rvResumeT); }
  function rvStart(rv) {
    rvStop(); if (reduce || !rv || !rv._pg || rv._pg.pages() < 2 || screens[i].getAttribute('data-type') !== 'result') return;
    rvTimer = setInterval(function () { if (!document.hidden) rv._pg.goTo(rv._pg.cur() + 1, true); }, AUTOPLAY_MS);
  }
  function rvPause(rv) { rvStop(); rvResumeT = setTimeout(function () { rvStart(rv); }, AUTOPLAY_PAUSE_MS); }
  if (rcPager) {
    rcPager.onUser = rcPause;
    ['pointerdown', 'touchstart', 'wheel'].forEach(function (ev) { rcTrack.addEventListener(ev, rcPause, { passive: true }); });
    rc.addEventListener('keydown', rcPause);
  }
  function renderStory() {
    var t = trend(), boxes = $$('.sq-story');
    if (rc) {
      var order = t === 'bundle' ? ['bundle', 'strips', 'tape'] : (t === 'tape' ? ['tape', 'bundle', 'strips'] : ['strips', 'bundle', 'tape']);
      $$('.sq-rc-card', rcTrack).sort(function (a, b) { return order.indexOf(a.dataset.product) - order.indexOf(b.dataset.product); }).forEach(function (c) { rcTrack.appendChild(c); });
      requestAnimationFrame(function () { rcPager.build(); rcPager.goTo(0, false); rcStart(); });
      return;
    }
    boxes.forEach(function (b) {
      var k = b.getAttribute('data-story'), revs = $$('.sq-review', b);
      var on = t === 'bundle' || k === t;
      b.hidden = !on || !b.children.length;
      revs.forEach(function (r, ri) { r.hidden = t === 'bundle' && ri > 0; });
      var v = $('video', b);
      if (v) { v.hidden = !on || (t === 'bundle' && k === 'tape' && !!$('video', boxes[0])); }
    });
    if (!boxes.some(function (b) { var v = $('video', b); return !b.hidden && v && !v.hidden; })) {
      var fb = boxes.filter(function (b) { return $('video', b); })[0];
      if (fb) { fb.hidden = false; $('video', fb).hidden = false; $$('.sq-review', fb).forEach(function (r) { r.hidden = true; }); }
    }
    boxes.forEach(function (b) {
      var v = $('video', b); if (!v) return;
      if (!b.hidden && !v.hidden && !reduce) { try { v.muted = true; var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); } catch (e) {} }
      else { try { v.pause(); } catch (e) {} }
    });
  }

  // ---- Q6 multi-select chips: "Nothing yet" clears the others and the others clear it ----
  var q6 = qScreens[6], q6opts = $$('.sq-opt', q6), cont = $('[data-sq-continue]');
  function triedIdx(v) { for (var k = 0; k < q6opts.length; k++) if (q6opts[k].getAttribute('data-tried') === v) return k; return -1; }
  var NOTHING = triedIdx('nothing'), OTHER = triedIdx('other');
  var otherBox = $('[data-sq-other]'), otherText = $('[data-sq-other-text]'), otherErr = $('[data-sq-other-err]');
  function otherOn() { return OTHER > -1 && (answers[6] || []).indexOf(OTHER) > -1; }
  function otherErrShow(m) { if (!otherErr) return; otherErr.textContent = m; otherErr.hidden = !m; otherText.setAttribute('aria-invalid', m ? 'true' : 'false'); }
  function syncMulti() {
    var picked = answers[6] || [];
    q6opts.forEach(function (x, j) { x.setAttribute('aria-pressed', picked.indexOf(j) > -1 ? 'true' : 'false'); });
    if (otherBox) {
      var on = otherOn();
      otherBox.hidden = !on; otherText.required = on;
      if (OTHER > -1) q6opts[OTHER].setAttribute('aria-expanded', on ? 'true' : 'false');
      if (!on) otherErrShow('');
    }
    cont.disabled = picked.length === 0;
  }
  if (otherText) otherText.addEventListener('input', function () { answers.other = otherText.value; if (otherText.value.trim()) otherErrShow(''); });
  q6opts.forEach(function (o, k) {
    o.addEventListener('click', function () {
      var picked = (answers[6] || []).slice(), at = picked.indexOf(k);
      if (at > -1) picked.splice(at, 1);
      else if (k === NOTHING) picked = [NOTHING];
      else { picked = picked.filter(function (x) { return x !== NOTHING; }); picked.push(k); }
      picked.sort(function (a, b) { return a - b; });
      answers[6] = picked; syncMulti();
      if (k === OTHER && otherOn() && otherText && !otherText.value.trim()) otherText.focus();
    });
  });
  cont.addEventListener('click', function () {
    if (busy || !(answers[6] || []).length) return;
    if (otherOn() && !otherText.value.trim()) { otherErrShow("Please tell us what you've tried."); otherText.focus(); return; }
    busy = true; go(i + 1);
  });

  // ---- "Finding your match…": 0→100% in 2 seconds, ticks off their own answers, then the result ----
  function runAnalyze() {
    var s = score(), my = run, p = s.partner ? 1 : 0;
    var tried = s.tried.filter(function (k) { return TXT.tried[k]; }).map(function (k) { return TXT.tried[k]; });
    var items = [TXT.problem[s.problem] ? TXT.problem[s.problem][p] : '', TXT.nose[s.nose] || '', TXT.energy[s.energy] || '',
      tried.length ? 'Tried: ' + tried.join(', ') : 'Nothing tried yet'].filter(Boolean);
    var list = $('[data-sq-checks]'); list.innerHTML = '';
    var lis = items.map(function (t) { var li = el('li', '', null); li.appendChild(el('span', 'sq-tick', null)); li.appendChild(el('span', '', t)); list.appendChild(li); return li; });
    var ring = $('[data-sq-ring]'), pct = $('[data-sq-pct]');
    var C = 2 * Math.PI * 52; ring.style.strokeDasharray = C; ring.style.strokeDashoffset = C;
    var t0 = null, DUR = 2000;
    function frame(ts) {
      if (my !== run) return;                              // left the screen
      if (t0 == null) t0 = ts;
      var f = Math.min(1, (ts - t0) / DUR), v = Math.round(f * 100);
      ring.style.strokeDashoffset = C * (1 - f); pct.textContent = v + '%';
      lis.forEach(function (li, k) { li.classList.toggle('is-done', f >= (k + 1) / (lis.length + 0.5)); });
      if (f < 1) requestAnimationFrame(frame);
      else timer = setTimeout(function () { if (my === run) go(i + 1); }, 250);
    }
    requestAnimationFrame(frame);
  }

  // ---- result page ----
  function money(c) {
    var n = c / 100, amount = n.toFixed(2), f = cfg.moneyFormat || '';
    if (!f) return '$' + amount;
    return f.replace(/<[^>]*>/g, '').replace(/\{\{\s*amount_no_decimals\s*\}\}/, String(Math.round(n)))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, amount.replace('.', ',')).replace(/\{\{\s*amount\s*\}\}/, amount);
  }
  var COLORS = {}; String(cfg.colorNames || '').split('|').forEach(function (p) { var a = p.split(':'); if (a[0]) COLORS[a[0].trim().toLowerCase()] = (a[1] || a[0]).trim(); });
  function colorName(c) { return COLORS[String(c).toLowerCase()] || c; }
  var SWATCH = { blue: '#2F5BF0', red: '#E03A3A', black: '#1b1b1f' };
  var sel = {};                                             // per product: { color, bags, mode: 'sub' | 'once' }

  function resEl(k) { return $('.sq-res[data-res="' + k + '"]'); }
  function current() { return resEl(score().result); }
  function variantsOf(k) { return (PRODUCTS[k] && PRODUCTS[k].variants) || []; }
  function pick(k) {
    var st = sel[k], vs = variantsOf(k);
    return vs.filter(function (v) { return v.bags === st.bags && (!st.color || v.color === st.color); })[0] || vs[0];
  }

  function renderResult() {
    var s = score(), k = s.result, r = resEl(k);
    $$('.sq-res').forEach(function (e) { e.hidden = e !== r; });
    if (!r) return;
    var why = (cfg.why || {})[s.problem]; $('[data-sq-why]', r).textContent = why ? why[s.partner ? 1 : 0] : '';
    $$('img', r).forEach(function (im, n) { if (n < 2) im.loading = 'eager'; });
    if (!sel[k]) { var v0 = variantsOf(k)[0] || {}; sel[k] = { color: v0.color || '', bags: v0.bags || 1, mode: 'once' }; }
    renderBuy(k);
    var rv = $('[data-sq-rv]', r);
    if (rv && !rv._pg) {
      rv._pg = pager(rv, $('[data-sq-rv-dots]', r)); rv._pg.onUser = function () { rvPause(rv); };
      ['pointerdown', 'touchstart', 'wheel'].forEach(function (ev) { rv.addEventListener(ev, function () { rvPause(rv); }, { passive: true }); });
      rv.addEventListener('keydown', function () { rvPause(rv); });
    }
    if (rv) requestAnimationFrame(function () { rv._pg.build(); rv._pg.goTo(0, false); rvStart(rv); });
  }

  function renderBuy(k) {
    var r = resEl(k), ui = $('[data-sq-buy-ui]', r), st = sel[k], v = pick(k), vs = variantsOf(k);
    ui.innerHTML = '';
    // colour (Sleep Bundle)
    var colors = []; vs.forEach(function (x) { if (x.color && colors.indexOf(x.color) < 0) colors.push(x.color); });
    if (colors.length > 1) {
      var cw = el('div', 'sq-colors'), lab = el('p', 'sq-colors-l', null);
      lab.appendChild(document.createTextNode((BUY.colorLabel || 'Color:') + ' ')); lab.appendChild(el('strong', '', colorName(st.color)));
      cw.appendChild(lab);
      var sw = el('div', 'sq-swatches'); sw.setAttribute('role', 'radiogroup'); sw.setAttribute('aria-label', 'Color');
      colors.forEach(function (c) {
        var b = el('button', 'sq-swatch', null); b.type = 'button'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', c === st.color ? 'true' : 'false');
        b.setAttribute('aria-label', colorName(c)); b.style.setProperty('--sw', SWATCH[String(c).toLowerCase()] || '#888');
        b.addEventListener('click', function () { st.color = c; renderBuy(k); swapImage(k); });
        sw.appendChild(b);
      });
      cw.appendChild(sw); ui.appendChild(cw);
    }
    // bag tiers
    var sizes = []; vs.forEach(function (x) { if (sizes.indexOf(x.bags) < 0) sizes.push(x.bags); });
    var tiers = el('div', 'sq-tiers'); tiers.setAttribute('role', 'radiogroup'); tiers.setAttribute('aria-label', 'How many bags');
    sizes.forEach(function (bags, n) {
      var tv = vs.filter(function (x) { return x.bags === bags && (!st.color || x.color === st.color); })[0]; if (!tv) return;
      var b = el('button', 'sq-tier', null); b.type = 'button'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', bags === st.bags ? 'true' : 'false');
      if (!tv.available) b.disabled = true;
      var badge = (BUY.badges || [])[n]; if (badge) b.appendChild(el('span', 'sq-tier-badge', badge));
      b.appendChild(el('span', 'sq-tier-t', tv.size || (bags + (bags > 1 ? ' Bags' : ' Bag'))));
      b.appendChild(el('span', 'sq-tier-n', tv.nights + ' nights'));
      b.appendChild(el('span', 'sq-tier-p', money(Math.round((tv.sub != null ? tv.sub : tv.once) / tv.nights)) + '/night'));
      var perk = (BUY.perks || [])[n]; if (perk) b.appendChild(el('span', 'sq-tier-k' + (n ? ' sq-tier-k--good' : ''), perk));
      b.addEventListener('click', function () { st.bags = bags; renderBuy(k); });
      tiers.appendChild(b);
    });
    ui.appendChild(tiers);
    // Autoship & Save / One-time purchase
    var opts = el('div', 'sq-plans'); opts.setAttribute('role', 'radiogroup'); opts.setAttribute('aria-label', 'Purchase option');
    if (v.sub != null) {
      if (BUY.banner) opts.appendChild(el('p', 'sq-plan-banner', BUY.banner));
      var a = planBtn(k, 'sub', BUY.autoship || 'Autoship & Save', v.price, v.sub);
      var ul = el('ul', 'sq-plan-list');
      var ship = v.bags > 1 ? (BUY.shipFree || '') : (BUY.ship1 || '');
      ul.appendChild(el('li', '', [money(Math.round(v.sub / v.bags)) + (v.bags > 1 ? '/bag' : '/mo'), ship, 'every ' + (v.days || v.nights) + ' days'].filter(Boolean).join(' · ')));
      if (BUY.lock) ul.appendChild(el('li', '', BUY.lock));
      if (BUY.cancel) ul.appendChild(el('li', '', BUY.cancel));
      a.appendChild(ul);
      if (v.bags > 1 && BUY.gifts) {
        var g = el('div', 'sq-gifts'); String(BUY.gifts).split('|').forEach(function (t) { if (t.trim()) g.appendChild(el('span', 'sq-gift', '🎁 ' + t.trim())); }); a.appendChild(g);
      }
      opts.appendChild(a);
    } else st.mode = 'once';
    var o = planBtn(k, 'once', BUY.onetime || 'One-time purchase', v.once < v.price ? v.price : null, v.once);
    if (v.sub != null && v.once > v.sub && BUY.save) o.appendChild(el('p', 'sq-plan-save', BUY.save.replace('[amount]', money(v.once - v.sub))));
    opts.appendChild(o);
    ui.appendChild(opts);
    var price = st.mode === 'sub' && v.sub != null ? v.sub : v.once;
    var sp = $('[data-sq-sticky-price]'); if (sp) sp.textContent = money(price);
    var atcB = $('[data-sq-atc]', r); if (atcB) atcB.disabled = !v.available;
    var bn = $('[data-sq-buynow]', r); if (bn) bn.disabled = !v.available;
  }
  function planBtn(k, mode, label, was, now) {
    var st = sel[k], b = el('div', 'sq-plan' + (st.mode === mode ? ' is-on' : ''), null);
    b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', st.mode === mode ? 'true' : 'false'); b.tabIndex = 0;
    var h = el('p', 'sq-plan-h', null); h.appendChild(el('span', 'sq-plan-dot', null)); h.appendChild(el('span', 'sq-plan-l', label));
    var pr = el('span', 'sq-plan-pr', null); if (was) pr.appendChild(el('s', '', money(was))); pr.appendChild(el('strong', '', money(now))); h.appendChild(pr);
    b.appendChild(h);
    var choose = function () { if (st.mode !== mode) { st.mode = mode; renderBuy(k); } };
    b.addEventListener('click', choose);
    b.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(); } });
    return b;
  }
  function swapImage(k) {
    var v = pick(k), r = resEl(k), box = $('[data-sq-res-img]', r); if (!box || !v.image) return;
    var first = $('[data-sq-thumb][data-first]', r);
    if (box.dataset.pack === '1' || (box.classList.contains('sq-res-img--pack') && !first)) return;   // fixed packet image
    var im = $('img', box); if (im) { im.removeAttribute('srcset'); im.src = v.image; }
    // colour change: the first thumbnail follows the colour's photo and becomes the selected one
    if (first) { first.dataset.src = v.image; var ti = $('img', first); if (ti) { ti.removeAttribute('srcset'); ti.src = v.image; } setThumb(r, first); }
  }
  // thumbnails under the result image: tap shows that photo as the main image
  function setThumb(r, t) { $$('[data-sq-thumb]', r).forEach(function (x) { x.setAttribute('aria-current', x === t ? 'true' : 'false'); }); }
  $$('[data-sq-thumb]').forEach(function (t) {
    t.addEventListener('click', function () {
      var r = t.closest('.sq-res'), box = r && $('[data-sq-res-img]', r), im = box && $('img', box); if (!im) return;
      if (box.dataset.pack == null) box.dataset.pack = box.classList.contains('sq-res-img--pack') ? '1' : '0';
      box.classList.toggle('sq-res-img--pack', t.hasAttribute('data-first') && box.dataset.pack === '1');
      im.removeAttribute('srcset'); im.removeAttribute('sizes'); im.src = t.dataset.src; setThumb(r, t);
    });
  });

  // Add to Cart → the theme's cart drawer (same cart event as the product page, so the drawer and cart icon refresh).
  // Speed: the button says "Adding…" at once; the drawer fills and opens as soon as /cart/add.js answers (its
  // rendered drawer section comes back with it), and the full cart for the cart icon is fetched after that, in the background.
  var ADDING = '<span class="sq-spin" aria-hidden="true"></span> ' + (BUY.adding || 'Adding…');
  // drawer preview while the add is on its way: product photo, name, size/colour, plan and price + "Adding to your cart…"
  function showAdding(drawer, td, k, v, price, sub) {
    var inner = drawer && drawer.querySelector('.cart-drawer__inner'), items = drawer && drawer.querySelector('cart-items-component');
    if (!inner || !td || typeof td.open !== 'function') return null;
    var card = el('div', 'sq-adding', null); card.setAttribute('role', 'status');
    var pic = v.image, ri = !pic && $('[data-sq-res-img] img', resEl(k));
    if (ri) pic = ri.currentSrc || ri.src;
    if (pic) { var im = document.createElement('img'); im.src = pic; im.alt = ''; im.width = 72; im.height = 72; card.appendChild(im); } else card.classList.add('sq-adding--noimg');
    var body = el('div', 'sq-adding-b', null);
    body.appendChild(el('p', 'sq-adding-t', PRODUCTS[k].title));
    body.appendChild(el('p', 'sq-adding-v', [v.color, v.size].filter(Boolean).join(' / ') + (sub ? ' · ' + (BUY.autoship || 'Autoship & Save') : '')));
    var st = el('p', 'sq-adding-s', null); st.innerHTML = '<span class="sq-spin" aria-hidden="true"></span> ' + (BUY.adding_drawer || 'Adding to your cart…'); body.appendChild(st);
    card.appendChild(body);
    card.appendChild(el('p', 'sq-adding-p', money(price)));
    var head = inner.querySelector('.theme-drawer__header');
    if (head && head.nextSibling) inner.insertBefore(card, head.nextSibling); else inner.insertBefore(card, inner.firstChild);
    if (items) items.classList.add(drawer.querySelector('[data-cart-drawer-empty], .cart-drawer--empty') ? 'sq-adding-hide' : 'sq-adding-dim');
    if (!td.isOpen) td.open();
    return { card: card, items: items, td: td };
  }
  function clearAdding(p, failed) {
    if (!p) return;
    if (p.items) p.items.classList.remove('sq-adding-dim', 'sq-adding-hide');
    p.card.remove();
    if (failed && p.td && p.td.isOpen && typeof p.td.close === 'function') p.td.close();
  }
  function addToCart(btn) {
    var k = score().result, st = sel[k]; if (!st || btn.getAttribute('aria-busy') === 'true') return;
    var v = pick(k), r = resEl(k), err = $('[data-sq-atc-err]', r);
    var body = { id: v.id, quantity: 1 };
    if (st.mode === 'sub' && v.plan) body.selling_plan = v.plan;
    var ids = $$('cart-items-component', document).map(function (c) { return c.dataset.sectionId; }).filter(Boolean);
    if (ids.length) body.sections = ids.join(',');
    var label = btn.innerHTML; btn.setAttribute('aria-busy', 'true'); btn.innerHTML = ADDING; err.hidden = true;
    var drawer = document.querySelector('cart-drawer-component'), td = drawer && drawer.closest('theme-drawer');
    var wasEmpty = !!(drawer && drawer.querySelector('[data-cart-drawer-empty], .cart-drawer--empty'));
    // Instant: open the drawer now with a preview of the line being added; the real cart replaces it when Shopify answers
    var preview = showAdding(drawer, td, k, v, st.mode === 'sub' && v.sub != null ? v.sub : v.once, st.mode === 'sub' && v.sub != null);
    var mod = null, deferred = null, Ev = null;
    // the add request starts right away; the events module (already preloaded by the theme) loads alongside it
    var addReq = fetch(ROOT_URL + 'cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body)
    }).then(function (res) { return res.json(); });
    var renderer = import('@theme/section-renderer').catch(function () { return null; });
    import('@shopify/events').catch(function () { return null; }).then(function (m) {
      mod = m; Ev = mod && mod.CartLinesUpdateEvent; deferred = Ev ? Ev.createPromise() : null;
      if (deferred) btn.dispatchEvent(new Ev({ action: 'add', context: 'product', lines: [{ merchandiseId: String(v.id), quantity: 1 }], promise: deferred.promise }));
      return addReq;
    }).then(function (added) {
      if (added.status) throw new Error(added.description || added.message || 'Could not add to cart');
      // 1) drawer: fill it from the returned section and open it now
      var html = added.sections && ids[0] && added.sections[ids[0]];
      var shown = renderer.then(function (rs) {
        if (rs && rs.morphSection && html) return rs.morphSection(ids[0], html, { mode: 'hydration', injectStylesheet: wasEmpty });
      }).catch(function () {}).then(function () {
        clearAdding(preview);
        if (td && typeof td.open === 'function') { if (!td.isOpen) td.open(); } else window.location.href = ROOT_URL + 'cart';
      });
      btn.textContent = BUY.added || 'Added ✓';
      setTimeout(function () { btn.innerHTML = label; btn.removeAttribute('aria-busy'); }, 1800);
      try { if (window.fbq) fbq('track', 'AddToCart', { content_name: PRODUCTS[k].title, content_category: 'SOMNA Quiz' }); } catch (e) {}
      // 2) cart icon and the rest of the theme: the full cart, in the background (the drawer is already up to date)
      return shown.then(function () { return fetch(ROOT_URL + 'cart.js'); }).then(function (res) { return res.json(); }).then(function (cart) {
        if (deferred) deferred.resolve({ cart: Ev.createCartFromAjaxResponse(cart), detail: { items: cart.items, source: 'somna-quiz', itemCount: 1, productId: String(PRODUCTS[k].id), sections: added.sections, didError: false } });
      });
    }).catch(function (e) {
      clearAdding(preview, true);
      if (deferred) deferred.reject(e);
      btn.innerHTML = label; btn.removeAttribute('aria-busy');
      err.textContent = (e && e.message) || 'Could not add to cart. Please try again.'; err.hidden = false;
    });
  }
  $$('[data-sq-atc]').forEach(function (b) { b.addEventListener('click', function () { addToCart(b); }); });

  // Buy now: adds the chosen bag / plan (same line as Add to Cart) and goes straight to checkout
  function buyNow(btn) {
    var k = score().result, st = sel[k]; if (!st || btn.getAttribute('aria-busy') === 'true') return;
    var v = pick(k), r = resEl(k), err = $('[data-sq-atc-err]', r);
    var body = { id: v.id, quantity: 1 };
    if (st.mode === 'sub' && v.plan) body.selling_plan = v.plan;
    var label = btn.innerHTML; btn.dataset.label = label; btn.setAttribute('aria-busy', 'true'); btn.innerHTML = '<span class="sq-spin" aria-hidden="true"></span> ' + (BUY.buying || 'Going to checkout…'); err.hidden = true;
    fetch(ROOT_URL + 'cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body)
    }).then(function (res) { return res.json(); }).then(function (added) {
      if (added.status) throw new Error(added.description || added.message || 'Could not add to cart');
      try { if (window.fbq) fbq('track', 'AddToCart', { content_name: PRODUCTS[k].title, content_category: 'SOMNA Quiz' }); } catch (e) {}
      window.location.href = ROOT_URL + 'checkout';
    }).catch(function (e) {
      btn.innerHTML = label; btn.removeAttribute('aria-busy');
      err.textContent = (e && e.message) || 'Could not add to cart. Please try again.'; err.hidden = false;
    });
  }
  $$('[data-sq-buynow]').forEach(function (b) { b.addEventListener('click', function () { buyNow(b); }); });
  // Back from checkout: the browser restores the page as it was left, so put the Buy now / Add to cart buttons back to normal
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    $$('[data-sq-buynow]').forEach(function (b) { if (b.dataset.label) b.innerHTML = b.dataset.label; b.removeAttribute('aria-busy'); });
  });

  // Sticky Add to Cart: shows once the main button has scrolled above the screen
  var stickyBar = $('[data-sq-sticky]'), io = null;
  function sticky(on) {
    if (!stickyBar) return;
    if (io) { io.disconnect(); io = null; }
    stickyBar.hidden = true;
    if (!on || !('IntersectionObserver' in window)) return;
    var r = current(), atc = r && ($('[data-sq-atc]', r) || $('[data-sq-buynow]', r)); if (!atc) return;
    io = new IntersectionObserver(function (es) { stickyBar.hidden = es[0].isIntersecting || es[0].boundingClientRect.top > 0; });
    io.observe(atc);
  }
  var stickyBtn = $('[data-sq-sticky-atc]');
  if (stickyBtn) stickyBtn.addEventListener('click', function () { var r = current(); if (r && $('[data-sq-atc]', r)) addToCart($('[data-sq-atc]', r)); });

  // Retake quiz: clears the answers and starts again at Q1
  $$('[data-sq-retake]').forEach(function (b) { b.addEventListener('click', function () { answers = {}; if (otherText) otherText.value = ''; syncMulti(); go(0); }); });

  show(0, false);
})();
</script>
<script>
  /* SOMNA V2 product page motion on the quiz result (only when "Result: use the SOMNA V2 product page sections" is on):
     <somna-quiz-layers> — What it's made of: layers peel apart, then the list appears (Sleep Bundle: the two cards drop in).
     <somna-quiz-float> — Results: the product flips once in place, then floats; the sticker keeps its pop shake (CSS).
     Plays when it comes on screen, resets once scrolled back below. Web Animations API, no library. */
  (function () {
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function watch(el, play, reset) {
      var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) play(); }, { rootMargin: '0px 0px -25% 0px' });
      var out = new IntersectionObserver(function (e) { if (!e[0].isIntersecting && e[0].boundingClientRect.top > 0) reset(); });
      io.observe(el); out.observe(el);
      return function () { io.disconnect(); out.disconnect(); };
    }
    /* "What it's made of" (V2 approved demo "Peel apart"): the layers appear stacked on one another, then peel apart one
       after another into place (first up-left, last down-right), then the list appears 1 -> n. The Sleep Bundle's two
       cards drop in one after the other. Layer centres are measured from the layer images, so 3 or 4 layers both work. */
    if (!customElements.get('somna-quiz-layers')) customElements.define('somna-quiz-layers', class extends HTMLElement {
      async connectedCallback() {
        if (still) return;
        this.layers = [...this.querySelectorAll('.sq-lay-layer')];
        this.items = [...this.querySelectorAll('.sq-lay-list li')];
        this.cards = [...this.querySelectorAll('.sq-lay-card')];
        this.anims = [];
        this.hidden(true);
        if (this.layers.length > 1) {
          try { this.centres = await Promise.all(this.layers.map((im) => this.centre(im.dataset.probe))); } catch (e) { this.centres = null; }
        }
        if (!this.isConnected) return;
        this.stop = watch(this, () => this.play(), () => this.reset());
      }
      disconnectedCallback() { if (this.stop) this.stop(); this.anims.forEach((a) => a.cancel()); }
      hidden(on) { [...this.layers, ...this.items, ...this.cards].forEach((el) => { el.style.opacity = on ? '0' : ''; }); }
      centre(src) {
        return new Promise((ok, no) => {
          var im = new Image(); im.crossOrigin = 'anonymous';
          im.onload = () => {
            var c = document.createElement('canvas'); c.width = im.naturalWidth; c.height = im.naturalHeight;
            var x = c.getContext('2d', { willReadFrequently: true }); x.drawImage(im, 0, 0);
            var d = x.getImageData(0, 0, c.width, c.height).data, sx = 0, sy = 0, n = 0;
            for (var k = 3; k < d.length; k += 4) if (d[k] > 160) { var q = (k - 3) / 4; sx += q % c.width; sy += Math.floor(q / c.width); n++; }
            ok(n ? { x: sx / n / c.width * 100, y: sy / n / c.height * 100 } : { x: 50, y: 50 });
          };
          im.onerror = no; im.src = src;
        });
      }
      add(el, kf, opt) { var a = el.animate(kf, Object.assign({ fill: 'both' }, opt)); this.anims.push(a); return a; }
      reset() {
        if (!this.played) return;
        this.anims.forEach((a) => a.cancel()); this.anims = []; this.played = false; this.hidden(true);
      }
      play() {
        if (this.played) return; this.played = true; this.hidden(false);
        var t = 0, ease = 'cubic-bezier(0.37, 0, 0.63, 1)';
        if (this.cards.length) {
          this.cards.forEach((c, i) => this.add(c, [{ opacity: 0, transform: 'translateY(28px) rotate(' + (i ? 3 : -3) + 'deg)' }, { opacity: 1, transform: 'none' }], { duration: 600, delay: i * 350, easing: 'cubic-bezier(0.34, 1.4, 0.64, 1)' }));
          t = 400;
        } else if (this.layers.length > 1) {
          var box = this.layers[0].getBoundingClientRect(), cs = this.centres || this.layers.map(() => ({ x: 50, y: 50 }));
          var mid = { x: cs.reduce((a, c) => a + c.x, 0) / cs.length, y: cs.reduce((a, c) => a + c.y, 0) / cs.length };
          var last = this.layers.length - 1, w = box.width / 100;
          this.layers.forEach((l, i) => {
            var ox = (mid.x - cs[i].x) / 100 * box.width, oy = (mid.y - cs[i].y) / 100 * box.height;
            var from = 'translate(' + ox + 'px,' + oy + 'px) scale(0.96)', at = 120 + i * 420;
            this.add(l, [{ opacity: 0, transform: from }, { opacity: 1, transform: from }], { duration: 160, easing: 'ease-out' });
            if (i === 0 || i === last) {
              var dir = i === 0 ? -1 : 1;
              this.add(l, [{ transform: from }, { transform: 'translate(' + dir * 14 * w + 'px,' + dir * 6 * w + 'px) rotate(' + dir * 8 + 'deg) scale(1.02)' }, { transform: 'none' }], { duration: 1000, delay: at, easing: ease, composite: 'replace' });
            } else {
              this.add(l, [{ transform: from }, { transform: 'none' }], { duration: 850, delay: at, easing: ease });
            }
          });
          t = 120 + last * 420 + 800;
        }
        this.items.forEach((it, i) => this.add(it, [{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 450, delay: t + i * 260, easing: 'ease-out' }));
      }
    });
    if (!customElements.get('somna-quiz-float')) customElements.define('somna-quiz-float', class extends HTMLElement {
      connectedCallback() {
        this.prod = this.querySelector('.sq-render-prod'); if (!this.prod) return;
        if (still) return;
        this.stop = watch(this, () => {
          if (this.flipped) return; this.flipped = true;
          this.classList.remove('is-floating');
          this.anim = this.prod.animate([
            { transform: 'translateY(0) rotateY(0deg)', opacity: 0 }, { transform: 'translateY(-24px) rotateY(180deg)', opacity: 1, offset: 0.5 }, { transform: 'translateY(0) rotateY(360deg)', opacity: 1 }
          ], { duration: 1100, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' });
          this.anim.finished.then(() => { if (this.flipped) this.classList.add('is-floating'); }).catch(function () {});
        }, () => { this.flipped = false; if (this.anim) this.anim.cancel(); this.classList.remove('is-floating'); });
      }
      disconnectedCallback() { if (this.stop) this.stop(); }
    });
  })();
</script>
