{%- comment -%} SOMNA quiz v5.2 logic: only rendered by sections/somna-quiz.liquid {%- endcomment -%}
<script>
(function () {
  var root = document.getElementById('sq-{{ sid }}');
  if (!root || root.dataset.sqReady) return;              // never initialise twice
  root.dataset.sqReady = '1';

  var $ = function (s, el) { return (el || root).querySelector(s); };
  var $$ = function (s, el) { return [].slice.call((el || root).querySelectorAll(s)); };
  var cfg = {};
  try { cfg = JSON.parse(root.parentNode.querySelector('[data-sq-config]').textContent); } catch (e) {}
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  var screens = $$('.sq-s');
  var qScreens = {}; screens.forEach(function (s) { if (s.dataset.q) qScreens[s.dataset.q] = s; });
  var top = $('[data-sq-top]'), back = $('[data-sq-back]'), progf = $('[data-sq-progf]'), prog = $('[data-sq-prog]');
  var step = $('[data-sq-step]'), live = $('[data-sq-live]');
  var form = $('[data-sq-form]'), emailIn = $('[data-sq-email]'), sendBtn = $('[data-sq-send]'), err = $('[data-sq-err]');
  var nameIn = $('[data-sq-name]');
  var TOTAL = 6;
  // progress bar per screen (PDF mockups)
  var PROG = { name: 6, q1: 12, q2: 25, q3: 38, q4: 50, story: 58, q5: 70, multi6: 82, analyze: 90, email: 95, report: 100, fix: 100 };

  // ---- state ----
  // unlocked: the discount code is earned only by signing up with an email (Skip shows the report without a code)
  var i = 0, answers = {}, busy = false, timer = null, signedUp = false, unlocked = false, sending = false, run = 0;
  var firstName = '';                                       // optional, from the name screen; personalises the email step + report
  var applying = null, applied = false, prefetched = {};    // QUIZ10 applied in the background → "Claim" goes straight to the product

  function opt(q) { var s = qScreens[q]; return answers[q] == null || !s ? null : s.querySelectorAll('.sq-opt')[answers[q]]; }
  function key(q) { var o = opt(q); return o ? o.getAttribute('data-key') : ''; }

  // ---- scoring (SOMNA_Quiz_v5.1: S = snoring/nose, T = mouth breathing; Q1–Q4 decide, Q5–Q6 report only) ----
  function score() {
    var S = 0, T = 0, who = 'self';
    for (var q = 1; q <= 4; q++) {
      var o = opt(q); if (!o) continue;
      S += parseInt(o.getAttribute('data-s') || '0', 10);
      T += parseInt(o.getAttribute('data-t') || '0', 10);
      if (q === 1) who = o.getAttribute('data-tag');
    }
    var tried = (answers[6] || []).map(function (k) { return qScreens[6].querySelectorAll('.sq-opt')[k].getAttribute('data-tried'); });
    // Check in order, stop at first match. Nasal Strips is the default (ties, low scores).
    var result = (S >= 3 && T >= 3) ? 'bundle' : (T > S ? 'tape' : 'strips');
    return { S: S, T: T, who: who, partner: who === 'partner', result: result, tried: tried,
      problem: key(2), nose: key(3), mouth: key(4), energy: key(5) };
  }
  // trend after Q4 (for the story break): same rule as the result
  function trend() { return score().result; }

  // ---- copy tables (report tiles, analyzing checklist, "why it fits you" ticks) ----
  var TXT = {
    issue: { snoring: 'Snoring', nose: 'Blocked nose', mouth: 'Dry mouth', tired: 'Waking up tired', both: 'Nose + mouth' },
    nose: { blocked: 'Blocked most nights', stuffy: 'Stuffy with a cold', clear: 'Clear' },
    mouth: { dry: 'Bone dry', drool: 'Drooling / breath', fine: 'Fine' },
    energy: { '1': 'Running on empty', '2': '3pm crash', '3': 'Foggy until coffee', '4': 'Pretty good' },
    tried: { strips: 'cheap strips', tape: 'mouth tape', pills: 'melatonin', earlier: 'sleeping earlier', spray: 'nasal spray', other: 'other' },
    check2: { snoring: ['Snoring: your biggest problem at night', 'Snoring: their biggest problem at night'],
      nose: ['Blocked or stuffy nose: your biggest problem', 'Blocked or stuffy nose: their biggest problem'],
      mouth: ['Dry mouth or sore throat on waking', 'Dry mouth or sore throat on waking'],
      tired: ['Waking up tired, even after a full night', 'Waking up tired, even after a full night'],
      both: ['Snoring or a blocked nose, plus a dry mouth', 'Snoring or a blocked nose, plus a dry mouth'] },
    check3: { blocked: 'Nose blocked most nights', stuffy: 'Nose stuffy with a cold or allergies', clear: 'Nose clear at night' },
    check4: { dry: 'Mouth bone dry on waking', drool: 'Drooling or morning breath', fine: 'Mouth fine on waking' },
    built: { snoring: 'snoring', nose: 'a blocked nose', mouth: 'a dry mouth', tired: 'tired mornings', both: 'a blocked nose + a dry mouth' }
  };
  function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
  function triedText(s) {
    var t = s.tried.filter(function (k) { return TXT.tried[k]; }).map(function (k) { return TXT.tried[k]; });
    return t.length ? cap(t.join(', ')) : 'Nothing yet';
  }
  function level(n) { return n >= 5 ? 'Strong' : (n >= 3 ? 'Medium' : 'Low'); }
  // "Sarah, your sleep report is ready" / "Sarah, you mentioned …"; no name → the line as written
  function named(t) { return firstName && t ? firstName + ', ' + t.charAt(0).toLowerCase() + t.slice(1) : t; }
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }

  // "Why it fits you": one tick from the result + up to two from Q6 (fallbacks keep it at three)
  function ticks(s) {
    var p = s.partner, out = [];
    if (s.result === 'strips') {
      // SOMNA_Quiz_Name_Personalisation.pdf: hold-open, then the strips line (tried strips) or the easy-start line, then drug-free
      out.push('Designed to gently hold ' + (p ? 'their' : 'your') + ' nose open through the night.');
      out.push(s.tried.indexOf('strips') > -1 ? (p ? (cfg.triedStripsPartner || cfg.triedStrips) : cfg.triedStrips) : cfg.stripsStart);
      return out.concat([cfg.triedPills]).filter(Boolean).slice(0, 3);
    } else if (s.result === 'tape') {
      var m = { dry: p ? '. You said they wake up bone dry.' : '. You said you wake up bone dry.', drool: '. You mentioned drooling or morning breath.' }[s.mouth]
        || ((s.problem === 'mouth') ? (p ? '. You said they wake with a dry mouth.' : '. You said you wake with a dry mouth.') : '.');
      out.push('Designed to keep ' + (p ? 'their lips gently closed so they breathe' : 'your lips gently closed so you breathe') + ' through the nose' + m);
    } else {
      out.push((p ? (cfg.bundleTickPartner || cfg.bundleTick) : cfg.bundleTick) || '');
    }
    var extra = [];
    if (s.tried.indexOf('strips') > -1 && s.result !== 'tape') extra.push(p ? (cfg.triedStripsPartner || cfg.triedStrips) : cfg.triedStrips);
    if (s.tried.indexOf('pills') > -1) extra.push(cfg.triedPills);
    if (s.tried.indexOf('tape') > -1 && s.result !== 'strips') extra.push(cfg.triedTape);
    extra = extra.filter(Boolean).slice(0, 2);
    // Sleep Bundle, nothing like it tried before: the easy-start line keeps it at three ticks
    if (s.result === 'bundle' && s.tried.indexOf('strips') < 0 && s.tried.indexOf('tape') < 0 && cfg.bundleStart) extra.unshift(p ? (cfg.bundleStartPartner || cfg.bundleStart) : cfg.bundleStart);
    if (extra.length < 2 && extra.indexOf(cfg.triedPills) < 0 && cfg.triedPills) extra.push(cfg.triedPills);
    // The 30-Night Money-Back Guarantee has its own trust line above the button, so it is not repeated here.
    return out.concat(extra).filter(Boolean).slice(0, 3);
  }

  function resEl(s) { return $('.sq-res[data-res="' + s.result + '"]'); }
  function productUrl(s) {
    var r = resEl(s), base = r ? r.getAttribute('data-url') : '';
    if (!base) return cfg.fallbackUrl || '/collections/all';
    var tried = s.tried.join(',');
    var path = base.split('?')[0], qs = (base.split('?')[1] ? base.split('?')[1] + '&' : '') + 'quiz=' + s.result + '&for=' + s.who + (tried ? '&tried=' + encodeURIComponent(tried) : '');
    // Email sign-ups: Shopify discount link applies the code, then opens the same product page.
    // Shopify drops a query string inside "redirect" but passes the link's other parameters on, so they go alongside it.
    if (unlocked && cfg.code && !applied) return '/discount/' + encodeURIComponent(cfg.code) + '?redirect=' + encodeURIComponent(path) + '&' + qs;
    return path + '?' + qs;
  }

  // Q1 "My partner" switches you/your to they/their. "Me" and "Both of us" keep the self wording.
  function applyWording() {
    var partner = score().partner;
    $$('[data-self][data-partner]').forEach(function (e) {
      var v = e.getAttribute(partner ? 'data-partner' : 'data-self');
      if (e.hasAttribute('data-html')) e.innerHTML = v; else e.textContent = v;
    });
  }

  function screenKey(sc) { var t = sc.getAttribute('data-type'); return t === 'q' ? 'q' + sc.dataset.q : (t === 'multi' ? 'multi' + sc.dataset.q : t); }
  function idx(type) { for (var k = 0; k < screens.length; k++) if (screens[k].getAttribute('data-type') === type) return k; return -1; }

  function show(n, focus) {
    clearTimeout(timer); busy = false; i = n; run++;
    screens.forEach(function (s, k) { s.classList.toggle('is-on', k === n); });
    // stop story-break videos (and any sound) once the shopper leaves that screen
    $$('.sq-s:not(.is-on) video').forEach(function (v) { try { v.pause(); } catch (e) {} });
    var sc = screens[n], ty = sc.getAttribute('data-type'), q = +sc.dataset.step || 0, pk = screenKey(sc);
    if (ty !== 'story') rcStop();
    root.classList.toggle('sq--wide', ty === 'report');      // result: report + fix side by side on wide screens (CSS)
    applyWording();
    var me = $('[data-sq-me]'); if (me) me.textContent = firstName || 'Me';   // Q1: their first name instead of "Me" (Skip keeps "Me")
    var hasBar = PROG[pk] != null;
    top.hidden = !hasBar;
    if (hasBar) { progf.style.width = PROG[pk] + '%'; prog.setAttribute('aria-valuenow', PROG[pk]); }
    back.hidden = n === 0 || ty === 'loader';
    step.hidden = !q; step.textContent = q ? q + ' of ' + TOTAL : '';
    live.textContent = q ? 'Question ' + q + ' of ' + TOTAL : '';
    if (ty === 'q') {
      var a = answers[sc.dataset.q];
      $$('.sq-opt', sc).forEach(function (o, k) { o.setAttribute('aria-pressed', a === k ? 'true' : 'false'); });
      var nx = $('[data-sq-next]', sc); if (nx) nx.hidden = a == null;
    }
    if (ty === 'multi') syncMulti();
    if (ty === 'story') renderStory();
    if (ty === 'analyze') runAnalyze();
    if (ty === 'email') { err.hidden = true; renderPeek(); renderEmail(); }
    if (ty === 'report') renderReport();
    if (ty === 'fix') renderFix();
    var h = sc.querySelector('.sq-res:not([hidden]) [tabindex="-1"]') || sc.querySelector('[tabindex="-1"]');
    if (focus && h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
    if (root.getBoundingClientRect().top < 0 || window.scrollY > root.offsetTop) { try { window.scrollTo({ top: root.offsetTop, behavior: reduce ? 'auto' : 'smooth' }); } catch (e) { window.scrollTo(0, root.offsetTop); } }
  }
  function go(n) { show(n, true); }

  // ---- single-select questions: tap lights up, moves on after 0.3s; repeat taps ignored ----
  screens.forEach(function (sc, si) {
    if (sc.getAttribute('data-type') !== 'q') return;
    $$('.sq-opt', sc).forEach(function (o, k) {
      o.addEventListener('click', function () {
        if (busy || screens[i] !== sc) return;
        busy = true;
        answers[sc.dataset.q] = k;
        $$('.sq-opt', sc).forEach(function (x) { x.setAttribute('aria-pressed', x === o ? 'true' : 'false'); });
        timer = setTimeout(function () { go(si + 1); }, 300);
      });
    });
  });
  screens.forEach(function (sc, si) {
    if (sc.getAttribute('data-type') !== 'q') return;
    var nx = el('button', 'sq-cta', 'Continue →'); nx.type = 'button'; nx.setAttribute('data-sq-next', ''); nx.hidden = true;
    nx.addEventListener('click', function () { if (!busy && answers[sc.dataset.q] != null) { busy = true; go(si + 1); } });
    sc.appendChild(nx);
  });
  // Back: previous step, skipping the auto screens (story break, analyzing) so it never bounces forward again.
  // Report → email step, Your fix → report. Answers, Q6 picks and the "Other" text are kept.
  var AUTO = { story: 1, analyze: 1, loader: 1 };
  back.addEventListener('click', function () {
    for (var k = i - 1; k >= 0; k--) if (!AUTO[screens[k].getAttribute('data-type')]) { go(k); return; }
  });
  $('[data-sq-story-next]').addEventListener('click', function () { if (!busy) { busy = true; go(i + 1); } });

  // ---- story break: Strips story if trending to Strips, Tape if Tape, one review of each for the Bundle ----
  // ---- review carousel (replaces the story video when "Story review" blocks exist) ----
  var rc = $('[data-sq-rc]'), rcTrack = rc && $('[data-sq-rc-track]', rc), rcTimer = null, rcDots = [], rcCur = 0, rcMoving = 0;
  function rcCards() { return $$('.sq-rc-card', rcTrack); }
  function rcIndex() { var c = rcCards(), x = rcTrack.scrollLeft, best = 0; c.forEach(function (e, k) { if (Math.abs(e.offsetLeft - rcTrack.offsetLeft - x) < Math.abs(c[best].offsetLeft - rcTrack.offsetLeft - x)) best = k; }); return best; }
  // 2 cards in view on mobile, 3 on desktop: the last start position is cards - visible, then it loops to the first
  function rcMax() { var c = rcCards(); if (!c.length) return 0; var vis = Math.max(1, Math.round(rcTrack.clientWidth / c[0].getBoundingClientRect().width)); return Math.max(0, c.length - vis); }
  function rcGo(k, smooth) {
    var c = rcCards(), m = rcMax(); if (!c.length) return; k = k > m ? 0 : (k < 0 ? m : k);
    rcCur = k; rcMoving = Date.now();                       // remember the target so taps during a slide still step on
    rcTrack.scrollTo({ left: c[k].offsetLeft - rcTrack.offsetLeft, behavior: smooth && !reduce ? 'smooth' : 'auto' });
    rcSync(k);
  }
  function rcSync(k) { var m = rcMax(); rcDots.forEach(function (d, j) { d.hidden = j > m; d.setAttribute('aria-current', j === Math.min(k, m) ? 'true' : 'false'); }); }
  // Autoplay: one review every 1s from the moment the screen shows (3s with no slide animation for "reduce motion" devices).
  // Pauses only while the shopper is swiping or using the arrows/dots, then resumes 6s later.
  var rcResumeT = null;
  function rcStop() { clearInterval(rcTimer); rcTimer = null; clearTimeout(rcResumeT); }
  function rcStart() { rcStop(); if (!rc || rcCards().length < 2 || screens[i].getAttribute('data-type') !== 'story') return; rcTimer = setInterval(function () { if (!document.hidden) rcGo(rcCur + 1, true); }, reduce ? 3000 : 1000); }
  function rcPause() { rcStop(); rcResumeT = setTimeout(rcStart, 6000); }
  if (rc) {
    var dotsBox = $('[data-sq-rc-dots]', rc);
    if (dotsBox) rcCards().forEach(function (c, k) {
      var d = el('button', 'sq-rc-dot', null); d.type = 'button'; d.setAttribute('aria-label', 'Review ' + (k + 1));
      d.addEventListener('click', function () { rcPause(); rcGo(k, true); }); dotsBox.appendChild(d); rcDots.push(d);
    });
    var pv = $('[data-sq-rc-prev]', rc), nx = $('[data-sq-rc-next]', rc);
    if (pv) pv.addEventListener('click', function () { rcPause(); rcGo(rcCur - 1, true); });
    if (nx) nx.addEventListener('click', function () { rcPause(); rcGo(rcCur + 1, true); });
    var rcScrollT; rcTrack.addEventListener('scroll', function () { clearTimeout(rcScrollT); rcScrollT = setTimeout(function () { if (Date.now() - rcMoving > 1200) { rcCur = rcIndex(); rcSync(rcCur); } }, 80); }, { passive: true });
    ['pointerdown', 'touchstart', 'wheel'].forEach(function (ev) { rcTrack.addEventListener(ev, rcPause, { passive: true }); });
    rc.addEventListener('keydown', rcPause);                            // keyboard users: hold still while they use it
  }
  function renderStory() {
    var t = trend(), boxes = $$('.sq-story');
    if (rc) {
      // reviews for the matched product first (Bundle: bundle, then strips, then tape)
      var order = t === 'bundle' ? ['bundle', 'strips', 'tape'] : (t === 'tape' ? ['tape', 'bundle', 'strips'] : ['strips', 'bundle', 'tape']);
      rcCards().sort(function (a, b) { return order.indexOf(a.dataset.product) - order.indexOf(b.dataset.product); }).forEach(function (c) { rcTrack.appendChild(c); });
      requestAnimationFrame(function () { rcGo(0, false); rcStart(); });
      return;
    }
    boxes.forEach(function (b) {
      var k = b.getAttribute('data-story'), revs = $$('.sq-review', b);
      var on = t === 'bundle' || k === t;
      b.hidden = !on || !b.children.length;
      revs.forEach(function (r, ri) { r.hidden = t === 'bundle' && ri > 0; });
      var v = $('video', b);
      if (v) { v.hidden = !on || (t === 'bundle' && k === 'tape' && !!$('video', boxes[0])); }
    });
    // No video for this path (e.g. Tape has none yet): show the first available story video instead, without its reviews.
    if (!boxes.some(function (b) { var v = $('video', b); return !b.hidden && v && !v.hidden; })) {
      var fb = boxes.filter(function (b) { return $('video', b); })[0];
      if (fb) { fb.hidden = false; $('video', fb).hidden = false; $$('.sq-review', fb).forEach(function (r) { r.hidden = true; }); }
    }
    boxes.forEach(function (b) {
      var v = $('video', b); if (!v) return;
      if (!b.hidden && !v.hidden && !reduce) { try { v.muted = true; var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); } catch (e) {} }
      else { try { v.pause(); } catch (e) {} }
    });
  }

  // ---- Q6 multi-select chips: "Nothing yet" clears the others and the others clear it ----
  var q6 = qScreens[6], q6opts = $$('.sq-opt', q6), cont = $('[data-sq-continue]');
  function triedIdx(v) { for (var k = 0; k < q6opts.length; k++) if (q6opts[k].getAttribute('data-tried') === v) return k; return -1; }
  var NOTHING = triedIdx('nothing'), OTHER = triedIdx('other');
  var otherBox = $('[data-sq-other]'), otherText = $('[data-sq-other-text]'), otherErr = $('[data-sq-other-err]');
  function otherOn() { return OTHER > -1 && (answers[6] || []).indexOf(OTHER) > -1; }
  function otherErrShow(m) { if (!otherErr) return; otherErr.textContent = m; otherErr.hidden = !m; otherText.setAttribute('aria-invalid', m ? 'true' : 'false'); }
  function syncMulti() {
    var picked = answers[6] || [];
    q6opts.forEach(function (x, j) { x.setAttribute('aria-pressed', picked.indexOf(j) > -1 ? 'true' : 'false'); });
    if (otherBox) {
      var on = otherOn();
      otherBox.hidden = !on; otherText.required = on;                // required only while Other is picked
      if (OTHER > -1) q6opts[OTHER].setAttribute('aria-expanded', on ? 'true' : 'false');
      if (!on) otherErrShow('');
    }
    cont.disabled = picked.length === 0;
  }
  if (otherText) otherText.addEventListener('input', function () { answers.other = otherText.value; if (otherText.value.trim()) otherErrShow(''); });
  q6opts.forEach(function (o, k) {
    o.addEventListener('click', function () {
      var picked = (answers[6] || []).slice(), at = picked.indexOf(k);
      if (at > -1) picked.splice(at, 1);
      else if (k === NOTHING) picked = [NOTHING];
      else { picked = picked.filter(function (x) { return x !== NOTHING; }); picked.push(k); }
      picked.sort(function (a, b) { return a - b; });
      answers[6] = picked; syncMulti();
      if (k === OTHER && otherOn() && otherText && !otherText.value.trim()) otherText.focus();
    });
  });
  cont.addEventListener('click', function () {
    if (busy || !(answers[6] || []).length) return;
    if (otherOn() && !otherText.value.trim()) { otherErrShow("Please tell us what you've tried."); otherText.focus(); return; }
    busy = true; go(i + 1);
  });

  // ---- 08 analyzing ring: 0→100% in 3 seconds, ticks off their own answers ----
  function runAnalyze() {
    var s = score(), my = run, p = s.partner ? 1 : 0;
    var items = [TXT.check2[s.problem] ? TXT.check2[s.problem][p] : 'Your biggest problem at night', TXT.check3[s.nose] || 'Nose at night',
      TXT.check4[s.mouth] || 'Mouth on waking', 'Tried before: ' + triedText(s).toLowerCase()];
    if (triedText(s) === 'Nothing yet') items[3] = 'Nothing tried yet';
    var list = $('[data-sq-checks]'); list.innerHTML = '';
    var lis = items.map(function (t) { var li = el('li', '', null); li.appendChild(el('span', 'sq-tick', null)); li.appendChild(el('span', '', t)); list.appendChild(li); return li; });
    var ring = $('[data-sq-ring]'), pct = $('[data-sq-pct]'), lbl = $('[data-sq-ring-lbl]');
    var C = 2 * Math.PI * 52; ring.style.strokeDasharray = C; ring.style.strokeDashoffset = C;
    var labels = ['Checking ' + (p ? 'their' : 'your') + ' nose answers', 'Checking ' + (p ? 'their' : 'your') + ' mouth answers', 'Finding ' + (p ? 'their' : 'your') + ' SOMNA fix'];
    var t0 = null, DUR = 3000;
    function frame(ts) {
      if (my !== run) return;                              // left the screen (Back)
      if (t0 == null) t0 = ts;
      var f = Math.min(1, (ts - t0) / DUR), v = Math.round(f * 100);
      ring.style.strokeDashoffset = C * (1 - f); pct.textContent = v + '%';
      lbl.textContent = labels[Math.min(2, Math.floor(f * 3))];
      lis.forEach(function (li, k) { li.classList.toggle('is-done', f >= (k + 1) * 0.22); });
      if (f < 1) requestAnimationFrame(frame);
      else timer = setTimeout(function () { if (my === run) go(i + 1); }, 350);
    }
    requestAnimationFrame(frame);
  }

  // ---- report building blocks (also used blurred on the email screen) ----
  function dots(box, n, max, animate) {
    box.innerHTML = '';
    for (var k = 0; k < max; k++) { var d = el('i', k < n ? 'is-on' : '', null); if (animate && k < n && !reduce) { d.className = ''; (function (d, k) { setTimeout(function () { d.className = 'is-on'; }, 250 + k * 110); })(d, k); } box.appendChild(d); }
  }
  function tiles(box, s) {
    box.innerHTML = '';
    var list = [['Main issue', TXT.issue[s.problem]]];
    if (s.result !== 'tape') list.push(['Nose at night', TXT.nose[s.nose]]);
    if (s.result !== 'strips') list.push(['Mouth on waking', TXT.mouth[s.mouth]]);
    list.push(['Daytime energy', TXT.energy[s.energy]], ['Tried before', triedText(s)]);
    list.forEach(function (t, k) {
      var d = el('div', 'sq-tilecard' + (list.length % 2 && k === list.length - 1 ? ' sq-tilecard--wide' : ''), null);
      d.appendChild(el('p', 'sq-lbl', t[0])); d.appendChild(el('p', '', t[1] || 'Not answered')); box.appendChild(d);
    });
  }
  function renderPeek() {
    var s = score(), box = $('[data-sq-peek]'); box.innerHTML = '';
    var c = el('div', 'sq-card sq-profile', null);
    c.appendChild(el('p', 'sq-lbl', 'Your breathing profile'));
    var m1 = el('div', 'sq-dots', null), m2 = el('div', 'sq-dots', null); dots(m1, Math.min(8, s.S), 8); dots(m2, Math.min(6, s.T), 6);
    c.appendChild(m1); c.appendChild(m2); box.appendChild(c);
    var g = el('div', 'sq-tilegrid', null); tiles(g, s); box.appendChild(g);
  }

  // ---- 10 sleep report ----
  function renderReport() {
    var s = score(), r = resEl(s), p = s.partner;
    var type = $('[data-sq-type]'), tname = r ? r.getAttribute('data-name') : '';
    type.textContent = tname;                                // the sleep type on its own; the name goes in the pill above
    var tp = $('[data-sq-type-pill]');                       // "Sarah's sleep type" (partner: "Their sleep type")
    if (tp && firstName && !p && cfg.typePillName) tp.textContent = cfg.typePillName.replace('[name]', firstName);
    type.classList.remove('is-reveal'); void type.offsetWidth; type.classList.add('is-reveal');
    var pr = $('[data-sq-problem]'), lines = (cfg.problems || {})[s.problem];
    pr.textContent = lines ? named(lines[p ? 1 : 0]) : ''; pr.hidden = !pr.textContent;
    $('[data-sq-nose-lbl]').textContent = level(s.S); $('[data-sq-mouth-lbl]').textContent = level(s.T);
    dots($('[data-sq-nose]'), Math.min(8, s.S), 8, true); dots($('[data-sq-mouth]'), Math.min(6, s.T), 6, true);
    tiles($('[data-sq-tilegrid]'), s);
    $('[data-sq-desc]').textContent = r ? r.getAttribute(p ? 'data-copy-partner' : 'data-copy-self') : '';
    var ct = $('[data-sq-code-top]'); if (ct) ct.hidden = !(unlocked && cfg.code);
    renderFix();
    prefetch(productUrl(s));                                 // product page is ready before they tap "Claim"
  }

  // ---- 11 your fix ----
  function renderFix() {
    var s = score(), r0 = resEl(s);
    $$('.sq-res').forEach(function (e) { e.hidden = e.getAttribute('data-res') !== s.result; });
    var rimg = $('.sq-res[data-res="' + s.result + '"] img'); if (rimg) rimg.loading = 'eager';   // load the matched product image now, not on scroll
    // "Sarah, here's your fix: SOMNA Nasal Strips" / partner: "Sarah, here's what we'd suggest for them: SOMNA Nasal Strips"
    var pre = s.partner ? (cfg.fixPartner || cfg.fixPrefix || '') : (firstName ? "Here's your fix:" : (cfg.fixPrefix || ''));
    $$('[data-sq-fix-h]').forEach(function (h) { h.textContent = named(pre) + ' SOMNA ' + h.getAttribute('data-ptitle'); });
    var tl1 = $('[data-sq-tl1]'); if (tl1 && s.result === 'strips' && tl1.getAttribute('data-strips')) tl1.textContent = tl1.getAttribute('data-strips');
    var plan = $('[data-sq-plan]'), word = r0 ? r0.getAttribute('data-word') : '';
    plan.setAttribute('href', productUrl(s));
    // "Get my strips – 10% off →" (partner: "Get their …"); no code (Skip) → without "– 10% off"
    var tmpl = (s.partner ? cfg.ctaPartner : cfg.ctaSelf) || '';
    if (tmpl && word) plan.textContent = tmpl.replace('[product]', word) + (unlocked && cfg.code && cfg.ctaOff ? ' ' + cfg.ctaOff : '') + ' →';
    var note = $('[data-sq-cta-note]'), nt = note && $('[data-sq-cta-note-t]', note);
    if (nt) { nt.textContent = note.getAttribute(unlocked && cfg.code ? 'data-code' : 'data-nocode') || ''; note.hidden = !nt.textContent; }
    var ul = $('[data-sq-ticks]'); ul.innerHTML = '';
    ticks(s).forEach(function (t) { var li = el('li', '', null); li.appendChild(el('span', 'sq-tick', null)); li.appendChild(el('span', '', t)); ul.appendChild(li); });
  }
  function saveMatch(s) {
    var r = resEl(s), built = TXT.built[s.problem] || '';
    if (s.result !== 'tape' && s.problem !== 'nose' && s.problem !== 'both' && (s.nose === 'blocked' || s.nose === 'stuffy')) built += ' + a ' + (s.nose === 'blocked' ? 'blocked' : 'stuffy') + ' nose';
    if (s.result !== 'strips' && s.problem !== 'mouth' && s.problem !== 'both' && s.mouth === 'dry') built += ' + a dry mouth';
    var path = productUrl(s).replace(/^\/discount\/[^?]*\?redirect=/, '').split(/[?&]/)[0];
    try { path = decodeURIComponent(path); } catch (e) {}
    // read by the product page banner (only on this product) and by "View my report" (restores this result)
    try { sessionStorage.setItem('somna-quiz-match', JSON.stringify({ result: s.result, who: s.who, path: path, type: r ? r.getAttribute('data-name') : '', built: built ? 'Built for ' + built : '', code: unlocked && cfg.code ? cfg.code : '', name: firstName,
      answers: answers, signedUp: signedUp, at: Date.now() })); } catch (e) {}
  }
  // "Claim My Discount" is a real link to the product page (works without JS too).
  $('[data-sq-plan]').addEventListener('click', function (e) {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
    e.preventDefault(); if (busy) return; busy = true;
    var a = this, s = score(); saveMatch(s); a.setAttribute('aria-busy', 'true');
    var done = false, leave = function () { if (done) return; done = true; location.href = productUrl(s); };
    if (applying && !applied) { applying.then(leave, leave); setTimeout(leave, 2500); } else leave();
  });

  // QUIZ10 is attached to the shopper's cart in the background as soon as it is unlocked (email sign-up),
  // so the product page opens directly instead of through Shopify's slow /discount redirect (~1–1.4s).
  function applyCode() {
    if (!cfg.code || applying) return;
    applying = fetch('/discount/' + encodeURIComponent(cfg.code), { redirect: 'manual', credentials: 'same-origin' })
      .then(function () { applied = true; var a = $('[data-sq-plan]'); if (a && screens[i].contains(a)) { a.setAttribute('href', productUrl(score())); prefetch(productUrl(score())); } })
      .catch(function () { applied = false; });                // keep the /discount link as the fallback
  }
  function prefetch(url) {
    if (!url || prefetched[url] || /^\/discount\//.test(url)) return;
    prefetched[url] = 1;
    var l = document.createElement('link'); l.rel = 'prefetch'; l.href = url; l.as = 'document'; document.head.appendChild(l);
  }

  // ---- 09 optional email → Klaviyo list (default Quiz Signups) with source "quiz" + result + answers ----
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  // "john" → "John"; letters, spaces, hyphens and apostrophes only; first word; never HTML (set via textContent)
  function cleanName(v) {
    v = String(v || '').replace(/[^\p{L}\p{M}' -]/gu, '').trim().split(/\s+/)[0] || '';
    return v ? v.charAt(0).toUpperCase() + v.slice(1, 30) : '';
  }
  function showErr(m) { err.textContent = m; err.hidden = !m; }
  function lead(result) { try { if (window.fbq) fbq('track', 'Lead', { content_name: 'SOMNA Quiz', content_category: result }); } catch (e) {} }
  function subscribe(email) {
    var s = score(), r = resEl(s);
    var props = { 'Signup source': cfg.source || 'quiz', 'Quiz result': s.result, 'Quiz sleep type': r ? r.getAttribute('data-name') : '', 'Quiz for': s.who,
      'Quiz problem': TXT.issue[s.problem] || '', 'Quiz nose': TXT.nose[s.nose] || '', 'Quiz mouth': TXT.mouth[s.mouth] || '',
      'Quiz energy': TXT.energy[s.energy] || '', 'Quiz tried': s.tried };
    if (s.tried.indexOf('other') > -1 && answers.other) props['Quiz tried other'] = answers.other.trim();
    function sub(list) {
      var body = { data: { type: 'subscription', attributes: {
        custom_source: cfg.source || 'quiz',
        profile: { data: { type: 'profile', attributes: firstName ? { email: email, first_name: firstName, properties: props } : { email: email, properties: props } } }
      }, relationships: { list: { data: { type: 'list', id: list } } } } };
      return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(cfg.klaviyoCompany), {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' }, body: JSON.stringify(body)
      });
    }
    // Quiz Signups (tracking) decides success; the Welcome flow list (Email List → Welcome Series) is added alongside, best effort
    var welcome = cfg.klaviyoWelcomeList && cfg.klaviyoWelcomeList !== cfg.klaviyoList ? sub(cfg.klaviyoWelcomeList).catch(function () {}) : null;
    return sub(cfg.klaviyoList).then(function (res) { if (!res.ok) throw new Error('Klaviyo ' + res.status); return welcome; }).then(function () { return s.result; });
  }
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    if (sending) return;                                   // ignore repeat taps / Enter
    var email = emailIn.value.trim();
    if (!EMAIL_RE.test(email)) { showErr('Enter a valid email address.'); emailIn.focus(); return; }
    if (!cfg.klaviyoCompany || !cfg.klaviyoList) { showErr("Sign-up isn't available right now. Tap the link below to see your report."); return; }
    sending = true; showErr(''); sendBtn.disabled = true; sendBtn.setAttribute('aria-busy', 'true'); sendBtn.textContent = 'Sending…';
    subscribe(email).then(function (result) {
      signedUp = true; unlocked = true; applyCode(); lead(result); go(idx('report'));   // code shows at the top of the report
    }).catch(function () {
      showErr("We couldn't save your email. Please try again, or tap the link below to see your report.");
    }).then(function () { sending = false; sendBtn.disabled = false; sendBtn.removeAttribute('aria-busy'); sendBtn.textContent = sendLabel; });
  });
  var sendLabel = sendBtn.textContent;
  emailIn.addEventListener('input', function () { if (!err.hidden) showErr(''); });
  // Skip: no email needed; shows the report without the discount code
  $('[data-sq-skip]').addEventListener('click', function () { if (!sending) go(idx('report')); });
  // Email step after a successful sign-up (e.g. Back from the report): show "You're in" + code instead of the form
  var done = $('[data-sq-done]'), consent = $('[data-sq-consent]'), skipBtn = $('[data-sq-skip]');
  function renderEmail() {
    var eh = $('[data-sq-named]'); if (eh) { if (!eh.dataset.orig) eh.dataset.orig = eh.textContent; eh.textContent = named(eh.dataset.orig); }
    if (done) done.hidden = !signedUp;
    form.hidden = signedUp; skipBtn.hidden = signedUp; if (consent) consent.hidden = signedUp;
  }
  var doneNext = $('[data-sq-done-next]'); if (doneNext) doneNext.addEventListener('click', function () { go(idx('report')); });

  // ---- 00 first name: optional. "Let's begin" with a name, or Skip → Q1 ----
  var nameForm = $('[data-sq-name-form]'), nameErr = $('[data-sq-name-err]'), nameSkip = $('[data-sq-name-skip]');
  function nameErrShow(m) { if (!nameErr) return; nameErr.textContent = m; nameErr.hidden = !m; if (m) nameIn.setAttribute('aria-invalid', 'true'); else nameIn.removeAttribute('aria-invalid'); }
  if (nameForm && nameIn) {
    nameForm.addEventListener('submit', function (ev) {
      ev.preventDefault(); if (busy) return;
      firstName = cleanName(nameIn.value);
      if (!firstName) { nameErrShow('Please enter your first name, or tap Skip.'); nameIn.focus(); return; }
      nameErrShow(''); go(i + 1);
    });
    nameIn.addEventListener('input', function () { if (nameErr && !nameErr.hidden) nameErrShow(''); });
  }
  if (nameSkip) nameSkip.addEventListener('click', function () { if (busy) return; firstName = ''; if (nameIn) { nameIn.value = ''; nameErrShow(''); } go(i + 1); });

  // "View my report" on the product page → /pages/quiz?report=1 reopens the saved result (same session only)
  var restored = false;
  if (/[?&]report=1/.test(location.search)) {
    try {
      var sv = JSON.parse(sessionStorage.getItem('somna-quiz-match') || 'null');
      if (sv && sv.answers && sv.answers[1] != null && Date.now() - (sv.at || 0) < 6 * 60 * 60 * 1000) {
        answers = sv.answers; firstName = sv.name || ''; signedUp = !!sv.signedUp; unlocked = !!sv.code;
        if (nameIn) nameIn.value = firstName; if (otherText && answers.other) otherText.value = answers.other;
        if (unlocked) applyCode();                           // code is already on the cart; keeps the button on the direct route
        show(idx('report'), false); restored = true;
      }
    } catch (e) {}
  }
  if (!restored) show(0, false);
})();
</script>
