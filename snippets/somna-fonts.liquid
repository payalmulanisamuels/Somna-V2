{%- comment -%}
  Somna V2 — Boldonse display font (Google Fonts, SIL Open Font License 1.1), self-hosted from the
  theme assets so there is no extra connection to Google. It replaces the accent font, which the
  Somna sections and display headings use. Boldonse has one weight (400); the accent weight is set
  to match so browsers never fake a bold.
  Latin subset only (23 KB). Preloaded on the homepage, where it is above the fold.
{%- endcomment -%}
{%- assign boldonse_url = 'boldonse-latin-400.woff2' | asset_url -%}
{%- if template.name == 'index' -%}
  {{ boldonse_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}
<style>
  @font-face {
    font-family: 'Boldonse';
    src: url('{{ boldonse_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --font-accent--family: 'Boldonse', {{ settings.type_accent_font.fallback_families }};
    --font-accent--style: normal;
    --font-accent--weight: 400;
  }
</style>
