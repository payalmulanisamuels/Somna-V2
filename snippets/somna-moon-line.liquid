{%- doc -%}
  Somna V2 — "moon countdown" line: seven moons from full to new, then "14 nights left · ends Wed 2 Dec, 11:59 PM PT".
  The end time and date come from the sale countdown bar (sections/somna-countdown.liquid, header group), so the date
  is set in one place. Hidden when there is no countdown bar or the sale has ended.
  @param {string} [text] - "[nights] nights left · ends [date]" ([nights] / [date] are filled in)
  @param {string} [date] - 'long' (desktop date "Wed 2 Dec, 11:59 PM PT", default), 'short' ("Wed 2 Dec") or 'auto' (short below 1300px)
  @param {string} [class] - extra class on the wrapper
{%- enddoc -%}
{%- liquid
  assign t = text | default: '[nights] nights left · ends [date]'
  assign d = date | default: 'long'
-%}
<somna-moon-line class="somna-moonline {{ class }}" data-text="{{ t | escape }}" data-date="{{ d }}" hidden>
  <span class="somna-moonline__moons" aria-hidden="true">
    {%- comment -%} full → new, as in the mockup {%- endcomment -%}
    <svg viewBox="0 0 136 16" focusable="false">
      <defs><clipPath id="smm-c"><circle cx="8" cy="8" r="7"/></clipPath></defs>
      {%- for i in (0..6) -%}
        {%- assign x = i | times: 20 -%}
        <g transform="translate({{ x }} 0)">
          <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3"/>
          {%- case i -%}
            {%- when 0 -%}<circle cx="8" cy="8" r="7" fill="currentColor"/>
            {%- when 1 -%}<path d="M8 1a7 7 0 1 1 0 14 4.6 7 0 0 1 0-14z" fill="currentColor"/>
            {%- when 2 -%}<path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor"/>
            {%- when 3 -%}<path d="M8 1a7 7 0 0 1 0 14 3 7 0 0 0 0-14z" fill="currentColor"/>
            {%- when 4 -%}<path d="M8 1a7 7 0 0 1 0 14 5.4 7 0 0 0 0-14z" fill="currentColor"/>
          {%- endcase -%}
        </g>
      {%- endfor -%}
    </svg>
  </span>
  <span class="somna-moonline__text" data-moon-text></span>
</somna-moon-line>

{%- unless somna_moon_line_loaded -%}
  {%- assign somna_moon_line_loaded = true -%}
  <script>
    if (!customElements.get('somna-moon-line')) {
      customElements.define('somna-moon-line', class extends HTMLElement {
        connectedCallback() {
          // a second moon line on the page connects before its own children are parsed: wait for the page
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
          else this.init();
        }
        init() {
          const cd = document.querySelector('somna-countdown[data-end]');
          const end = cd ? Date.parse(cd.dataset.end) : NaN;
          if (!end || end <= Date.now()) return;
          const long = cd.querySelector('.somna-cd__date')?.textContent.trim() || '';
          const short = cd.querySelector('.somna-cd__label-mob span')?.textContent.trim() || long.split(',')[0];
          const mode = this.dataset.date === 'auto' ? (matchMedia('(max-width: 1299px)').matches ? 'short' : 'long') : this.dataset.date;
          const date = mode === 'short' ? short : long;
          const nights = Math.max(1, Math.ceil((end - Date.now()) / 86400000));
          let t = this.dataset.text.replace('[nights]', nights).replace('[date]', date);
          if (nights === 1) t = t.replace('nights left', 'night left');
          this.querySelector('[data-moon-text]').textContent = t;
          this.hidden = false;
          this.buildMoons();
        }
        // moons drawn like the countdown bar's: shaded spheres with craters that wax new → full one after another,
        // with a soft halo pop as each fills. Reduced motion: the static full → new row. Paused while off screen.
        buildMoons() {
          const sv = this.querySelector('.somna-moonline__moons svg'); if (!sv) return;
          const g = 'sml' + Math.random().toString(36).slice(2, 8), R = 7, X = [8, 28, 48, 68, 88, 108, 128];
          const CR = [[-2.4, -1.7, 1.5], [2.3, 1.5, 1.2], [-0.6, 2.8, 0.9], [1.7, -2.8, 0.8], [-3.4, 1.3, 0.7]];
          const sphere = (cx, lit) => '<circle cx="' + cx + '" cy="8" r="' + R + '" fill="url(#' + g + (lit ? 'l' : 'd') + ')"/>' +
            CR.map((c) => '<circle cx="' + (cx + c[0]) + '" cy="' + (8 + c[1]) + '" r="' + c[2] + '" fill="url(#' + g + (lit ? 'cl' : 'cd') + ')"/>').join('') +
            '<circle cx="' + cx + '" cy="8" r="' + (R - 0.2) + '" fill="none" stroke="' + (lit ? 'rgba(255,255,255,.55)' : 'rgba(175,189,248,.35)') + '" stroke-width=".45"/>';
          sv.setAttribute('viewBox', '0 -2 136 20');
          sv.style.overflow = 'visible';
          sv.innerHTML = '<defs>' +
            '<radialGradient id="' + g + 'l" cx="38%" cy="34%" r="70%"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#e9edff"/><stop offset=".75" stop-color="#b9c3f5"/><stop offset="1" stop-color="#7f8ad0"/></radialGradient>' +
            '<radialGradient id="' + g + 'd" cx="38%" cy="34%" r="70%"><stop offset="0" stop-color="#343b66"/><stop offset=".7" stop-color="#232945"/><stop offset="1" stop-color="#171b33"/></radialGradient>' +
            '<radialGradient id="' + g + 'cl" cx="60%" cy="60%" r="60%"><stop offset="0" stop-color="#c6cdf2"/><stop offset=".8" stop-color="#9ea9e3"/><stop offset="1" stop-color="#eef1ff" stop-opacity=".6"/></radialGradient>' +
            '<radialGradient id="' + g + 'cd" cx="60%" cy="60%" r="60%"><stop offset="0" stop-color="#151a31"/><stop offset="1" stop-color="#2b3258" stop-opacity=".6"/></radialGradient>' +
            '<filter id="' + g + 'glow" x="-30%" y="-80%" width="160%" height="260%"><feGaussianBlur stdDeviation="1.1" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>' +
            X.map((x, i) => '<clipPath id="' + g + 'c' + i + '"><path class="somna-moonline__ph" d="M0 0Z"/></clipPath>').join('') + '</defs>' +
            '<g>' + X.map((x) => sphere(x, false)).join('') + '</g>' +
            '<g filter="url(#' + g + 'glow)">' + X.map((x, i) => '<g clip-path="url(#' + g + 'c' + i + ')">' + sphere(x, true) + '</g>').join('') + '</g>' +
            X.map((x) => '<circle class="somna-moonline__halo" cx="' + x + '" cy="8" r="7.6" fill="none" stroke="#dfe5ff" stroke-width=".6"/>').join('');
          this.X = X; this.R = R;
          this.phs = [...sv.querySelectorAll('.somna-moonline__ph')];
          this.halos = [...sv.querySelectorAll('.somna-moonline__halo')];
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            [1, 0.8, 0.5, 0.3, 0.15, 0, 0].forEach((f, i) => this.phs[i].setAttribute('d', this.phase(X[i], f)));
            return;
          }
          const loop = (now) => { this.draw(now); this.raf = requestAnimationFrame(loop); };
          const io = new IntersectionObserver((es) => {
            cancelAnimationFrame(this.raf);
            if (es[0].isIntersecting) this.raf = requestAnimationFrame(loop);
          });
          io.observe(this); this.io = io;
        }
        phase(cx, f) {
          const R = this.R;
          if (f <= 0) return 'M0 0Z';
          if (f >= 1) return 'M' + (cx - R) + ' 8a' + R + ' ' + R + ' 0 1 0 ' + 2 * R + ' 0a' + R + ' ' + R + ' 0 1 0 ' + -2 * R + ' 0Z';
          const rx = Math.abs(1 - 2 * f) * R;
          return 'M' + cx + ' ' + (8 - R) + 'A' + R + ' ' + R + ' 0 0 1 ' + cx + ' ' + (8 + R) + 'A' + rx + ' ' + R + ' 0 0 ' + (f < 0.5 ? 0 : 1) + ' ' + cx + ' ' + (8 - R) + 'Z';
        }
        draw(now) {
          const cyc = 14000;                                    // all seven moons fill in 14 s, then start again
          const prog = (now % cyc) / cyc;
          this.phs.forEach((ph, i) => ph.setAttribute('d', this.phase(this.X[i], Math.min(1, Math.max(0, prog * 7 - i)))));
          const full = Math.floor(prog * 7 + 1e-6);
          if (this.lastFull !== undefined && full > this.lastFull) {
            const h = this.halos[full - 1];
            if (h) { h.classList.remove('is-pop'); void h.getBBox(); h.classList.add('is-pop'); }
          }
          this.lastFull = full;
        }
        disconnectedCallback() { cancelAnimationFrame(this.raf); if (this.io) this.io.disconnect(); }
      });
    }
  </script>
  <style>
    .somna-moonline { display: inline-flex; align-items: center; gap: 12px; color: #f3feee; font-size: 15px; font-weight: 600; line-height: 1.3; }
    .somna-moonline[hidden] { display: none; }
    .somna-moonline__moons { flex: none; color: #f3feee; }
    .somna-moonline__moons svg { display: block; width: 136px; height: 16px; }
    .somna-moonline__halo { opacity: 0; transform-box: fill-box; transform-origin: center; }
    .somna-moonline__halo.is-pop { animation: somna-moonline-halo 1.1s ease-out; }
    @keyframes somna-moonline-halo { 0% { opacity: 0.9; transform: scale(0.9); } 100% { opacity: 0; transform: scale(1.9); } }
    @media (prefers-reduced-motion: reduce) { .somna-moonline__halo.is-pop { animation: none; } }
    @media screen and (max-width: 749px) {
      .somna-moonline { gap: 10px; font-size: 14px; }
      .somna-moonline__moons svg { width: 116px; height: 14px; }
    }
  </style>
{%- endunless -%}

