{%- doc -%}
  Black Friday sale page hero (Figma 5039:852, updated): the price line under the heading, with live prices
  (Subscribe & Save = lowest selling plan price, One-time = price less the one-time sale %), and the hero's
  sticker badge look (lavender, mint outline + hard mint shadow, slight tilt).
  Rendered from a Custom Liquid block in the sale page hero.
  Phones (Figma 5075:3845): centred hero with a short info line and the pouches photo below the copy, plus the
  phone styles for this page's gifts and FAQ sections (theme Section blocks, so they are styled here).
  @param {string} [handle] - product the prices come from (default nasal-strips)
  @param {string} [meta] - info line shown on phones under the price line
{%- enddoc -%}
{%- liquid
  assign hp = all_products[handle] | default: all_products['nasal-strips']
  assign hv = hp.first_available_variant | default: hp.variants.first
  assign sub = hv.price
  for a in hv.selling_plan_allocations
    if a.price < sub
      assign sub = a.price
    endif
  endfor
  capture once_off
    render 'somna-sale', get: 'once_off'
  endcapture
  assign once_off = once_off | strip | plus: 0
  assign once = 100 | minus: once_off | times: hv.price | divided_by: 100
-%}
<p class="somna-sale-hero-line">Strips, Tape and every bundle. Subscribe &amp; Save from <b>{{ sub | money }}</b>, one-time from <b>{{ once | money }}</b>.</p>
<p class="somna-sale-hero-meta">{{ meta | default: 'Drug-free · 30-Night guarantee · $4.95 shipping · 7–9 business days' | escape | replace: ' · ', ' <span aria-hidden="true">·</span> ' }}</p>
<style>
  /* the header ends on a fractional pixel, which left a 1px white seam above the hero: tuck the hero 1px under it */
  .hero-wrapper:has(.somna-sale-hero-line) { margin-top: -1px; }
  .somna-sale-hero-line { max-width: 514px; margin: 0; font-size: 16.5px; line-height: 1.35; color: rgb(243 254 238 / 0.67); }
  .somna-sale-hero-line b { font-weight: 700; color: #afbdf8; }
  .hero-wrapper:has(.somna-sale-hero-line) .somna-badge { rotate: -0.82deg; }
  .hero-wrapper:has(.somna-sale-hero-line) .somna-badge__main {
    padding: 0.45rem 0.9rem;
    border: 1.8px solid #f3feee;
    border-radius: 12px;
    box-shadow: 4.5px 3.6px 0 #f3feee;
    font-size: 17px;
  }
  .somna-sale-hero-meta { display: none; }
  @media screen and (max-width: 749px) {
    /* hero: centred copy at the top, pouches photo lower down (Figma 5075:3845) */
    .hero-wrapper:has(.somna-sale-hero-line) .hero__container { min-height: 650px !important; }
    .hero-wrapper:has(.somna-sale-hero-line) .hero__content-wrapper { justify-content: flex-start !important; padding-top: 0 !important; }
    .hero-wrapper:has(.somna-sale-hero-line) .hero__media-grid { overflow: hidden; }
    .hero-wrapper:has(.somna-sale-hero-line) .group-block-content { align-items: center !important; gap: 14px !important; text-align: center; }
    .hero-wrapper:has(.somna-sale-hero-line) .text-block,
    .hero-wrapper:has(.somna-sale-hero-line) h1 { text-align: center !important; }
    .hero-wrapper:has(.somna-sale-hero-line) h1 { font-size: 42px !important; line-height: 1.2 !important; }
    .hero-wrapper:has(.somna-sale-hero-line) img.hero__media {
      object-position: 50% 100% !important;
      transform: translateY(175px);
      transform-origin: 50% 100%;
    }
    .hero-wrapper:has(.somna-sale-hero-line) .overlay {
      opacity: 1 !important;
      background-image: linear-gradient(to bottom, #0b0f1d 0%, #0b0f1d 38%, rgb(11 15 29 / 0) 58%, rgb(11 15 29 / 0) 90%, #0b0f1d 100%) !important;
    }
    .hero-wrapper:has(.somna-sale-hero-line) .somna-badge { margin-bottom: 12px; rotate: -0.3deg; }
    .hero-wrapper:has(.somna-sale-hero-line) .somna-badge__main {
      padding: 2px 10px;
      border-width: 1px;
      border-radius: 6px;
      box-shadow: 2.2px 1.7px 0 #f3feee;
      font-size: 10px;
    }
    .somna-sale-hero-line { max-width: 300px; margin-inline: auto; font-size: 14px; text-align: center; }
    .somna-sale-hero-meta { display: block; margin: 6px 0 0; font-size: 10px; line-height: 1.3; text-align: center; color: rgb(243 254 238 / 0.7); }
    .somna-sale-hero-meta span { margin-inline: 4px; }

    /* gifts section: copy left-aligned, lavender button (as in the phone design) */
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__eyebrow'],
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__heading'],
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__heading'] *,
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__text'],
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__eyebrow'] p,
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__text'] p { text-align: left !important; align-self: stretch; }
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__eyebrow'] p { font-size: 10px !important; letter-spacing: 0.18em; text-transform: uppercase; }
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__heading'] * { text-align: left !important; font-size: 40px !important; line-height: 1.2 !important; color: #f3feee !important; }
    body:has(.somna-sale-hero-line) [id$='__gifts'] [class*='__text'] p { font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.04em; color: rgb(243 254 238 / 0.75) !important; }
    body:has(.somna-sale-hero-line) [id$='__gifts'] a[class*='__button'] {
      width: 320px !important;
      max-width: 100%;
      min-height: 50px;
      margin-inline: auto;
      border-radius: 14px !important;
      background: #afbdf8 !important;
      border-color: #afbdf8 !important;
      font-size: 17px !important;
      font-weight: 500 !important;
    }

    /* FAQ: uppercase eyebrow + heading, no "Can't find your answer" line (as in the phone design) */
    body:has(.somna-sale-hero-line) [id$='__faq'] [class*='__eyebrow'] p { text-transform: uppercase; }
    body:has(.somna-sale-hero-line) [id$='__faq'] [class*='__heading'] * { text-transform: uppercase; font-size: 36px !important; line-height: 1.2 !important; }
    body:has(.somna-sale-hero-line) [id$='__faq'] [class*='-block--'][class*='__text'] { display: none; }
  }
</style>
