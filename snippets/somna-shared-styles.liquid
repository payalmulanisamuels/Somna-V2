  @media screen and (max-width: 749px) {
    :is(.somna-edge-drip-bottom, .somna-edge-drip-top, .somna-edge-torn, .somna-edge-mobile-drip-bottom) {
      --somna-drip-h: 26px;
    }

    /* "Edge shape on mobile" overrides */
    .somna-edge-mobile-none {
      -webkit-mask: none;
      mask: none;
      border-bottom-width: 0 !important;
    }

    .somna-edge-mobile-drip-bottom {
      border-bottom: var(--somna-drip-h) solid transparent !important;
      border-end-start-radius: 0 !important;
      border-end-end-radius: 0 !important;
      -webkit-mask: linear-gradient(#000 0 0) top / 100% calc(100% - var(--somna-drip-h) + 1px) no-repeat,
        var(--somna-drip) bottom / 100% var(--somna-drip-h) no-repeat;
      mask: linear-gradient(#000 0 0) top / 100% calc(100% - var(--somna-drip-h) + 1px) no-repeat,
        var(--somna-drip) bottom / 100% var(--somna-drip-h) no-repeat;
    }

    .somna-edge-torn:not([class*='somna-edge-mobile-']) {
      -webkit-mask-size: 20px 100%, calc(100% - 38px) 100%, 20px 100%;
      mask-size: 20px 100%, calc(100% - 38px) 100%, 20px 100%;
    }
  }

  /* #SomnaNights: Figma sets the Instagram button text bold */
  [id$='__somna_nights'] .button-custom {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media screen and (min-width: 750px) {
    [id$='__somna_nights'] .button-custom {
      font-size: 1rem;
    }
  }

  /* Final CTA (desktop/tablet): tall enough that the pouches clear the wave hanging over the photo,
     content centred in the visible part below the wave, Figma button (bold, 351px) */
  @media screen and (min-width: 750px) {
    [id$='__final_cta'] :is(.hero, .hero__container) {
      min-height: max(40vw, 520px) !important;
    }

    [id$='__final_cta'] .hero__container {
      padding-block: calc(16px + 135 * min(100vw, 1440px) / 1440) 16px !important;
    }

    [id$='__final_cta'] img.hero__media {
      object-position: 50% 20% !important;
    }

    [id$='__final_cta'] .button-custom {
      width: 351px !important;
      max-width: 100%;
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
  }

  /* Guarantee ("Try for 30 nights"): QA — Figma button, larger sub-line, tight spacing */
  [id$='__guarantee'] .button-custom {
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 14px rgb(29 78 216 / 0.2);
  }

  [id$='__guarantee'] .section-content-wrapper.layout-panel-flex {
    padding-block: 0 !important;
  }

  @media screen and (min-width: 750px) {
    [id$='__guarantee'] .somna-icon {
      --somna-icon-box: 80px !important;
      --somna-icon-size: 80px !important;
    }

    [id$='__guarantee'] .section-content-wrapper.layout-panel-flex {
      gap: 12px;
    }

    [id$='__guarantee'] .button-custom {
      width: 440px !important;
      max-width: 100%;
      min-height: 60px;
      font-size: 1.125rem;
      border-radius: 16px;
    }

    [id$='__guarantee'] [class*='__text'] p {
      font-size: 1.625rem !important;
      font-weight: 600 !important;
      letter-spacing: 0.02em !important;
    }
  }

  /* Figma font weights for Horizon text/button blocks on the homepage */
  [id$='__still_cant_pick'] [class*='__text'] p,
  [id$='__trust'] [class*='__label'] p {
    font-weight: 600 !important;
  }

  :is([id$='__still_cant_pick'], [id$='__gifts']) .button-custom {
    font-weight: 600 !important;
  }

  [id$='__gifts'] :is([class*='__label'], [class*='__text']) p,
  [id$='__newsletter'] button {
    font-weight: 500 !important;
  }

  /* FAQ ("Questions? We've got you."): Figma sizes, questions lead, heading a step smaller */
  [id$='__faq'] .details__header {
    font-weight: 400 !important;
    letter-spacing: 0.04em;
  }

  [id$='__faq'] .details-content p {
    color: #3a3a3a !important;
  }

  @media screen and (min-width: 750px) {
    [id$='__faq'] [class*='__heading'] h2 {
      font-size: 2.5rem !important;
      line-height: normal !important;
    }

    [id$='__faq'] .details__header {
      font-size: 1.25rem !important;
      padding-block: 16px !important;
    }

    [id$='__faq'] .icon-plus {
      width: 18px !important;
      height: 18px !important;
    }

    [id$='__faq'] .details-content {
      max-width: 62ch !important;
      padding-block-end: 16px !important;
    }
  }

  /* Hero "Shop now" button: Figma Inter Extra Bold */
  [id$='__hero_jVaWmY'] .button-custom {
    font-weight: 800 !important;
  }
{% endstylesheet %}
