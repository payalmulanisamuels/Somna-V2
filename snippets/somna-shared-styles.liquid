  }

  .somna-edge-drip-bottom {
    border-bottom: var(--somna-drip-h) solid transparent !important;
    border-end-start-radius: 0 !important;
    border-end-end-radius: 0 !important;
    -webkit-mask: linear-gradient(#000 0 0) top / 100% calc(100% - var(--somna-drip-h) + 1px) no-repeat,
      var(--somna-drip) bottom / 100% var(--somna-drip-h) no-repeat;
    mask: linear-gradient(#000 0 0) top / 100% calc(100% - var(--somna-drip-h) + 1px) no-repeat,
      var(--somna-drip) bottom / 100% var(--somna-drip-h) no-repeat;
  }

