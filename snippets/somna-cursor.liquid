{%- doc -%}
  Somna V2 — custom cursor (approved demo "D · Stardust trail"): the Figma crescent moon follows the
  pointer with soft easing and leaves a short trail of stardust (no pointer dot, no wave line).
  On hover it tilts and little "z"s float up ("N · Sleepy Zzz").

  Rendered once from layout/theme.liquid. Turned on/off in Theme settings → Animations → "Somna cursor".
  Not loaded in the theme editor, so editing keeps the normal cursor.
  Behaviour lives in assets/somna-cursor.js; the native cursor is only hidden once that script has
  drawn the custom one (html.somna-cursor-on), so if it fails the normal cursor stays.
{%- enddoc -%}
{%- if settings.somna_cursor and request.design_mode == false -%}
  <script src="{{ 'somna-cursor.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  /* native cursor off only once the custom one is live; text fields, iframes and disabled/busy controls keep theirs */
  html.somna-cursor-on,
  html.somna-cursor-on *,
  html.somna-cursor-on ::backdrop {
    cursor: none !important;
  }

  html.somna-cursor-on :is(input:not([type='button'], [type='submit'], [type='reset'], [type='checkbox'], [type='radio'], [type='range'], [type='color'], [type='file'], [type='image']), textarea, [contenteditable=''], [contenteditable='true']) {
    cursor: text !important;
  }

  html.somna-cursor-on :is(:disabled, [aria-disabled='true']) {
    cursor: not-allowed !important;
  }

  html.somna-cursor-on [aria-busy='true'] {
    cursor: progress !important;
  }

  .somna-cursor {
    /* navy on light grounds, lavender + mint on dark; a thin opposite halo keeps it readable over photos */
    --somna-cursor-moon: #0b0f1d;
    --somna-cursor-halo: rgb(243 254 238 / 0.9);

    position: fixed;
    inset: 0 auto auto 0;
    z-index: 2147483647;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .somna-cursor.on-dark {
    --somna-cursor-moon: #afbdf8;
    --somna-cursor-halo: rgb(11 15 29 / 0.75);
  }

  .somna-cursor.is-visible {
    opacity: 1;
  }

  .somna-cursor.is-native {
    opacity: 0;
    transition-duration: 0.08s;
  }

  .somna-cursor > * {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
  }

  /* the theme's base.css caps canvas/svg at max-width: 100% of their parent; the cursor box is 0 × 0,
     which squashed the stardust canvas to nothing — lift that cap for the cursor only */
  .somna-cursor canvas,
  .somna-cursor svg {
    max-width: none;
    max-height: none;
  }

  .somna-cursor__fx {
    width: 100vw;
    height: 100vh;
    will-change: auto;
  }

  /* the crescent's open side sits on the pointer, like a star beside the moon */
  .somna-cursor__moon {
    width: 34px;
    height: 34px;
    margin: -14px 0 0 -23px;
  }

  .somna-cursor__moon svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform-origin: 23px 14px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .somna-cursor__body {
    fill: var(--somna-cursor-moon);
    stroke: var(--somna-cursor-halo);
    stroke-width: 1;
    paint-order: stroke;
    transition: fill 0.25s, stroke 0.25s;
  }

  .somna-cursor__cut {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* hover ("N · Sleepy Zzz"): the crescent tilts and little "z"s float up from it */
  .somna-cursor.is-hover .somna-cursor__moon svg {
    transform: scale(1.1) rotate(-15deg);
  }

  .somna-cursor__zzz {
    position: absolute;
    left: 27px;
    top: -4px;
    width: 0;
    height: 0;
  }

  .somna-cursor__zzz i {
    position: absolute;
    left: 0;
    top: 0;
    font: 800 9px/1 var(--font-body--family, system-ui, sans-serif);
    font-style: normal;
    color: var(--somna-cursor-moon);
    text-shadow: 0 0 2px var(--somna-cursor-halo);
    opacity: 0;
  }

  .somna-cursor.is-hover .somna-cursor__zzz i {
    animation: somna-cursor-zzz 2.1s ease-out infinite;
  }

  .somna-cursor.is-hover .somna-cursor__zzz i:nth-child(2) {
    animation-delay: 0.7s;
    font-size: 11px;
  }

  .somna-cursor.is-hover .somna-cursor__zzz i:nth-child(3) {
    animation-delay: 1.4s;
    font-size: 13px;
  }

  @keyframes somna-cursor-zzz {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }

    20% {
      opacity: 1;
    }

    100% {
      transform: translate(14px, -22px);
      opacity: 0;
    }
  }

  .somna-cursor.is-down .somna-cursor__moon svg {
    transform: scale(0.86) rotate(-6deg);
    transition-duration: 0.12s;
  }

  .somna-cursor.is-hover.is-down .somna-cursor__moon svg {
    transform: scale(0.98) rotate(-15deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-cursor__moon svg,
    .somna-cursor__cut {
      transition: none !important;
    }

    .somna-cursor__fx {
      display: none;
    }

    .somna-cursor.is-hover .somna-cursor__zzz i {
      animation: none;
    }
  }
{% endstylesheet %}
