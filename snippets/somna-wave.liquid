{%- doc -%}
  Somna V2 — animated wave divider between two colours (shape traced from the Figma wave).
  Used by the "Somna wave" section and at the bottom of the Somna sections ("Bottom wave" setting).

  How it works: the wave shape is one seamless period in assets/somna-wave-mask.svg. Each layer is a
  strip in the "below" colour, one period wider than the screen, cut by that SVG as a repeating CSS
  mask, and slides left to right by exactly one period with a GPU transform, so the loop has no visible reset. A second, very faint
  layer (mirrored, slower) gives depth. Reduced-motion users get the same wave, static.

  @param {string} top - colour above the wave
  @param {string} bottom - colour below the wave
  @param {boolean} [flip] - mirror horizontally
  @param {boolean} [drops] - show the small drops (default true)
  @param {boolean} [animate] - gentle drift (default true)
  @param {number} [height] - maximum height in px on large screens (default 140)
  @param {number} [height_mobile] - minimum height in px on small screens (default 48)
{%- enddoc -%}
{%- liquid
  assign mask = 'somna-wave-mask.svg'
  if drops == false
    assign mask = 'somna-wave-mask-plain.svg'
  endif
  assign classes = 'somna-wave'
  if flip
    assign classes = classes | append: ' somna-wave--flip'
  endif
  if animate == false
    assign classes = classes | append: ' somna-wave--static'
  endif
-%}
<div
  class="{{ classes }}"
  style="--somna-wave-top: {{ top }}; --somna-wave-bottom: {{ bottom }}; --somna-wave-h: {{ height | default: 140 }}px; --somna-wave-h-mobile: {{ height_mobile | default: 48 }}px; --somna-wave-mask: url('{{ mask | asset_url }}'); --somna-wave-mask-plain: url('{{ 'somna-wave-mask-plain.svg' | asset_url }}');"
  aria-hidden="true"
>
  <span class="somna-wave__layer somna-wave__layer--back"><span class="somna-wave__shape"></span></span>
  <span class="somna-wave__layer somna-wave__layer--front"><span class="somna-wave__shape"></span></span>
</div>

{% stylesheet %}
  .somna-wave {
    position: relative;
    display: block;
    /* height follows the Figma proportions (140 / 1440) between the mobile minimum and the desktop maximum */
    --somna-wave-height: clamp(var(--somna-wave-h-mobile, 48px), 9.72vw, var(--somna-wave-h, 140px));
    /* one wave period keeps the Figma aspect ratio, so curves never get squeezed on small screens */
    /* whole pixels, so the repeating mask tiles meet without hairline seams */
    --somna-wave-period: round(calc(var(--somna-wave-height) * 1440 / 140), 1px);
    height: var(--somna-wave-height);
    background: var(--somna-wave-top);
    overflow: hidden;
    contain: paint;
  }

  .somna-wave__layer {
    position: absolute;
    inset: 0;
  }

  .somna-wave__layer--back {
    opacity: 0.14;
    transform: scaleX(-1) translateY(-6%);
  }

  .somna-wave--flip .somna-wave__layer--front {
    transform: scaleX(-1);
  }

  .somna-wave--flip .somna-wave__layer--back {
    transform: translateY(-6%);
  }

  .somna-wave__shape {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(100% + var(--somna-wave-period));
    background: var(--somna-wave-bottom);
    -webkit-mask: var(--somna-wave-mask) 0 0 / var(--somna-wave-period) 100% repeat-x;
    mask: var(--somna-wave-mask) 0 0 / var(--somna-wave-period) 100% repeat-x;
    animation: somna-wave-drift 48s linear infinite;
    will-change: transform;
  }

  .somna-wave__layer--back .somna-wave__shape {
    -webkit-mask-image: var(--somna-wave-mask-plain);
    mask-image: var(--somna-wave-mask-plain);
    animation-duration: 76s;
    animation-direction: reverse;
  }

  /* a mirrored layer moves the other way on screen, so reverse it to keep everything drifting left → right */
  .somna-wave--flip .somna-wave__layer--front .somna-wave__shape {
    animation-direction: reverse;
  }

  .somna-wave--flip .somna-wave__layer--back .somna-wave__shape {
    animation-direction: normal;
  }

  @keyframes somna-wave-drift {
    from {
      transform: translate3d(calc(-1 * var(--somna-wave-period)), 0, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .somna-wave--static .somna-wave__shape {
    animation: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-wave__shape {
      animation: none;
      will-change: auto;
    }
  }
{% endstylesheet %}
