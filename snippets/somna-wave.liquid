{%- if shape_h > 0 -%}
  {%- liquid
    assign classes = 'somna-wave somna-wave--shape'
    if flip
      assign classes = classes | append: ' somna-wave--flip'
    endif
    if overlap
      assign classes = classes | append: ' somna-wave--overlap'
    endif
  -%}
  <div class="{{ classes }}" style="--somna-wave-units: {{ shape_h }};" aria-hidden="true">
    <svg viewBox="0 0 1440 {{ shape_h }}" preserveAspectRatio="none" focusable="false">
      {%- if bottom != blank -%}
        {%- if top != blank -%}<rect width="1440" height="{{ shape_h }}" fill="{{ top }}"/>{%- endif -%}
        <path fill="{{ bottom }}" d="M0,{{ shape_h }}{{ shape_edge }}L1440,{{ shape_h }}Z"/>
      {%- else -%}
        <path fill="{{ top }}" d="M0,0{{ shape_edge }}L1440,0Z"/>
      {%- endif -%}
      {%- unless drops == false -%}
        {%- assign drop_list = shape_drops | split: ';' -%}
        {%- for drop in drop_list -%}
          {%- assign dp = drop | split: ',' -%}
          {%- if dp[5] == '1' -%}{%- assign drop_fill = bottom | default: top -%}{%- else -%}{%- assign drop_fill = top | default: bottom -%}{%- endif -%}
          <ellipse cx="{{ dp[0] }}" cy="{{ dp[1] }}" rx="{{ dp[2] }}" ry="{{ dp[3] }}" transform="rotate({{ dp[4] }} {{ dp[0] }} {{ dp[1] }})" fill="{{ drop_fill }}"/>
        {%- endfor -%}
      {%- endunless -%}
    </svg>
  </div>
{%- else -%}
{%- liquid
  assign mask = 'somna-wave-sine.svg'
  if drops == false
    assign mask = 'somna-wave-sine-plain.svg'
  endif
  assign classes = 'somna-wave'
  if flip
    assign classes = classes | append: ' somna-wave--flip'
  endif

  # The darker colour always sits on the drop side and the drops are light, as in the Figma.
  # When the lighter colour is on top, the same wave is drawn upside down with the colours swapped.
  assign wave_bg = top
  assign wave_fill = bottom
  assign top_brightness = top | color_brightness
  assign bottom_brightness = bottom | color_brightness
  if top_brightness > bottom_brightness
    assign wave_bg = bottom
    assign wave_fill = top
    assign classes = classes | append: ' somna-wave--invert'
  endif
-%}
<div
  class="{{ classes }}"
  data-roll="{{ roll | default: 8 }}"
  data-animate="{% if animate == false %}false{% else %}true{% endif %}"
  data-drops="{% if drops == false %}false{% else %}true{% endif %}"
  style="--somna-wave-top: {{ wave_bg }}; --somna-wave-bottom: {{ wave_fill }}; --somna-wave-h: {{ height | default: 140 }}px; --somna-wave-h-mobile: {{ height_mobile | default: 48 }}px; --somna-wave-mask: url('{{ mask | asset_url }}');"
  aria-hidden="true"
>
  <span class="somna-wave__static"></span>
  <canvas class="somna-wave__canvas" data-somna-wave></canvas>
</div>
<script src="{{ 'somna-wave.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  .somna-wave {
    position: relative;
    display: block;
    /* height follows the Figma proportions (140 / 1440) between the mobile minimum and the desktop maximum */
    --somna-wave-height: clamp(var(--somna-wave-h-mobile, 48px), 9.72vw, var(--somna-wave-h, 140px));
    height: var(--somna-wave-height);
    background: var(--somna-wave-top);
    overflow: hidden;
    contain: paint;
  }

  .somna-wave__static,
  .somna-wave__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(var(--somna-wave-sx, 1), var(--somna-wave-sy, 1));
  }

  .somna-wave--flip {
    --somna-wave-sx: -1;
  }

  .somna-wave--invert {
    --somna-wave-sy: -1;
  }

  /* same wave, still, until the script draws on the canvas; tile width matches the canvas proportions */
  .somna-wave__static {
    background: var(--somna-wave-bottom);
    -webkit-mask: var(--somna-wave-mask) 0 0 / calc(var(--somna-wave-height) * 7.65) 100% repeat-x;
    mask: var(--somna-wave-mask) 0 0 / calc(var(--somna-wave-height) * 7.65) 100% repeat-x;
  }

  .somna-wave--live .somna-wave__static {
    visibility: hidden;
  }

  /* Figma shapes: 1440 design units across on desktop (capped at 1440px tall-scale on wide screens),
     the middle 640 units across on mobile, so the wave keeps the mobile Figma size */
  .somna-wave--shape {
    container-type: inline-size;
    background: none;
    height: auto;
    contain: none;
    overflow: hidden;
  }

  .somna-wave--shape svg {
    --somna-wave-u: calc(min(100cqi, 1440px) / 1440);
    display: block;
    width: max(100%, calc(1440 * var(--somna-wave-u)));
    height: calc(var(--somna-wave-units) * var(--somna-wave-u));
    margin-inline-start: 50%;
    transform: translateX(-50%) scaleX(var(--somna-wave-sx, 1));
  }

  .somna-wave--overlap {
    position: relative;
    z-index: 2;
    margin-block-end: calc(var(--somna-wave-units) * min(100vw, 1440px) / -1440);
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .somna-wave--shape svg {
      --somna-wave-u: calc(100cqi / 640);
    }

    .somna-wave--overlap {
      margin-block-end: calc(var(--somna-wave-units) * 100vw / -640);
    }
  }
{% endstylesheet %}
