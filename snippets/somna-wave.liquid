{%- doc -%}
  Somna V2 — animated wave divider between two colours ("K2": soft, even waves rolling slowly
  left to right, with the Figma drops riding on the water).
  Used by the "Somna wave" section and at the bottom of the Somna sections ("Bottom wave" setting).

  How it works: one wave, drawn on a <canvas> by assets/somna-wave.js (same drawing as the approved
  demo): even waves rolling left to right, a slower counter-ripple so the crests keep changing
  height, and the drops bobbing on the surface. The script pauses off screen and in background tabs,
  and draws one still frame for reduced motion. Underneath, the same wave is drawn statically with a
  CSS mask (assets/somna-wave-sine.svg), so the divider looks right before the script runs.

  @param {string} top - colour above the wave
  @param {string} bottom - colour below the wave
  @param {boolean} [flip] - mirror horizontally
  @param {boolean} [drops] - show the small drops (default true)
  @param {boolean} [animate] - gentle drift (default true)
  @param {number} [height] - maximum height in px on large screens (default 140)
  @param {number} [height_mobile] - minimum height in px on small screens (default 48)
  @param {number} [roll] - seconds for one crest to roll past (default 8)
{%- enddoc -%}
{%- liquid
  assign mask = 'somna-wave-sine.svg'
  if drops == false
    assign mask = 'somna-wave-sine-plain.svg'
  endif
  assign classes = 'somna-wave'
  if flip
    assign classes = classes | append: ' somna-wave--flip'
  endif

  # The darker colour always sits on the drop side and the drops are light, as in the Figma.
  # When the lighter colour is on top, the same wave is drawn upside down with the colours swapped.
  assign wave_bg = top
  assign wave_fill = bottom
  assign top_brightness = top | color_brightness
  assign bottom_brightness = bottom | color_brightness
  if top_brightness > bottom_brightness
    assign wave_bg = bottom
    assign wave_fill = top
    assign classes = classes | append: ' somna-wave--invert'
  endif
-%}
<div
  class="{{ classes }}"
  data-roll="{{ roll | default: 8 }}"
  data-animate="{% if animate == false %}false{% else %}true{% endif %}"
  data-drops="{% if drops == false %}false{% else %}true{% endif %}"
  style="--somna-wave-top: {{ wave_bg }}; --somna-wave-bottom: {{ wave_fill }}; --somna-wave-h: {{ height | default: 140 }}px; --somna-wave-h-mobile: {{ height_mobile | default: 48 }}px; --somna-wave-mask: url('{{ mask | asset_url }}');"
  aria-hidden="true"
>
  <span class="somna-wave__static"></span>
  <canvas class="somna-wave__canvas" data-somna-wave></canvas>
</div>
<script src="{{ 'somna-wave.js' | asset_url }}" defer></script>

{% stylesheet %}
  .somna-wave {
    position: relative;
    display: block;
    /* height follows the Figma proportions (140 / 1440) between the mobile minimum and the desktop maximum */
    --somna-wave-height: clamp(var(--somna-wave-h-mobile, 48px), 9.72vw, var(--somna-wave-h, 140px));
    height: var(--somna-wave-height);
    background: var(--somna-wave-top);
    overflow: hidden;
    contain: paint;
  }

  .somna-wave__static,
  .somna-wave__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(var(--somna-wave-sx, 1), var(--somna-wave-sy, 1));
  }

  .somna-wave--flip {
    --somna-wave-sx: -1;
  }

  .somna-wave--invert {
    --somna-wave-sy: -1;
  }

  /* same wave, still, until the script draws on the canvas; tile width matches the canvas proportions */
  .somna-wave__static {
    background: var(--somna-wave-bottom);
    -webkit-mask: var(--somna-wave-mask) 0 0 / calc(var(--somna-wave-height) * 7.65) 100% repeat-x;
    mask: var(--somna-wave-mask) 0 0 / calc(var(--somna-wave-height) * 7.65) 100% repeat-x;
  }

  .somna-wave--live .somna-wave__static {
    visibility: hidden;
  }
{% endstylesheet %}
