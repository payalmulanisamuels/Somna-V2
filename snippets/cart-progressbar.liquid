{%- comment -%}
  Somna V2 — free-gift progress in the cart drawer (rules moved from the live theme, new design).
  Rules:
  - 1 Bag / 1 month -> no guides (0%)
  - 2 Bags / 2 months -> both guides (100%)
  - 3+1 Bags / 4 months -> both guides (100%)
  - Colour Set + Season Bundle -> 3 months -> both guides (100%)
  - Sleep Bundle -> same rule for 2-Set and 3+1-Set tiers -> both guides (100%)
{%- endcomment -%}

{%- liquid
  # Bags per line = units in the variant's Size / Quantity / Set / Supply option x quantity:
  #   "1 Bag" / "1 Set" = 1, "2 Bags" / "2 Sets" = 2, "3+1 Bags" / "3+1 Sets" = 4,
  #   "4 Bags — 120 nights" = 4, "90 nights — 90 strips" = 3 (30 nights = 1 bag).
  # The Colour Set and Season Bundle unlock the guides on their own.
  # Free ($0) lines, e.g. the gifted e-books, are ignored.
  assign total_bags = 0
  assign has_guides = false
  assign progress_percent = 0
  assign message = 'You unlocked 3 free Sleep Guides!'

  for item in cart.items
    if item.original_price == 0
      continue
    endif

    assign product_title = item.product.title | downcase
    if product_title contains 'colour set' or product_title contains 'color set' or product_title contains 'season bundle'
      assign has_guides = true
      continue
    endif

    assign item_bags = 0
    for option in item.options_with_values
      assign option_name = option.name | downcase
      unless option_name contains 'size' or option_name contains 'quantity' or option_name contains 'set' or option_name contains 'supply'
        continue
      endunless

      assign option_value = option.value | downcase
      assign first_token = option_value | split: ' ' | first
      if first_token contains '+'
        # "3+1 Bags" -> 3 + 1
        assign token_parts = first_token | split: '+'
        for token_part in token_parts
          assign item_bags = item_bags | plus: token_part
        endfor
      elsif option_value contains 'bag' or option_value contains 'set'
        assign item_bags = first_token | plus: 0
      elsif option_value contains 'night'
        assign item_bags = first_token | plus: 0 | divided_by: 30
      endif
      break
    endfor

    assign line_bags = item_bags | times: item.quantity
    assign total_bags = total_bags | plus: line_bags
  endfor

  if has_guides or total_bags >= 2
    assign progress_percent = 100
    assign message = 'You unlocked 3 <b>FREE gifts</b>!'
  elsif total_bags == 1
    assign progress_percent = 50
    assign message = "You're <b>1 bag away</b> from 3 <b>FREE gifts</b>"
  else
    assign progress_percent = 0
    assign message = "You're <b>1 bag away</b> from 3 <b>FREE gifts</b>"
  endif
-%}

<div class="somna-gifts{% if progress_percent == 100 %} is-done{% endif %}">
  <p class="somna-gifts__msg"><span class="somna-gifts__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19M12 9v11.5M12 9c-1.5-3.8-6-4.6-6-2 0 1.6 3 2 6 2zM12 9c1.5-3.8 6-4.6 6-2 0 1.6-3 2-6 2z"/></svg></span><span>{{ message }}</span></p>
  <div class="somna-gifts__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress_percent }}" aria-label="Free gift progress">
    <span class="somna-gifts__fill" style="width: {{ progress_percent }}%;"></span>
    {%- if progress_percent > 0 and progress_percent < 100 -%}<span class="somna-gifts__dot" style="left: {{ progress_percent }}%;"></span>{%- endif -%}
    <span class="somna-gifts__end"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19M12 9v11.5M12 9c-1.5-3.8-6-4.6-6-2 0 1.6 3 2 6 2zM12 9c1.5-3.8 6-4.6 6-2 0 1.6-3 2-6 2z"/></svg></span>
  </div>
  <div class="somna-gifts__steps"><span>1 bag</span><span>2 bags · 3 gifts</span></div>
</div>
