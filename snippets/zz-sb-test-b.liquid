{%- liquid
  assign mf = product.metafields.custom
  assign images = product.media | where: 'media_type', 'image'
  # extra gallery images from the product's "PDP – Extra gallery images" field come first, then the product photos
  assign extra_images = mf.pdp_gallery.value
  if extra_images != blank
    assign images = extra_images | concat: images
  endif
  assign first_image = images | first
  assign gallery_below = false
  if s.gallery_layout == 'below'
    assign gallery_below = true
  elsif s.gallery_layout == 'auto' and first_image.aspect_ratio > 1
    assign gallery_below = true
  endif
  assign price_nights = mf.nights.value | default: 30
-%}
{%- assign box_products = mf.pdp_box_products.value -%}{%- assign box_notes = mf.pdp_box_notes.value -%}{%- for bp in box_products limit: 2 -%}{%- assign bnote = box_notes[forloop.index0] -%}{{ bp.title }}{{ bnote }}{%- endfor -%}