    position: absolute;
    top: 50%;
    left: -18px;
    translate: -50% -50%;
    color: #f3feee;
    font-size: 1.375rem;
    font-weight: 700;
  }

  .somna-pdp-hero__box-card,
  .somna-pdp-hero__gifts-bar {
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 6px;
    background: #2e3134;
    color: #f3feee;
  }

  .somna-pdp-hero__box-card {
    display: flex;
    gap: 14px;
    align-items: center;
    min-height: 92px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .somna-pdp-hero__box-card:hover {
    border-color: var(--somna-chip);
    background: #383c40;
  }

  .somna-pdp-hero__box-card:focus-visible {
    outline: 2px solid var(--somna-chip);
    outline-offset: 2px;
  }

  .somna-pdp-hero__box-thumb {
    flex: none;
    align-self: stretch;
    width: 86px;
    height: auto;
    object-fit: cover;
  }

  .somna-pdp-hero__box-text {
    display: grid;
    gap: 2px;
    min-width: 0;
    padding-right: 10px;
  }

  .somna-pdp-hero__box-name {
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .somna-pdp-hero__box-note {
    color: #9a9a9a;
    font-size: 0.9375rem;
  }

  .somna-pdp-hero__gifts-bar {
    display: grid;
    place-items: center;
    min-height: 56px;
    margin: 0;
    padding: 8px 16px;
    font-size: clamp(1.0625rem, 1.65vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  /* one product in the box (Color Set): the card takes the full row */
  .somna-pdp-hero__box-list:has(> :only-child) {
    grid-template-columns: minmax(0, 1fr);
  }

  .somna-pdp-hero__box-colors {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: center;
    margin-top: 2px;
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .somna-pdp-hero__box-color {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    letter-spacing: 0;
  }

  .somna-pdp-hero__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--somna-dot);
  }

  /* colour swatches (Sleep Bundle) */
  .somna-pdp-hero__colors {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .somna-pdp-hero__colors legend {
    float: left;
    padding: 0;
    color: #f3feee;
    font-size: clamp(1.25rem, 1.75vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .somna-pdp-hero__swatches {
    display: flex;
    gap: 18px;
  }

  .somna-pdp-hero__swatch {
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    background: var(--somna-dot);
    cursor: pointer;
    transition: box-shadow 0.2s;
  }

  .somna-pdp-hero__swatch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .somna-pdp-hero__swatch:has(input:checked) {
    box-shadow: 0 0 0 3px #0b0f1d, 0 0 0 5px var(--somna-mint);
  }

  .somna-pdp-hero__swatch:has(input:focus-visible) {
    outline: 2px solid var(--somna-chip);
    outline-offset: 6px;
  }

  /* upgrade card under the perks (Color Set "Add the tape?", Sleep Bundle "Go for 90 nights?") */
  .somna-pdp-hero__upsell {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }

  .somna-pdp-hero__upsell-label {
    margin: 0;
    color: #f3feee;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .somna-pdp-hero__upsell-card {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 10px 16px 10px 10px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 6px;
    background: #2e3134;
    color: #f3feee;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .somna-pdp-hero__upsell-card:hover {
    border-color: var(--somna-chip);
    background: #383c40;
  }

  .somna-pdp-hero__upsell-card:focus-visible {
    outline: 2px solid var(--somna-chip);
    outline-offset: 2px;
  }

  .somna-pdp-hero__upsell-thumb {
    flex: none;
    width: 120px;
    height: 88px;
    border-radius: 4px;
    object-fit: cover;
  }

  .somna-pdp-hero__upsell-text {
    display: grid;
    flex: 1;
    gap: 4px;
    min-width: 0;
  }

  .somna-pdp-hero__upsell-title {
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .somna-pdp-hero__upsell-desc {
    color: #9a9a9a;
    font-size: 1rem;
    line-height: 1.2;
  }

  .somna-pdp-hero__upsell-button {
    flex: none;
    padding: 22px 26px;
    border-radius: 12px;
    background: var(--somna-chip);
    color: #000;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* tablets and phones: the upgrade card wraps and the swatches shrink, so the buy panel never widens the page */
  @media screen and (max-width: 1199px) {
    .somna-pdp-hero__upsell-card {
      flex-wrap: wrap;
    }

    .somna-pdp-hero__upsell-thumb {
      width: 88px;
      height: 72px;
    }

    .somna-pdp-hero__upsell-text {
      flex-basis: calc(100% - 104px);
    }

    .somna-pdp-hero__upsell-button {
      flex: 1;
      padding: 14px;
      text-align: center;
    }

    .somna-pdp-hero__swatch {
      width: 44px;
      height: 44px;
    }
  }

  @media screen and (min-width: 990px) and (max-width: 1299px) {
    .somna-pdp-hero__box-list {
      gap: 24px;
    }

    .somna-pdp-hero__box-item + .somna-pdp-hero__box-item::before {
      left: -12px;
    }

    .somna-pdp-hero__box-thumb {
      width: 64px;
    }

    .somna-pdp-hero__price-night {
      flex-basis: 100%;
      margin-left: 0;
    }
  }

  /* small laptops / tablets: the panel is too narrow for two cards side by side, so they stack */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .somna-pdp-hero__box-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }

    .somna-pdp-hero__box-item + .somna-pdp-hero__box-item::before {
      top: -13px;
      left: 50%;
    }

    .somna-pdp-hero__box-card {
      min-height: 72px;
    }

    .somna-pdp-hero__box-thumb {
      width: 72px;
    }
  }

  /* Mobile QA (Figma 4781:9521 / 4767:8277 / 4759:7535). Placed last so it wins over the tablet rules above.
     One grid column (the default "auto" column grew to the widest child and pushed the page sideways at 320px). */
  @media screen and (max-width: 749px) {
    .somna-pdp-hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-hero__savings {
      font-size: 0.625rem;
      letter-spacing: 0.04em;
      line-height: 1.35;
    }

    .somna-pdp-hero__price-night {
      font-size: 0.75rem;
    }

    .somna-pdp-hero__colors {
      gap: 8px 16px;
      margin-top: 12px;
    }

    .somna-pdp-hero__colors legend {
      font-size: 0.8125rem;
    }

    .somna-pdp-hero__swatches {
      gap: 12px;
    }

    .somna-pdp-hero__swatch {
      width: 30px;
      height: 30px;
    }

    /* What's in the box: two small cards side by side */
    .somna-pdp-hero__box {
      gap: 8px;
      margin-top: 12px;
    }

    .somna-pdp-hero__box-title {
      font-size: 0.75rem;
    }

    .somna-pdp-hero__box-list {
      gap: 20px;
    }

    .somna-pdp-hero__box-item + .somna-pdp-hero__box-item::before {
      left: -10px;
      font-size: 0.9375rem;
    }

    .somna-pdp-hero__box-card {
      gap: 8px;
      min-height: 46px;
      border-radius: 4px;
    }

    .somna-pdp-hero__box-thumb {
      width: 36px;
    }

    .somna-pdp-hero__box-text {
      gap: 1px;
      padding-block: 4px;
      padding-right: 6px;
    }

    .somna-pdp-hero__box-name {
      font-size: 0.8125rem;
    }

    .somna-pdp-hero__box-note,
    .somna-pdp-hero__box-colors {
      font-size: 0.5625rem;
    }

    .somna-pdp-hero__box-colors {
      gap: 2px 8px;
    }

    .somna-pdp-hero__dot {
      width: 9px;
      height: 9px;
    }

    .somna-pdp-hero__gifts-bar {
      min-height: 30px;
      padding: 6px 10px;
      font-size: 0.75rem;
    }

    /* upgrade card: one compact row, button on the right */
    .somna-pdp-hero__upsell {
      gap: 6px;
      margin-top: 4px;
    }

    .somna-pdp-hero__upsell-label {
      font-size: 0.75rem;
    }

    .somna-pdp-hero__upsell-card {
      flex-wrap: nowrap;
      gap: 10px;
      padding: 6px 8px 6px 6px;
    }

    .somna-pdp-hero__upsell-thumb {
      width: 56px;
      height: 44px;
    }

    .somna-pdp-hero__upsell-text {
      flex: 1 1 auto;
      gap: 2px;
    }

    .somna-pdp-hero__upsell-title {
      font-size: 0.8125rem;
    }

    .somna-pdp-hero__upsell-desc {
      font-size: 0.5625rem;
      line-height: 1.3;
    }

    .somna-pdp-hero__upsell-button {
      flex: none;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 0.625rem;
      text-align: center;
    }
  }

  /* very small phones (320px): the three feature labels may wrap */
  @media screen and (max-width: 359px) {
    .somna-pdp-hero__features li {
      white-space: normal;
      text-align: center;
    }
  }

  /* ---------- Sticky add to cart (Figma 4927:555 / 4927:1736) ----------
     Sizes come from a few variables so phones, tablets and desktop stay in proportion:
     phones follow the Figma 398px frame scaled to the screen, desktop is a compact floating card. */
  .somna-sticky-atc {
    --sa-mint: #f3feee;
    --sa-lav: #afbdf8;
    --sa-pad: 10px;
    --sa-thumb: 52px;
    --sa-title: clamp(0.9375rem, 4.2vw, 1.125rem);
    --sa-meta: 0.75rem;
    --sa-add-w: 76px;
    --sa-add-font: 0.875rem;
    --sa-banner: clamp(0.625rem, 2.9vw, 0.75rem);
    --sa-heading: clamp(1.125rem, calc((100vw - 80px) / 13.2), 1.75rem); /* "Choose your pack" stays on one line */
    --sa-mode: 0.8125rem;
    --sa-row-h: 64px;
    --sa-radio: 22px;
    --sa-name: 1.0625rem;
    --sa-row-meta: 0.75rem;
    --sa-price: 1.0625rem;
    --sa-badge: 0.75rem;
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    pointer-events: none;
    color: #000;
  }

  .somna-sticky-atc__bar {
    position: relative;
    z-index: 2;
    background: var(--sa-mint);
    border-top: 1.5px solid #000;
    transform: translateY(110%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: auto;
  }

  .somna-sticky-atc.is-visible .somna-sticky-atc__bar {
    transform: none;
  }

  html.somna-sticky-on body {
    padding-bottom: var(--somna-sticky-h, 0px);
  }

  .somna-sticky-atc__banner {
    margin: 0;
    padding: 6px 10px;
    border-bottom: 1.5px solid #000;
    background: var(--sa-lav);
    font-size: var(--sa-banner);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.3;
    text-align: center;
  }

  .somna-sticky-atc__main {
    display: flex;
    gap: 8px;
    align-items: stretch;
    padding: var(--sa-pad) var(--sa-pad) calc(var(--sa-pad) + env(safe-area-inset-bottom));
  }

  .somna-sticky-atc__card {
    display: flex;
    flex: 1;
    gap: 10px;
    align-items: center;
    min-width: 0;
    padding: 5px 10px 5px 5px;
    border: 2px solid #000;
    border-radius: 9px;
    background: var(--sa-mint);
    box-shadow: 2.5px 3px 0 #000;
    color: #000;
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .somna-sticky-atc__card:hover {
    background: #fff;
  }

  .somna-sticky-atc__card:active {
    transform: translate(2px, 2px);
    box-shadow: 0.5px 1px 0 #000;
  }

  .somna-sticky-atc__thumb {
    flex: none;
    width: var(--sa-thumb);
    height: var(--sa-thumb);
    overflow: hidden;
    border-radius: 6px;
    background: #0b1d6b;
  }

  .somna-sticky-atc__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-sticky-atc__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .somna-sticky-atc__title {
    overflow: hidden;
    font-family: var(--font-accent--family);
    font-size: var(--sa-title);
    font-weight: var(--font-accent--weight);
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .somna-sticky-atc__meta {
    overflow: hidden;
    font-size: var(--sa-meta);
    letter-spacing: 0.03em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .somna-sticky-atc__caret {
    flex: none;
    width: 10px;
    transition: transform 0.3s ease;
  }

  .somna-sticky-atc.is-open .somna-sticky-atc__caret {
    transform: rotate(180deg);
  }

  .somna-sticky-atc__add {
    flex: none;
    width: var(--sa-add-w);
    padding: 4px 6px;
    border: 2px solid #000;
    border-radius: 9px;
    background: #000;
    box-shadow: 2.5px 3px 0 var(--sa-lav);
    color: var(--sa-mint);
    font-family: var(--font-accent--family);
    font-size: var(--sa-add-font);
    font-weight: var(--font-accent--weight);
    line-height: 1.1;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .somna-sticky-atc__add:hover {
    background: var(--sa-lav);
    color: #000;
  }

  .somna-sticky-atc__add:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--sa-lav);
  }

  .somna-sticky-atc__add:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .somna-sticky-atc__add[aria-busy='true'] {
    opacity: 1;
    cursor: progress;
    animation: somnaStickyBusy 0.9s ease-in-out infinite;
  }

  @keyframes somnaStickyBusy {
    50% { opacity: 0.6; }
  }

  /* sheet: slides up from behind the bar */
  .somna-sticky-atc__backdrop {
    position: fixed;
    inset: 0;
    background: rgb(11 15 29 / 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .somna-sticky-atc.is-open .somna-sticky-atc__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .somna-sticky-atc__sheet {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    z-index: 1;
    max-height: calc(100dvh - var(--somna-sticky-h, 120px) - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 16px 20px;
    border-radius: 16px 16px 0 0;
    background: #000;
    color: var(--sa-mint);
    transform: translateY(calc(100% + var(--somna-sticky-h, 120px)));
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
    pointer-events: auto;
  }

  .somna-sticky-atc:not(.is-visible) .somna-sticky-atc__sheet {
    visibility: hidden;
  }

  .somna-sticky-atc.is-open .somna-sticky-atc__sheet {
    transform: none;
  }

  .somna-sticky-atc__sheet-head {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .somna-sticky-atc__heading {
    margin: 0;
    white-space: nowrap;
    color: var(--sa-lav);
    font-family: var(--font-accent--family);
    font-size: var(--sa-heading);
    font-weight: var(--font-accent--weight);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .somna-sticky-atc__heading em {
    color: var(--sa-mint);
    font-style: normal;
  }

  .somna-sticky-atc__close {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--sa-mint);
    cursor: pointer;
    transition: transform 0.3s ease, background-color 0.2s ease;
  }

  .somna-sticky-atc__close svg {
    width: 20px;
    height: 20px;
  }

  .somna-sticky-atc__close:hover {
    background: rgb(243 254 238 / 0.12);
    transform: rotate(90deg);
  }

  .somna-sticky-atc__modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin: 0 0 10px;
    padding: 3px;
    border: 2px solid var(--sa-mint);
    border-radius: 40px;
    box-shadow: 2.5px 3px 0 var(--sa-mint);
  }

  .somna-sticky-atc__mode {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 3px 8px;
    border: 0;
    border-radius: 32px;
    background: transparent;
    color: var(--sa-mint);
    font-size: var(--sa-mode);
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .somna-sticky-atc__mode[aria-pressed='true'] {
    background: var(--sa-lav);
    color: #000;
    font-weight: 600;
  }

  .somna-sticky-atc__mode:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .somna-sticky-atc__note {
    margin: 0 0 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    opacity: 0.85;
  }

  .somna-sticky-atc__colors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 10px;
  }

  .somna-sticky-atc__swatch {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 2px solid var(--sa-mint);
    border-radius: 50%;
    background: var(--somna-dot);
    cursor: pointer;
  }

  .somna-sticky-atc__swatch[aria-pressed='true'] {
    outline: 2px solid var(--sa-lav);
    outline-offset: 2px;
  }

  .somna-sticky-atc__packs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px 6px 4px 0;
  }

  .somna-sticky-atc__pack {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: var(--sa-row-h);
    padding: 8px 14px;
    border: 2px solid var(--sa-mint);
    border-radius: 8px;
    background: #000;
    box-shadow: 2.5px 3px 0 var(--sa-mint);
    color: var(--sa-mint);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }

  .somna-sticky-atc__pack:hover {
    transform: translate(-1px, -1px);
  }

  .somna-sticky-atc__pack[aria-checked='true'] {
    background: var(--sa-lav);
    color: #000;
  }

  .somna-sticky-atc__pack:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .somna-sticky-atc__radio {
    flex: none;
    width: var(--sa-radio);
    height: var(--sa-radio);
    border: 2px solid currentColor;
    border-radius: 50%;
    background: var(--sa-mint);
  }

  .somna-sticky-atc__pack[aria-checked='true'] .somna-sticky-atc__radio {
    border: 2.5px solid var(--sa-mint);
    background: #000;
    box-shadow: 0 0 0 2px #000;
  }

  .somna-sticky-atc__pack-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .somna-sticky-atc__pack-name {
    font-size: var(--sa-name);
    font-weight: 500;
    line-height: 1.2;
  }

  .somna-sticky-atc__pack-meta {
    font-size: var(--sa-row-meta);
    letter-spacing: 0.03em;
  }

  .somna-sticky-atc__pack-price {
    flex: none;
    font-size: var(--sa-price);
    font-weight: 600;
  }

  .somna-sticky-atc__badge {
    position: absolute;
    top: -11px;
    right: -6px;
    padding: 2px 6px;
    border: 1.5px solid #000;
    border-radius: 6px;
    background: var(--sa-mint);
    color: #000;
    font-family: var(--font-accent--family);
    font-size: var(--sa-badge);
    font-weight: var(--font-accent--weight);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .somna-sticky-atc :is(button):focus-visible {
    outline: 2px solid var(--sa-lav);
    outline-offset: 3px;
  }

  /* big phones / small tablets */
  @media screen and (min-width: 480px) {
    .somna-sticky-atc {
      --sa-thumb: 56px;
      --sa-title: 1.1875rem;
      --sa-meta: 0.8125rem;
      --sa-add-w: 96px;
      --sa-add-font: 0.9375rem;
      --sa-banner: 0.75rem;
      --sa-mode: 0.875rem;
      --sa-row-h: 68px;
      --sa-name: 1.125rem;
      --sa-row-meta: 0.8125rem;
      --sa-price: 1.125rem;
    }
  }

  /* tablet and desktop: a compact floating card centred at the bottom; the sheet opens just above it */
  @media screen and (min-width: 750px) {
    .somna-sticky-atc {
      --sa-pad: 8px;
      --sa-thumb: 44px;
      --sa-title: 1.125rem;
      --sa-meta: 0.75rem;
      --sa-add-font: 1rem;
      --sa-banner: 0.75rem;
      --sa-heading: 1.625rem;
      --sa-mode: 0.8125rem;
      --sa-row-h: 58px;
      --sa-radio: 20px;
      --sa-name: 1rem;
      --sa-row-meta: 0.75rem;
      --sa-price: 1rem;
      --sa-badge: 0.6875rem;
      inset: auto 0 14px;
      display: flex;
      justify-content: center;
    }

    .somna-sticky-atc__bar {
      width: min(560px, calc(100% - 40px));
      overflow: hidden;
      border: 2px solid #000;
      border-radius: 12px;
      box-shadow: 3px 4px 0 #000;
      transform: translateY(calc(100% + 24px));
    }

    .somna-sticky-atc__banner {
      padding: 4px 10px;
    }

    .somna-sticky-atc__main {
      gap: 8px;
      padding: 8px 10px 10px;
    }

    .somna-sticky-atc__card {
      padding: 4px 10px 4px 4px;
    }

    .somna-sticky-atc__add {
      width: auto;
      min-width: 132px;
      padding: 0 16px;
      white-space: nowrap;
    }

    .somna-sticky-atc__sheet {
      right: auto;
      left: 50%;
      bottom: calc(100% + 10px);
      width: min(440px, calc(100% - 40px));
      max-height: min(560px, calc(100dvh - var(--somna-sticky-h, 100px) - 90px));
      padding: 16px 18px 18px;
      border: 2px solid #000;
      border-radius: 14px;
      translate: -50% 0;
      transform: translateY(16px);
      opacity: 0;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
    }

    .somna-sticky-atc.is-open .somna-sticky-atc__sheet {
      opacity: 1;
    }

    html.somna-sticky-on body {
      padding-bottom: calc(var(--somna-sticky-h, 0px) + 24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-sticky-atc__bar,
    .somna-sticky-atc__sheet,
    .somna-sticky-atc__backdrop {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna product hero",
  "tag": "section",
  "class": "section-somna-pdp-hero",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Product content comes from the product: images, packs (variants), subscription plans and the metafields Tagline, Hero features, Hero quote and Review rating." },
    { "type": "product", "id": "preview_product", "label": "Product for the theme editor", "info": "Only used where there is no product (e.g. a preview)." },
    { "type": "checkbox", "id": "drip_edges", "label": "Drippy edges", "default": true },
    { "type": "header", "content": "Gallery" },
    { "type": "text", "id": "badge_text", "label": "Round badge", "default": "Up to 60% off" },
    { "type": "text", "id": "sticker_text", "label": "Sticker on the image", "info": "A product's PDP – Image sticker replaces it.", "default": "Bestseller" },
    { "type": "select", "id": "badge_motion", "label": "Badge and sticker animation", "info": "A short shake every few seconds. Off for visitors who prefer reduced motion.", "options": [{ "value": "none", "label": "None" }, { "value": "wiggle", "label": "Wiggle" }, { "value": "swing", "label": "Tilt-swing" }, { "value": "pop", "label": "Pop-jiggle" }], "default": "pop" },
    { "type": "select", "id": "rating_source", "label": "Rating line from", "options": [{ "value": "metafield", "label": "Product rating metafield" }, { "value": "judgeme", "label": "Judge.me (same numbers as the Reviews section)" }], "default": "judgeme", "info": "Judge.me falls back to the metafield when the product has no reviews." },
    { "type": "checkbox", "id": "quote_from_judgeme", "label": "Quote card: use a Judge.me review when the product has no Hero quote", "info": "Picks a short, named 5★ review of this product.", "default": true },
    { "type": "text", "id": "quote_skip_words", "label": "Quote card: skip Judge.me reviews containing", "info": "Comma-separated, no spaces after commas (spaces count, so \" but \" matches the word only). Skips mixed reviews such as \"worked fine at first, but…\".", "default": " but ,loose,okay,fell off" },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified Buyer" },
    { "type": "select", "id": "main_shape", "label": "Main photo box", "options": [{ "value": "natural", "label": "Photo's own shape" }, { "value": "square-fit", "label": "Square, whole photo on navy" }, { "value": "square-fill", "label": "Square, photo fills (sides trimmed)" }], "default": "natural", "info": "Square keeps the main photo as tall as the square gallery photos." },
    { "type": "select", "id": "main_drip", "label": "Main photo and drip edge", "options": [{ "value": "over", "label": "Drip over the photo's top" }, { "value": "below", "label": "Photo below the drip (whole photo)" }, { "value": "below-crop", "label": "Photo below the drip, bottom trimmed" }, { "value": "fit", "label": "Photo below the drip, a bit smaller" }, { "value": "none", "label": "No drip on the photo" }], "default": "over" },
    { "type": "select", "id": "video_shape", "label": "Video cards", "options": [{ "value": "natural", "label": "Each video's own shape" }, { "value": "equal", "label": "Same width (narrowest shape)" }], "default": "natural" },
    { "type": "text", "id": "videos_heading", "label": "Videos heading", "default": "Real Nights, On Camera" },
    { "type": "text", "id": "play_label", "label": "Play label (screen readers)", "default": "Play video" },
    { "type": "select", "id": "gallery_layout", "label": "Gallery layout", "options": [{ "value": "side", "label": "Thumbnails beside a portrait photo" }, { "value": "below", "label": "Thumbnails below a landscape photo" }, { "value": "auto", "label": "Automatic (by first photo)" }], "default": "side" },
    { "type": "header", "content": "Buy panel" },
    { "type": "text", "id": "rating_format", "label": "Rating text", "info": "[rating] and [count] come from the product's review metafield.", "default": "[rating]/5 · [count] reviews" },
    { "type": "text", "id": "brand", "label": "Brand before the title", "default": "somna." },
    { "type": "text", "id": "box_heading", "label": "What's in the box: heading", "info": "Shown when the product has PDP – What's in the box products.", "default": "What's in the Box?" },
    { "type": "text", "id": "box_colors_label", "label": "What's in the box: colours text", "info": "Before the colour dots (PDP – What's in the box colours).", "default": "Strip colors in this set:" },
    { "type": "header", "content": "Sticky add to cart" },
    { "type": "checkbox", "id": "sticky_enable", "label": "Show the sticky add to cart bar", "default": true, "info": "Appears once the buy box scrolls off the screen. Tapping the product opens “Choose your pack”." },
    { "type": "inline_richtext", "id": "sticky_banner", "label": "Bar: banner", "default": "+ 3 FREE GIFTS on 2+ packs . $4.95 standard shipping" },
    { "type": "text", "id": "sticky_sub_word", "label": "Bar: subscribe word", "default": "subscribe", "info": "Title reads “1 Bag. subscribe”" },
    { "type": "text", "id": "sticky_once_word", "label": "Bar: one-time word", "default": "one time" },
    { "type": "text", "id": "sticky_add_label", "label": "Bar: button", "default": "Add to cart" },
    { "type": "text", "id": "sticky_open_label", "label": "Bar: open packs (screen readers)", "default": "Change pack" },
    { "type": "text", "id": "sticky_heading", "label": "Sheet: heading", "default": "Choose your *pack*", "info": "*word* shows in white" },
    { "type": "text", "id": "sticky_sub_toggle", "label": "Sheet: subscribe button", "default": "Subscribe & Save" },
    { "type": "text", "id": "sticky_once_toggle", "label": "Sheet: one-time button", "default": "One time" },
    { "type": "text", "id": "sticky_note", "label": "Sheet: subscription note", "default": "Delivery [interval] . skip, pause or cancel anytime", "info": "[interval] = the chosen delivery interval, e.g. every month" },
    { "type": "text", "id": "upsell_button", "label": "Upgrade card: button", "info": "Used when the product's PDP – Upgrade card: button is empty.", "default": "Upgrade" },
    { "type": "text", "id": "save_label", "label": "Save badge", "info": "[percent] is worked out from the compare-at price.", "default": "Save [percent]%" },
    { "type": "text", "id": "percent_suffix", "label": "Discount after the plan names", "default": " · [percent]% off" },
    { "type": "text", "id": "packs_label", "label": "Pack label", "default": "Choose Your Pack" },
    { "type": "range", "id": "selected_position", "label": "Pack selected by default", "min": 1, "max": 6, "step": 1, "default": 1 },
    { "type": "range", "id": "badge_position", "label": "Pack with the badge", "min": 1, "max": 6, "step": 1, "default": 1 },
    { "type": "text", "id": "badge_label", "label": "Pack badge", "default": "Recommended" },
    { "type": "range", "id": "badge_2_position", "label": "Pack with the second badge", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "text", "id": "badge_2_label", "label": "Second pack badge", "default": "Most popular" },
    { "type": "range", "id": "badge_3_position", "label": "Pack with the third badge", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "badge_3_label", "label": "Third pack badge", "default": "Best value" },
    { "type": "text", "id": "gift_label", "label": "Gift note on bigger packs", "default": "+3 free gifts" },
    { "type": "number", "id": "gift_min_bags", "label": "Gift note from this many bags", "default": 2 },
    { "type": "number", "id": "nights_per_bag", "label": "Nights per bag", "info": "Used for the per-night price. 0 hides it.", "default": 30 },
    { "type": "text", "id": "night_label", "label": "Per-night suffix", "default": "/night" },
    { "type": "text", "id": "mode_label", "label": "Purchase option label (screen readers)", "default": "Purchase option" },
    { "type": "select", "id": "default_mode", "label": "Selected by default", "options": [{ "value": "sub", "label": "Subscribe" }, { "value": "once", "label": "One-time" }], "default": "sub" },
    { "type": "text", "id": "sub_label", "label": "Subscribe label", "default": "Subscribe & Save" },
    { "type": "textarea", "id": "sub_points", "label": "Subscribe points", "info": "One per line. [price] = the subscription price, [interval] = the chosen delivery frequency (e.g. every month).", "default": "Delivered on your schedule\n3 free gifts on 2+ packs\nSkip, pause or cancel anytime" },
    { "type": "text", "id": "plan_label", "label": "Delivery frequency label (screen readers)", "default": "Delivery frequency" },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One-time purchase" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to your cart." },
    { "type": "text", "id": "error_label", "label": "Error message", "default": "Couldn’t add to cart. Please try again." },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "select", "id": "sticker_motion", "label": "Trust sticker animation", "options": [{ "value": "none", "label": "None" }, { "value": "wiggle", "label": "Wiggle" }, { "value": "swing", "label": "Tilt-swing" }, { "value": "pop", "label": "Pop-jiggle" }], "default": "swing" },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#afbdf8" },
    { "type": "color", "id": "panel_color", "label": "Panel background", "default": "#0b0f1d" },
    { "type": "color", "id": "mint_color", "label": "Plan box and quote", "default": "#f3feee" },
    { "type": "color", "id": "chip_color", "label": "Accent / button", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
