    pointer-events: none;
    -webkit-mask:
      conic-gradient(from 45deg, #000 0deg var(--somna-border-reveal), transparent var(--somna-border-reveal) calc(360deg - var(--somna-border-reveal)), #000 calc(360deg - var(--somna-border-reveal))),
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: source-in, xor;
    mask:
      conic-gradient(from 45deg, #000 0deg var(--somna-border-reveal), transparent var(--somna-border-reveal) calc(360deg - var(--somna-border-reveal)), #000 calc(360deg - var(--somna-border-reveal))),
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: intersect, exclude;
    animation: somna-border-trace 0.68s cubic-bezier(0.45, 0, 0.2, 1) both;
