{%- comment -%}
  Somna V2 — product page hero (Figma 4557:857 Nasal Strips / 4557:44 Mouth Tape).
  Everything product-specific comes from the product: media, variants (packs), selling plans,
  and the metafields custom.pdp_tagline, custom.pdp_hero_features (PDP feature metaobjects),
  custom.pdp_quote (PDP quote metaobject) and custom.custom_review_rating_review_count.
  The buy panel is a real /cart/add form (works without JavaScript); with JavaScript it adds through
  assets/somna-cart.js so the cart drawer opens, and prices follow the chosen pack and plan.
  Shared look (packs, plan box, button) reuses the .somna-buy__* rules of the homepage buy box.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign perk_blocks = section.blocks | where: 'type', 'perk'
  assign sticker_blocks = section.blocks | where: 'type', 'sticker'
-%}
{%- if product != blank -%}
{%- liquid
  assign mf = product.metafields.custom
  assign images = product.media | where: 'media_type', 'image'
  assign first_image = images | first
  assign selected_index = s.selected_position | minus: 1
  assign current = product.selected_variant
  if current == blank
    assign current = product.variants[selected_index] | default: product.selected_or_first_available_variant
  endif
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign mode = s.default_mode
  if has_plans == false
    assign mode = 'once'
  endif
  assign alloc = current.selling_plan_allocations | first
  if mode == 'sub' and alloc
    assign price = alloc.price
  else
    assign price = current.price
  endif
  assign compare = current.compare_at_price | default: 0
  if price < current.price and current.price > compare
    assign compare = current.price
  endif
  if compare <= price
    assign compare = 0
  endif

  assign rating = ''
  assign rating_count = ''
  assign rating_raw = mf.custom_review_rating_review_count.value | strip_html | strip
  if rating_raw != blank
    assign rating = rating_raw | split: ' ' | first
    if rating_raw contains '('
      assign rating_count = rating_raw | split: '(' | last | split: ')' | first | strip
    endif
  endif
  if s.rating_source == 'judgeme'
    assign jm_sum = product.metafields.judgeme.review_widget_data.value
    if jm_sum and jm_sum.number_of_reviews > 0
      assign rating = jm_sum.average_rating | times: 1.0 | round: 1
      assign rating_count = jm_sum.number_of_reviews
    endif
  endif
-%}

<somna-pdp-buy
  class="somna-pdp-hero"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-nights="{{ s.nights_per_bag }}"
  data-gift-min="{{ s.gift_min_bags }}"
  style="--somna-pdp-bg: {{ s.background_color }}; --somna-panel: {{ s.panel_color }}; --somna-mint: {{ s.mint_color }}; --somna-chip: {{ s.chip_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <script type="application/json" data-variants>
    [
    {%- for v in product.variants -%}
      { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }}, "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "plans": [
        {%- for a in v.selling_plan_allocations -%}{ "id": {{ a.selling_plan.id }}, "price": {{ a.price }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}
      ] }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>

  <div class="somna-pdp-hero__inner somna-container">
    <div class="somna-pdp-hero__gallery">
      {%- if images.size > 1 -%}
        <ul class="somna-pdp-hero__thumbs" role="list">
          {%- for m in images limit: 8 -%}
            <li>
              <button type="button" class="somna-pdp-hero__thumb" data-media="{{ forloop.index0 }}" data-src="{{ m | image_url: width: 1100 }}" data-srcset="{{ m | image_url: width: 600 }} 600w, {{ m | image_url: width: 900 }} 900w, {{ m | image_url: width: 1100 }} 1100w" aria-label="{{ m.alt | default: product.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ m | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 96, height: 104 }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="somna-pdp-hero__main{% if s.drip_edges %} somna-edge-drip-top{% endif %}">
        {%- if first_image -%}
          {{ first_image | image_url: width: 1100 | image_tag: data-main: '', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 445px, (min-width: 750px) 45vw, 100vw', widths: '600, 900, 1100', alt: first_image.alt | default: product.title }}
        {%- endif -%}
      </div>

      {%- if s.badge_text != blank -%}<p class="somna-pdp-hero__badge{% if s.badge_motion != 'none' %} somna-shake--{{ s.badge_motion }}{% endif %}"><span>{{ s.badge_text }}</span></p>{%- endif -%}
      {%- if s.sticker_text != blank -%}<p class="somna-pdp-hero__sticker{% if s.badge_motion != 'none' %} somna-shake--{{ s.badge_motion }}{% endif %}" style="--somna-shake-delay: 0.7s;">{{ s.sticker_text }}</p>{%- endif -%}
    </div>

    <div class="somna-pdp-hero__side">
      {%- assign quote = mf.pdp_quote.value -%}
      {%- if quote == blank and s.quote_from_judgeme -%}
        {%- comment -%} Figma quote card: fall back to a real Judge.me review (short, 5★, named, no import tag) {%- endcomment -%}
        {%- assign jm = product.metafields.judgeme.review_widget_data.value -%}
        {%- assign jm_pick = nil -%}
        {%- for rv in jm.reviews -%}
          {%- assign rv_body = rv.body | strip_html | strip -%}
          {%- if rv.rating >= 5 and rv.is_anonymous_reviewer != true and rv_body.size <= 110 -%}
            {%- unless rv_body contains '(Review #' -%}
              {%- assign jm_pick = rv -%}
              {%- break -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if jm_pick -%}
          {%- assign jq_parts = jm_pick.reviewer_name | strip | split: ' ' -%}
          {%- assign jq_name = jq_parts | first -%}
          {%- if jq_parts.size > 1 -%}{%- assign jq_last = jq_parts | last | slice: 0 | upcase -%}{%- assign jq_name = jq_name | append: ' ' | append: jq_last | append: '.' -%}{%- endif -%}
          <figure class="somna-pdp-hero__quote">
            <span class="somna-pdp-hero__avatar somna-pdp-hero__avatar--initial" aria-hidden="true">{{ jq_name | slice: 0 }}</span>
            <div>
              <p class="somna-pdp-hero__stars" aria-label="{{ jm_pick.rating }} / 5">{% for i in (1..jm_pick.rating) %}★{% endfor %}</p>
              <blockquote>“{{ jm_pick.body | strip_html | strip }}”</blockquote>
              <figcaption><strong>{{ jq_name }}</strong>{% if jm_pick.verified_buyer %} <span>{{ s.verified_label }}</span>{% endif %}</figcaption>
            </div>
          </figure>
        {%- endif -%}
      {%- endif -%}
      {%- if quote != blank -%}
        <figure class="somna-pdp-hero__quote">
          {%- if quote.avatar.value != blank -%}{{ quote.avatar.value | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 79, height: 79, class: 'somna-pdp-hero__avatar' }}{%- endif -%}
          <div>
            {%- assign stars = quote.rating.value | default: 5 -%}
            <p class="somna-pdp-hero__stars" aria-label="{{ stars }} / 5">{% for i in (1..stars) %}★{% endfor %}</p>
            <blockquote>“{{ quote.quote.value }}”</blockquote>
            <figcaption><strong>{{ quote.author.value }}</strong>{% if quote.verified.value %} <span>{{ s.verified_label }}</span>{% endif %}</figcaption>
          </div>
        </figure>
      {%- endif -%}

      {%- if video_blocks.size > 0 -%}
        <div class="somna-pdp-hero__videos">
          {%- if s.videos_heading != blank -%}<h2 class="somna-pdp-hero__videos-title">{{ s.videos_heading }}</h2>{%- endif -%}
          <ul class="somna-pdp-hero__video-list" role="list">
            {%- for block in video_blocks -%}
              {%- liquid
                assign b = block.settings
                assign poster = b.poster | default: b.video.preview_image
                assign src = ''
                if b.video != blank
                  assign mp4 = b.video.sources | where: 'mime_type', 'video/mp4' | sort: 'height'
                  assign src = mp4.first.url
                  for m in mp4
                    if m.height <= 720
                      assign src = m.url
                    endif
                  endfor
                endif
              -%}
              <li class="somna-pdp-hero__video" {{ block.shopify_attributes }}>
                {%- if src != blank -%}
                  <button type="button" class="somna-pdp-hero__play" data-video="{{ src }}" aria-label="{{ s.play_label | escape }}{% if b.caption != blank %}: {{ b.caption | escape }}{% endif %}">
                    {%- if poster -%}{{ poster | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', width: 181, height: 299 }}{%- endif -%}
                    <span class="somna-pdp-hero__play-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>
                  </button>
                {%- elsif poster -%}
                  {{ poster | image_url: width: 400 | image_tag: loading: 'lazy', alt: b.caption, width: 181, height: 299 }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="somna-pdp-hero__panel{% if s.drip_edges %} somna-edge-drip-bottom{% endif %}">
      {%- if rating != blank -%}
        <p class="somna-pdp-hero__rating">
          <span class="somna-pdp-hero__rating-stars" aria-hidden="true">★★★★★</span>
          {{ s.rating_format | replace: '[rating]', rating | replace: '[count]', rating_count }}
        </p>
      {%- endif -%}
      <h1 class="somna-pdp-hero__title"><span class="somna-pdp-hero__brand">{{ s.brand }}</span> {{ product.title }}</h1>
      {%- if mf.pdp_tagline != blank -%}<p class="somna-pdp-hero__tagline">{{ mf.pdp_tagline.value | newline_to_br }}</p>{%- endif -%}

      {%- assign features = mf.pdp_hero_features.value -%}
      {%- if features != blank -%}
        <ul class="somna-pdp-hero__features" role="list">
          {%- for f in features -%}
            <li><span class="somna-pdp-hero__feature-icon">{% render 'somna-pdp-icon', name: f.icon.value %}</span>{{ f.title.value }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="somna-pdp-hero__price">
        {%- assign price_parts = price | money | split: '.' -%}
        <span class="somna-pdp-hero__price-now" data-price>{{ price_parts[0] }}{% if price_parts[1] %}<sup>{{ price_parts[1] }}</sup>{% endif %}</span>
        <s data-compare{% if compare == 0 %} hidden{% endif %}>{{ compare | money_without_trailing_zeros }}</s>
        {%- assign pct = 0 -%}
        {%- if compare > 0 -%}{%- assign pct = compare | minus: price | times: 100 | divided_by: compare -%}{%- endif -%}
        <span class="somna-pdp-hero__save" data-save{% if pct == 0 %} hidden{% endif %}>{{ s.save_label | replace: '[percent]', pct }}</span>
      </p>

      {%- form 'product', product, class: 'somna-pdp-hero__form', data-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-id>
        <input type="hidden" name="selling_plan" value="{% if mode == 'sub' and alloc %}{{ alloc.selling_plan.id }}{% endif %}" data-plan-input>

        <fieldset class="somna-buy__packs somna-pdp-hero__packs">
          <legend>{{ s.packs_label }}</legend>
          <div class="somna-buy__pack-list">
            {%- for v in product.variants -%}
              {%- liquid
                assign v_alloc = v.selling_plan_allocations | first
                if mode == 'sub' and v_alloc
                  assign v_price = v_alloc.price
                else
                  assign v_price = v.price
                endif
                assign bags = v.title | split: ' ' | first | plus: 0
                if bags < 1
                  assign bags = 1
                endif
              -%}
              <label class="somna-buy__pack{% unless v.available %} is-sold-out{% endunless %}">
                {%- if forloop.index == s.badge_position and s.badge_label != blank -%}<span class="somna-buy__pack-badge">{{ s.badge_label }}</span>{%- endif -%}
                <input type="radio" name="{{ section.id }}-pack" value="{{ forloop.index0 }}" data-pack{% if v.id == current.id %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
                <span class="somna-buy__pack-name">{{ v.title }}</span>
                <span class="somna-buy__pack-price" data-pack-price>{{ v_price | money }}</span>
                {%- assign v_compare = v.compare_at_price | default: 0 -%}
                {%- if v_price < v.price and v.price > v_compare -%}{%- assign v_compare = v.price -%}{%- endif -%}
                <s data-pack-compare>{% if v_compare > v_price %}{{ v_compare | money_without_trailing_zeros }}{% endif %}</s>
                {%- if bags >= s.gift_min_bags and s.gift_label != blank -%}
                  <span class="somna-pdp-hero__gift">{{ s.gift_label }}</span>
                {%- elsif s.nights_per_bag > 0 -%}
                  <span class="somna-buy__pack-night" data-pack-night>{{ v_price | divided_by: bags | divided_by: s.nights_per_bag | money }}{{ s.night_label }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="somna-buy__modes somna-pdp-hero__modes">
          <legend class="visually-hidden">{{ s.mode_label }}</legend>
          {%- if has_plans -%}
            <div class="somna-pdp-hero__mode-box" data-mode-box="sub">
              <label class="somna-buy__mode"><input type="radio" name="{{ section.id }}-mode" value="sub" data-mode-input{% if mode == 'sub' %} checked{% endif %}> <span class="somna-buy__mode-label"><strong>{{ s.sub_label }}</strong><span data-sub-pct></span></span> <span class="somna-buy__mode-price" data-price-sub>{% if alloc %}{{ alloc.price | money }}{% endif %}</span></label>
              {%- if s.sub_points != blank -%}
                <ul class="somna-pdp-hero__sub-points" role="list">
                  {%- assign points = s.sub_points | newline_to_br | split: '<br />' -%}
                  {%- for t in points -%}{%- assign pt = t | strip | replace: '[price]', '<span data-sub-each></span>' | replace: '[interval]', '<span data-sub-interval></span>' -%}{%- if pt != blank -%}<li><span class="somna-check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg></span><span>{{ pt }}</span></li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
              {%- assign group = product.selling_plan_groups | first -%}
              {%- if group.selling_plans.size > 1 -%}
                <label class="visually-hidden" for="{{ section.id }}-plan">{{ s.plan_label }}</label>
                <select class="somna-pdp-hero__plan" id="{{ section.id }}-plan" data-plan>
                  {%- for plan in group.selling_plans -%}
                    <option value="{{ plan.id }}"{% if alloc and plan.id == alloc.selling_plan.id %} selected{% endif %}>{{ plan.options.first.value | default: plan.name }}</option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
            </div>
          {%- endif -%}
          <label class="somna-buy__mode somna-pdp-hero__once"><input type="radio" name="{{ section.id }}-mode" value="once" data-mode-input{% if mode == 'once' %} checked{% endif %}> <span class="somna-buy__mode-label">{{ s.once_label }}<span data-once-pct></span></span> <span class="somna-buy__mode-price" data-price-once>{{ current.price | money }}</span></label>
        </fieldset>

        <button type="submit" name="add" class="somna-buy__add somna-pdp-hero__add" data-add{% unless current.available %} disabled{% endunless %}>
          <span data-add-label>{% if current.available %}{{ s.add_label }} · {{ price | money }}{% else %}{{ s.sold_out_label }}{% endif %}</span>
        </button>
        <p class="somna-buy__status" role="status" data-status></p>
      {%- endform -%}

      {%- if perk_blocks.size > 0 -%}
        <ul class="somna-pdp-hero__perks" role="list">
          {%- for block in perk_blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'somna-pdp-icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if sticker_blocks.size > 0 -%}
    <ul class="somna-pdp-hero__stickers somna-container" role="list">
      {%- for block in sticker_blocks -%}
        <li class="{% if s.sticker_motion != 'none' %}somna-shake--{{ s.sticker_motion }}{% endif %}" style="--somna-tilt: {{ block.settings.tilt }}deg; --somna-shake-delay: {{ forloop.index0 | times: 0.3 }}s;" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <script type="application/ld+json">{{ product | structured_data }}</script>
</somna-pdp-buy>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}

<script type="module">
  import { somnaAddToCart, somnaMoney } from '{{ 'somna-cart.js' | asset_url }}';

  if (!customElements.get('somna-pdp-buy')) {
    customElements.define('somna-pdp-buy', class extends HTMLElement {
      connectedCallback() {
        try { this.variants = JSON.parse(this.querySelector('[data-variants]').textContent); } catch (e) { this.variants = []; }
        this.form = this.querySelector('[data-form]');
        if (!this.form || !this.variants.length) return;
        const checked = this.querySelector('[data-pack]:checked');
        this.v = checked ? Number(checked.value) : 0;
        this.mode = this.querySelector('[data-mode-input]:checked')?.value || 'once';
        this.planSelect = this.querySelector('[data-plan]');
        this.nights = Number(this.dataset.nights) || 0;
        this.giftMin = Number(this.dataset.giftMin) || 99;
        this.labels = { add: {{ s.add_label | json }}, soldOut: {{ s.sold_out_label | json }}, added: {{ s.added_label | json }}, error: {{ s.error_label | json }}, night: {{ s.night_label | json }}, save: {{ s.save_label | json }}, pct: {{ s.percent_suffix | json }} };
        this.money = (c) => somnaMoney(c, this.dataset.currency, this.dataset.locale);
        this.addEventListener('change', this.onChange);
        this.addEventListener('click', this.onClick);
        this.form.addEventListener('submit', this.onSubmit);
        this.update();
      }
      disconnectedCallback() {
        this.removeEventListener('change', this.onChange);
        this.removeEventListener('click', this.onClick);
        this.form?.removeEventListener('submit', this.onSubmit);
      }
      bags(v) { const n = parseInt(String(v.title).replace(/[^0-9]/g, ''), 10); return n > 0 ? n : 1; }
      plan(v) {
        if (this.mode !== 'sub' || !v.plans.length) return null;
        const id = Number(this.planSelect?.value);
        return v.plans.find((p) => p.id === id) || v.plans[0];
      }
      priceOf(v, mode = this.mode) { const p = mode === 'sub' && v.plans.length ? (this.plan(v) || v.plans[0]) : null; return p ? p.price : v.price; }
      base(v, price) { return Math.max(v.compare || 0, price < v.price ? v.price : 0); }
      pct(price, v) { const base = this.base(v, price); return base > price ? Math.round((1 - price / base) * 100) : 0; }
      priceHTML(p) { const [a, b] = this.money(p).split('.'); return b ? `${a}<sup>${b}</sup>` : a; }
      update() {
        const v = this.variants[this.v];
        const q = (s) => this.querySelector(s);
        if (this.mode === 'sub' && !v.plans.length) this.mode = 'once';
        const price = this.priceOf(v);
        const plan = this.plan(v);
        q('[data-id]').value = v.id;
        q('[data-plan-input]').value = plan ? plan.id : '';
        q('[data-price]').innerHTML = this.priceHTML(price);
        const compare = this.base(v, price) > price ? this.base(v, price) : 0;
        const c = q('[data-compare]'); c.hidden = !compare; c.textContent = compare ? this.money(compare).replace(/[.,]00(?=\D*$)/, '') : '';
        const pct = this.pct(price, v);
        const save = q('[data-save]'); save.hidden = !pct; save.textContent = this.labels.save.replace('[percent]', pct);
        this.querySelectorAll('[data-pack]').forEach((input) => {
          const x = this.variants[Number(input.value)];
          const pr = this.priceOf(x);
          const label = input.closest('label');
          label.querySelector('[data-pack-price]').textContent = this.money(pr);
          const xb = this.base(x, pr);
          label.querySelector('[data-pack-compare]').textContent = xb > pr ? this.money(xb).replace(/[.,]00(?=\D*$)/, '') : '';
          const night = label.querySelector('[data-pack-night]');
          if (night && this.nights) night.textContent = this.money(Math.round(pr / (this.bags(x) * this.nights))) + this.labels.night;
        });
        this.querySelectorAll('[data-mode-input]').forEach((r) => { r.checked = r.value === this.mode; r.disabled = r.value === 'sub' && !v.plans.length; });
        this.querySelector('[data-mode-box]')?.classList.toggle('is-active', this.mode === 'sub');
        const subPrice = v.plans.length ? this.priceOf(v, 'sub') : 0;
        const subEl = q('[data-price-sub]'); if (subEl) subEl.textContent = subPrice ? this.money(subPrice) : '';
        const subPct = subPrice ? this.pct(subPrice, v) : 0;
        const subPctEl = q('[data-sub-pct]'); if (subPctEl) subPctEl.textContent = subPct ? this.labels.pct.replace('[percent]', subPct) : '';
        this.querySelectorAll('[data-sub-each]').forEach((el) => { el.textContent = subPrice ? this.money(subPrice) : ''; });
        const subPlan = v.plans.length ? (this.plan(v) || v.plans[0]) : null;
        const opt = this.planSelect && subPlan ? [...this.planSelect.options].find((o) => Number(o.value) === subPlan.id) : null;
        this.querySelectorAll('[data-sub-interval]').forEach((el) => { el.textContent = opt ? opt.textContent.trim().replace(/^Deliver(y)?\s+/i, '') : ''; });
        q('[data-price-once]').textContent = this.money(v.price);
        const oncePct = this.pct(v.price, v);
        q('[data-once-pct]').textContent = oncePct ? this.labels.pct.replace('[percent]', oncePct) : '';
        if (this.planSelect) this.planSelect.disabled = this.mode !== 'sub';
        const add = q('[data-add]');
        add.disabled = !v.available;
        q('[data-add-label]').textContent = v.available ? `${this.labels.add} · ${this.money(price)}` : this.labels.soldOut;
      }
      onChange = (e) => {
        const t = e.target;
        if (t.matches('[data-pack]')) { this.v = Number(t.value); this.update(); }
        else if (t.matches('[data-mode-input]')) { this.mode = t.value; this.update(); }
        else if (t.matches('[data-plan]')) { this.mode = 'sub'; this.update(); }
      };
      onClick = (e) => {
        const thumb = e.target.closest('[data-media]');
        if (thumb) {
          const img = this.querySelector('[data-main]');
          if (img) { img.srcset = thumb.dataset.srcset; img.src = thumb.dataset.src; img.alt = thumb.getAttribute('aria-label') || ''; }
          this.querySelectorAll('[data-media]').forEach((b) => b.setAttribute('aria-current', String(b === thumb)));
          return;
        }
        const play = e.target.closest('[data-video]');
        if (play) {
          this.querySelectorAll('.somna-pdp-hero__video video').forEach((v) => v.pause());
          const video = document.createElement('video');
          video.src = play.dataset.video;
          video.controls = true;
          video.playsInline = true;
          video.autoplay = true;
          const poster = play.querySelector('img');
          if (poster) video.poster = poster.currentSrc || poster.src;
          play.replaceWith(video);
          video.play().catch(() => {});
          video.addEventListener('play', () => this.querySelectorAll('.somna-pdp-hero__video video').forEach((o) => { if (o !== video) o.pause(); }));
        }
      };
      onSubmit = async (e) => {
        e.preventDefault();
        if (this.busy) return;
        const v = this.variants[this.v];
        if (!v.available) return;
        const btn = this.querySelector('[data-add]');
        const status = this.querySelector('[data-status]');
        this.busy = true;
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        status.textContent = '';
        try {
          await somnaAddToCart(this, { id: v.id, quantity: 1, selling_plan: this.plan(v)?.id || null });
          status.textContent = this.labels.added;
        } catch (err) {
          status.textContent = err && err.message ? err.message : this.labels.error;
        } finally {
          this.busy = false;
          btn.removeAttribute('aria-busy');
          btn.disabled = !v.available;
        }
      };
    });
  }
</script>
{%- endif -%}

