{%- comment -%}
  Somna V2 — product page hero (Figma 4557:857 Nasal Strips / 4557:44 Mouth Tape).
  Everything product-specific comes from the product: media, variants (packs), selling plans,
  and the metafields custom.pdp_tagline, custom.pdp_hero_features (PDP feature metaobjects), custom.pdp_gallery,
  custom.pdp_night_label, custom.pdp_savings_note, custom.pdp_box_products / pdp_box_notes, custom.pdp_gifts_bar,
  custom.pdp_quote (PDP quote metaobject) and custom.custom_review_rating_review_count.
  The buy panel is a real /cart/add form (works without JavaScript); with JavaScript it adds through
  assets/somna-cart.js so the cart drawer opens, and prices follow the chosen pack and plan.
  Shared look (packs, plan box, button) reuses the .somna-buy__* rules of the homepage buy box.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign perk_blocks = section.blocks | where: 'type', 'perk'
  assign sticker_blocks = section.blocks | where: 'type', 'sticker'
-%}
{%- if product != blank -%}
{%- liquid
  assign mf = product.metafields.custom
  assign images = product.media | where: 'media_type', 'image'
  # gallery = the product's own photos from Shopify admin only (in admin order)
  assign first_image = images | first
  # gallery layout "auto": thumbnails go below when the first photo is landscape (Season Bundle), beside it otherwise
  assign gallery_below = false
  if s.gallery_layout == 'below'
    assign gallery_below = true
  elsif s.gallery_layout == 'auto' and first_image.aspect_ratio > 1
    assign gallery_below = true
  endif
  # per-night next to the price: the product's Nights field, else the section's nights per bag
  assign price_nights = mf.nights.value | default: s.nights_per_bag
  assign selected_index = s.selected_position | minus: 1
  assign current = product.selected_variant
  if current == blank
    assign current = product.variants[selected_index] | default: product.selected_or_first_available_variant
  endif
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign mode = s.default_mode
  if has_plans == false
    assign mode = 'once'
  endif
  # one-time price = regular price minus the theme's one-time sale % (the automatic "Sale" discount applies it at checkout)
  assign once_factor = 100 | minus: settings.somna_once_discount
  assign current_once = current.price | times: once_factor | divided_by: 100
  assign alloc = current.selling_plan_allocations | first
  if mode == 'sub' and alloc
    assign price = alloc.price
  else
    assign price = current_once
  endif
  assign compare = current.compare_at_price | default: 0
  if price < current.price and current.price > compare
    assign compare = current.price
  endif
  if compare <= price
    assign compare = 0
  endif

  # products with a Color option plus a size option (Sleep Bundle): colour swatches + one pack per size
  assign color_option = nil
  assign color_idx = -1
  assign size_idx = 0
  if product.options_with_values.size == 2
    for o in product.options_with_values
      assign oname = o.name | downcase | strip
      if oname == 'color' or oname == 'colour'
        assign color_option = o
        assign color_idx = forloop.index0
      endif
    endfor
    if color_idx == 0
      assign size_idx = 1
    endif
  endif
  assign current_color = ''
  if color_option
    assign current_color = current.options[color_idx]
  endif
  assign hero_sticker = mf.pdp_hero_sticker.value | default: s.sticker_text

  assign rating = ''
  assign rating_count = ''
  assign rating_raw = mf.custom_review_rating_review_count.value | strip_html | strip
  if rating_raw != blank
    assign rating = rating_raw | split: ' ' | first
    if rating_raw contains '('
      assign rating_count = rating_raw | split: '(' | last | split: ')' | first | strip
    endif
  endif
  if s.rating_source == 'judgeme'
    assign jm_sum = product.metafields.judgeme.review_widget_data.value
    if jm_sum and jm_sum.number_of_reviews > 0
      assign rating = jm_sum.average_rating | times: 1.0 | round: 1
      assign rating_count = jm_sum.number_of_reviews
    endif
  endif
-%}

<somna-pdp-buy
  class="somna-pdp-hero{% if gallery_below %} somna-pdp-hero--gallery-below{% endif %}"
  data-interval="{{ product.selling_plan_groups.first.selling_plans.first.options.first.value | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-nights="{{ s.nights_per_bag }}"
  data-price-nights="{{ price_nights }}"
  data-night-label="{{ mf.pdp_night_label.value | escape }}"
  data-gift-min="{{ s.gift_min_bags }}"
  data-color-index="{{ color_idx }}"
  data-size-index="{{ size_idx }}"
  style="--somna-pdp-bg: {{ s.background_color }}; --somna-panel: {{ s.panel_color }}; --somna-mint: {{ s.mint_color }}; --somna-chip: {{ s.chip_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <script type="application/json" data-variants>
    [
    {%- for v in product.variants -%}
      { "id": {{ v.id }}, "title": {{ v.title | json }}, "options": {{ v.options | json }}, "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1100 | json }}{% else %}null{% endif %}, "available": {{ v.available | json }}, "price": {{ v.price | times: once_factor | divided_by: 100 }}, "compare": {% assign v_cmp = v.compare_at_price | default: 0 %}{% if v.price > v_cmp %}{{ v.price }}{% else %}{{ v_cmp }}{% endif %}, "plans": [
        {%- for a in v.selling_plan_allocations -%}{ "id": {{ a.selling_plan.id }}, "price": {{ a.price }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}
      ] }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>

  <div class="somna-pdp-hero__inner somna-container">
    {%- comment -%} left column (gallery + quote + videos): on desktop it stays in view while a long buy panel scrolls {%- endcomment -%}
    <div class="somna-pdp-hero__gallery-wrap">
    <div class="somna-pdp-hero__gallery">
      {%- if images.size > 1 -%}
        <ul class="somna-pdp-hero__thumbs" role="list">
          {%- for m in images limit: 8 -%}
            <li>
              <button type="button" class="somna-pdp-hero__thumb" data-media="{{ forloop.index0 }}" data-src="{{ m | image_url: width: 1100 }}" data-srcset="{{ m | image_url: width: 600 }} 600w, {{ m | image_url: width: 900 }} 900w, {{ m | image_url: width: 1100 }} 1100w" aria-label="{{ m.alt | default: product.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ m | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 96, height: 104 }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="somna-pdp-hero__main{% if s.drip_edges %} somna-edge-drip-top somna-pdp-hero__main--{{ s.main_drip | default: 'over' }}{% endif %}{% if s.main_shape != blank and s.main_shape != 'natural' %} somna-pdp-hero__main--shape-{{ s.main_shape }}{% endif %}">
        {%- if first_image -%}
          {{ first_image | image_url: width: 1100 | image_tag: data-main: '', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1300px) 570px, (min-width: 990px) 445px, (min-width: 750px) 45vw, 100vw', widths: '600, 900, 1100', alt: first_image.alt | default: product.title }}
        {%- endif -%}
      </div>

      {%- if s.badge_text != blank -%}<p class="somna-pdp-hero__badge{% if s.badge_motion != 'none' %} somna-shake--{{ s.badge_motion }}{% endif %}"><span>{{ s.badge_text }}</span></p>{%- endif -%}
      {%- if hero_sticker != blank -%}<p class="somna-pdp-hero__sticker{% if s.badge_motion != 'none' %} somna-shake--{{ s.badge_motion }}{% endif %}" style="--somna-shake-delay: 0.7s;">{{ hero_sticker }}</p>{%- endif -%}
    </div>

    <div class="somna-pdp-hero__side">
      {%- assign quote = mf.pdp_quote.value -%}
      {%- if quote == blank and s.quote_from_judgeme -%}
        {%- comment -%} Figma quote card: fall back to a real Judge.me review (short, 5★, named, no import tag) {%- endcomment -%}
        {%- assign jm = product.metafields.judgeme.review_widget_data.value -%}
        {%- assign quote_skip = s.quote_skip_words | split: ',' -%}
        {%- assign jm_pick = nil -%}
        {%- for rv in jm.reviews -%}
          {%- assign rv_body = rv.body | strip_html | strip -%}
          {%- if rv.rating >= 5 and rv.is_anonymous_reviewer != true and rv_body.size <= 110 -%}
            {%- comment -%} skip mixed reviews ("worked fine … but it came loose") via the skip-words setting {%- endcomment -%}
            {%- assign rv_low = rv_body | downcase | append: ' ' | append: rv.title | downcase -%}
            {%- assign rv_skip = false -%}
            {%- for w in quote_skip -%}
              {%- assign w2 = w | downcase -%}
              {%- if w2 != blank and rv_low contains w2 -%}{%- assign rv_skip = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- unless rv_body contains '(Review #' or rv_skip -%}
              {%- assign jm_pick = rv -%}
              {%- break -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if jm_pick -%}
          {%- assign jq_parts = jm_pick.reviewer_name | strip | split: ' ' -%}
          {%- assign jq_name = jq_parts | first -%}
          {%- if jq_parts.size > 1 -%}{%- assign jq_last = jq_parts | last | slice: 0 | upcase -%}{%- assign jq_name = jq_name | append: ' ' | append: jq_last | append: '.' -%}{%- endif -%}
          <figure class="somna-pdp-hero__quote">
            <span class="somna-pdp-hero__avatar somna-pdp-hero__avatar--initial" aria-hidden="true">{{ jq_name | slice: 0 }}</span>
            <div>
              <p class="somna-pdp-hero__stars" aria-label="{{ jm_pick.rating }} / 5">{% for i in (1..jm_pick.rating) %}★{% endfor %}</p>
              <blockquote>“{{ jm_pick.body | strip_html | strip }}”</blockquote>
              <figcaption><strong>{{ jq_name }}</strong>{% if jm_pick.verified_buyer %} <span>{{ s.verified_label }}</span>{% endif %}</figcaption>
            </div>
          </figure>
        {%- endif -%}
      {%- endif -%}
      {%- if quote != blank -%}
        <figure class="somna-pdp-hero__quote">
          {%- if quote.avatar.value != blank -%}{{ quote.avatar.value | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 79, height: 79, class: 'somna-pdp-hero__avatar' }}{%- endif -%}
          <div>
            {%- assign stars = quote.rating.value | default: 5 -%}
            <p class="somna-pdp-hero__stars" aria-label="{{ stars }} / 5">{% for i in (1..stars) %}★{% endfor %}</p>
            <blockquote>“{{ quote.quote.value }}”</blockquote>
            <figcaption><strong>{{ quote.author.value }}</strong>{% if quote.verified.value %} <span>{{ s.verified_label }}</span>{% endif %}</figcaption>
          </div>
        </figure>
      {%- endif -%}

      {%- comment -%}
        "Real Nights, On Camera": the product's own videos (custom.pdp_videos) when set, otherwise the section's
        video blocks. The video's own preview frame is the poster.
      {%- endcomment -%}
      {%- assign product_videos = mf.pdp_videos.value -%}
      {%- if product_videos.size > 0 or video_blocks.size > 0 -%}
        <div class="somna-pdp-hero__videos">
          {%- if s.videos_heading != blank -%}<h2 class="somna-pdp-hero__videos-title">{{ s.videos_heading }}</h2>{%- endif -%}
          {%- liquid
            # "Same width" video cards: every card takes the narrowest video's shape (the others crop a little at the sides)
            assign video_list_style = ''
            if s.video_shape == 'equal'
              assign min_ar = 10
              if product_videos.size > 0
                for vid in product_videos limit: 3
                  if vid.aspect_ratio and vid.aspect_ratio < min_ar
                    assign min_ar = vid.aspect_ratio
                  endif
                endfor
              else
                for block in video_blocks
                  if block.settings.video.aspect_ratio and block.settings.video.aspect_ratio < min_ar
                    assign min_ar = block.settings.video.aspect_ratio
                  endif
                endfor
              endif
              if min_ar < 10
                assign video_list_style = ' style="--somna-video-ar: ' | append: min_ar | append: ';"'
              endif
            endif
          -%}
          <ul class="somna-pdp-hero__video-list{% if video_list_style != '' %} somna-pdp-hero__video-list--equal{% endif %}" role="list"{{ video_list_style }}>
            {%- if product_videos.size > 0 -%}
              {%- for vid in product_videos limit: 3 -%}
                {%- liquid
                  assign src = ''
                  assign mp4 = vid.sources | where: 'mime_type', 'video/mp4' | sort: 'height'
                  assign src = mp4.first.url
                  for m in mp4
                    if m.height <= 720
                      assign src = m.url
                    endif
                  endfor
                -%}
                <li class="somna-pdp-hero__video"{% if video_list_style == '' %} style="--somna-video-ar: {{ vid.aspect_ratio | default: 0.8 }};"{% endif %}>
                  {%- if src != blank -%}
                    <button type="button" class="somna-pdp-hero__play" data-video="{{ src }}" aria-label="{{ s.play_label | escape }}{% if vid.alt != blank %}: {{ vid.alt | escape }}{% endif %}">
                      {%- if vid.preview_image -%}{{ vid.preview_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', width: 181, height: 299 }}{%- endif -%}
                      <span class="somna-pdp-hero__play-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>
                    </button>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- else -%}
            {%- for block in video_blocks -%}
              {%- liquid
                assign b = block.settings
                assign poster = b.poster | default: b.video.preview_image
                assign src = ''
                if b.video != blank
                  assign mp4 = b.video.sources | where: 'mime_type', 'video/mp4' | sort: 'height'
                  assign src = mp4.first.url
                  for m in mp4
                    if m.height <= 720
                      assign src = m.url
                    endif
                  endfor
                endif
              -%}
              <li class="somna-pdp-hero__video"{% if b.video != blank and video_list_style == '' %} style="--somna-video-ar: {{ b.video.aspect_ratio }};"{% endif %} {{ block.shopify_attributes }}>
                {%- if src != blank -%}
                  <button type="button" class="somna-pdp-hero__play" data-video="{{ src }}" aria-label="{{ s.play_label | escape }}{% if b.caption != blank %}: {{ b.caption | escape }}{% endif %}">
                    {%- if poster -%}{{ poster | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', width: 181, height: 299 }}{%- endif -%}
                    <span class="somna-pdp-hero__play-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>
                  </button>
                {%- elsif poster -%}
                  {{ poster | image_url: width: 400 | image_tag: loading: 'lazy', alt: b.caption, width: 181, height: 299 }}
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
    </div>

    <div class="somna-pdp-hero__panel{% if s.drip_edges %} somna-edge-drip-bottom{% endif %}">
      {%- if rating != blank -%}
        <p class="somna-pdp-hero__rating">
          <span class="somna-pdp-hero__rating-stars" aria-hidden="true">★★★★★</span>
          {{ s.rating_format | replace: '[rating]', rating | replace: '[count]', rating_count }}
        </p>
      {%- endif -%}
      <h1 class="somna-pdp-hero__title"><span class="somna-pdp-hero__brand">{{ s.brand }}</span> {{ product.title }}</h1>
      {%- if mf.pdp_tagline != blank -%}<p class="somna-pdp-hero__tagline">{{ mf.pdp_tagline.value | newline_to_br }}</p>{%- endif -%}

      {%- assign features = mf.pdp_hero_features.value -%}
      {%- if features != blank -%}
        <ul class="somna-pdp-hero__features" role="list">
          {%- for f in features -%}
            <li><span class="somna-pdp-hero__feature-icon">{% render 'somna-pdp-icon', name: f.icon.value, variant: 'figma' %}</span>{{ f.title.value }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="somna-pdp-hero__price">
        {%- assign price_parts = price | money | split: '.' -%}
        <span class="somna-pdp-hero__price-now" data-price>{{ price_parts[0] }}{% if price_parts[1] %}<sup>{{ price_parts[1] }}</sup>{% endif %}</span>
        <s data-compare{% if compare == 0 %} hidden{% endif %}>{{ compare | money_without_trailing_zeros }}</s>
        {%- assign pct = 0 -%}
        {%- if compare > 0 -%}{%- assign pct = compare | minus: price | times: 100 | divided_by: compare -%}{%- endif -%}
        <span class="somna-pdp-hero__save" data-save{% if pct == 0 %} hidden{% endif %}>{{ s.save_label | replace: '[percent]', pct }}</span>
        {%- if mf.pdp_night_label != blank and price_nights > 0 -%}
          <span class="somna-pdp-hero__price-night" data-price-night>{{ price | times: 1.0 | divided_by: price_nights | round | money }}{{ mf.pdp_night_label.value }}</span>
        {%- endif -%}
      </p>
      {%- if mf.pdp_savings_note != blank -%}<p class="somna-pdp-hero__savings">{{ mf.pdp_savings_note.value }}</p>{%- endif -%}

      {%- comment -%} What's in the box: under the price for single-variant products; after the packs when there are packs (Sleep Bundle) {%- endcomment -%}
      {%- capture box_markup -%}
      {%- assign box_products = mf.pdp_box_products.value -%}
      {%- assign box_notes = mf.pdp_box_notes.value -%}
      {%- assign box_titles = mf.pdp_box_titles.value -%}
      {%- assign box_colors = mf.pdp_box_colors.value -%}
      {%- if box_products != blank -%}
        <div class="somna-pdp-hero__box">
          {%- if s.box_heading != blank -%}<h2 class="somna-pdp-hero__box-title">{{ s.box_heading }}</h2>{%- endif -%}
          <ul class="somna-pdp-hero__box-list" role="list">
            {%- for bp in box_products limit: 2 -%}
              {%- assign bnote = box_notes[forloop.index0] -%}
              {%- if bp != blank -%}
                <li class="somna-pdp-hero__box-item">
                  <a class="somna-pdp-hero__box-card" href="{{ bp.url }}">
                    {%- if bp.featured_image -%}{{ bp.featured_image | image_url: width: 180, height: 180, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 86, height: 92, class: 'somna-pdp-hero__box-thumb' }}{%- endif -%}
                    <span class="somna-pdp-hero__box-text">
                      <span class="somna-pdp-hero__box-name">{{ box_titles[forloop.index0] | default: bp.title }}</span>
                      {%- if bnote != blank -%}<span class="somna-pdp-hero__box-note">{{ bnote }}{% if box_colors == blank %} <span aria-hidden="true">→</span>{% endif %}</span>{%- endif -%}
                      {%- if forloop.first and box_colors != blank -%}
                        <span class="somna-pdp-hero__box-colors">
                          {%- if s.box_colors_label != blank -%}<span>{{ s.box_colors_label }}</span>{%- endif -%}
                          {%- for c in box_colors -%}<span class="somna-pdp-hero__box-color"><span class="somna-pdp-hero__dot" style="--somna-dot: {% render 'somna-swatch-color', name: c %};" aria-hidden="true"></span>{{ c }}</span>{%- endfor -%}
                        </span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if mf.pdp_gifts_bar != blank -%}<p class="somna-pdp-hero__gifts-bar">{{ mf.pdp_gifts_bar.value }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- endcapture -%}
      {%- if product.has_only_default_variant -%}{{ box_markup }}{%- endif -%}

      {%- form 'product', product, class: 'somna-pdp-hero__form', data-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-id>
        <input type="hidden" name="selling_plan" value="{% if mode == 'sub' and alloc %}{{ alloc.selling_plan.id }}{% endif %}" data-plan-input>

        {%- if color_option -%}
          <fieldset class="somna-pdp-hero__colors">
            <legend><span>{{ color_option.name }}</span> : <span data-color-name>{{ current_color }}</span></legend>
            <div class="somna-pdp-hero__swatches">
              {%- for val in color_option.values -%}
                {%- capture sw -%}{%- if val.swatch.color -%}{{ val.swatch.color }}{%- else -%}{% render 'somna-swatch-color', name: val.name %}{%- endif -%}{%- endcapture -%}
                <label class="somna-pdp-hero__swatch" style="--somna-dot: {{ sw | strip }};">
                  <input type="radio" name="{{ section.id }}-color" value="{{ val.name | escape }}" data-color{% if val.name == current_color %} checked{% endif %}>
                  <span class="visually-hidden">{{ val.name }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        <fieldset class="somna-buy__packs somna-pdp-hero__packs"{% if product.has_only_default_variant %} hidden{% endif %}>
          <legend>{{ s.packs_label }}</legend>
          <div class="somna-buy__pack-list">
            {%- assign pack_n = 0 -%}
            {%- for v in product.variants -%}
              {%- if color_option and v.options[color_idx] != current_color -%}{%- continue -%}{%- endif -%}
              {%- assign pack_n = pack_n | plus: 1 -%}
              {%- liquid
                assign v_name = v.title
                if color_option
                  assign v_name = v.options[size_idx]
                endif
                assign v_alloc = v.selling_plan_allocations | first
                assign v_once = v.price | times: once_factor | divided_by: 100
                if mode == 'sub' and v_alloc
                  assign v_price = v_alloc.price
                else
                  assign v_price = v_once
                endif
                assign bags = v_name | split: ' ' | first | plus: 0
                if bags < 1
                  assign bags = 1
                endif
              -%}
              <label class="somna-buy__pack{% unless v.available %} is-sold-out{% endunless %}">
                {%- liquid
                  assign pack_badge = ''
                  if pack_n == s.badge_position
                    assign pack_badge = s.badge_label
                  elsif pack_n == s.badge_2_position
                    assign pack_badge = s.badge_2_label
                  elsif pack_n == s.badge_3_position
                    assign pack_badge = s.badge_3_label
                  endif
                -%}
                {%- if pack_badge != blank -%}<span class="somna-buy__pack-badge">{{ pack_badge }}</span>{%- endif -%}
                <input type="radio" name="{{ section.id }}-pack" value="{{ forloop.index0 }}" data-pack{% if color_option %} data-size="{{ v_name | escape }}"{% endif %}{% if v.id == current.id %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
                <span class="somna-buy__pack-name">{{ v_name }}</span>
                <span class="somna-buy__pack-price" data-pack-price>{{ v_price | money }}</span>
                {%- assign v_compare = v.compare_at_price | default: 0 -%}
                {%- if v_price < v.price and v.price > v_compare -%}{%- assign v_compare = v.price -%}{%- endif -%}
                <s data-pack-compare>{% if v_compare > v_price %}{{ v_compare | money_without_trailing_zeros }}{% endif %}</s>
                {%- if bags >= s.gift_min_bags and s.gift_label != blank -%}
                  <span class="somna-pdp-hero__gift">{{ s.gift_label }}</span>
                {%- elsif s.nights_per_bag > 0 -%}
                  <span class="somna-buy__pack-night" data-pack-night>{{ v_price | times: 1.0 | divided_by: bags | divided_by: s.nights_per_bag | round | money }}{{ s.night_label }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        {%- unless product.has_only_default_variant -%}{{ box_markup }}{%- endunless -%}

        <fieldset class="somna-buy__modes somna-pdp-hero__modes">
          <legend class="visually-hidden">{{ s.mode_label }}</legend>
          {%- if has_plans -%}
            <div class="somna-pdp-hero__mode-box" data-mode-box="sub">
              <label class="somna-buy__mode"><input type="radio" name="{{ section.id }}-mode" value="sub" data-mode-input{% if mode == 'sub' %} checked{% endif %}> <span class="somna-buy__mode-label"><strong>{{ s.sub_label }}</strong><span data-sub-pct></span></span> <span class="somna-buy__mode-price" data-price-sub>{% if alloc %}{{ alloc.price | money }}{% endif %}</span></label>
              {%- if s.sub_points != blank -%}
                <ul class="somna-pdp-hero__sub-points" role="list">
                  {%- assign points = s.sub_points | newline_to_br | split: '<br />' -%}
                  {%- for t in points -%}{%- assign pt = t | strip | replace: '[price]', '<span data-sub-each></span>' | replace: '[interval]', '<span data-sub-interval></span>' -%}{%- if pt != blank -%}<li><span class="somna-check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg></span><span>{{ pt }}</span></li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
              {%- assign group = product.selling_plan_groups | first -%}
              {%- if group.selling_plans.size > 1 -%}
                <label class="visually-hidden" for="{{ section.id }}-plan">{{ s.plan_label }}</label>
                <select class="somna-pdp-hero__plan" id="{{ section.id }}-plan" data-plan>
                  {%- for plan in group.selling_plans -%}
                    <option value="{{ plan.id }}"{% if alloc and plan.id == alloc.selling_plan.id %} selected{% endif %}>{{ plan.options.first.value | default: plan.name }}</option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
            </div>
          {%- endif -%}
          <label class="somna-buy__mode somna-pdp-hero__once"><input type="radio" name="{{ section.id }}-mode" value="once" data-mode-input{% if mode == 'once' %} checked{% endif %}> <span class="somna-buy__mode-label">{{ s.once_label }}<span data-once-pct></span></span> <span class="somna-buy__mode-price" data-price-once>{{ current_once | money }}</span></label>
        </fieldset>

        <button type="submit" name="add" class="somna-buy__add somna-pdp-hero__add" data-add{% unless current.available %} disabled{% endunless %}>
          <span data-add-label>{% if current.available %}{{ s.add_label }} · {{ price | money }}{% else %}{{ s.sold_out_label }}{% endif %}</span>
        </button>
        <p class="somna-buy__status" role="status" data-status></p>
      {%- endform -%}

      {%- if perk_blocks.size > 0 -%}
        <ul class="somna-pdp-hero__perks" role="list">
          {%- for block in perk_blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'somna-pdp-icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} upgrade card: product + wording from the product's "PDP – Upgrade card" fields {%- endcomment -%}
      {%- assign upsell = mf.pdp_upsell_product.value -%}
      {%- if upsell != blank and upsell.id != product.id -%}
        <div class="somna-pdp-hero__upsell">
          {%- if mf.pdp_upsell_label != blank -%}<p class="somna-pdp-hero__upsell-label">{{ mf.pdp_upsell_label.value }}</p>{%- endif -%}
          <a class="somna-pdp-hero__upsell-card" href="{{ upsell.url }}">
            {%- comment -%} thumbnail: the linked product's first PDP gallery image (pack shot), else its featured image {%- endcomment -%}
            {%- assign upsell_image = upsell.metafields.custom.pdp_gallery.value | first | default: upsell.featured_image -%}
            {%- if upsell_image -%}{{ upsell_image | image_url: width: 260, height: 190, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 120, height: 88, class: 'somna-pdp-hero__upsell-thumb' }}{%- endif -%}
            <span class="somna-pdp-hero__upsell-text">
              <span class="somna-pdp-hero__upsell-title">{{ mf.pdp_upsell_heading.value | default: upsell.title }}</span>
              {%- if mf.pdp_upsell_text != blank -%}<span class="somna-pdp-hero__upsell-desc">{{ mf.pdp_upsell_text.value }}</span>{%- endif -%}
            </span>
            <span class="somna-pdp-hero__upsell-button">{{ mf.pdp_upsell_button.value | default: s.upsell_button }} <span aria-hidden="true">→</span></span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if sticker_blocks.size > 0 -%}
    <ul class="somna-pdp-hero__stickers somna-stickers somna-container" role="list">
      {%- for block in sticker_blocks -%}
        <li class="{% if s.sticker_motion != 'none' %}somna-shake--{{ s.sticker_motion }}{% endif %}" style="--somna-tilt: {{ block.settings.tilt }}deg; --somna-shake-delay: {{ forloop.index0 | times: 0.3 }}s;" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if s.sticky_enable -%}
    {%- comment -%}
      Sticky add to cart (Figma 4927:555 bar, 4927:1736 "Choose your pack" sheet). Shows once the buy box's form has
      scrolled off the top. It has no form of its own: it reads and sets the buy box above (pack, colour,
      subscribe / one-time), so both always agree, and its button adds through the same cart code.
    {%- endcomment -%}
    {%- liquid
      assign sticky_img = current.featured_image | default: product.featured_image
      assign sticky_heading_parts = s.sticky_heading | split: '*'
    -%}
    <somna-pdp-sticky class="somna-sticky-atc" data-product-title="{{ product.title | escape }}" data-sub-word="{{ s.sticky_sub_word | escape }}" data-once-word="{{ s.sticky_once_word | escape }}" data-note="{{ s.sticky_note | escape }}" hidden>
      <div class="somna-sticky-atc__backdrop" data-sticky-close></div>
      <div class="somna-sticky-atc__sheet" id="StickyPacks-{{ section.id }}" role="dialog" aria-modal="false" aria-labelledby="StickyPacksTitle-{{ section.id }}" data-sticky-sheet inert>
        <div class="somna-sticky-atc__sheet-head">
          <h2 class="somna-sticky-atc__heading" id="StickyPacksTitle-{{ section.id }}">
            {%- for part in sticky_heading_parts -%}{%- assign odd = forloop.index0 | modulo: 2 -%}{%- if odd == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}{%- endfor -%}
          </h2>
          <button type="button" class="somna-sticky-atc__close" data-sticky-close aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
          </button>
        </div>
        {%- if has_plans -%}
          <div class="somna-sticky-atc__modes" role="group" aria-label="{{ s.mode_label | escape }}">
            <button type="button" class="somna-sticky-atc__mode" data-sticky-mode="sub" aria-pressed="false"><span>{{ s.sticky_sub_toggle }}</span> <span data-sticky-pct="sub"></span></button>
            <button type="button" class="somna-sticky-atc__mode" data-sticky-mode="once" aria-pressed="false"><span>{{ s.sticky_once_toggle }}</span> <span data-sticky-pct="once"></span></button>
          </div>
          <p class="somna-sticky-atc__note" data-sticky-note></p>
        {%- endif -%}
        {%- if color_option -%}
          <div class="somna-sticky-atc__colors" role="group" aria-label="{{ color_option.name | escape }}">
            {%- for val in color_option.values -%}
              {%- capture sw -%}{%- if val.swatch.color -%}{{ val.swatch.color }}{%- else -%}{% render 'somna-swatch-color', name: val.name %}{%- endif -%}{%- endcapture -%}
              <button type="button" class="somna-sticky-atc__swatch" style="--somna-dot: {{ sw | strip }};" data-sticky-color="{{ val.name | escape }}" aria-pressed="false"><span class="visually-hidden">{{ val.name }}</span></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="somna-sticky-atc__packs" role="radiogroup" aria-label="{{ s.packs_label | escape }}" data-sticky-packs></div>
      </div>
      <div class="somna-sticky-atc__bar">
        {%- if s.sticky_banner != blank -%}<p class="somna-sticky-atc__banner">{{ s.sticky_banner }}</p>{%- endif -%}
        <div class="somna-sticky-atc__main">
          <button type="button" class="somna-sticky-atc__card" data-sticky-open aria-expanded="false" aria-controls="StickyPacks-{{ section.id }}">
            <span class="somna-sticky-atc__thumb">
              {%- if sticky_img -%}{{ sticky_img | image_url: width: 180, height: 180, crop: 'center' | image_tag: alt: '', loading: 'lazy', width: 66, height: 66, data-sticky-img: '' }}{%- endif -%}
            </span>
            <span class="somna-sticky-atc__info">
              <span class="somna-sticky-atc__title" data-sticky-title>{{ product.title }}</span>
              <span class="somna-sticky-atc__meta" data-sticky-meta></span>
            </span>
            <svg class="somna-sticky-atc__caret" viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6.5L6 1.5l5 5"/></svg>
            <span class="visually-hidden">{{ s.sticky_open_label }}</span>
          </button>
          <button type="button" class="somna-sticky-atc__add" data-sticky-add><span data-sticky-add-label>{{ s.sticky_add_label }}</span></button>
        </div>
      </div>
    </somna-pdp-sticky>
  {%- endif -%}

  <script type="application/ld+json">{{ product | structured_data }}</script>
</somna-pdp-buy>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}

<script type="module">
  import { somnaAddToCart, somnaMoney } from '{{ 'somna-cart.js' | asset_url }}';

  if (!customElements.get('somna-pdp-buy')) {
    customElements.define('somna-pdp-buy', class extends HTMLElement {
      connectedCallback() {
        try { this.variants = JSON.parse(this.querySelector('[data-variants]').textContent); } catch (e) { this.variants = []; }
        this.form = this.querySelector('[data-form]');
        if (!this.form || !this.variants.length) return;
        const checked = this.querySelector('[data-pack]:checked');
        this.v = checked ? Number(checked.value) : 0;
        this.mode = this.querySelector('[data-mode-input]:checked')?.value || 'once';
        this.planSelect = this.querySelector('[data-plan]');
        this.nights = Number(this.dataset.nights) || 0;
        this.giftMin = Number(this.dataset.giftMin) || 99;
        this.ci = Number(this.dataset.colorIndex);
        this.si = Number(this.dataset.sizeIndex) || 0;
        this.labels = { add: {{ s.add_label | json }}, soldOut: {{ s.sold_out_label | json }}, added: {{ s.added_label | json }}, error: {{ s.error_label | json }}, night: {{ s.night_label | json }}, save: {{ s.save_label | json }}, pct: {{ s.percent_suffix | json }} };
        this.money = (c) => somnaMoney(c, this.dataset.currency, this.dataset.locale);
        this.addEventListener('change', this.onChange);
        this.addEventListener('click', this.onClick);
        this.form.addEventListener('submit', this.onSubmit);
        this.update();
      }
      disconnectedCallback() {
        this.removeEventListener('change', this.onChange);
        this.removeEventListener('click', this.onClick);
        this.form?.removeEventListener('submit', this.onSubmit);
      }
      bags(v) { const n = parseInt(String(v.title).replace(/[^0-9]/g, ''), 10); return n > 0 ? n : 1; }
      plan(v) {
        if (this.mode !== 'sub' || !v.plans.length) return null;
        const id = Number(this.planSelect?.value);
        return v.plans.find((p) => p.id === id) || v.plans[0];
      }
      priceOf(v, mode = this.mode) { const p = mode === 'sub' && v.plans.length ? (this.plan(v) || v.plans[0]) : null; return p ? p.price : v.price; }
      base(v, price) { return Math.max(v.compare || 0, price < v.price ? v.price : 0); } // v.compare = regular price (or compare-at), v.price = one-time sale price
      pct(price, v) { const base = this.base(v, price); return base > price ? Math.round((1 - price / base) * 100) : 0; }
      priceHTML(p) { const [a, b] = this.money(p).split('.'); return b ? `${a}<sup>${b}</sup>` : a; }
      update() {
        const v = this.variants[this.v];
        const q = (s) => this.querySelector(s);
        if (this.mode === 'sub' && !v.plans.length) this.mode = 'once';
        const price = this.priceOf(v);
        const plan = this.plan(v);
        q('[data-id]').value = v.id;
        q('[data-plan-input]').value = plan ? plan.id : '';
        q('[data-price]').innerHTML = this.priceHTML(price);
        const compare = this.base(v, price) > price ? this.base(v, price) : 0;
        const c = q('[data-compare]'); c.hidden = !compare; c.textContent = compare ? this.money(compare).replace(/[.,]00(?=\D*$)/, '') : '';
        const priceNight = q('[data-price-night]');
        const priceNights = Number(this.dataset.priceNights) || 0;
        if (priceNight && priceNights) priceNight.textContent = this.money(Math.round(price / priceNights)) + (this.dataset.nightLabel || '');
        const pct = this.pct(price, v);
        const save = q('[data-save]'); save.hidden = !pct; save.textContent = this.labels.save.replace('[percent]', pct);
        this.querySelectorAll('[data-pack]').forEach((input) => {
          const x = this.variants[Number(input.value)];
          const pr = this.priceOf(x);
          const label = input.closest('label');
          label.querySelector('[data-pack-price]').textContent = this.money(pr);
          const xb = this.base(x, pr);
          label.querySelector('[data-pack-compare]').textContent = xb > pr ? this.money(xb).replace(/[.,]00(?=\D*$)/, '') : '';
          const night = label.querySelector('[data-pack-night]');
          if (night && this.nights) night.textContent = this.money(Math.round(pr / (this.bags(x) * this.nights))) + this.labels.night;
        });
        this.querySelectorAll('[data-mode-input]').forEach((r) => { r.checked = r.value === this.mode; r.disabled = r.value === 'sub' && !v.plans.length; });
        this.querySelector('[data-mode-box]')?.classList.toggle('is-active', this.mode === 'sub');
        const subPrice = v.plans.length ? this.priceOf(v, 'sub') : 0;
        const subEl = q('[data-price-sub]'); if (subEl) subEl.textContent = subPrice ? this.money(subPrice) : '';
        const subPct = subPrice ? this.pct(subPrice, v) : 0;
        const subPctEl = q('[data-sub-pct]'); if (subPctEl) subPctEl.textContent = subPct ? this.labels.pct.replace('[percent]', subPct) : '';
        this.querySelectorAll('[data-sub-each]').forEach((el) => { el.textContent = subPrice ? this.money(subPrice) : ''; });
        const subPlan = v.plans.length ? (this.plan(v) || v.plans[0]) : null;
        const opt = this.planSelect && subPlan ? [...this.planSelect.options].find((o) => Number(o.value) === subPlan.id) : null;
        const intervalText = opt ? opt.textContent : (subPlan ? this.dataset.interval || '' : '');
        this.querySelectorAll('[data-sub-interval]').forEach((el) => { el.textContent = intervalText.trim().replace(/^Deliver(y)?\s+/i, ''); });
        q('[data-price-once]').textContent = this.money(v.price);
        const oncePct = this.pct(v.price, v);
        q('[data-once-pct]').textContent = oncePct ? this.labels.pct.replace('[percent]', oncePct) : '';
        if (this.planSelect) this.planSelect.disabled = this.mode !== 'sub';
        const add = q('[data-add]');
        add.disabled = !v.available;
        q('[data-add-label]').textContent = v.available ? `${this.labels.add} · ${this.money(price)}` : this.labels.soldOut;
      }
      // colour swatches: point every pack at the variant with that colour and its size, then show that colour's photo
      setColor(color) {
        this.querySelectorAll('[data-pack]').forEach((input) => {
          const i = this.variants.findIndex((x) => x.options[this.ci] === color && x.options[this.si] === input.dataset.size);
          if (i > -1) { input.value = i; input.disabled = !this.variants[i].available; input.closest('label').classList.toggle('is-sold-out', !this.variants[i].available); }
        });
        const checked = this.querySelector('[data-pack]:checked') || this.querySelector('[data-pack]');
        if (checked) this.v = Number(checked.value);
        const name = this.querySelector('[data-color-name]');
        if (name) name.textContent = color;
        const v = this.variants[this.v];
        const img = this.querySelector('[data-main]');
        if (img && v && v.image) {
          img.removeAttribute('srcset');
          img.src = v.image;
          this.querySelectorAll('[data-media]').forEach((b) => b.setAttribute('aria-current', 'false'));
        }
        this.update();
      }
      onChange = (e) => {
        const t = e.target;
        if (t.matches('[data-pack]')) { this.v = Number(t.value); this.update(); }
        else if (t.matches('[data-color]')) this.setColor(t.value);
        else if (t.matches('[data-mode-input]')) { this.mode = t.value; this.update(); }
        else if (t.matches('[data-plan]')) { this.mode = 'sub'; this.update(); }
      };
      onClick = (e) => {
        const thumb = e.target.closest('[data-media]');
        if (thumb) {
          const img = this.querySelector('[data-main]');
          if (img) { img.srcset = thumb.dataset.srcset; img.src = thumb.dataset.src; img.alt = thumb.getAttribute('aria-label') || ''; }
          this.querySelectorAll('[data-media]').forEach((b) => b.setAttribute('aria-current', String(b === thumb)));
          return;
        }
        const play = e.target.closest('[data-video]');
        if (play) {
          this.querySelectorAll('.somna-pdp-hero__video video').forEach((v) => v.pause());
          const video = document.createElement('video');
          video.src = play.dataset.video;
          video.controls = true;
          video.playsInline = true;
          video.autoplay = true;
          const poster = play.querySelector('img');
          if (poster) video.poster = poster.currentSrc || poster.src;
          play.replaceWith(video);
          video.play().catch(() => {});
          video.addEventListener('play', () => this.querySelectorAll('.somna-pdp-hero__video video').forEach((o) => { if (o !== video) o.pause(); }));
        }
      };
      onSubmit = async (e) => {
        e.preventDefault();
        if (this.busy) return;
        const v = this.variants[this.v];
        if (!v.available) return;
        const btn = this.querySelector('[data-add]');
        const status = this.querySelector('[data-status]');
        this.busy = true;
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        status.textContent = '';
        try {
          await somnaAddToCart(this, { id: v.id, quantity: 1, selling_plan: this.plan(v)?.id || null });
          status.textContent = this.labels.added;
        } catch (err) {
          status.textContent = err && err.message ? err.message : this.labels.error;
        } finally {
          this.busy = false;
          btn.removeAttribute('aria-busy');
          btn.disabled = !v.available;
        }
      };
    });
  }


  /* Sticky add to cart (sections/somna-pdp-hero, markup above </somna-pdp-buy>) */
  if (!customElements.get('somna-pdp-sticky')) {
    customElements.define('somna-pdp-sticky', class extends HTMLElement {
      connectedCallback() {
        this.buy = this.closest('somna-pdp-buy');
        if (!this.buy) return;
        // wait until the buy box has read its variants
        requestAnimationFrame(() => this.init());
      }
      init() {
        const buy = this.buy;
        if (!buy.variants || !buy.variants.length || !buy.form) return;
        this.sheet = this.querySelector('[data-sticky-sheet]');
        this.open = this.querySelector('[data-sticky-open]');
        this.addBtn = this.querySelector('[data-sticky-add]');
        this.hidden = false;
        this.onBuyChange = () => requestAnimationFrame(() => this.render());
        buy.addEventListener('change', this.onBuyChange);
        this.addEventListener('click', this.onClick);
        this.onKey = (e) => { if (e.key === 'Escape' && this.classList.contains('is-open')) { this.toggle(false); this.open.focus(); } };
        document.addEventListener('keydown', this.onKey);
        // show once the buy box's form has gone off the top of the screen
        this.io = new IntersectionObserver(([e]) => this.show(!e.isIntersecting && e.boundingClientRect.top < 0));
        this.io.observe(buy.form);
        this.ro = new ResizeObserver(() => document.documentElement.style.setProperty('--somna-sticky-h', this.querySelector('.somna-sticky-atc__bar').offsetHeight + 'px'));
        this.ro.observe(this.querySelector('.somna-sticky-atc__bar'));
        this.render();
      }
      disconnectedCallback() {
        this.buy?.removeEventListener('change', this.onBuyChange);
        document.removeEventListener('keydown', this.onKey);
        this.io?.disconnect();
        this.ro?.disconnect();
        document.documentElement.classList.remove('somna-sticky-on');
      }
      show(on) {
        if (!on && this.classList.contains('is-open')) return;
        this.classList.toggle('is-visible', on);
        this.querySelector('.somna-sticky-atc__bar').inert = !on;
        document.documentElement.classList.toggle('somna-sticky-on', on);
      }
      toggle(on) {
        this.classList.toggle('is-open', on);
        this.sheet.inert = !on;
        this.open.setAttribute('aria-expanded', String(on));
        if (on) (this.sheet.querySelector('[aria-checked="true"]') || this.sheet.querySelector('[aria-pressed="true"]') || this.sheet.querySelector('button'))?.focus({ preventScroll: true });
      }
      // set a control in the buy box and let it update itself (it fires our render through its change event)
      pick(input) {
        if (!input || input.disabled) return;
        input.checked = true;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
      onClick = async (e) => {
        const buy = this.buy;
        if (e.target.closest('[data-sticky-close]')) { this.toggle(false); this.open.focus(); return; }
        if (e.target.closest('[data-sticky-open]')) { this.toggle(!this.classList.contains('is-open')); return; }
        const mode = e.target.closest('[data-sticky-mode]');
        if (mode) { this.pick(buy.querySelector(`[data-mode-input][value="${mode.dataset.stickyMode}"]`)); return; }
        const color = e.target.closest('[data-sticky-color]');
        if (color) { this.pick([...buy.querySelectorAll('[data-color]')].find((i) => i.value === color.dataset.stickyColor)); return; }
        const pack = e.target.closest('[data-sticky-pack]');
        if (pack) { this.pick(buy.querySelectorAll('[data-pack]')[Number(pack.dataset.stickyPack)]); return; }
        if (e.target.closest('[data-sticky-add]')) {
          if (this.addBtn.disabled || buy.busy) return;
          this.addBtn.setAttribute('aria-busy', 'true');
          this.addBtn.disabled = true;
          try { await buy.onSubmit({ preventDefault() {} }); } finally {
            this.addBtn.removeAttribute('aria-busy');
            this.render();
            this.toggle(false);
          }
        }
      };
      render() {
        const buy = this.buy;
        const v = buy.variants[buy.v];
        if (!v) return;
        const sub = buy.mode === 'sub' && v.plans.length;
        const price = buy.priceOf(v);
        const single = buy.querySelector('.somna-pdp-hero__packs')?.hidden;
        const nightsOf = (x) => (single ? Number(buy.dataset.priceNights) || buy.nights : buy.bags(x) * buy.nights);
        const packInput = buy.querySelector('[data-pack]:checked');
        const packName = single ? this.dataset.productTitle : packInput?.closest('label').querySelector('.somna-buy__pack-name')?.textContent.trim();
        const word = sub ? this.dataset.subWord : this.dataset.onceWord;
        this.querySelector('[data-sticky-title]').textContent = word ? `${packName}. ${word}` : packName;
        const n = nightsOf(v);
        this.querySelector('[data-sticky-meta]').textContent = this.money(price) + (n ? ` . ${buy.money(Math.round(price / n))}${buy.labels.night}` : '');
        const img = this.querySelector('[data-sticky-img]');
        if (img && v.image && img.dataset.variant !== String(v.id)) {
          img.dataset.variant = v.id;
          img.removeAttribute('srcset');
          img.src = v.image.replace(/width=\d+/, 'width=180');
        }
        this.addBtn.disabled = !v.available;
        this.querySelector('[data-sticky-add-label]').textContent = v.available ? this.addLabel() : buy.labels.soldOut;
        // purchase toggle
        this.querySelectorAll('[data-sticky-mode]').forEach((b) => {
          const m = b.dataset.stickyMode;
          b.setAttribute('aria-pressed', String(m === buy.mode));
          b.disabled = m === 'sub' && !v.plans.length;
          const pct = m === 'sub' ? (v.plans.length ? buy.pct(buy.priceOf(v, 'sub'), v) : 0) : buy.pct(v.price, v);
          b.querySelector('[data-sticky-pct]').textContent = pct ? `${pct}% off` : '';
        });
        const note = this.querySelector('[data-sticky-note]');
        if (note) {
          const interval = (buy.querySelector('[data-sub-interval]')?.textContent || buy.dataset.interval || '').trim();
          note.textContent = sub ? this.dataset.note.replace('[interval]', interval) : '';
          note.hidden = !sub || !this.dataset.note;
        }
        const colorName = buy.querySelector('[data-color]:checked')?.value;
        this.querySelectorAll('[data-sticky-color]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.stickyColor === colorName)));
        // pack rows (one per buy-box pack; one row for single products)
        const inputs = single ? [] : [...buy.querySelectorAll('[data-pack]')];
        const rows = (inputs.length ? inputs : [null]).map((input, i) => {
          const x = input ? buy.variants[Number(input.value)] : v;
          const label = input?.closest('label');
          const name = input ? label.querySelector('.somna-buy__pack-name')?.textContent.trim() : packName;
          const pr = buy.priceOf(x);
          const nights = nightsOf(x);
          const gift = label?.querySelector('.somna-pdp-hero__gift')?.textContent.trim();
          const badge = gift || label?.querySelector('.somna-buy__pack-badge')?.textContent.trim() || '';
          const on = input ? input.checked : true;
          const off = input ? input.disabled : !x.available;
          return `<button type="button" class="somna-sticky-atc__pack" role="radio" aria-checked="${on}" ${off ? 'disabled' : ''} data-sticky-pack="${i}">
            ${badge ? `<span class="somna-sticky-atc__badge${gift ? ' is-gift' : ''}">${this.esc(badge)}</span>` : ''}
            <span class="somna-sticky-atc__radio" aria-hidden="true"></span>
            <span class="somna-sticky-atc__pack-text"><span class="somna-sticky-atc__pack-name">${this.esc(name || '')}</span>${nights ? `<span class="somna-sticky-atc__pack-meta">${nights} nights. ${buy.money(Math.round(pr / nights))}${this.esc(buy.labels.night)}</span>` : ''}</span>
            <span class="somna-sticky-atc__pack-price">${this.money(pr)}</span>
          </button>`;
        });
        this.querySelector('[data-sticky-packs]').innerHTML = rows.join('');
      }
      money(c) { return this.buy.money(c); }
      addLabel() { return this.querySelector('[data-sticky-add-label]').dataset.label || (this.querySelector('[data-sticky-add-label]').dataset.label = this.querySelector('[data-sticky-add-label]').textContent); }
      esc(t) { return String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]); }
    });
  }

  // Links to the buy box: #pack-N (e.g. "Choose 2+ packs") selects pack N and scrolls to the packs;
  // #buy (e.g. "Try Somna risk-free") scrolls to the top of the buy box. Without a buy box they stay normal links.
  if (!window.somnaPackLinks) {
    window.somnaPackLinks = true;
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[href*="#pack-"], a[href$="#buy"]');
      const buy = link && document.querySelector('somna-pdp-buy');
      if (!buy) return;
      e.preventDefault();
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (link.getAttribute('href').endsWith('#buy')) {
        (buy.querySelector('.somna-pdp-hero__panel') || buy).scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
        return;
      }
      const n = parseInt(link.getAttribute('href').split('#pack-')[1], 10);
      const input = buy.querySelectorAll('[data-pack]')[n - 1];
      if (input && !input.disabled && !input.checked) {
        input.checked = true;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
      const packs = buy.querySelector('.somna-pdp-hero__packs');
      const target = packs && !packs.hidden ? packs : buy.querySelector('.somna-pdp-hero__panel') || buy;
      target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  /* "#buy" links scroll here: keep the panel clear of the sticky header */
  .somna-pdp-hero__panel {
    scroll-margin-top: calc(var(--header-height, 64px) + 16px);
  }

  somna-pdp-buy {
    display: block;
    background: var(--somna-pdp-bg);
    color: #000;
  }

  .somna-pdp-hero__inner {
    --somna-content-width: 1330px;
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .somna-pdp-hero__gallery {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 34px;
    align-items: start;
  }

  /* the thumbnail column never makes the gallery taller than the main image; extra thumbs scroll */
  .somna-pdp-hero__thumbs {
    --somna-thumbs-offset: 72px;
    display: grid;
    align-content: start;
    gap: 8px;
    height: 0;
    min-height: calc(100% - var(--somna-thumbs-offset));
    margin: var(--somna-thumbs-offset) 0 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    scrollbar-width: none;
  }

  /* Figma: plain rounded images, no border (the main image shows which one is selected) */
  .somna-pdp-hero__thumb {
    display: block;
    width: 96px;
    aspect-ratio: 96 / 104;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #0b0f1d;
    cursor: pointer;
  }

  .somna-pdp-hero__thumb:focus-visible {
    outline: 2px solid #0b0f1d;
    outline-offset: 2px;
  }

  .somna-pdp-hero__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* the main photo is shown whole (never cropped): its box takes the photo's own shape */
  .somna-pdp-hero__main img {
    display: block;
    width: 100%;
    height: auto;
  }

  .somna-pdp-hero__main {
    overflow: hidden;
    background: #0b0f1d;
  }

  /* only a layout box below desktop (the gallery stays a grid item there) */
  .somna-pdp-hero__gallery-wrap {
    display: contents;
  }

  .somna-pdp-hero__main.somna-edge-drip-top {
    --somna-drip-h: 56px;
  }

  /* "Main photo and drip" setting: below = the photo starts under the drip (whole photo, box a little taller);
     below-crop = same, but the box keeps its height and the photo's bottom is trimmed instead */
  .somna-pdp-hero__main--below,
  .somna-pdp-hero__main--below-crop {
    padding-top: calc(var(--somna-drip-h) - 6px);
  }

  .somna-pdp-hero__main--below-crop img {
    margin-bottom: calc(6px - var(--somna-drip-h));
  }

  /* fit = photo starts under the drip and is drawn a little narrower, so the whole photo shows and the box keeps
     about the same height (navy shows at the sides); none = no drip on the main photo, rounded corners instead */
  .somna-pdp-hero__main--fit {
    padding: calc(var(--somna-drip-h) - 6px) 4.5% 0;
  }

  /* "Main photo box" setting: square = every photo gets the same square box, so a wide first photo
     (Season Bundle 4:3) is as tall as the square gallery photos. square-fit shows the whole photo on navy,
     square-fill fills the box and trims the photo's sides. */
  .somna-pdp-hero__main--shape-square-fit,
  .somna-pdp-hero__main--shape-square-fill {
    aspect-ratio: 1;
  }

  .somna-pdp-hero__main--shape-square-fit img,
  .somna-pdp-hero__main--shape-square-fill img {
    height: 100%;
    object-fit: contain;
    object-position: 50% 60%;
  }

  .somna-pdp-hero__main--shape-square-fill img {
    object-fit: cover;
    object-position: 50% 50%;
  }

  .somna-pdp-hero__main--none.somna-edge-drip-top {
