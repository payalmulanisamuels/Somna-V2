{%- comment -%}
  Somna V2 — "Still thinking about it?" (recently viewed products).
  Two modes:
  - Record only (put it on the product template): saves the product handle in this browser.
  - Show list (homepage or any page): appears once the visitor has viewed at least
    "Minimum products viewed" different products. Hidden otherwise.
  Views are kept only in the visitor's browser (localStorage, max 12 handles), and only when
  Shopify's customer privacy API allows preference storage (or no consent banner is in use).
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign key = 'somna:recently-viewed'
-%}

{%- if s.mode == 'record' -%}
  {%- if product -%}
    <script>
      (function () {
        try {
          var cp = window.Shopify && window.Shopify.customerPrivacy;
          if (cp && typeof cp.preferencesProcessingAllowed === 'function' && !cp.preferencesProcessingAllowed()) return;
          var key = {{ key | json }}, h = {{ product.handle | json }};
          var list = JSON.parse(localStorage.getItem(key) || '[]').filter(function (x) { return x !== h; });
          list.unshift(h);
          localStorage.setItem(key, JSON.stringify(list.slice(0, 12)));
        } catch (e) {}
      })();
    </script>
  {%- endif -%}
{%- else -%}
  <div
    class="somna-rv{% if s.layout == 'compact' %} somna-rv--compact{% endif %}"
    id="SomnaRV-{{ section.id }}"
    hidden
    style="--somna-rv-bg: {{ s.background_color }}; --somna-rv-card: {{ s.card_color }}; --somna-rv-button: {{ s.button_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
  >
    <div class="somna-rv__inner somna-container">
      <div class="somna-rv__head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="somna-rv__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="somna-rv__heading">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- comment -%} arrows show only when the cards don't all fit (desktop/tablet); phones swipe {%- endcomment -%}
        <div class="somna-rv__nav" data-nav hidden>
          <button type="button" class="somna-rv__arrow" data-prev aria-controls="SomnaRVList-{{ section.id }}" aria-label="{{ s.prev_label | escape }}" disabled>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="somna-rv__arrow" data-next aria-controls="SomnaRVList-{{ section.id }}" aria-label="{{ s.next_label | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <ul class="somna-rv__list" id="SomnaRVList-{{ section.id }}" role="list" data-list></ul>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('SomnaRV-{{ section.id }}');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var key = {{ key | json }};
      var threshold = {{ s.threshold }};
      var max = {{ s.max_products }};
      var current = {{ product.handle | default: '' | json }};
      var list = [];
      try { list = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) {}
      list = list.filter(function (h) { return h && h !== current; });
      if (list.length < threshold) return;
      list = list.slice(0, max);

      var ul = root.querySelector('[data-list]');

      // Slider: native horizontal scroll (touch swipe, trackpad) plus prev/next arrows that move by the number of
      // whole cards in view, measured from the real card width and gap. Arrows hide when everything fits.
      var nav = root.querySelector('[data-nav]');
      var prev = root.querySelector('[data-prev]');
      var next = root.querySelector('[data-next]');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var step = function () {
        var card = ul.querySelector('.somna-rv__card');
        var gap = parseFloat(getComputedStyle(ul).columnGap) || 0;
        if (!card) return ul.clientWidth;
        var w = card.getBoundingClientRect().width + gap;
        return Math.max(1, Math.floor((ul.clientWidth + gap) / w)) * w;
      };
      var update = function () {
        var max = ul.scrollWidth - ul.clientWidth;
        nav.hidden = max <= 2;
        prev.disabled = ul.scrollLeft <= 2;
        next.disabled = ul.scrollLeft >= max - 2;
      };
      var queued = false;
      ul.addEventListener('scroll', function () {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () { queued = false; update(); });
      }, { passive: true });
      prev.addEventListener('click', function () { ul.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }); });
      next.addEventListener('click', function () { ul.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }); });
      if (window.ResizeObserver) new ResizeObserver(update).observe(ul);
      var labels = { from: {{ s.price_prefix | json }}, sub: {{ s.subscribe_label | json }}, cta: {{ s.button_label | json }} };
      var onceOff = {{ settings.somna_once_discount | default: 0 }};
      // star rating per product (Judge.me, snippets/somna-rating), keyed by handle
      var ratings = {
        {%- for rp in collections.all.products -%}
          {%- capture rp_rating -%}{%- render 'somna-rating', product: rp, format: '[rating]/5 · [count] reviews' -%}{%- endcapture -%}
          {%- assign rp_rating = rp_rating | strip -%}
          {%- if rp_rating != blank -%}{{ rp.handle | json }}: {{ rp_rating | json }},{%- endif -%}
        {%- endfor -%}
      };
      // Reserve the space before the request finishes so nothing below jumps.
      ul.innerHTML = list.map(function () { return '<li class="somna-rv__card is-loading" aria-hidden="true"><span class="somna-rv__media"></span></li>'; }).join('');
      root.hidden = false;

      var money = function (cents) {
        var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || {{ cart.currency.iso_code | json }};
        try { return new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: cur }).format(cents / 100); }
        catch (e) { return (cents / 100).toFixed(2); }
      };
      var esc = function (t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; };
      var root_url = {{ routes.root_url | json }};
      var base = root_url === '/' ? '' : root_url;

      Promise.all(list.map(function (h) {
        return fetch(base + '/products/' + encodeURIComponent(h) + '.js', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .catch(function () { return null; });
      })).then(function (products) {
        products = products.filter(function (p) { return p && p.available !== undefined; });
        if (products.length < threshold) { root.hidden = true; return; }
        ul.innerHTML = products.map(function (p) {
          var img = p.featured_image ? p.featured_image.replace(/^\/\//, 'https://') : '';
          var src = img ? img + (img.indexOf('?') > -1 ? '&' : '?') + 'width=600' : '';
          var sub = p.selling_plan_groups && p.selling_plan_groups.length ? '<span class="somna-rv__sub">' + esc(labels.sub) + '</span>' : '';
          // lowest price: Subscribe & Save plan price, else the one-time sale price (regular minus the sale %)
          var hasPlans = !!(p.selling_plan_groups && p.selling_plan_groups.length);
          var low = { price: p.price_min, compare: 0 };
          (p.variants || []).forEach(function (v) {
            var cands = [hasPlans ? Math.round(v.price * (100 - onceOff) / 100) : v.price];
            (v.selling_plan_allocations || []).forEach(function (a) { cands.push(a.price); });
            var best = Math.min.apply(null, cands);
            if (best <= low.price) low = { price: best, compare: Math.max(v.price, v.compare_at_price || 0) };
          });
          return '<li class="somna-rv__card">' +
            '<a class="somna-rv__media" href="' + esc(p.url) + '" tabindex="-1" aria-hidden="true">' +
              (src ? '<img src="' + esc(src) + '" alt="" width="600" height="468" loading="lazy" decoding="async">' : '') +
            '</a>' +
            (ratings[p.handle] ? '<p class="somna-stars-line somna-rv__rating"><span class="somna-stars-line__stars" aria-hidden="true">★★★★★</span><span class="somna-stars-line__text">' + esc(ratings[p.handle]) + '</span></p>' : '') +
            '<h3 class="somna-rv__title"><a href="' + esc(p.url) + '">' + esc(p.title) + '</a></h3>' +
            '<p class="somna-rv__price">' + esc(labels.from) + ' ' + money(low.price) + (low.compare > low.price ? ' <s>' + money(low.compare) + '</s>' : '') + sub + '</p>' +
            '<a class="somna-rv__button" href="' + esc(p.url) + '">' + esc(labels.cta) + '<span class="visually-hidden">: ' + esc(p.title) + '</span></a>' +
          '</li>';
        }).join('');
        ul.scrollLeft = 0;
        update();
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .somna-rv {
    background: var(--somna-rv-bg);
    color: #f3feee;
    overflow: hidden;
  }

  .somna-rv[hidden] {
    display: none;
  }

  .somna-rv__eyebrow {
    margin: 0 0 14px;
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .somna-rv__head {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    justify-content: space-between;
    /* gap above the cards lives here: the theme's ":last-child" heading rule zeroes the heading's own margin */
    margin-bottom: 24px;
  }

  .somna-rv__nav {
    display: flex;
    flex: none;
    gap: 10px;
  }

  .somna-rv__nav[hidden] {
    display: none;
  }

  .somna-rv__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid #f3feee;
    border-radius: 50%;
    background: transparent;
    color: #f3feee;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }

  .somna-rv__arrow:hover:not(:disabled) {
    background: #f3feee;
    color: #0b0f1d;
  }

  .somna-rv__arrow:focus-visible {
    outline: 2px solid var(--somna-rv-button);
    outline-offset: 3px;
  }

  .somna-rv__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .somna-rv__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.5rem, 1.96vw, 1.75rem);
    line-height: 1.35;
    color: inherit;
  }

  .somna-rv__list {
    display: grid;
    grid-auto-flow: column;
    /* fixed Figma card width; the row runs to the right edge of the screen like the design */
    grid-auto-columns: min(326px, 78vw);
    gap: 30px;
    margin: 0 calc(50% - 50vw) 0 0;
    padding: 0 max(16px, calc(50vw - 50%)) 8px 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .somna-rv__list::-webkit-scrollbar {
    display: none;
  }

  /* position: relative keeps each card's screen-reader label inside the scrolling list
     (without it those labels stretched the whole page sideways on phones and tablets) */
  .somna-rv__card {
    position: relative;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    padding: 17px 10px 11px;
    border: 1.2px solid rgb(0 0 0 / 0.1);
    border-radius: 20px;
    background: var(--somna-rv-card);
    color: #0a1a4a;
  }

  .somna-rv__media {
    display: block;
    aspect-ratio: 282 / 220;
    margin: 0 11px 20px 13px;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(11 15 29 / 0.08);
  }

  .somna-rv__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-rv__rating {
    margin: 0 9px 4px;
    color: #0b0f1d;
    font-size: 0.75rem;
  }

  .somna-rv__title {
    margin: 0 9px;
    font-family: var(--font-body--family);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.1;
    text-shadow: 0 5.5px 5.5px rgb(0 0 0 / 0.1);
  }

  .somna-rv__title a {
    color: inherit;
    text-decoration: none;
  }

  .somna-rv__price {
    display: flex;
    gap: 10px;
    margin: 4px 9px 10px;
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.18;
    color: #0b0f1d;
  }

  .somna-rv__button {
    display: grid;
    place-items: center;
    min-height: 43px;
    margin-top: auto;
    border-radius: 8.5px;
    background: var(--somna-rv-button);
    box-shadow: 0 3.5px 5.3px rgb(0 0 0 / 0.25);
    color: #000;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
  }

  .somna-rv__button:focus-visible,
  .somna-rv__title a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .somna-rv__card.is-loading .somna-rv__media {
    animation: somna-rv-pulse 1.2s ease-in-out infinite alternate;
  }

  /* Compact layout (product pages, approved demo): a short row of side-by-side cards — image left,
     title / price / button right */
  .somna-rv--compact .somna-rv__head {
    margin-bottom: 18px;
  }

  .somna-rv--compact .somna-rv__eyebrow {
    margin-bottom: 8px;
  }

  .somna-rv--compact .somna-rv__list {
    grid-auto-columns: min(318px, 84vw);
    gap: 20px;
  }

  .somna-rv--compact .somna-rv__card {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    column-gap: 14px;
    padding: 10px;
    border-radius: 16px;
  }

  .somna-rv--compact .somna-rv__media {
    grid-row: 1 / 5;
    align-self: stretch;
    min-height: 118px;
    margin: 0;
    aspect-ratio: auto;
    border-radius: 12px;
  }

  .somna-rv--compact .somna-rv__rating {
    margin: 2px 0 2px;
  }

  .somna-rv--compact .somna-rv__title {
    margin: 0;
    font-size: 1.0625rem;
  }

  .somna-rv--compact .somna-rv__price {
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 4px 0 8px;
  }

  .somna-rv--compact .somna-rv__button {
    min-height: 34px;
    border-radius: 8px;
    font-size: 0.8125rem;
  }

  @keyframes somna-rv-pulse {
    to { opacity: 0.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-rv__card.is-loading .somna-rv__media {
      animation: none;
    }
  }

  /* phones keep the existing swipe-only layout */
  @media screen and (max-width: 749px) {
    .somna-rv__nav {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna recently viewed",
  "tag": "section",
  "class": "section-somna-rv",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "options": [
        { "value": "show", "label": "Show list" },
        { "value": "record", "label": "Record views only (product page)" }
      ],
      "default": "show"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Card layout",
      "options": [
        { "value": "cards", "label": "Tall cards (image on top)" },
        { "value": "compact", "label": "Compact (image left, details right)" }
      ],
      "default": "cards",
      "visible_if": "{{ section.settings.mode == 'show' }}"
    },
    {
      "type": "range",
      "id": "threshold",
      "label": "Minimum products viewed",
      "info": "Different products. The list stays hidden until the visitor has viewed this many.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.mode == 'show' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "visible_if": "{{ section.settings.mode == 'show' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recently viewed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still thinking about it?"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscription label",
      "info": "Shown when the product can be bought as a subscription.",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    { "type": "text", "id": "prev_label", "label": "Previous arrow (screen readers)", "default": "Previous products" },
    { "type": "text", "id": "next_label", "label": "Next arrow (screen readers)", "default": "Next products" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0b0f1d"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#f3feee"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#afbdf8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Somna recently viewed"
    }
  ]
}
{% endschema %}
