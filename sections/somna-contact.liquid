{%- doc -%}
  Somna V2 — contact form + direct contact details. The form is Shopify's own contact form
  ({% form 'contact' %}), so messages arrive exactly where the current contact form sends them.
  Inline validation and a sending state are added with a few lines of vanilla JS; without JS the
  browser's own required-field checks still work.
{%- enddoc -%}
{{ 'section-somna-contact.css' | asset_url | stylesheet_tag }}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign form_id = 'SomnaContact-' | append: section.id
  assign options = s.enquiry_options | newline_to_br | split: '<br />'
-%}
<somna-contact
  id="{{ s.anchor | default: 'contact-form' | handleize }}"
  class="somna-contact somna-contact--{{ s.style | default: 'panel' }}"
  style="--scf-bg: {{ s.background_color }}; --scf-panel: {{ s.panel_color }}; --scf-accent: {{ s.accent_color }}; --scf-card: {{ s.card_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-container somna-contact__grid">
    <div class="somna-contact__intro">
      {%- if s.eyebrow != blank -%}<p class="somna-contact__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="somna-contact__heading somna-accent">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="somna-contact__text">{{ s.text }}</div>{%- endif -%}

      {%- comment -%} quick links (Figma "Quick answers"): one block per link {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="somna-contact__links" role="list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <a class="somna-contact__link{% if b.dark %} somna-contact__link--dark{% endif %}" href="{{ b.link | default: '#' }}">
                <span class="somna-contact__link-icon" aria-hidden="true">
                  {%- if b.icon != blank -%}<span class="somna-contact__mask" style="--scf-mask: url('{{ b.icon | image_url: width: 160 }}');{% if b.icon_size %} width: {{ b.icon_size }}px; height: {{ b.icon_size }}px;{% endif %}"></span>{%- else -%}{%- render 'somna-line-icon', name: 'question', class: 'somna-contact__svg', stroke: 1.6 -%}{%- endif -%}
                </span>
                <span class="somna-contact__link-label">{{ b.label | escape }}</span>
                <span class="somna-contact__link-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.email != blank -%}
        <div class="somna-contact__direct">
          <span class="somna-contact__direct-icon">{%- if s.direct_icon != blank -%}<span class="somna-contact__mask somna-contact__mask--direct" style="--scf-mask: url('{{ s.direct_icon | image_url: width: 160 }}');"></span>{%- else -%}{%- render 'somna-line-icon', name: 'mail', class: 'somna-contact__svg', stroke: 1.6 -%}{%- endif -%}</span>
          <div class="somna-contact__direct-body">
            {%- if s.direct_label != blank -%}<p class="somna-contact__direct-label">{{ s.direct_label | escape }}</p>{%- endif -%}
            <a class="somna-contact__email" href="mailto:{{ s.email | strip }}">{{ s.email | strip | escape }}</a>
            {%- if s.response_time != blank -%}
              <p class="somna-contact__response">
                {%- render 'somna-line-icon', name: 'clock', class: 'somna-contact__svg somna-contact__svg--small', stroke: 1.6 -%}
                {{ s.response_time | escape }}
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="somna-contact__panel{% if s.drip_edge and s.style != 'card' %} somna-edge-drip-bottom{% endif %}">
      {%- if s.form_heading != blank -%}<h2 class="somna-contact__form-heading">{{ s.form_heading }}</h2>{%- endif -%}

      <div data-no-reveal>
      {%- form 'contact', id: form_id, class: 'somna-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="somna-contact__notice somna-contact__notice--success" role="status" tabindex="-1" data-notice>
            {%- render 'somna-line-icon', name: 'shield', class: 'somna-contact__svg', stroke: 1.6 -%}
            <p>{{ s.success_message | escape }}</p>
          </div>
        {%- elsif form.errors -%}
          <div class="somna-contact__notice somna-contact__notice--error" role="alert" tabindex="-1" data-notice>
            <p>{{ s.error_message | escape }}</p>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <p class="somna-contact__required-note"><span aria-hidden="true">*</span> {{ s.required_note | escape }}</p>

        <div class="somna-contact__fields">
          <div class="somna-contact__field">
            <label for="{{ form_id }}-name">{{ s.name_label | escape }} <span class="somna-contact__req" aria-hidden="true">*</span></label>
            <input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" required placeholder="{{ s.name_placeholder | escape }}" value="{{ form.name | escape }}" aria-describedby="{{ form_id }}-name-error">
            <p class="somna-contact__error" id="{{ form_id }}-name-error" data-error hidden>{{ s.required_error | escape }}</p>
          </div>

          <div class="somna-contact__field">
            <label for="{{ form_id }}-email">{{ s.email_label | escape }} <span class="somna-contact__req" aria-hidden="true">*</span></label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="{{ s.email_placeholder | escape }}" value="{% if form.email != blank %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" aria-describedby="{{ form_id }}-email-error" data-email-error="{{ s.email_error | escape }}">
            <p class="somna-contact__error" id="{{ form_id }}-email-error" data-error hidden>{{ s.required_error | escape }}</p>
          </div>

          {%- if s.second_field == 'order' -%}
            <div class="somna-contact__field">
              <label for="{{ form_id }}-order">{{ s.order_label | escape }}</label>
              <input id="{{ form_id }}-order" type="text" name="contact[{{ s.order_label | escape }}]" autocomplete="off" placeholder="{{ s.order_placeholder | escape }}" value="{{ form[s.order_label] | escape }}">
            </div>
          {%- else -%}
          <div class="somna-contact__field">
            <label for="{{ form_id }}-phone">{{ s.phone_label | escape }}</label>
            <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s\(\)\.]*" placeholder="{{ s.phone_placeholder | escape }}" value="{{ form.phone | escape }}" aria-describedby="{{ form_id }}-phone-error" data-pattern-error="{{ s.phone_error | escape }}">
            <p class="somna-contact__error" id="{{ form_id }}-phone-error" data-error hidden>{{ s.phone_error | escape }}</p>
          </div>
          {%- endif -%}

          <div class="somna-contact__field">
            <label for="{{ form_id }}-enquiry">{{ s.enquiry_label | escape }} <span class="somna-contact__req" aria-hidden="true">*</span></label>
            <div class="somna-contact__select">
              <select id="{{ form_id }}-enquiry" name="contact[{{ s.enquiry_label | escape }}]" required aria-describedby="{{ form_id }}-enquiry-error">
                <option value="" disabled selected>{{ s.enquiry_placeholder | escape }}</option>
                {%- for opt in options -%}
                  {%- assign o = opt | strip -%}
                  {%- if o != blank -%}<option value="{{ o | escape }}">{{ o | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
            <p class="somna-contact__error" id="{{ form_id }}-enquiry-error" data-error hidden>{{ s.select_error | escape }}</p>
          </div>

          <div class="somna-contact__field somna-contact__field--full">
            <label for="{{ form_id }}-body">{{ s.message_label | escape }} <span class="somna-contact__req" aria-hidden="true">*</span></label>
            <textarea id="{{ form_id }}-body" name="contact[body]" rows="6" required placeholder="{{ s.message_placeholder | escape }}" aria-describedby="{{ form_id }}-body-error">{{ form.body }}</textarea>
            <p class="somna-contact__error" id="{{ form_id }}-body-error" data-error hidden>{{ s.required_error | escape }}</p>
          </div>
        </div>

        <button type="submit" class="somna-contact__submit" data-submit data-sending="{{ s.sending_label | escape }}">
          <span class="somna-contact__spinner" aria-hidden="true"></span>
          <span data-submit-label>{{ s.submit_label | escape }}</span>
        </button>
      {%- endform -%}
      </div>
    </div>
  </div>
</somna-contact>

<script>
  if (!customElements.get('somna-contact')) {
    customElements.define(
      'somna-contact',
      class extends HTMLElement {
        connectedCallback() {
          const form = this.querySelector('form');
          if (!form) return;
          form.noValidate = true;
          this.querySelectorAll('[data-error]').forEach((e) => (e.dataset.base = e.textContent.trim()));
          this.fields = [...form.querySelectorAll('input:not([type="hidden"]), select, textarea')];
          this.fields.forEach((f) => {
            f.addEventListener('blur', () => this.check(f));
            f.addEventListener('input', () => f.getAttribute('aria-invalid') === 'true' && this.check(f));
            f.addEventListener('change', () => f.getAttribute('aria-invalid') === 'true' && this.check(f));
          });
          form.addEventListener('submit', (e) => {
            const bad = this.fields.filter((f) => !this.check(f));
            if (bad.length) {
              e.preventDefault();
              bad[0].focus();
              return;
            }
            const btn = form.querySelector('[data-submit]');
            btn.disabled = true;
            btn.classList.add('is-sending');
            btn.setAttribute('aria-busy', 'true');
            btn.querySelector('[data-submit-label]').textContent = btn.dataset.sending;
          });
          const notice = this.querySelector('[data-notice]');
          if (notice) requestAnimationFrame(() => notice.focus({ preventScroll: false }));
        }

        check(f) {
          const err = document.getElementById(f.getAttribute('aria-describedby') || '');
          let msg = '';
          if (f.validity.valueMissing) msg = err?.dataset.base || '';
          else if (f.validity.typeMismatch) msg = f.dataset.emailError;
          else if (f.validity.patternMismatch) msg = f.dataset.patternError;
          const ok = f.validity.valid;
          f.setAttribute('aria-invalid', ok ? 'false' : 'true');
          if (err) {
            err.hidden = ok;
            if (!ok) err.textContent = msg || err.dataset.base;
          }
          return ok;
        }
      }
    );
  }
</script>


{% schema %}
{
  "name": "Somna contact form",
  "tag": "section",
  "class": "somna-contact-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "contact-form", "info": "Link to the form with #contact-form." },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "panel", "label": "Navy form panel" }, { "value": "card", "label": "Mint form card with black border" }], "default": "panel" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Send us a <em>message</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Direct contact" },
    { "type": "image_picker", "id": "direct_icon", "label": "Email icon", "info": "Transparent PNG; drawn in black. Empty: a line envelope." },
    { "type": "text", "id": "direct_label", "label": "Label", "default": "Email us directly" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@somnasleep.com" },
    { "type": "text", "id": "response_time", "label": "Response time", "default": "Typically within 1 business day." },
    { "type": "header", "content": "Form" },
    { "type": "inline_richtext", "id": "form_heading", "label": "Form heading", "info": "Card style: italic words start a new line in lavender." },
    { "type": "text", "id": "required_note", "label": "Required note", "default": "Required fields" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Full name" },
    { "type": "text", "id": "name_placeholder", "label": "Name placeholder", "default": "Your full name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "select", "id": "second_field", "label": "Third field", "options": [{ "value": "phone", "label": "Phone number" }, { "value": "order", "label": "Order number" }], "default": "phone" },
    { "type": "text", "id": "order_label", "label": "Order number label", "default": "Order number, optional", "info": "Also used as the field name in the message you receive." },
    { "type": "text", "id": "order_placeholder", "label": "Order number placeholder", "default": "e.g. #12345" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone number" },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "Optional" },
    { "type": "text", "id": "enquiry_label", "label": "Enquiry label", "default": "Enquiry type", "info": "Also used as the field name in the message you receive." },
    { "type": "text", "id": "enquiry_placeholder", "label": "Enquiry placeholder", "default": "Choose a topic" },
    { "type": "textarea", "id": "enquiry_options", "label": "Enquiry options", "info": "One per line.", "default": "My order\nMy subscription\nUsing Somna\nReturns & guarantee\nSomething else" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "How can we help? Include your order number if you have one." },
    { "type": "text", "id": "submit_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "sending_label", "label": "Sending label", "default": "Sending…" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for reaching out. We'll get back to you within 1 business day." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Something went wrong. Please check the fields below and try again." },
    { "type": "text", "id": "required_error", "label": "Required field error", "default": "Please fill in this field." },
    { "type": "text", "id": "select_error", "label": "Topic error", "default": "Please choose a topic." },
    { "type": "text", "id": "email_error", "label": "Email error", "default": "Please enter a valid email address." },
    { "type": "text", "id": "phone_error", "label": "Phone error", "default": "Please use numbers, spaces, +, -, ( ) only." },
    { "type": "checkbox", "id": "drip_edge", "label": "Drip edge on form panel", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3feee" },
    { "type": "color", "id": "panel_color", "label": "Form panel", "default": "#0b0f1d" },
    { "type": "color", "id": "card_color", "label": "Direct contact card", "default": "#afbdf8" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Track your order" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Transparent PNG; drawn in the text colour. Empty: a question-mark line icon." },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 30 },
        { "type": "checkbox", "id": "dark", "label": "Dark button", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Somna contact form" }]
}
{% endschema %}

