{%- comment -%}
  Somna V2 — horizontal strip of media cards (customer videos / UGC).
  A card with a video link shows a play button and opens the video; without a link it is a plain image.
  Scrolls horizontally with scroll-snap when the cards don't fit.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
-%}
<div
  class="somna-strip"
  style="background: {{ s.background_color }}; color: {{ s.text_color }}; --somna-strip-card: {{ s.card_width }}px; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-strip__head somna-container">
    {%- if s.eyebrow != blank -%}<p class="somna-strip__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="somna-strip__heading">{{ s.heading }}</h2>{%- endif -%}
  </div>
  <ul class="somna-strip__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign label = b.caption | default: b.image.alt | default: s.heading
      -%}
      <li class="somna-strip__item" {{ block.shopify_attributes }}>
        {%- if b.video_link != blank -%}<a class="somna-strip__card" href="{{ b.video_link }}" target="_blank" rel="noopener" aria-label="{{ s.play_label | escape }}: {{ label | escape }}">{%- else -%}<div class="somna-strip__card">{%- endif -%}
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: 'var(--somna-strip-card)', loading: 'lazy', class: 'somna-strip__img' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'somna-strip__img' }}
          {%- endif -%}
          {%- if b.video_link != blank -%}
            <span class="somna-strip__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
          {%- endif -%}
        {%- if b.video_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- if b.caption != blank -%}<p class="somna-strip__caption">{{ b.caption }}</p>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color -%}
{%- endif -%}

{% stylesheet %}
  .somna-strip__head {
    text-align: center;
  }

  .somna-strip__eyebrow {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-strip__heading {
    margin: 4px 0 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(2rem, 3.47vw, 3.125rem);
    line-height: 1.3;
    color: inherit;
  }

  .somna-strip__list {
    display: flex;
    gap: 26px;
    margin: 20px 0 0;
    padding: 0 22px 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 22px;
    scrollbar-width: thin;
  }

  .somna-strip__item {
    flex: 0 0 var(--somna-strip-card);
    scroll-snap-align: start;
  }

  .somna-strip__card {
    position: relative;
    display: block;
    aspect-ratio: 207 / 342;
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
  }

  .somna-strip__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .somna-strip__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-strip__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #000;
    translate: -50% -50%;
    transition: scale 0.2s;
  }

  .somna-strip__play svg {
    width: 22px;
    height: 22px;
    margin-left: 2px;
  }

  .somna-strip__card:hover .somna-strip__play {
    scale: 1.08;
  }

  .somna-strip__caption {
    margin: 10px 2px 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-strip__play {
      transition: none;
    }
  }

  /* final mobile design: left-aligned heading, two cards in view */
  @media screen and (max-width: 749px) {
    .somna-strip__head {
      text-align: start;
    }

    .somna-strip__eyebrow {
      font-size: 0.625rem;
    }

    .somna-strip__heading {
      font-size: 1.875rem;
    }

    .somna-strip__list {
      gap: 20px;
      padding-inline: 26px;
      scroll-padding-inline: 26px;
    }

    .somna-strip__item {
      flex-basis: min(var(--somna-strip-card), calc(50vw - 36px));
    }

    .somna-strip__caption {
      font-size: 0.6875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna media strip",
  "tag": "section",
  "class": "section-somna-strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "play_label", "label": "Play label (screen readers)", "default": "Play video" },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 140, "max": 320, "step": 4, "unit": "px", "default": 208 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3feee" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "video_link", "label": "Video link", "info": "Adds a play button. Leave empty for a plain image." },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    { "name": "Somna media strip", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }
  ]
}
{% endschema %}
