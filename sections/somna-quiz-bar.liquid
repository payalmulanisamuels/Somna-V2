{%- comment -%}
  Somna V2 — "Not sure where to start? 60-sec sleep quiz · Take the quiz →" strip (header group, under the sale
  countdown). Phones only by default (setting), and never on the quiz page itself.
  Its stylesheet also trims the announcement bar on phones: wrap the part of the announcement text to drop on
  phones in italics (e.g. "… with Subscribe & Save<em> · 3 free gifts on 2+ packs · Ends Mon 23 Nov</em>") and it
  shows on desktop only, in normal (not italic) type.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign on_quiz = false
  if request.path contains '/pages/quiz'
    assign on_quiz = true
  endif
-%}
{%- unless on_quiz or s.text == blank -%}
  <a class="somna-quizbar{% if s.phones_only %} somna-quizbar--phones{% endif %}" href="{{ s.link | default: '/pages/quiz' }}" style="--qb-bg: {{ s.bg_color }}; --qb-text: {{ s.text_color }};">
    {%- assign qb_parts = s.text | split: '? ' -%}
    <span class="somna-quizbar__text">{% if qb_parts.size > 1 %}<span class="somna-quizbar__pre">{{ qb_parts[0] }}? </span>{{ qb_parts | slice: 1, 9 | join: '? ' }}{% else %}{{ s.text }}{% endif %}</span>
    <span class="somna-quizbar__cta">{{ s.link_label }} <span aria-hidden="true">→</span></span>
  </a>
{%- endunless -%}

{% stylesheet %}
  .somna-quizbar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 9px max(16px, calc((100vw - 1219px) / 2)); background: var(--qb-bg); color: var(--qb-text);
    font-size: 16px; line-height: 1.3; text-decoration: none;
  }
  .somna-quizbar__cta { flex: none; font-weight: 800; white-space: nowrap; }
  .somna-quizbar:hover .somna-quizbar__cta { text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (min-width: 750px) { .somna-quizbar--phones { display: none; } }
  @media screen and (max-width: 749px) {
    .somna-quizbar { padding: 9px 16px; font-size: 13px; }
    .somna-quizbar__text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
  /* announcement bar: italic part = desktop-only words */
  .announcement-bar em { font-style: normal; }
  @media screen and (min-width: 750px) {
    .announcement-bar .announcement-bar__text { font-size: 0.8125rem; white-space: nowrap; }
  }
  @media screen and (max-width: 749px) {
    .announcement-bar em { display: none; }
    .announcement-bar .announcement-bar__text { font-size: 0.6875rem; letter-spacing: 0.02em; white-space: nowrap; }
  }
  @media screen and (max-width: 400px) {
    .announcement-bar .announcement-bar__text { white-space: normal; text-wrap: balance; }
  }
  @media screen and (max-width: 360px) {
    .somna-quizbar__pre { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna quiz bar",
  "tag": "section",
  "class": "section-somna-quiz-bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Not sure where to start? 60-sec sleep quiz" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Take the quiz" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "phones_only", "label": "Phones only", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#afbdf8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Somna quiz bar" }]
}
{% endschema %}
