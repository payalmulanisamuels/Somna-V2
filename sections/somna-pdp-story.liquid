  /* desktop (Figma 1440) */
  @media screen and (min-width: 990px) {
    .somna-pdp-story--problem .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 480px) minmax(0, 753px);
      justify-content: space-between;
      align-items: start;
    }

    .somna-pdp-story--how .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 560px) minmax(0, 640px);
      justify-content: space-between;
    }

    /* Figma: the strip is much taller, so the four features spread further apart */
    .somna-pdp-story--how .somna-pdp-story__visual {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr) minmax(0, 1fr);
      /* Figma: features sit top and bottom of a ~440px area, whatever the product shape (tall strip or round tape) */
      grid-template-rows: 1fr 1fr;
      min-height: clamp(360px, 30.5vw, 440px);
    }

    .somna-pdp-story--layers .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 440px) minmax(0, 460px) minmax(0, 320px);
      gap: 24px;
      justify-content: space-between;
    }

    .somna-pdp-story--steps .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 520px) minmax(0, 640px);
      justify-content: space-between;
      align-items: start;
