  /* "How it works" hop-flip: hidden until it plays; float once landed */
  somna-pdp-how {
    perspective: 1100px;
  }

  somna-pdp-how .somna-pdp-story__product {
    transform-style: preserve-3d;
    will-change: transform;
  }

  somna-pdp-how.is-pending :is(.somna-pdp-story__product, .somna-pdp-story__point-icon, .somna-pdp-story__point h3, .somna-pdp-story__point p) {
    opacity: 0;
  }

  somna-pdp-how.is-done .somna-pdp-story__product img {
    animation: somnaHowFloat 4s ease-in-out infinite;
  }

  @keyframes somnaHowFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* two products: each floats on its own, out of step (translate, so it adds to the landed hop transform) */
  somna-pdp-how.is-done.somna-pdp-story__visual--pair .somna-pdp-story__product img {
    animation: somnaHowFloatPair 3.2s ease-in-out infinite;
  }

  somna-pdp-how.is-done.somna-pdp-story__visual--pair .somna-pdp-story__product img + img {
    animation-delay: -1.6s;
  }

  @keyframes somnaHowFloatPair {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -6px; }
  }

  somna-pdp-how.somna-pdp-story__visual--pair .somna-pdp-story__product {
    perspective: 1100px;
    transform-style: flat;
  }

  somna-pdp-how.somna-pdp-story__visual--pair .somna-pdp-story__product img {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    somna-pdp-how.is-done .somna-pdp-story__product img,
    somna-pdp-how.is-done.somna-pdp-story__visual--pair .somna-pdp-story__product img {
      animation: none;
    }
  }
  /* layers built from separate layer images (stacked = the Figma picture) */
  .somna-pdp-story__stack {
    position: relative;
    display: block;
    width: 100%;
  }

  .somna-pdp-story__stack .somna-pdp-story__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  somna-pdp-layers .somna-pdp-story__layer {
    will-change: transform, opacity;
  }

  .somna-pdp-layers-traveller {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .somna-pdp-layers-traveller img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 16px rgb(0 0 0 / 0.2));
  }

  /* Mobile, bundles (Figma 4781:9521 / 4767:8277 / 4759:7535): "The problem" and "The fix" share one spot and
     cross-fade in a loop (same 7s timing as the Mouth Tape problem picture); the two "What it's made of"
     cards sit side by side with a one-column list */
  @media screen and (max-width: 749px) {
    .somna-pdp-story__split:has(> .somna-pdp-story__panel--after) {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-story__split:has(> .somna-pdp-story__panel--after) > .somna-pdp-story__panel {
      grid-area: 1 / 1;
    }

    .somna-pdp-story__split:has(> .somna-pdp-story__panel--after) > .somna-pdp-story__panel:not(.somna-pdp-story__panel--after) {
      animation: somnaStoryFade 7s ease-in-out infinite;
    }

    .somna-pdp-story__panel--after {
      animation: somnaStoryFadeIn 7s ease-in-out infinite;
    }
  }

  @media screen and (max-width: 749px) and (prefers-reduced-motion: reduce) {
    .somna-pdp-story__split > .somna-pdp-story__panel {
      animation: none;
    }

    .somna-pdp-story__panel--after {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {

    .somna-pdp-story__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      align-items: stretch;
    }

    .somna-pdp-story__pair-plus {
      display: none;
    }

    .somna-pdp-story__pair-card,
    .somna-pdp-story__pair-card:last-child {
      padding: 14px 10px 16px;
      border-width: 2px;
      border-radius: 14px;
      box-shadow: 2px 3px 0 #000;
      rotate: 0deg;
    }

    .somna-pdp-story__pair-title {
      margin: 0 0 10px;
      font-size: 1.125rem;
      line-height: 1.2;
    }

    .somna-pdp-story__pair-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .somna-pdp-story__pair .somna-pdp-story__layers {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding-left: 1.2em;
      font-size: 0.625rem;
    }

    .somna-pdp-story__pair .somna-pdp-story__layers :is(h4, p) {
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }
  }
  /* desktop: step pictures cut from one combined photo showed thin edge lines; trim 2% of each edge
     (zoom 1.04 + clip) so only the picture shows, same size and rounded corners */
  @media screen and (min-width: 750px) {
    .somna-pdp-story__step img {
      scale: 1.04;
      clip-path: inset(2% round 12px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna product story",
  "tag": "section",
  "class": "section-somna-pdp-story",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Content and layout",
      "info": "Reads the product's matching PDP section metafield.",
      "options": [
        { "value": "problem", "label": "Problem (Sound familiar?)" },
        { "value": "how", "label": "How it works" },
        { "value": "layers", "label": "What it's made of" },
        { "value": "steps", "label": "Three steps" }
      ],
      "default": "problem"
    },
    { "type": "product", "id": "preview_product", "label": "Product for the theme editor", "info": "Only used where there is no product." },
    { "type": "video", "id": "video", "label": "Three steps: fallback video", "info": "The \"Watch how it works\" popup plays the product's steps metaobject \"video\" field, or the product metafield custom.how_it_works_video. This video is used only when neither is set." },
    { "type": "text", "id": "video_button_label", "label": "Three steps: button label", "default": "Watch how it works", "info": "Used when the steps metaobject has no button label." },
    { "type": "checkbox", "id": "layers_animation", "label": "Animate \"What it's made of\"", "info": "When every layer has its own image: the How it works product travels in and peels into the layers as you scroll (phones: the layers peel apart without the travel). Off for reduced motion.", "default": true },
    { "type": "select", "id": "pills_motion", "label": "Pill badges animation", "info": "A short shake every few seconds, one pill after another. Off for reduced motion.", "options": [{ "value": "none", "label": "None" }, { "value": "wiggle", "label": "Wiggle" }, { "value": "swing", "label": "Tilt-swing" }, { "value": "pop", "label": "Pop-jiggle" }], "default": "swing" },
    { "type": "checkbox", "id": "how_animation", "label": "Animate \"How it works\"", "info": "Hop-flip of the product and icons 1 → 4 when the section comes on screen. Off for visitors who prefer reduced motion.", "default": true },
    { "type": "select", "id": "accent_line", "label": "Heading line in the accent colour", "options": [{ "value": "first", "label": "First line" }, { "value": "second", "label": "Second line" }], "default": "first" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0b0f1d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3feee" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Heading accent / button", "default": "#afbdf8" },
    { "type": "color", "id": "card_color", "label": "Pills and icon colour", "default": "#f3feee" },
    { "type": "color", "id": "card_text_color", "label": "Icon circle", "default": "#000000" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#afbdf8" },
    { "type": "select", "id": "layers_mode", "label": "What it's made of: show", "options": [{ "value": "single", "label": "One product" }, { "value": "pair", "label": "Products side by side" }, { "value": "after", "label": "One product, after the steps" }], "default": "single", "visible_if": "{{ section.settings.layout == 'layers' }}", "info": "Side by side = entries with Products in this section (bundles). After the steps reads PDP – What it's made of (after steps)." },
    { "type": "header", "content": "Lavender style", "info": "Used when the product's content entry has Style = Lavender." },
    { "type": "color", "id": "alt_background_color", "label": "Background", "default": "#afbdf8" },
    { "type": "color", "id": "alt_accent_color", "label": "Heading accent", "default": "#f3feee" },
    { "type": "color", "id": "alt_button_color", "label": "Button", "default": "#f3feee" },
    { "type": "color", "id": "alt_wave_color", "label": "Colour below the wave", "default": "#f3feee" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
  ],
  "presets": [{ "name": "Somna product story" }]
}
{% endschema %}
