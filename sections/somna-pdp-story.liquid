  /* small laptops (990–1299px): the layers text column is ~290–420px, so the three badges shrink to stay on one row */
  @media screen and (min-width: 990px) and (max-width: 1299px) {
    .somna-pdp-story__pills {
      gap: 2px;
    }

    .somna-pdp-story__pills li {
