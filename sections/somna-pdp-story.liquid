{%- comment -%}
  Somna V2 — product page story sections (Figma 4557:857 / 4557:44): "Sound familiar?" (problem),
  "How it works", "What it's made of" (layers) and "Three steps". One section, four layouts.
  Content comes from the product's PDP section metaobject (custom.pdp_problem / pdp_how /
  pdp_layers / pdp_steps): eyebrow, two-line heading, text, label, image, pills, button and a list of
  PDP features (icon + title + text + optional photo), plus an optional second (solution) image. The section hides itself when the product has
  no content for the chosen layout. Entry fields Style, Heading line in the accent colour and Products in this
  section set per-product looks (Season Bundle).
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign key = 'pdp_' | append: s.layout
  # "after the steps" reads its own field (Color Set: Figma puts What it's made of after the steps)
  if s.layout == 'layers' and s.layers_mode == 'after'
    assign key = 'pdp_layers_after'
  endif
  assign c = product.metafields.custom[key].value

  # per-product look, set on the content entry ("Style"): Side by side (problem) or Lavender (steps)
  assign style = c.style.value | default: 'Default'
  assign split = false
  if s.layout == 'problem' and style == 'Side by side'
    assign split = true
  endif
  assign bg = s.background_color
  assign accent = s.accent_color
  assign button = s.button_color | default: '#afbdf8'
  assign wave = s.wave_color
  if style == 'Lavender'
    assign bg = s.alt_background_color
    assign accent = s.alt_accent_color
    assign button = s.alt_button_color
    assign wave = s.alt_wave_color
  endif

  # "What it's made of": an entry with "Products in this section" shows those products as cards side by side.
  # The template has two layers sections (single before the steps, pair after them, as in Figma); each shows only its own kind.
  assign related = c.related.value
  assign layout_class = s.layout
  if s.layout == 'layers'
    if s.layers_mode == 'after'
      if related != blank
        assign c = nil
      endif
    elsif s.layers_mode == 'pair'
      if related == blank
        assign c = nil
      else
        assign layout_class = 'layers_pair'
      endif
    elsif related != blank
      assign c = nil
    endif
  endif
-%}
{%- if c != blank -%}
{%- liquid
  assign features = c.features.value
  assign image = c.image.value
  assign accent_first = false
  assign accent_pos = c.accent_line.value | default: s.accent_line | downcase
  if accent_pos == 'first'
    assign accent_first = true
  endif
-%}
<div
  class="somna-pdp-story somna-pdp-story--{{ layout_class }}{% if split %} somna-pdp-story--split{% endif %}"
  style="--somna-story-bg: {{ bg }}; --somna-story-fg: {{ s.text_color }}; --somna-story-heading: {{ s.heading_color }}; --somna-story-accent: {{ accent }}; --somna-story-card: {{ s.card_color }}; --somna-story-card-fg: {{ s.card_text_color }}; --somna-story-button: {{ button }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-pdp-story__inner somna-container">
    <div class="somna-pdp-story__copy">
      {%- if c.eyebrow != blank -%}<p class="somna-pdp-story__eyebrow">{{ c.eyebrow.value }}</p>{%- endif -%}
      <h2 class="somna-pdp-story__heading">
        <span{% if accent_first %} class="is-accent"{% endif %}>{{ c.heading.value }}</span>
        {%- if c.heading_accent != blank %} <span{% unless accent_first %} class="is-accent"{% endunless %}>{{ c.heading_accent.value }}</span>{% endif -%}
      </h2>
      {%- if c.text != blank -%}<p class="somna-pdp-story__text">{{ c.text.value | newline_to_br }}</p>{%- endif -%}

      {%- if s.layout == 'how' and c.label != blank -%}<p class="somna-pdp-story__label">{{ c.label.value }}</p>{%- endif -%}

      {%- assign pills = c.pills.value -%}
      {%- if pills != blank -%}
        <ul class="somna-pdp-story__pills" role="list">
          {%- for p in pills -%}<li{% if s.pills_motion != 'none' %} class="somna-shake--{{ s.pills_motion }}" style="--somna-shake-delay: {{ forloop.index0 | times: 0.3 }}s;"{% endif %}>{{ p }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} snoring (approved demo): sound waves and z's at the metaobject's "mouth position" (left %, top %)
      on the problem picture (both layouts); with the problem/solution loop it shows only while the problem picture does {%- endcomment -%}
    {%- capture snore_html -%}
      {%- if image and c.snore_spot != blank -%}
        {%- assign spot = c.snore_spot.value | remove: '%' | split: ',' -%}
        <span class="somna-snore" style="left: {{ spot[0] | strip }}%; top: {{ spot[1] | strip }}%;" aria-hidden="true">
          <svg class="somna-snore__waves" viewBox="0 0 46 46" focusable="false"><path d="M8 30a8 8 0 0 0 6-10"/><path d="M14 36a16 16 0 0 0 10-20"/><path d="M20 42a24 24 0 0 0 14-30"/></svg>
          <span class="somna-snore__z">z</span><span class="somna-snore__z">z</span><span class="somna-snore__z">Z</span>
        </span>
      {%- endif -%}
    {%- endcapture -%}
    {%- case layout_class -%}
      {%- when 'problem' -%}
        {%- if split -%}
          {%- comment -%} two panels side by side: the problem (label + bullets bottom-left) and the fix (bottom-right) {%- endcomment -%}
          {%- assign image_after = c.image_after.value -%}
          {%- assign features_after = c.features_after.value -%}
          <div class="somna-pdp-story__split">
            <div class="somna-pdp-story__panel">
              {%- if image -%}{{ image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '500, 700, 1000, 1300', sizes: '(min-width: 990px) 636px, 100vw', class: 'somna-pdp-story__panel-image' }}{%- endif -%}
              {{- snore_html -}}
              {%- if c.label != blank -%}<p class="somna-pdp-story__panel-tag">{{ c.label.value }}</p>{%- endif -%}
              {%- if features != blank -%}
                <ul class="somna-pdp-story__panel-list" role="list">
                  {%- for f in features -%}<li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
            {%- if image_after or features_after != blank or c.label_after != blank -%}
              <div class="somna-pdp-story__panel somna-pdp-story__panel--after">
                {%- if image_after -%}{{ image_after | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '500, 700, 1000, 1300', sizes: '(min-width: 990px) 636px, 100vw', class: 'somna-pdp-story__panel-image' }}{%- endif -%}
                {%- if c.label_after != blank -%}<p class="somna-pdp-story__panel-tag">{{ c.label_after.value }}</p>{%- endif -%}
                {%- if features_after != blank -%}
                  <ul class="somna-pdp-story__panel-list" role="list">
                    {%- for f in features_after -%}<li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>{%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
        <div class="somna-pdp-story__media">
          {%- assign image_after = c.image_after.value -%}
          {%- if c.label != blank -%}
            <p class="somna-pdp-story__tag{% if image and image_after %} has-after{% endif %}">
              <span class="somna-pdp-story__tag-before">{{ c.label.value }}</span>
              {%- if image and image_after and c.label_after != blank -%}<span class="somna-pdp-story__tag-after" aria-hidden="true">{{ c.label_after.value }}</span>{%- endif -%}
            </p>
          {%- endif -%}
          <div class="somna-pdp-story__frame{% if image and image_after %} has-after{% endif %}">
            {%- if image -%}{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__before' }}{%- endif -%}
            {%- if image and image_after -%}{{ image_after | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__after' }}{%- endif -%}
            {{- snore_html -}}
            {%- if features != blank -%}
              <ul class="somna-pdp-story__bullets" role="list">
                {%- for f in features -%}
                  <li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- assign features_after = c.features_after.value -%}
            {%- if image and image_after and features_after != blank -%}
              <ul class="somna-pdp-story__bullets somna-pdp-story__bullets--after" role="list">
                {%- for f in features_after -%}
                  <li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

      {%- when 'how' -%}
        {%- assign how_after = c.image_after.value -%}
        {%- capture visual_class -%}somna-pdp-story__visual{% if how_after %} somna-pdp-story__visual--pair{% endif %}{%- endcapture -%}
        {%- if s.how_animation -%}<somna-pdp-how class="{{ visual_class }}" data-order="1,2,4,3">{%- else -%}<div class="{{ visual_class }}">{%- endif -%}
          {%- if image -%}
            <div class="somna-pdp-story__product">
              {{- image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 335px, 50vw' -}}
              {%- comment -%} optional second product (Season Bundle: tape + strip side by side) {%- endcomment -%}
              {%- if how_after -%}{{ how_after | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 200px, 30vw', class: 'somna-pdp-story__product-after' }}{%- endif -%}
            </div>
          {%- endif -%}
          {%- for f in features limit: 4 -%}
            <div class="somna-pdp-story__point somna-pdp-story__point--{{ forloop.index }}">
              <span class="somna-pdp-story__point-icon">{% render 'somna-pdp-icon', name: f.icon.value %}</span>
              <h3>{{ f.title.value }}</h3>
              {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- if s.how_animation -%}</somna-pdp-how>{%- else -%}</div>{%- endif -%}

      {%- when 'layers' -%}
        {%- liquid
          assign layer_images = true
          if features == blank or features.size < 2
            assign layer_images = false
          endif
          for f in features
            if f.image == blank
              assign layer_images = false
            endif
          endfor
        -%}
        {%- if layer_images -%}
          {%- comment -%} each layer is its own full-size transparent image; stacked they make the Figma picture {%- endcomment -%}
          {%- for f in features limit: 1 -%}{%- assign first_layer = f.image.value -%}{%- endfor -%}
          {%- if s.layers_animation -%}<somna-pdp-layers class="somna-pdp-story__product somna-pdp-story__stack" style="aspect-ratio: {{ first_layer.width }} / {{ first_layer.height }};">{%- else -%}<div class="somna-pdp-story__product somna-pdp-story__stack" style="aspect-ratio: {{ first_layer.width }} / {{ first_layer.height }};">{%- endif -%}
            {%- for f in features -%}
              {%- assign li = f.image.value -%}
              {%- assign probe = li | image_url: width: 120 -%}
              {{ li | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 483px, 60vw', class: 'somna-pdp-story__layer', alt: f.title.value, data-probe: probe }}
            {%- endfor -%}
          {%- if s.layers_animation -%}</somna-pdp-layers>{%- else -%}</div>{%- endif -%}
        {%- elsif image -%}<div class="somna-pdp-story__product">{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 483px, 60vw' }}</div>{%- endif -%}
        {%- if features != blank -%}
          <ol class="somna-pdp-story__layers">
            {%- for f in features -%}
              <li><h3>{{ f.title.value }}</h3>{%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}</li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

      {%- when 'layers_pair' -%}
        {%- comment -%} two products' "What it's made of" entries side by side (Season Bundle) {%- endcomment -%}
        <div class="somna-pdp-story__pair">
          {%- for entry in related limit: 2 -%}
            {%- assign card_title = entry.admin_name.value | split: ' – ' | first | split: ' - ' | first -%}
            {%- unless forloop.first -%}<span class="somna-pdp-story__pair-plus" aria-hidden="true"></span>{%- endunless -%}
            <div class="somna-pdp-story__pair-card">
              {%- if card_title != blank -%}<h3 class="somna-pdp-story__pair-title">{{ card_title }}</h3>{%- endif -%}
              <div class="somna-pdp-story__pair-body">
                {%- assign entry_image = entry.image.value -%}
                {%- if entry_image -%}{{ entry_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 990px) 260px, 45vw', class: 'somna-pdp-story__pair-image', alt: card_title }}{%- endif -%}
                {%- assign entry_features = entry.features.value -%}
                {%- if entry_features != blank -%}
                  <ol class="somna-pdp-story__layers">
                    {%- for f in entry_features -%}
                      <li><h4>{{ f.title.value }}</h4>{%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}</li>
                    {%- endfor -%}
                  </ol>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

      {%- when 'steps' -%}
        <div class="somna-pdp-story__steps">
          <ol class="somna-pdp-story__step-list" role="list">
            {%- for f in features -%}
              {%- assign photo = f.image.value -%}
              {%- assign crop = f.image_crop.value | downcase | default: 'center' -%}
              <li class="somna-pdp-story__step">
                {%- if photo -%}{{ photo | image_url: width: 506, height: 308, crop: crop | image_tag: loading: 'lazy', alt: photo.alt, width: 253, height: 154 }}{%- endif -%}
                <div>
                  <h3><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ f.title.value }}</h3>
                  {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
          {%- liquid
            # video for the popup: the steps metaobject's "video" field, then the product metafield
            # custom.how_it_works_video, then the section's fallback video
            assign how_video = c.video.value
            if how_video == blank
              assign how_video = product.metafields.custom.how_it_works_video.value
            endif
            if how_video == blank
              assign how_video = s.video
            endif
            assign button_label = c.button_label.value | default: s.video_button_label
          -%}
          {%- if how_video != blank and how_video.sources != blank and button_label != blank -%}
            <button
              type="button"
              class="somna-pdp-story__button"
              aria-haspopup="dialog"
              aria-controls="SomnaHowVideo-{{ section.id }}"
              data-somna-video-open
            >
              <span class="somna-pdp-story__button-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>{{ button_label }}
            </button>
            <dialog
              id="SomnaHowVideo-{{ section.id }}"
              class="somna-video-modal"
              aria-label="{{ button_label | escape }}"
              data-somna-video-modal
            >
              <button type="button" class="somna-video-modal__close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}" data-somna-video-close>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
              </button>
              {{ how_video | video_tag: controls: true, playsinline: true, preload: 'none', class: 'somna-video-modal__video', image_size: '1080x' }}
            </dialog>
          {%- elsif c.button_label != blank and c.button_url != blank -%}
            <a class="somna-pdp-story__button" href="{{ c.button_url.value | replace: 'https://usesomna.com', '' }}">
              <span class="somna-pdp-story__button-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>{{ c.button_label.value }}
            </a>
          {%- endif -%}
        </div>
    {%- endcase -%}
  </div>
</div>
{%- if wave != blank -%}
  {%- render 'somna-wave', top: bg, bottom: wave, shape: section.settings.wave_shape -%}
{%- endif -%}
{%- endif -%}

{%- if s.layout == 'steps' -%}
<script src="{{ 'somna-video-modal.js' | asset_url }}" defer></script>
{%- endif -%}

{%- if layout_class == 'layers' and s.layers_animation and c != blank -%}
<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script type="module">
  /* "How it works" -> "What it's made of" (approved demo N · Peel apart, Slow).
     Plays by itself (~3.2s, soft ease-in-out; approved demo E) when the section is a third of the way up the screen: the "How it works" product leaves its spot,
     flips and travels down-right into this section, turns into the stacked layers, the layers peel
     apart one after another (first up-left, last down-right), then the descriptions appear 1 -> n.
     Rewinds when scrolled back above it. Phones (under 750px): same flip-and-travel; the sections stack, so it
     starts when the layers picture peeks in under the How-it-works strip. Off for reduced motion.
     Layer offsets are measured from the layer images themselves, so it works for 3 or 4 layers. */
  if (!customElements.get('somna-pdp-layers')) {
    customElements.define('somna-pdp-layers', class extends HTMLElement {
      async connectedCallback() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.layers = [...this.querySelectorAll('.somna-pdp-story__layer')];
        const section = this.closest('.somna-pdp-story');
        this.items = section ? [...section.querySelectorAll('.somna-pdp-story__layers li')] : [];
        if (this.layers.length < 2 || !(await this.ready())) return;
        let centres;
        try { centres = await Promise.all(this.layers.map((img) => this.centre(img.dataset.probe))); } catch (e) { return; }
        if (!this.isConnected) return;
        this.build(section, centres);
      }
      disconnectedCallback() {
        this.io?.disconnect();
        this.tl?.kill();
        this.traveller?.remove();
        if (this.source) this.source.style.opacity = '';
      }
      ready() {
        return new Promise((resolve) => {
          let n = 0;
          const check = () => (window.gsap ? resolve(true) : ++n > 100 ? resolve(false) : setTimeout(check, 50));
          check();
        });
      }
      /* centre of the visible part of one layer image, in % of the image box */
      async centre(src) {
        const im = new Image();
        im.crossOrigin = 'anonymous';
        im.src = src;
        await im.decode();
        const c = document.createElement('canvas');
        c.width = im.naturalWidth;
        c.height = im.naturalHeight;
        const x = c.getContext('2d', { willReadFrequently: true });
        x.drawImage(im, 0, 0);
        const d = x.getImageData(0, 0, c.width, c.height).data;
        let sx = 0, sy = 0, n = 0;
        for (let i = 3; i < d.length; i += 4) if (d[i] > 160) { const p = (i - 3) / 4; sx += p % c.width; sy += Math.floor(p / c.width); n++; }
        return n ? { x: (sx / n / c.width) * 100, y: (sy / n / c.height) * 100 } : { x: 50, y: 50 };
      }
      build(section, centres) {
        const { gsap } = window;
        const mid = { x: centres.reduce((a, c) => a + c.x, 0) / centres.length, y: centres.reduce((a, c) => a + c.y, 0) / centres.length };
        const box = () => this.getBoundingClientRect();
        this.phone = innerWidth < 750;
        // the "How it works" picture that travels into this section (optional)
        this.source = document.querySelector('.somna-pdp-story--how .somna-pdp-story__product img');
        // only when "How it works" sits right before this section (Nasal Strips / Mouth Tape). If another story
        // section is in between (Color Set: steps come first), the layers simply appear stacked and peel apart.
        const howSection = this.source?.closest('.shopify-section');
        const ownSection = section.closest('.shopify-section');
        if (howSection && ownSection) {
          for (let el = howSection.nextElementSibling; el && el !== ownSection; el = el.nextElementSibling) {
            if (el.querySelector('.somna-pdp-story')) { this.source = null; break; }
          }
        }
        // the traveller lives in <main> (or the body), positioned relative to it, so it scrolls with the page
        const host = section.closest('main') || document.body;
        if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
        const doc = (r) => { const h = host.getBoundingClientRect(); return { x: r.left - h.left, y: r.top - h.top, w: r.width, h: r.height }; };
        // layout position of an element relative to the host, ignoring transforms (the "How it works"
        // product may be mid hop-flip or floating when this is measured)
        const layout = (el) => {
          let x = 0, y = 0, e = el;
          while (e && e !== host) { x += e.offsetLeft; y += e.offsetTop; e = e.offsetParent; }
          if (e !== host) return doc(el.getBoundingClientRect());
          return { x, y, w: el.offsetWidth, h: el.offsetHeight };
        };
        if (this.source) {
          this.traveller = document.createElement('div');
          this.traveller.className = 'somna-pdp-layers-traveller';
          this.traveller.setAttribute('aria-hidden', 'true');
          const img = this.source.cloneNode();
          img.removeAttribute('loading');
          img.alt = '';
          this.traveller.appendChild(img);
          host.appendChild(this.traveller);
        }
        const last = this.layers.length - 1;
        const off = (i) => ({ x: ((mid.x - centres[i].x) / 100) * box().width, y: ((mid.y - centres[i].y) / 100) * box().height });
        gsap.set(this.layers, { opacity: 0, scale: 0.96, x: (i) => off(i).x, y: (i) => off(i).y });
        gsap.set(this.items, { opacity: 0, y: 16 });
        const tl = gsap.timeline({ defaults: { ease: 'none' } });
        let T = 0;
        if (this.traveller) {
          const start = () => layout(this.source);
          const endW = () => box().width * 0.8;
          const end = () => { const b = doc(box()); return { x: b.x + (b.w * mid.x) / 100 - endW() / 2, y: b.y + (b.h * mid.y) / 100 - endW() / 2 }; };
          // fromTo with function values: start and end are re-measured on every refresh (invalidateOnRefresh),
          // so the copy always matches the real picture's spot and size, even if it loaded after this ran
          tl.fromTo(this.traveller,
            { x: () => start().x, y: () => start().y, width: () => start().w, rotationY: 0, rotationZ: 0 },
            { x: () => end().x, y: () => end().y, width: endW, rotationY: 360, rotationZ: 100, duration: 0.45, ease: 'sine.inOut', immediateRender: true },
            0);
          T = 0.44;
          // Hand-off between the real picture and its travelling copy, decided from the timeline's own time
          // (no zero-time .set(), which GSAP leaves applied at progress 0). At time 0 — before the
          // transition and after scrolling back up — the real picture is always the visible one.
          const handoff = () => {
            const t = tl.time();
            const travelling = t > 0.001;
            // a fast scroll can start this while the How-it-works hop is still running: jump it to its end
            // so the copy (measured at the strip's resting spot) takes over without a sideways jump
            if (travelling && !this.wasTravelling) this.source.closest('somna-pdp-how')?.finishNow?.();
            this.wasTravelling = travelling;
            this.source.style.opacity = travelling ? '0' : '';
            this.traveller.style.opacity = travelling ? String(Math.max(0, Math.min(1, (T + 0.08 - t) / 0.08))) : '0';
          };
          tl.eventCallback('onUpdate', handoff);
          this.handoff = handoff;
        }
        // stacked layers appear, then peel apart one after another (overlapping, soft ease-in-out):
        // first up-left, middle ones settle, last down-right
        tl.to(this.layers, { opacity: 1, duration: 0.12, ease: 'sine.out' }, T);
        const t3 = T + 0.06;
        const s = () => box().width / 100;
        const peel = 0.9, step = 0.45;
        this.layers.forEach((l, i) => {
          const at = t3 + i * step;
          if (i === 0 || i === last) {
            const dir = i === 0 ? -1 : 1;
            tl.to(l, { keyframes: [
              { x: () => dir * 14 * s(), y: () => dir * 6 * s(), rotation: dir * 8, scale: 1.02, duration: peel * 0.6, ease: 'sine.inOut' },
              { x: 0, y: 0, rotation: 0, scale: 1, duration: peel * 0.6, ease: 'sine.inOut' },
            ] }, at);
          } else {
            tl.to(l, { x: 0, y: 0, scale: 1, duration: peel, ease: 'sine.inOut' }, at);
          }
        });
        const t4 = t3 + last * step + peel * 0.8;
        this.items.forEach((it, i) => tl.to(it, { opacity: 1, y: 0, duration: 0.5, ease: 'sine.out' }, t4 + i * 0.3));
        this.tl = tl;
        // Approved demo E: plays by itself (~3.2s) once the section is a third of the way up the screen,
        // and rewinds (twice as fast) when the visitor scrolls back above it.
        tl.pause(0);
        tl.timeScale(tl.duration() / 3.2);
        const speed = tl.timeScale();
        // Started by an IntersectionObserver, not ScrollTrigger: the page scrolls smoothly (scroll-behavior: smooth),
        // and ScrollTrigger's re-measuring while lazy images load mid-scroll (phones) left it with wrong start
        // positions, so the strip could leave "How it works" before the layers were even on screen.
        // Desktop: plays when the section top passes 66% of the screen; phones (sections stack): when it passes 60%,
        // so the How-it-works strip is still on screen above and the layers picture is coming in below.
        const line = this.phone ? 40 : 34;
        this.io = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) {
            if (tl.progress() === 0) tl.invalidate(); // re-measure the strip's spot and the landing spot
            tl.timeScale(speed).play();
          } else if (e.boundingClientRect.top > 0 && tl.progress() > 0) {
            tl.timeScale(speed * 2).reverse(); // scrolled back up above it
          } else if (e.boundingClientRect.top <= 0 && tl.progress() === 0) {
            tl.progress(1); // page opened (or jumped) further down: show the finished state
          }
        }, { rootMargin: `0px 0px -${line}% 0px` });
        this.io.observe(section);
        this.handoff?.();
      }
    });
  }
</script>
{%- endif -%}

{%- if s.layout == 'how' and s.how_animation and c != blank -%}
<script type="module">
  /* "How it works" — I3 long hop + side flip (approved demo). Plays once when the section comes on
     screen (no scroll scrubbing, no pin), resets when the section is scrolled back below the fold.
     Product hops from just right of the text (or the left column on tablet), flips left -> right
     around its vertical axis, lands in the Figma spot and floats; then icon 1 -> 4 (TL, TR, BR, BL),
     each followed by its heading and text. Web Animations API only — no library. */
  if (!customElements.get('somna-pdp-how')) {
    customElements.define('somna-pdp-how', class extends HTMLElement {
      connectedCallback() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.product = this.querySelector('.somna-pdp-story__product');
        if (!this.product) return;
        const order = (this.dataset.order || '1,2,3,4').split(',');
        this.points = order.map((n) => this.querySelector('.somna-pdp-story__point--' + n.trim())).filter(Boolean);
        this.anims = [];
        this.classList.add('is-pending');
        // play when the visual is a third of the way up the screen…
        this.io = new IntersectionObserver(([e]) => e.isIntersecting && this.play(), { rootMargin: '0px 0px -30% 0px' });
        // …and reset only once it is completely below the screen, so nothing vanishes while visible
        this.out = new IntersectionObserver(([e]) => !e.isIntersecting && e.boundingClientRect.top > 0 && this.reset());
        this.io.observe(this);
        this.out.observe(this);
      }
      disconnectedCallback() {
        this.io?.disconnect();
        this.out?.disconnect();
        this.anims?.forEach((a) => a.cancel());
      }
      startX() {
        const p = this.product.getBoundingClientRect();
        const copy = this.closest('.somna-pdp-story__inner')?.querySelector('.somna-pdp-story__copy')?.getBoundingClientRect();
        const centre = p.left + p.width / 2;
        if (copy && copy.right < p.left) return copy.right + 30 + p.width / 2 - centre; // desktop: from just after the text
        const v = this.getBoundingClientRect();
        return v.left + v.width * 0.17 - centre; // tablet: from the left column
      }
      finishNow() {
        if (!this.played) return;
        this.anims.forEach((a) => { try { a.finish(); } catch (e) {} });
      }
      reset() {
        if (!this.played) return;
        this.anims.forEach((a) => a.cancel());
        this.anims = [];
        this.played = false;
        this.classList.remove('is-done');
        this.classList.add('is-pending');
      }
      play() {
        if (this.played) return;
        this.played = true;
        const x = this.startX();
        const add = (el, kf, opt) => { const a = el.animate(kf, { fill: 'both', ...opt }); this.anims.push(a); return a; };
        this.classList.remove('is-pending');
        const pairImgs = this.classList.contains('somna-pdp-story__visual--pair') ? [...this.product.querySelectorAll('img')] : [];
        if (pairImgs.length > 1) {
          // Season Bundle (approved demo A, "Split hop"): the tape hop-flips in from the text side, the strip from the
          // right 0.2s later; each lands with a small squash. Uses transform for the hop and scale for the squash,
          // so the float (translate) can run on top once both have landed.
          const v = this.getBoundingClientRect();
          pairImgs.forEach((im, i) => {
            const r = im.getBoundingClientRect();
            const centre = r.left + r.width / 2;
            const copy = this.closest('.somna-pdp-story__inner')?.querySelector('.somna-pdp-story__copy')?.getBoundingClientRect();
            // tape: from just after the text (or 220px to the left); strip: from beyond the right edge of the visual
            const dx = i === 0
              ? Math.min(-140, copy && copy.right < r.left ? copy.right + 40 - r.left : -220)
              : Math.max(160, v.right + 40 - centre);
            const delay = i * 200;
            add(im, [
              { transform: `translate3d(${dx}px, 0, 0) rotateY(0deg)`, opacity: 0, offset: 0 },
              { opacity: 1, offset: 0.12 },
              { transform: `translate3d(${dx * 0.45}px, -90px, 0) rotateY(180deg)`, offset: 0.5 },
              { transform: 'translate3d(0, 0, 0) rotateY(360deg)', opacity: 1, offset: 1 },
            ], { duration: 1100, delay, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' });
            const squash = add(im, [{ scale: '1 1' }, { scale: '1.05 0.94' }, { scale: '0.99 1.02' }, { scale: '1 1' }], { duration: 380, delay: delay + 1060, easing: 'ease-out', fill: 'none' });
            if (i === pairImgs.length - 1) squash.finished.then(() => this.played && this.classList.add('is-done')).catch(() => {});
          });
          this.points.forEach((pt, i) => {
            const at = 1450 + i * 220;
            const icon = pt.querySelector('.somna-pdp-story__point-icon');
            if (icon) add(icon, [{ opacity: 0, transform: 'scale(0.5)' }, { opacity: 1, transform: 'scale(1.08)', offset: 0.7 }, { opacity: 1, transform: 'scale(1)' }], { duration: 350, delay: at, easing: 'ease-out' });
            pt.querySelectorAll('h3, p').forEach((t, j) => add(t, [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 350, delay: at + 150 + j * 70, easing: 'ease-out' }));
          });
          return;
        }
        add(this.product, [
          { transform: `translate3d(${x}px, 0, 0) rotateY(0deg)`, opacity: 0, offset: 0 },
          { opacity: 1, offset: 0.12 },
          { transform: `translate3d(${x * 0.45}px, -110px, 0) rotateY(180deg)`, offset: 0.5 },
          { transform: 'translate3d(0, 0, 0) rotateY(360deg)', opacity: 1, offset: 1 },
        ], { duration: 1300, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' });
        const img = this.product.querySelector('img');
        if (img) add(img, [
          { transform: 'scale(1, 1)' }, { transform: 'scale(1.05, 0.94)' }, { transform: 'scale(0.99, 1.02)' }, { transform: 'scale(1, 1)' },
        ], { duration: 400, delay: 1250, easing: 'ease-out', fill: 'none' }).finished.then(() => this.played && this.classList.add('is-done')).catch(() => {});
        this.points.forEach((pt, i) => {
          const at = 1550 + i * 300;
          const icon = pt.querySelector('.somna-pdp-story__point-icon');
          if (icon) add(icon, [{ opacity: 0, transform: 'scale(0.5)' }, { opacity: 1, transform: 'scale(1.08)', offset: 0.7 }, { opacity: 1, transform: 'scale(1)' }], { duration: 350, delay: at, easing: 'ease-out' });
          pt.querySelectorAll('h3, p').forEach((t, j) => add(t, [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 350, delay: at + 150 + j * 70, easing: 'ease-out' }));
        });
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-pdp-story {
    background: var(--somna-story-bg);
    color: var(--somna-story-fg);
  }

  .somna-pdp-story__inner {
    --somna-content-width: 1250px;
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .somna-pdp-story__eyebrow {
    margin: 0 0 6px;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading {
    margin: 0;
    color: var(--somna-story-heading);
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.85vw, 3.4375rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading span {
    display: block;
  }

  .somna-pdp-story__heading .is-accent {
    color: var(--somna-story-accent);
  }

  .somna-pdp-story__text {
    max-width: 480px;
    margin: 14px 0 0;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .somna-pdp-story__label {
    margin: 40px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .somna-pdp-story__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .somna-pdp-story__pills li {
    padding: 8px 16px;
    border: 2px solid #000;
    border-radius: 999px;
    background: var(--somna-story-card);
    color: #000;
    box-shadow: 2px 3px 0 #000;
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    line-height: 1.4;
    rotate: -2deg;
  }

  .somna-pdp-story__pills li:nth-child(even) {
    rotate: 1.5deg;
  }

  /* problem */
  .somna-pdp-story__tag {
    margin: 0 0 12px;
    color: var(--somna-story-fg);
    font-family: var(--font-accent--family);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  .somna-pdp-story__frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.15);
  }

  .somna-pdp-story__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* problem -> solution: the two pictures cross-fade in a loop with a slow zoom (7s) */
  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }

  @keyframes somnaStoryBefore {
    0%, 42% { opacity: 1; transform: scale(1.06); }
    50%, 92% { opacity: 0; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.06); }
  }

  @keyframes somnaStoryAfter {
    0%, 42% { opacity: 0; transform: scale(1.04); }
    50%, 92% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.04); }
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__before {
    animation: somnaStoryBefore 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    animation: somnaStoryAfter 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__bullets,
  .somna-pdp-story__tag.has-after .somna-pdp-story__tag-before {
    animation: somnaStoryFade 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__bullets--after,
  .somna-pdp-story__tag-after {
    animation: somnaStoryFadeIn 7s ease-in-out infinite;
  }

  /* Snoring (problem image): sized in container units so it scales with the picture on every screen */
  :is(.somna-pdp-story__frame, .somna-pdp-story__panel):has(.somna-snore) {
    container-type: inline-size;
  }

  .somna-snore {
    position: absolute;
    z-index: 1;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .somna-pdp-story__frame.has-after .somna-snore {
    animation: somnaSnoreShow 7s ease-in-out infinite;
  }

  .somna-snore__waves {
    position: absolute;
    left: 0.5cqw;
    top: -4cqw;
    width: max(6.1cqw, 26px);
    max-width: none;
    height: auto;
    overflow: visible;
  }

  .somna-snore__waves path {
    fill: none;
    stroke: #f3feee;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0;
    transform-origin: 0 100%;
    animation: somnaSnoreWave 2.4s ease-out infinite;
  }

  .somna-snore__waves path:nth-child(2) {
    animation-delay: 0.2s;
  }

  .somna-snore__waves path:nth-child(3) {
    animation-delay: 0.4s;
  }

  .somna-snore__z {
    position: absolute;
    left: 3.5cqw;
    top: -4.5cqw;
    font-family: var(--font-accent--family);
    font-size: max(2.1cqw, 10px);
    line-height: 1;
    color: #f3feee;
    opacity: 0;
    animation: somnaSnoreZ 3.6s ease-in-out infinite;
  }

  .somna-snore__z:nth-of-type(2) {
    font-size: max(2.9cqw, 13px);
    animation-delay: 1.2s;
  }

  .somna-snore__z:nth-of-type(3) {
    font-size: max(3.7cqw, 16px);
    animation-delay: 2.4s;
  }

  @keyframes somnaSnoreWave {
    0% { opacity: 0; transform: scale(0.7); }
    25% { opacity: 1; }
    60% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.15); }
  }

  @keyframes somnaSnoreZ {
    0% { opacity: 0; translate: 0 0; rotate: -10deg; }
    20% { opacity: 1; }
    100% { opacity: 0; translate: 9.3cqw -12cqw; rotate: 12deg; }
  }

  /* visible with the open-mouth picture only, gone a little before the taped picture fades in */
  @keyframes somnaSnoreShow {
    0%, 38% { opacity: 1; }
    44%, 96% { opacity: 0; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-snore {
      display: none;
    }
  }

  @keyframes somnaStoryFade {
    0%, 42% { opacity: 1; }
    50%, 92% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes somnaStoryFadeIn {
    0%, 42% { opacity: 0; }
    50%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .somna-pdp-story__tag.has-after {
    display: grid;
    justify-items: end;
  }

  .somna-pdp-story__tag.has-after > span {
    grid-area: 1 / 1;
  }

  .somna-pdp-story__tag-after {
    text-transform: none;
  }

  .somna-pdp-story__bullets--after svg {
    padding: 3px;
    border-radius: 3px;
    background: #4caf3e;
    color: #fff;
    stroke-width: 3.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-pdp-story__frame.has-after :is(.somna-pdp-story__before, .somna-pdp-story__bullets),
    .somna-pdp-story__tag.has-after .somna-pdp-story__tag-before {
      animation: none;
    }

    .somna-pdp-story__frame.has-after :is(.somna-pdp-story__after, .somna-pdp-story__bullets--after),
    .somna-pdp-story__tag-after {
      display: none;
    }
  }

  .somna-pdp-story__bullets {
    z-index: 1;
    position: absolute;
    left: 20px;
    bottom: 22px;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #fff;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .somna-pdp-story__bullets li {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .somna-pdp-story__bullets svg {
    width: 20px;
    height: 20px;
    color: #e3262f;
    stroke-width: 3.2;
  }

  /* how it works: product photo with four features around it */
  .somna-pdp-story__visual {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.2fr) 1fr;
    grid-template-rows: auto auto;
    gap: 24px 16px;
    align-items: start;
    justify-items: center;
  }

  .somna-pdp-story__visual .somna-pdp-story__product {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .somna-pdp-story__point {
    display: grid;
    justify-items: center;
    max-width: 170px;
    text-align: center;
  }

  .somna-pdp-story__point--1 { grid-area: 1 / 1; }
  .somna-pdp-story__point--2 { grid-area: 1 / 3; }
  .somna-pdp-story__point--3 { grid-area: 2 / 1; align-self: end; }
  .somna-pdp-story__point--4 { grid-area: 2 / 3; align-self: end; }

  /* how it works with two products (Season Bundle, Figma 4654:113): tape + strip side by side,
     the first two features above either side and the third centred underneath */
  /* Figma: the tape and the strip stand close together (about 10px apart) at ~360px tall.
     Both images carry transparent margins (tape: 26% left / 25% right of a square; strip: 28% left / 15% right
     of a 2:3 picture), so the sizes and the overlap below are worked out from --pair-h, the visible height. */
  .somna-pdp-story__visual--pair .somna-pdp-story__product {
    --pair-h: clamp(170px, 25vw, 360px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .somna-pdp-story__visual--pair .somna-pdp-story__product img {
    flex: none;
    width: auto;
    max-width: none;
    height: calc(var(--pair-h) / 0.893);
    margin-left: calc(var(--pair-h) * -0.176); /* centres the visible pair, not the padded boxes */
    object-fit: contain;
  }

  .somna-pdp-story__visual--pair .somna-pdp-story__product img.somna-pdp-story__product-after {
    height: calc(var(--pair-h) * 1.5 / 1.281);
    margin-top: calc(var(--pair-h) * -0.05);
    margin-left: calc(var(--pair-h) * -0.471);
  }

  .somna-pdp-story__visual--pair .somna-pdp-story__point--3 {
    grid-area: 3 / 2;
    align-self: start;
  }

  .somna-pdp-story__visual--pair .somna-pdp-story__point h3 {
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) {
    /* the two products fill the visual; the first two features sit above either side, the third underneath */
    .somna-pdp-story--how .somna-pdp-story__visual.somna-pdp-story__visual--pair {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      min-height: 0;
    }

    .somna-pdp-story__visual--pair .somna-pdp-story__point {
      position: relative;
      z-index: 1;
    }

    .somna-pdp-story__visual--pair .somna-pdp-story__point--1 { grid-area: 1 / 1; justify-self: start; }
    .somna-pdp-story__visual--pair .somna-pdp-story__point--2 { grid-area: 1 / 3; justify-self: end; }

    .somna-pdp-story__visual--pair :is(.somna-pdp-story__point--1, .somna-pdp-story__point--2) {
      max-width: 130px;
    }

    .somna-pdp-story--how .somna-pdp-story__visual--pair .somna-pdp-story__product {
      grid-column: 1 / -1;
      grid-row: 1 / span 2;
      width: 100%;
      overflow: visible;
    }
  }

  /* small laptops: the visual is narrower, so the pair shrinks to stay clear of the labels */
  @media screen and (min-width: 990px) and (max-width: 1199px) {
    .somna-pdp-story__visual--pair .somna-pdp-story__product {
      --pair-h: 19vw;
    }
  }

  .somna-pdp-story__point-icon {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--somna-story-card-fg);
