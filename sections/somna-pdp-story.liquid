{%- comment -%}
  Somna V2 — product page story sections (Figma 4557:857 / 4557:44): "Sound familiar?" (problem),
  "How it works", "What it's made of" (layers) and "Three steps". One section, four layouts.
  Content comes from the product's PDP section metaobject (custom.pdp_problem / pdp_how /
  pdp_layers / pdp_steps): eyebrow, two-line heading, text, label, image, pills, button and a list of
  PDP features (icon + title + text + optional photo), plus an optional second (solution) image. The section hides itself when the product has
  no content for the chosen layout.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign key = 'pdp_' | append: s.layout
  assign c = product.metafields.custom[key].value
-%}
{%- if c != blank -%}
{%- liquid
  assign features = c.features.value
  assign image = c.image.value
  assign accent_first = false
  if s.accent_line == 'first'
    assign accent_first = true
  endif
-%}
<div
  class="somna-pdp-story somna-pdp-story--{{ s.layout }}"
  style="--somna-story-bg: {{ s.background_color }}; --somna-story-fg: {{ s.text_color }}; --somna-story-heading: {{ s.heading_color }}; --somna-story-accent: {{ s.accent_color }}; --somna-story-card: {{ s.card_color }}; --somna-story-card-fg: {{ s.card_text_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-pdp-story__inner somna-container">
    <div class="somna-pdp-story__copy">
      {%- if c.eyebrow != blank -%}<p class="somna-pdp-story__eyebrow">{{ c.eyebrow.value }}</p>{%- endif -%}
      <h2 class="somna-pdp-story__heading">
        <span{% if accent_first %} class="is-accent"{% endif %}>{{ c.heading.value }}</span>
        {%- if c.heading_accent != blank %} <span{% unless accent_first %} class="is-accent"{% endunless %}>{{ c.heading_accent.value }}</span>{% endif -%}
      </h2>
      {%- if c.text != blank -%}<p class="somna-pdp-story__text">{{ c.text.value | newline_to_br }}</p>{%- endif -%}

      {%- if s.layout == 'how' and c.label != blank -%}<p class="somna-pdp-story__label">{{ c.label.value }}</p>{%- endif -%}

      {%- assign pills = c.pills.value -%}
      {%- if pills != blank -%}
        <ul class="somna-pdp-story__pills" role="list">
          {%- for p in pills -%}<li{% if s.pills_motion != 'none' %} class="somna-shake--{{ s.pills_motion }}" style="--somna-shake-delay: {{ forloop.index0 | times: 0.3 }}s;"{% endif %}>{{ p }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- case s.layout -%}
      {%- when 'problem' -%}
        <div class="somna-pdp-story__media">
          {%- assign image_after = c.image_after.value -%}
          {%- if c.label != blank -%}
            <p class="somna-pdp-story__tag{% if image and image_after %} has-after{% endif %}">
              <span class="somna-pdp-story__tag-before">{{ c.label.value }}</span>
              {%- if image and image_after and c.label_after != blank -%}<span class="somna-pdp-story__tag-after" aria-hidden="true">{{ c.label_after.value }}</span>{%- endif -%}
            </p>
          {%- endif -%}
          <div class="somna-pdp-story__frame{% if image and image_after %} has-after{% endif %}">
            {%- if image -%}{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__before' }}{%- endif -%}
            {%- if image and image_after -%}{{ image_after | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__after' }}{%- endif -%}
            {%- if features != blank -%}
              <ul class="somna-pdp-story__bullets" role="list">
                {%- for f in features -%}
                  <li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- assign features_after = c.features_after.value -%}
            {%- if image and image_after and features_after != blank -%}
              <ul class="somna-pdp-story__bullets somna-pdp-story__bullets--after" role="list">
                {%- for f in features_after -%}
                  <li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>

      {%- when 'how' -%}
        {%- if s.how_animation -%}<somna-pdp-how class="somna-pdp-story__visual" data-order="1,2,4,3">{%- else -%}<div class="somna-pdp-story__visual">{%- endif -%}
          {%- if image -%}<div class="somna-pdp-story__product">{{ image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 335px, 50vw' }}</div>{%- endif -%}
          {%- for f in features limit: 4 -%}
            <div class="somna-pdp-story__point somna-pdp-story__point--{{ forloop.index }}">
              <span class="somna-pdp-story__point-icon">{% render 'somna-pdp-icon', name: f.icon.value %}</span>
              <h3>{{ f.title.value }}</h3>
              {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- if s.how_animation -%}</somna-pdp-how>{%- else -%}</div>{%- endif -%}

      {%- when 'layers' -%}
        {%- liquid
          assign layer_images = true
          if features == blank or features.size < 2
            assign layer_images = false
          endif
          for f in features
            if f.image == blank
              assign layer_images = false
            endif
          endfor
        -%}
        {%- if layer_images -%}
          {%- comment -%} each layer is its own full-size transparent image; stacked they make the Figma picture {%- endcomment -%}
          {%- for f in features limit: 1 -%}{%- assign first_layer = f.image.value -%}{%- endfor -%}
          {%- if s.layers_animation -%}<somna-pdp-layers class="somna-pdp-story__product somna-pdp-story__stack" style="aspect-ratio: {{ first_layer.width }} / {{ first_layer.height }};">{%- else -%}<div class="somna-pdp-story__product somna-pdp-story__stack" style="aspect-ratio: {{ first_layer.width }} / {{ first_layer.height }};">{%- endif -%}
            {%- for f in features -%}
              {%- assign li = f.image.value -%}
              {%- assign probe = li | image_url: width: 120 -%}
              {{ li | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 483px, 60vw', class: 'somna-pdp-story__layer', alt: f.title.value, data-probe: probe }}
            {%- endfor -%}
          {%- if s.layers_animation -%}</somna-pdp-layers>{%- else -%}</div>{%- endif -%}
        {%- elsif image -%}<div class="somna-pdp-story__product">{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 483px, 60vw' }}</div>{%- endif -%}
        {%- if features != blank -%}
          <ol class="somna-pdp-story__layers">
            {%- for f in features -%}
              <li><h3>{{ f.title.value }}</h3>{%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}</li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

      {%- when 'steps' -%}
        <div class="somna-pdp-story__steps">
          <ol class="somna-pdp-story__step-list" role="list">
            {%- for f in features -%}
              {%- assign photo = f.image.value -%}
              {%- assign crop = f.image_crop.value | downcase | default: 'center' -%}
              <li class="somna-pdp-story__step">
                {%- if photo -%}{{ photo | image_url: width: 506, height: 308, crop: crop | image_tag: loading: 'lazy', alt: photo.alt, width: 253, height: 154 }}{%- endif -%}
                <div>
                  <h3><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ f.title.value }}</h3>
                  {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
          {%- if c.button_label != blank and c.button_url != blank -%}
            <a class="somna-pdp-story__button" href="{{ c.button_url.value | replace: 'https://usesomna.com', '' }}">
              <span class="somna-pdp-story__button-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>{{ c.button_label.value }}
            </a>
          {%- endif -%}
        </div>
    {%- endcase -%}
  </div>
</div>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}
{%- endif -%}

{%- if s.layout == 'layers' and s.layers_animation and c != blank -%}
<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script src="{{ 'gsap-scroll-trigger.min.js' | asset_url }}" defer></script>
<script type="module">
  /* "How it works" -> "What it's made of" (approved demo N · Peel apart, Slow).
     Scroll-linked (scrub 1.2, ~630px on desktop, no pin): the "How it works" product leaves its spot,
     flips and travels down-right into this section, turns into the stacked layers, the layers peel
     apart one after another (first up-left, last down-right), then the descriptions appear 1 -> n.
     Reverses on scroll up. Desktop + tablet only (mobile design pending); off for reduced motion.
     Layer offsets are measured from the layer images themselves, so it works for 3 or 4 layers. */
  if (!customElements.get('somna-pdp-layers')) {
    customElements.define('somna-pdp-layers', class extends HTMLElement {
      async connectedCallback() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || innerWidth < 750) return;
        this.layers = [...this.querySelectorAll('.somna-pdp-story__layer')];
        const section = this.closest('.somna-pdp-story');
        this.items = section ? [...section.querySelectorAll('.somna-pdp-story__layers li')] : [];
        if (this.layers.length < 2 || !(await this.ready())) return;
        let centres;
        try { centres = await Promise.all(this.layers.map((img) => this.centre(img.dataset.probe))); } catch (e) { return; }
        if (!this.isConnected) return;
        this.build(section, centres);
      }
      disconnectedCallback() {
        this.ro?.disconnect();
        this.st?.kill();
        this.tl?.kill();
        this.traveller?.remove();
        if (this.source) this.source.style.opacity = '';
      }
      ready() {
        return new Promise((resolve) => {
          let n = 0;
          const check = () => (window.gsap && window.ScrollTrigger ? resolve(true) : ++n > 100 ? resolve(false) : setTimeout(check, 50));
          check();
        });
      }
      /* centre of the visible part of one layer image, in % of the image box */
      async centre(src) {
        const im = new Image();
        im.crossOrigin = 'anonymous';
        im.src = src;
        await im.decode();
        const c = document.createElement('canvas');
        c.width = im.naturalWidth;
        c.height = im.naturalHeight;
        const x = c.getContext('2d', { willReadFrequently: true });
        x.drawImage(im, 0, 0);
        const d = x.getImageData(0, 0, c.width, c.height).data;
        let sx = 0, sy = 0, n = 0;
        for (let i = 3; i < d.length; i += 4) if (d[i] > 160) { const p = (i - 3) / 4; sx += p % c.width; sy += Math.floor(p / c.width); n++; }
        return n ? { x: (sx / n / c.width) * 100, y: (sy / n / c.height) * 100 } : { x: 50, y: 50 };
      }
      build(section, centres) {
        const { gsap, ScrollTrigger } = window;
        gsap.registerPlugin(ScrollTrigger);
        const mid = { x: centres.reduce((a, c) => a + c.x, 0) / centres.length, y: centres.reduce((a, c) => a + c.y, 0) / centres.length };
        const box = () => this.getBoundingClientRect();
        // the "How it works" picture that travels into this section (optional)
        this.source = document.querySelector('.somna-pdp-story--how .somna-pdp-story__product img');
        // the page may scroll inside .page-wrapper instead of the window
        const pw = document.querySelector('.page-wrapper');
        this.scroller = pw && /(auto|scroll)/.test(getComputedStyle(pw).overflowY) && pw.scrollHeight > pw.clientHeight ? pw : window;
        // the traveller lives in <main> (or the body), positioned relative to it, so it scrolls with the page
        const host = section.closest('main') || document.body;
        if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
        const doc = (r) => { const h = host.getBoundingClientRect(); return { x: r.left - h.left, y: r.top - h.top, w: r.width, h: r.height }; };
        // layout position of an element relative to the host, ignoring transforms (the "How it works"
        // product may be mid hop-flip or floating when this is measured)
        const layout = (el) => {
          let x = 0, y = 0, e = el;
          while (e && e !== host) { x += e.offsetLeft; y += e.offsetTop; e = e.offsetParent; }
          if (e !== host) return doc(el.getBoundingClientRect());
          return { x, y, w: el.offsetWidth, h: el.offsetHeight };
        };
        if (this.source) {
          this.traveller = document.createElement('div');
          this.traveller.className = 'somna-pdp-layers-traveller';
          this.traveller.setAttribute('aria-hidden', 'true');
          const img = this.source.cloneNode();
          img.removeAttribute('loading');
          img.alt = '';
          this.traveller.appendChild(img);
          host.appendChild(this.traveller);
        }
        const last = this.layers.length - 1;
        const off = (i) => ({ x: ((mid.x - centres[i].x) / 100) * box().width, y: ((mid.y - centres[i].y) / 100) * box().height });
        gsap.set(this.layers, { opacity: 0, scale: 0.96, x: (i) => off(i).x, y: (i) => off(i).y });
        gsap.set(this.items, { opacity: 0, y: 16 });
        const tl = gsap.timeline({ defaults: { ease: 'none' } });
        let T = 0;
        if (this.traveller) {
          const start = () => layout(this.source);
          const endW = () => box().width * 0.8;
          const end = () => { const b = doc(box()); return { x: b.x + (b.w * mid.x) / 100 - endW() / 2, y: b.y + (b.h * mid.y) / 100 - endW() / 2 }; };
          // fromTo with function values: start and end are re-measured on every refresh (invalidateOnRefresh),
          // so the copy always matches the real picture's spot and size, even if it loaded after this ran
          tl.fromTo(this.traveller,
            { x: () => start().x, y: () => start().y, width: () => start().w, rotationY: 0, rotationZ: 0 },
            { x: () => end().x, y: () => end().y, width: endW, rotationY: 360, rotationZ: 100, duration: 0.45, ease: 'power2.inOut', immediateRender: true },
            0);
          T = 0.44;
          // Hand-off between the real picture and its travelling copy, decided from the timeline's own time
          // (no zero-time .set(), which GSAP leaves applied at progress 0). At time 0 — before the
          // transition and after scrolling back up — the real picture is always the visible one.
          const handoff = () => {
            const t = tl.time();
            const travelling = t > 0.001;
            // a fast scroll can start this while the How-it-works hop is still running: jump it to its end
            // so the copy (measured at the strip's resting spot) takes over without a sideways jump
            if (travelling && !this.wasTravelling) this.source.closest('somna-pdp-how')?.finishNow?.();
            this.wasTravelling = travelling;
            this.source.style.opacity = travelling ? '0' : '';
            this.traveller.style.opacity = travelling ? String(Math.max(0, Math.min(1, (T + 0.08 - t) / 0.08))) : '0';
          };
          tl.eventCallback('onUpdate', handoff);
          this.handoff = handoff;
        }
        // stacked layers appear, then peel apart: first up-left, middle ones settle, last down-right
        tl.to(this.layers, { opacity: 1, duration: 0.07 }, T);
        const t3 = T + 0.08;
        const s = () => box().width / 100;
        this.layers.forEach((l, i) => {
          const at = t3 + i * (0.16 / Math.max(1, last));
          if (i === 0 || i === last) {
            const dir = i === 0 ? -1 : 1;
            tl.to(l, { keyframes: [
              { x: () => dir * 14 * s(), y: () => dir * 6 * s(), rotation: dir * 8, scale: 1.02, duration: 0.1, ease: 'sine.out' },
              { x: 0, y: 0, rotation: 0, scale: 1, duration: 0.1, ease: 'sine.inOut' },
            ] }, at);
          } else {
            tl.to(l, { x: 0, y: 0, scale: 1, duration: 0.16, ease: 'power2.out' }, at);
          }
        });
        const t4 = t3 + 0.32;
        this.items.forEach((it, i) => tl.to(it, { opacity: 1, y: 0, duration: 0.1, ease: 'power2.out' }, t4 + i * 0.1));
        this.tl = tl;
        this.st = ScrollTrigger.create({
          animation: tl, trigger: section, scroller: this.scroller,
          start: 'top 80%', endTrigger: this, end: 'center 45%',
          scrub: 0.6, invalidateOnRefresh: true,
          onRefresh: () => this.handoff?.(),
        });
        this.handoff?.();
        // keep trigger positions right when content above changes height (lazy images, reviews app)
        let timer;
        this.ro = new ResizeObserver(() => { clearTimeout(timer); timer = setTimeout(() => ScrollTrigger.refresh(), 200); });
        this.ro.observe(host);
        // and when the How-it-works picture itself changes size (layout settles, fonts, breakpoints)
        if (this.source) this.ro.observe(this.source);
        // the How-it-works picture is lazy-loaded: measure again once it has its real size
        if (this.source && !(this.source.complete && this.source.naturalWidth)) {
          this.source.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
        }
      }
    });
  }
</script>
{%- endif -%}

{%- if s.layout == 'how' and s.how_animation and c != blank -%}
<script type="module">
  /* "How it works" — I3 long hop + side flip (approved demo). Plays once when the section comes on
     screen (no scroll scrubbing, no pin), resets when the section is scrolled back below the fold.
     Product hops from just right of the text (or the left column on tablet), flips left -> right
     around its vertical axis, lands in the Figma spot and floats; then icon 1 -> 4 (TL, TR, BR, BL),
     each followed by its heading and text. Web Animations API only — no library. */
  if (!customElements.get('somna-pdp-how')) {
    customElements.define('somna-pdp-how', class extends HTMLElement {
      connectedCallback() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.product = this.querySelector('.somna-pdp-story__product');
        if (!this.product) return;
        const order = (this.dataset.order || '1,2,3,4').split(',');
        this.points = order.map((n) => this.querySelector('.somna-pdp-story__point--' + n.trim())).filter(Boolean);
        this.anims = [];
        this.classList.add('is-pending');
        // play when the visual is a third of the way up the screen…
        this.io = new IntersectionObserver(([e]) => e.isIntersecting && this.play(), { rootMargin: '0px 0px -30% 0px' });
        // …and reset only once it is completely below the screen, so nothing vanishes while visible
        this.out = new IntersectionObserver(([e]) => !e.isIntersecting && e.boundingClientRect.top > 0 && this.reset());
        this.io.observe(this);
        this.out.observe(this);
      }
      disconnectedCallback() {
        this.io?.disconnect();
        this.out?.disconnect();
        this.anims?.forEach((a) => a.cancel());
      }
      startX() {
        const p = this.product.getBoundingClientRect();
        const copy = this.closest('.somna-pdp-story__inner')?.querySelector('.somna-pdp-story__copy')?.getBoundingClientRect();
        const centre = p.left + p.width / 2;
        if (copy && copy.right < p.left) return copy.right + 30 + p.width / 2 - centre; // desktop: from just after the text
        const v = this.getBoundingClientRect();
        return v.left + v.width * 0.17 - centre; // tablet: from the left column
      }
      finishNow() {
        if (!this.played) return;
        this.anims.forEach((a) => { try { a.finish(); } catch (e) {} });
      }
      reset() {
        if (!this.played) return;
        this.anims.forEach((a) => a.cancel());
        this.anims = [];
        this.played = false;
        this.classList.remove('is-done');
        this.classList.add('is-pending');
      }
      play() {
        if (this.played) return;
        this.played = true;
        const x = this.startX();
        const add = (el, kf, opt) => { const a = el.animate(kf, { fill: 'both', ...opt }); this.anims.push(a); return a; };
        this.classList.remove('is-pending');
        add(this.product, [
          { transform: `translate3d(${x}px, 0, 0) rotateY(0deg)`, opacity: 0, offset: 0 },
          { opacity: 1, offset: 0.12 },
          { transform: `translate3d(${x * 0.45}px, -110px, 0) rotateY(180deg)`, offset: 0.5 },
          { transform: 'translate3d(0, 0, 0) rotateY(360deg)', opacity: 1, offset: 1 },
        ], { duration: 1300, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' });
        const img = this.product.querySelector('img');
        if (img) add(img, [
          { transform: 'scale(1, 1)' }, { transform: 'scale(1.05, 0.94)' }, { transform: 'scale(0.99, 1.02)' }, { transform: 'scale(1, 1)' },
        ], { duration: 400, delay: 1250, easing: 'ease-out', fill: 'none' }).finished.then(() => this.played && this.classList.add('is-done')).catch(() => {});
        this.points.forEach((pt, i) => {
          const at = 1550 + i * 300;
          const icon = pt.querySelector('.somna-pdp-story__point-icon');
          if (icon) add(icon, [{ opacity: 0, transform: 'scale(0.5)' }, { opacity: 1, transform: 'scale(1.08)', offset: 0.7 }, { opacity: 1, transform: 'scale(1)' }], { duration: 350, delay: at, easing: 'ease-out' });
          pt.querySelectorAll('h3, p').forEach((t, j) => add(t, [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 350, delay: at + 150 + j * 70, easing: 'ease-out' }));
        });
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-pdp-story {
    background: var(--somna-story-bg);
    color: var(--somna-story-fg);
  }

  .somna-pdp-story__inner {
    --somna-content-width: 1250px;
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .somna-pdp-story__eyebrow {
    margin: 0 0 6px;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading {
    margin: 0;
    color: var(--somna-story-heading);
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.85vw, 3.4375rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading span {
    display: block;
  }

  .somna-pdp-story__heading .is-accent {
    color: var(--somna-story-accent);
  }

  .somna-pdp-story__text {
    max-width: 480px;
    margin: 14px 0 0;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .somna-pdp-story__label {
    margin: 40px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .somna-pdp-story__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .somna-pdp-story__pills li {
    padding: 8px 16px;
    border: 2px solid #000;
    border-radius: 999px;
    background: var(--somna-story-card);
    color: #000;
    box-shadow: 2px 3px 0 #000;
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    line-height: 1.4;
    rotate: -2deg;
  }

  .somna-pdp-story__pills li:nth-child(even) {
    rotate: 1.5deg;
  }

  /* problem */
  .somna-pdp-story__tag {
    margin: 0 0 12px;
    color: var(--somna-story-fg);
    font-family: var(--font-accent--family);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  .somna-pdp-story__frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.15);
  }

  .somna-pdp-story__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* problem -> solution: the two pictures cross-fade in a loop with a slow zoom (7s) */
  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }

  @keyframes somnaStoryBefore {
    0%, 42% { opacity: 1; transform: scale(1.06); }
    50%, 92% { opacity: 0; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.06); }
  }

  @keyframes somnaStoryAfter {
    0%, 42% { opacity: 0; transform: scale(1.04); }
    50%, 92% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.04); }
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__before {
    animation: somnaStoryBefore 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    animation: somnaStoryAfter 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__bullets,
  .somna-pdp-story__tag.has-after .somna-pdp-story__tag-before {
    animation: somnaStoryFade 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__bullets--after,
  .somna-pdp-story__tag-after {
    animation: somnaStoryFadeIn 7s ease-in-out infinite;
  }

  @keyframes somnaStoryFade {
    0%, 42% { opacity: 1; }
    50%, 92% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes somnaStoryFadeIn {
    0%, 42% { opacity: 0; }
    50%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .somna-pdp-story__tag.has-after {
    display: grid;
    justify-items: end;
  }

  .somna-pdp-story__tag.has-after > span {
    grid-area: 1 / 1;
  }

  .somna-pdp-story__tag-after {
    text-transform: none;
  }

  .somna-pdp-story__bullets--after svg {
    padding: 3px;
    border-radius: 3px;
    background: #4caf3e;
    color: #fff;
    stroke-width: 3.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-pdp-story__frame.has-after :is(.somna-pdp-story__before, .somna-pdp-story__bullets),
    .somna-pdp-story__tag.has-after .somna-pdp-story__tag-before {
      animation: none;
    }

    .somna-pdp-story__frame.has-after :is(.somna-pdp-story__after, .somna-pdp-story__bullets--after),
    .somna-pdp-story__tag-after {
      display: none;
    }
  }

  .somna-pdp-story__bullets {
    z-index: 1;
    position: absolute;
    left: 20px;
    bottom: 22px;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #fff;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .somna-pdp-story__bullets li {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .somna-pdp-story__bullets svg {
    width: 20px;
    height: 20px;
    color: #e3262f;
    stroke-width: 3.2;
  }

  /* how it works: product photo with four features around it */
  .somna-pdp-story__visual {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.2fr) 1fr;
    grid-template-rows: auto auto;
    gap: 24px 16px;
    align-items: start;
    justify-items: center;
  }

  .somna-pdp-story__visual .somna-pdp-story__product {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .somna-pdp-story__point {
    display: grid;
    justify-items: center;
    max-width: 170px;
    text-align: center;
  }

  .somna-pdp-story__point--1 { grid-area: 1 / 1; }
  .somna-pdp-story__point--2 { grid-area: 1 / 3; }
  .somna-pdp-story__point--3 { grid-area: 2 / 1; align-self: end; }
  .somna-pdp-story__point--4 { grid-area: 2 / 3; align-self: end; }

  .somna-pdp-story__point-icon {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--somna-story-card-fg);
    color: var(--somna-story-card);
  }

  .somna-pdp-story__point-icon svg {
    width: 36px;
    height: 36px;
  }

  .somna-pdp-story__point h3 {
    margin: 10px 0 2px;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .somna-pdp-story__point p {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0.85;
  }

  .somna-pdp-story__product img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* layers: numbered list */
  .somna-pdp-story__layers {
    display: grid;
    gap: 34px;
    margin: 0;
    padding-left: 1.4em;
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
  }

  .somna-pdp-story__layers li::marker {
    font-weight: 700;
  }

  .somna-pdp-story__layers h3 {
    margin: 0;
    font-size: inherit;
    font-weight: 700;
    line-height: 1.3;
  }

  .somna-pdp-story__layers p {
    margin: 2px 0 0;
    line-height: 1.35;
  }

  /* steps */
  .somna-pdp-story__steps {
    display: grid;
    gap: 28px;
  }

  .somna-pdp-story__step-list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-pdp-story__step {
    display: grid;
    grid-template-columns: 253px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .somna-pdp-story__step img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .somna-pdp-story__step h3 {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-story__step p {
    margin: 0;
    max-width: 330px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .somna-pdp-story__button {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
    min-height: 102px;
    border-radius: 18px;
    background: #afbdf8; /* Figma: lighter lavender than the heading accent */
    color: #000;
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.18);
    font-size: 1.625rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    transition: translate 0.2s;
  }

  .somna-pdp-story__button:hover {
    translate: 0 -2px;
  }

  .somna-pdp-story__button:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }

  .somna-pdp-story__button-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #000;
    color: #fff;
  }

  .somna-pdp-story__button-icon svg {
    width: 22px;
    margin-left: 3px;
  }

  /* Figma type scale (desktop 1440, scales down on tablet) — QA pass */
  @media screen and (min-width: 750px) {
    .somna-pdp-story__eyebrow {
      font-size: clamp(15px, 1.25vw, 18px);
      letter-spacing: 0.18em;
    }

    .somna-pdp-story__heading {
      line-height: 1.35;
    }

    .somna-pdp-story__text,
    .somna-pdp-story__bullets li,
    .somna-pdp-story__layers :is(h3, p) {
      font-size: clamp(16px, 1.37vw, 19.7px);
      line-height: 1.3;
      letter-spacing: 0.08em;
    }

    .somna-pdp-story__label {
      font-size: clamp(19px, 1.74vw, 25px);
      letter-spacing: 0.08em;
    }

    .somna-pdp-story__tag {
      font-size: clamp(28px, 2.63vw, 38px);
      letter-spacing: 0.08em;
    }

    .somna-pdp-story__step h3 {
      font-size: clamp(30px, 2.72vw, 39px);
    }

    .somna-pdp-story__button {
      font-weight: 700;
    }
  }

  /* button hover: dark fill so the change is clearly visible on the light section */
  .somna-pdp-story__button {
    transition: translate 0.2s, background-color 0.2s, color 0.2s;
  }

  .somna-pdp-story__button:hover {
    background: #0b0f1d;
    color: #f3feee;
  }

  .somna-pdp-story__button-icon {
    transition: background-color 0.2s, color 0.2s;
  }

  .somna-pdp-story__button:hover .somna-pdp-story__button-icon {
    background: var(--somna-story-accent, #98a3de);
    color: #000;
  }

  /* desktop (Figma 1440) */
  @media screen and (min-width: 990px) {
    .somna-pdp-story--problem .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 480px) minmax(0, 753px);
      justify-content: space-between;
      align-items: start;
    }

    .somna-pdp-story--how .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 560px) minmax(0, 640px);
      justify-content: space-between;
    }

    /* Figma: the strip is much taller, so the four features spread further apart */
    .somna-pdp-story--how .somna-pdp-story__visual {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr) minmax(0, 1fr);
      /* Figma: features sit top and bottom of a ~440px area, whatever the product shape (tall strip or round tape) */
      grid-template-rows: 1fr 1fr;
      min-height: clamp(360px, 30.5vw, 440px);
    }

    .somna-pdp-story--layers .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 440px) minmax(0, 460px) minmax(0, 320px);
      gap: 24px;
      justify-content: space-between;
    }

    .somna-pdp-story--steps .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 520px) minmax(0, 640px);
      justify-content: space-between;
      align-items: start;
    }
  }

  /* tablet: adapted two-column layouts, no horizontal scroll */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-pdp-story--problem .somna-pdp-story__inner,
    .somna-pdp-story--steps .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-story--how .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-story--layers .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .somna-pdp-story--layers .somna-pdp-story__copy {
      grid-column: 1 / -1;
    }

    .somna-pdp-story__text {
      max-width: 620px;
    }

    .somna-pdp-story__visual {
      max-width: 640px;
      margin-inline: auto;
    }

    .somna-pdp-story__step {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .somna-pdp-story__button {
      min-height: 76px;
      font-size: 1.375rem;
    }
  }

  /* mobile: design to come (Figma pending) — simple stacked fallback only */
  /* Mobile (Figma 4606:9024 / 4606:9662): homepage mobile type scale — eyebrow 12px, headings 26px,
     text 14px, buttons ~52px — and tighter gaps. Tablet/desktop (>= 750px) untouched. */
  @media screen and (max-width: 749px) {
    .somna-pdp-story__inner {
      gap: 20px;
    }

    .somna-pdp-story__eyebrow {
      margin-bottom: 8px;
      font-size: 0.75rem;
    }

    .somna-pdp-story__heading {
      font-size: 1.625rem;
    }

    .somna-pdp-story__text {
      margin-top: 10px;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .somna-pdp-story__label {
      margin-top: 18px;
      font-size: 0.9375rem;
    }

    .somna-pdp-story__pills {
      margin-top: 14px;
    }

    .somna-pdp-story__pills li {
      padding: 5px 12px;
      font-size: 0.8125rem;
    }

    /* problem: label on the left, smaller overlay list */
    .somna-pdp-story__tag {
      margin-bottom: 10px;
      font-size: 1.25rem;
      text-align: left;
    }

    .somna-pdp-story__tag.has-after {
      justify-items: start;
    }

    .somna-pdp-story__bullets {
      left: 12px;
      bottom: 12px;
      font-size: 0.8125rem;
    }

    .somna-pdp-story__bullets svg {
      width: 14px;
      height: 14px;
    }

    /* how it works: the four features stay at the corners of the product, as in Figma */
    /* Figma: a large product picture with the features at its four corners */
    .somna-pdp-story__visual {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr) minmax(0, 0.85fr);
      gap: 72px 4px;
    }

    .somna-pdp-story__visual .somna-pdp-story__product {
      width: 100%;
    }

    .somna-pdp-story__point {
      max-width: 98px;
    }

    .somna-pdp-story__point-icon {
      width: 38px;
      height: 38px;
    }

    .somna-pdp-story__point-icon svg {
      width: 22px;
      height: 22px;
    }

    .somna-pdp-story__point h3 {
      margin-top: 6px;
      font-size: 0.75rem;
    }

    .somna-pdp-story__point p {
      font-size: 0.6875rem;
    }

    /* layers: picture, then the list in two columns */
    .somna-pdp-story--layers .somna-pdp-story__product {
      max-width: 360px;
      margin-inline: auto;
    }

    .somna-pdp-story__layers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 18px;
      padding-left: 1.1em;
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
    }

    .somna-pdp-story__layers p {
      font-size: 0.75rem;
    }

    /* steps: photo on the left, title + text on the right */
    .somna-pdp-story__steps {
      gap: 20px;
    }

    .somna-pdp-story__step-list {
      gap: 8px;
    }

    .somna-pdp-story__step {
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
    }

    .somna-pdp-story__step h3 {
      font-size: 1.375rem;
    }

    .somna-pdp-story__step p {
      font-size: 0.75rem;
      line-height: 1.35;
    }

    .somna-pdp-story__button {
      gap: 10px;
      min-height: 52px;
      border-radius: 14px;
      font-size: 1rem;
    }

    .somna-pdp-story__button-icon {
      width: 30px;
      height: 30px;
    }

    .somna-pdp-story__button-icon svg {
      width: 14px;
      margin-left: 2px;
    }
  }
  /* "How it works" hop-flip: hidden until it plays; float once landed */
  somna-pdp-how {
    perspective: 1100px;
  }

  somna-pdp-how .somna-pdp-story__product {
    transform-style: preserve-3d;
    will-change: transform;
  }

  somna-pdp-how.is-pending :is(.somna-pdp-story__product, .somna-pdp-story__point-icon, .somna-pdp-story__point h3, .somna-pdp-story__point p) {
    opacity: 0;
  }

  somna-pdp-how.is-done .somna-pdp-story__product img {
    animation: somnaHowFloat 4s ease-in-out infinite;
  }

  @keyframes somnaHowFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    somna-pdp-how.is-done .somna-pdp-story__product img {
      animation: none;
    }
  }
  /* layers built from separate layer images (stacked = the Figma picture) */
  .somna-pdp-story__stack {
    position: relative;
    display: block;
    width: 100%;
  }

  .somna-pdp-story__stack .somna-pdp-story__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  somna-pdp-layers .somna-pdp-story__layer {
    will-change: transform, opacity;
  }

  .somna-pdp-layers-traveller {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .somna-pdp-layers-traveller img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 16px rgb(0 0 0 / 0.2));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna product story",
  "tag": "section",
  "class": "section-somna-pdp-story",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Content and layout",
      "info": "Reads the product's matching PDP section metafield.",
      "options": [
        { "value": "problem", "label": "Problem (Sound familiar?)" },
        { "value": "how", "label": "How it works" },
        { "value": "layers", "label": "What it's made of" },
        { "value": "steps", "label": "Three steps" }
      ],
      "default": "problem"
    },
    { "type": "product", "id": "preview_product", "label": "Product for the theme editor", "info": "Only used where there is no product." },
    { "type": "checkbox", "id": "layers_animation", "label": "Animate \"What it's made of\"", "info": "When every layer has its own image: the How it works product travels in and peels into the layers as you scroll. Desktop and tablet; off for reduced motion.", "default": true },
    { "type": "select", "id": "pills_motion", "label": "Pill badges animation", "info": "A short shake every few seconds, one pill after another. Off for reduced motion.", "options": [{ "value": "none", "label": "None" }, { "value": "wiggle", "label": "Wiggle" }, { "value": "swing", "label": "Tilt-swing" }, { "value": "pop", "label": "Pop-jiggle" }], "default": "swing" },
    { "type": "checkbox", "id": "how_animation", "label": "Animate \"How it works\"", "info": "Hop-flip of the product and icons 1 → 4 when the section comes on screen. Off for visitors who prefer reduced motion.", "default": true },
    { "type": "select", "id": "accent_line", "label": "Heading line in the accent colour", "options": [{ "value": "first", "label": "First line" }, { "value": "second", "label": "Second line" }], "default": "first" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0b0f1d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3feee" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Heading accent / button", "default": "#afbdf8" },
    { "type": "color", "id": "card_color", "label": "Pills and icon colour", "default": "#f3feee" },
    { "type": "color", "id": "card_text_color", "label": "Icon circle", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
  ],
  "presets": [{ "name": "Somna product story" }]
}
{% endschema %}
