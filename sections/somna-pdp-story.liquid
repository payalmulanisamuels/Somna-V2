    .somna-pdp-story__label {
      margin-top: 18px;
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .somna-pdp-story__pills {
      margin-top: 14px;
    }

    /* Figma: Boldonse 10.8px, 0.03em */
    .somna-pdp-story__pills li {
      padding: 5px 11px;
      font-size: 0.6875rem;
      letter-spacing: 0.03em;
    }

    /* problem: label on the left, smaller overlay list */
    .somna-pdp-story__tag {
      margin-bottom: 10px;
      letter-spacing: 0.08em;
      font-size: 1.25rem;
      text-align: left;
    }

    .somna-pdp-story__tag.has-after {
      justify-items: start;
    }

    .somna-pdp-story__bullets {
      left: 12px;
      bottom: 12px;
      font-size: 0.8125rem;
    }

    .somna-pdp-story__bullets svg {
      width: 14px;
      height: 14px;
    }

    /* how it works: the four features stay at the corners of the product, as in Figma */
    /* Figma: a large product picture with the features at its four corners */
    .somna-pdp-story__visual {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr) minmax(0, 0.85fr);
      gap: 72px 4px;
    }

    .somna-pdp-story__visual .somna-pdp-story__product {
      width: 100%;
    }

    /* bundles (tape + strip): the third feature sits right under the pair, as in Figma 4781:9521 */
    .somna-pdp-story__visual.somna-pdp-story__visual--pair {
      row-gap: 6px;
    }

    .somna-pdp-story__point {
      max-width: 98px;
    }

    .somna-pdp-story__point-icon {
      width: 38px;
      height: 38px;
    }

    .somna-pdp-story__point-icon svg {
      width: 22px;
      height: 22px;
    }

    .somna-pdp-story__point h3 {
      margin-top: 6px;
      font-size: 0.6875rem;
      font-weight: 500;
    }

    .somna-pdp-story__point p {
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }

    /* layers: picture, then the list in two columns */
    .somna-pdp-story--layers .somna-pdp-story__product {
      max-width: 360px;
      margin-inline: auto;
    }

    /* Figma: Inter Bold 12 / Regular 12, 0.08em */
    .somna-pdp-story__layers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 18px;
      padding-left: 1.1em;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    .somna-pdp-story__layers :is(h3, p) {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      line-height: 1.3;
    }

    /* steps: photo on the left, title + text on the right */
    .somna-pdp-story__steps {
      gap: 20px;
    }

    .somna-pdp-story__step-list {
      gap: 8px;
    }

    .somna-pdp-story__step {
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
    }

    .somna-pdp-story__step h3 {
      font-size: 1.375rem;
    }

    /* Figma: Arimo Bold */
    .somna-pdp-story__step p {
