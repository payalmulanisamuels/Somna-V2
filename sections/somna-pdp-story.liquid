  /* mobile: design to come (Figma pending) — simple stacked fallback only */
  /* Mobile (Figma 4606:9024 / 4606:9662): homepage mobile type scale — eyebrow 12px, headings 26px,
     text 14px, buttons ~52px — and tighter gaps. Tablet/desktop (>= 750px) untouched. */
  @media screen and (max-width: 749px) {
    /* section padding is an inline style from the settings */
    .somna-pdp-story {
      padding-block: 16px 24px !important;
    }

    .somna-pdp-story__inner {
      gap: 20px;
    }

    .somna-pdp-story__eyebrow {
      margin-bottom: 8px;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
    }

    .somna-pdp-story__heading {
      font-size: 1.625rem;
    }

    .somna-pdp-story__text {
      margin-top: 10px;
      font-size: 0.875rem;
      letter-spacing: 0.06em;
      line-height: 1.3;
