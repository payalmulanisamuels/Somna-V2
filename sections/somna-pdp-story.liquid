{%- comment -%}
  Somna V2 — product page story sections (Figma 4557:857 / 4557:44): "Sound familiar?" (problem),
  "How it works", "What it's made of" (layers) and "Three steps". One section, four layouts.
  Content comes from the product's PDP section metaobject (custom.pdp_problem / pdp_how /
  pdp_layers / pdp_steps): eyebrow, two-line heading, text, label, image, pills, button and a list of
  PDP features (icon + title + text + optional photo). The section hides itself when the product has
  no content for the chosen layout.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign key = 'pdp_' | append: s.layout
  assign c = product.metafields.custom[key].value
-%}
{%- if c != blank -%}
{%- liquid
  assign features = c.features.value
  assign image = c.image.value
  assign accent_first = false
  if s.accent_line == 'first'
    assign accent_first = true
  endif
-%}
<div
  class="somna-pdp-story somna-pdp-story--{{ s.layout }}"
  style="--somna-story-bg: {{ s.background_color }}; --somna-story-fg: {{ s.text_color }}; --somna-story-heading: {{ s.heading_color }}; --somna-story-accent: {{ s.accent_color }}; --somna-story-card: {{ s.card_color }}; --somna-story-card-fg: {{ s.card_text_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-pdp-story__inner somna-container">
    <div class="somna-pdp-story__copy">
      {%- if c.eyebrow != blank -%}<p class="somna-pdp-story__eyebrow">{{ c.eyebrow.value }}</p>{%- endif -%}
      <h2 class="somna-pdp-story__heading">
        <span{% if accent_first %} class="is-accent"{% endif %}>{{ c.heading.value }}</span>
        {%- if c.heading_accent != blank %} <span{% unless accent_first %} class="is-accent"{% endunless %}>{{ c.heading_accent.value }}</span>{% endif -%}
      </h2>
      {%- if c.text != blank -%}<p class="somna-pdp-story__text">{{ c.text.value | newline_to_br }}</p>{%- endif -%}

      {%- if s.layout == 'how' and c.label != blank -%}<p class="somna-pdp-story__label">{{ c.label.value }}</p>{%- endif -%}

      {%- assign pills = c.pills.value -%}
      {%- if pills != blank -%}
        <ul class="somna-pdp-story__pills" role="list">
          {%- for p in pills -%}<li>{{ p }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- case s.layout -%}
      {%- when 'problem' -%}
        <div class="somna-pdp-story__media">
          {%- if c.label != blank -%}<p class="somna-pdp-story__tag">{{ c.label.value }}</p>{%- endif -%}
          {%- assign image_after = c.image_after.value -%}
          <div class="somna-pdp-story__frame{% if image and image_after %} has-after{% endif %}">
            {%- if image -%}{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__before' }}{%- endif -%}
            {%- if image and image_after -%}{{ image_after | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500', sizes: '(min-width: 990px) 753px, 100vw', class: 'somna-pdp-story__after' }}{%- endif -%}
            {%- if features != blank -%}
              <ul class="somna-pdp-story__bullets" role="list">
                {%- for f in features -%}
                  <li>{% render 'somna-pdp-icon', name: f.icon.value %}<span>{{ f.title.value }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>

      {%- when 'how' -%}
        <div class="somna-pdp-story__visual">
          {%- if image -%}<div class="somna-pdp-story__product">{{ image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 335px, 50vw' }}</div>{%- endif -%}
          {%- for f in features limit: 4 -%}
            <div class="somna-pdp-story__point somna-pdp-story__point--{{ forloop.index }}">
              <span class="somna-pdp-story__point-icon">{% render 'somna-pdp-icon', name: f.icon.value %}</span>
              <h3>{{ f.title.value }}</h3>
              {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>

      {%- when 'layers' -%}
        {%- if image -%}<div class="somna-pdp-story__product">{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 483px, 60vw' }}</div>{%- endif -%}
        {%- if features != blank -%}
          <ol class="somna-pdp-story__layers">
            {%- for f in features -%}
              <li><h3>{{ f.title.value }}</h3>{%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}</li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

      {%- when 'steps' -%}
        <div class="somna-pdp-story__steps">
          <ol class="somna-pdp-story__step-list" role="list">
            {%- for f in features -%}
              {%- assign photo = f.image.value -%}
              {%- assign crop = f.image_crop.value | downcase | default: 'center' -%}
              <li class="somna-pdp-story__step">
                {%- if photo -%}{{ photo | image_url: width: 506, height: 308, crop: crop | image_tag: loading: 'lazy', alt: photo.alt, width: 253, height: 154 }}{%- endif -%}
                <div>
                  <h3><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ f.title.value }}</h3>
                  {%- if f.text != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
          {%- if c.button_label != blank and c.button_url != blank -%}
            <a class="somna-pdp-story__button" href="{{ c.button_url.value | replace: 'https://usesomna.com', '' }}">
              <span class="somna-pdp-story__button-icon">{% render 'somna-pdp-icon', name: 'play' %}</span>{{ c.button_label.value }}
            </a>
          {%- endif -%}
        </div>
    {%- endcase -%}
  </div>
</div>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}
{%- endif -%}

{% stylesheet %}
  .somna-pdp-story {
    background: var(--somna-story-bg);
    color: var(--somna-story-fg);
  }

  .somna-pdp-story__inner {
    --somna-content-width: 1250px;
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .somna-pdp-story__eyebrow {
    margin: 0 0 6px;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading {
    margin: 0;
    color: var(--somna-story-heading);
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.85vw, 3.4375rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-story__heading span {
    display: block;
  }

  .somna-pdp-story__heading .is-accent {
    color: var(--somna-story-accent);
  }

  .somna-pdp-story__text {
    max-width: 480px;
    margin: 14px 0 0;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .somna-pdp-story__label {
    margin: 40px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .somna-pdp-story__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .somna-pdp-story__pills li {
    padding: 8px 16px;
    border: 2px solid #000;
    border-radius: 999px;
    background: var(--somna-story-card);
    color: #000;
    box-shadow: 2px 3px 0 #000;
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    line-height: 1.4;
    rotate: -2deg;
  }

  .somna-pdp-story__pills li:nth-child(even) {
    rotate: 1.5deg;
  }

  /* problem */
  .somna-pdp-story__tag {
    margin: 0 0 12px;
    color: var(--somna-story-fg);
    font-family: var(--font-accent--family);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  .somna-pdp-story__frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.15);
  }

  .somna-pdp-story__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* problem -> solution: the two pictures cross-fade in a loop with a slow zoom (7s) */
  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }

  @keyframes somnaStoryBefore {
    0%, 42% { opacity: 1; transform: scale(1.06); }
    50%, 92% { opacity: 0; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.06); }
  }

  @keyframes somnaStoryAfter {
    0%, 42% { opacity: 0; transform: scale(1.04); }
    50%, 92% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.04); }
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__before {
    animation: somnaStoryBefore 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__after {
    animation: somnaStoryAfter 7s ease-in-out infinite;
  }

  .somna-pdp-story__frame.has-after .somna-pdp-story__bullets {
    animation: somnaStoryBefore 7s ease-in-out infinite;
    transform-origin: 0 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-pdp-story__frame.has-after :is(.somna-pdp-story__before, .somna-pdp-story__bullets) {
      animation: none;
    }

    .somna-pdp-story__frame.has-after .somna-pdp-story__after {
      display: none;
    }
  }

  .somna-pdp-story__bullets {
    z-index: 1;
    position: absolute;
    left: 20px;
    bottom: 22px;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #fff;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .somna-pdp-story__bullets li {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .somna-pdp-story__bullets svg {
    width: 20px;
    height: 20px;
    color: #e3262f;
    stroke-width: 3.2;
  }

  /* how it works: product photo with four features around it */
  .somna-pdp-story__visual {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.2fr) 1fr;
    grid-template-rows: auto auto;
    gap: 24px 16px;
    align-items: start;
    justify-items: center;
  }

  .somna-pdp-story__visual .somna-pdp-story__product {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .somna-pdp-story__point {
    display: grid;
    justify-items: center;
    max-width: 170px;
    text-align: center;
  }

  .somna-pdp-story__point--1 { grid-area: 1 / 1; }
  .somna-pdp-story__point--2 { grid-area: 1 / 3; }
  .somna-pdp-story__point--3 { grid-area: 2 / 1; align-self: end; }
  .somna-pdp-story__point--4 { grid-area: 2 / 3; align-self: end; }

  .somna-pdp-story__point-icon {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--somna-story-card-fg);
    color: var(--somna-story-card);
  }

  .somna-pdp-story__point-icon svg {
    width: 36px;
    height: 36px;
  }

  .somna-pdp-story__point h3 {
    margin: 10px 0 2px;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .somna-pdp-story__point p {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0.85;
  }

  .somna-pdp-story__product img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* layers: numbered list */
  .somna-pdp-story__layers {
    display: grid;
    gap: 34px;
    margin: 0;
    padding-left: 1.4em;
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
  }

  .somna-pdp-story__layers li::marker {
    font-weight: 700;
  }

  .somna-pdp-story__layers h3 {
    margin: 0;
    font-size: inherit;
    font-weight: 700;
    line-height: 1.3;
  }

  .somna-pdp-story__layers p {
    margin: 2px 0 0;
    line-height: 1.35;
  }

  /* steps */
  .somna-pdp-story__steps {
    display: grid;
    gap: 28px;
  }

  .somna-pdp-story__step-list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-pdp-story__step {
    display: grid;
    grid-template-columns: 253px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .somna-pdp-story__step img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .somna-pdp-story__step h3 {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-story__step p {
    margin: 0;
    max-width: 330px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .somna-pdp-story__button {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
    min-height: 102px;
    border-radius: 18px;
    background: var(--somna-story-accent);
    color: #000;
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.18);
    font-size: 1.625rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    transition: translate 0.2s;
  }

  .somna-pdp-story__button:hover {
    translate: 0 -2px;
  }

  .somna-pdp-story__button:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }

  .somna-pdp-story__button-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #000;
    color: #fff;
  }

  .somna-pdp-story__button-icon svg {
    width: 22px;
    margin-left: 3px;
  }

  /* desktop (Figma 1440) */
  @media screen and (min-width: 990px) {
    .somna-pdp-story--problem .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 480px) minmax(0, 753px);
      justify-content: space-between;
      align-items: start;
    }

    .somna-pdp-story--how .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 560px) minmax(0, 640px);
      justify-content: space-between;
    }

    .somna-pdp-story--layers .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 440px) minmax(0, 460px) minmax(0, 320px);
      gap: 24px;
      justify-content: space-between;
    }

    .somna-pdp-story--steps .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 520px) minmax(0, 640px);
      justify-content: space-between;
      align-items: start;
    }
  }

  /* tablet: adapted two-column layouts, no horizontal scroll */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-pdp-story--problem .somna-pdp-story__inner,
    .somna-pdp-story--steps .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-story--how .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .somna-pdp-story--layers .somna-pdp-story__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .somna-pdp-story--layers .somna-pdp-story__copy {
      grid-column: 1 / -1;
    }

    .somna-pdp-story__text {
      max-width: 620px;
    }

    .somna-pdp-story__visual {
      max-width: 640px;
      margin-inline: auto;
    }

    .somna-pdp-story__step {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .somna-pdp-story__button {
      min-height: 76px;
      font-size: 1.375rem;
    }
  }

  /* mobile: design to come (Figma pending) — simple stacked fallback only */
  @media screen and (max-width: 749px) {
    .somna-pdp-story__visual {
      grid-template-columns: 1fr 1fr;
    }

    .somna-pdp-story__visual .somna-pdp-story__product {
      grid-column: 1 / -1;
      grid-row: 1;
      max-width: 220px;
    }

    .somna-pdp-story__point--1,
    .somna-pdp-story__point--2,
    .somna-pdp-story__point--3,
    .somna-pdp-story__point--4 {
      grid-area: auto;
    }

    .somna-pdp-story__step {
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 12px;
    }

    .somna-pdp-story__step p {
      font-size: 0.9375rem;
    }

    .somna-pdp-story__button {
      min-height: 60px;
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna product story",
  "tag": "section",
  "class": "section-somna-pdp-story",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Content and layout",
      "info": "Reads the product's matching PDP section metafield.",
      "options": [
        { "value": "problem", "label": "Problem (Sound familiar?)" },
        { "value": "how", "label": "How it works" },
        { "value": "layers", "label": "What it's made of" },
        { "value": "steps", "label": "Three steps" }
      ],
      "default": "problem"
    },
    { "type": "product", "id": "preview_product", "label": "Product for the theme editor", "info": "Only used where there is no product." },
    { "type": "select", "id": "accent_line", "label": "Heading line in the accent colour", "options": [{ "value": "first", "label": "First line" }, { "value": "second", "label": "Second line" }], "default": "first" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0b0f1d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3feee" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Heading accent / button", "default": "#afbdf8" },
    { "type": "color", "id": "card_color", "label": "Pills and icon colour", "default": "#f3feee" },
    { "type": "color", "id": "card_text_color", "label": "Icon circle", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
  ],
  "presets": [{ "name": "Somna product story" }]
}
{% endschema %}
