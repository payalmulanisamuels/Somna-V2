{%- doc -%}
  Somna V2 — FAQ topics as cards (Figma 4927:1231 Support): a 2-column grid of mint cards, each a topic heading
  followed by its questions. Each question is the theme's accordion (snippets/accordion-custom-component,
  the same open/close animation as every other FAQ on the site): the row turns lavender and bold when open,
  its arrow turns down, the answer slides out under it.

  Blocks: "Topic" starts a card; the "Question" blocks after it go in that card.
  A topic's anchor id makes the hero's jump pills work (e.g. #products).
{%- enddoc -%}
{%- liquid
  assign s = section.settings
  assign open_card = false
-%}
<div
  class="somna-faq-cards"
  style="--sfc-bg: {{ s.background_color }}; --sfc-card: {{ s.card_color }}; --sfc-accent: {{ s.accent_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-faq-cards__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- case block.type -%}
        {%- when 'topic' -%}
          {%- if open_card -%}</div></div>{%- endif -%}
          {%- assign open_card = true -%}
          <div class="somna-faq-cards__card" {% if b.anchor != blank %}id="{{ b.anchor | handleize }}"{% endif %} {{ block.shopify_attributes }}>
            <h2 class="somna-faq-cards__title">{{ b.title | escape }}</h2>
            <div class="somna-faq-cards__list">
        {%- when 'question' -%}
          {%- unless open_card -%}
            {%- assign open_card = true -%}
            <div class="somna-faq-cards__card"><div class="somna-faq-cards__list">
          {%- endunless -%}
          {%- capture row -%}
            <details class="somna-faq-cards__item" {{ block.shopify_attributes }}>
              <summary class="somna-faq-cards__q">
                <span>{{ b.question | escape }}</span>
                <span class="somna-faq-cards__arrow" aria-hidden="true">→</span>
              </summary>
              <div class="details-content somna-faq-cards__a">{{ b.answer }}</div>
            </details>
          {%- endcapture -%}
          {%- render 'accordion-custom-component', children: row, open_by_default_on_desktop: b.open, open_by_default_on_mobile: b.open -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- if open_card -%}</div></div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Figma 4927:1350–1388: 601px cards, 57px gap, 21px radius, 2.44px border, hard 3.25/4.06 shadow */
  .somna-faq-cards {
    background: var(--sfc-bg);
    color: #000;
  }

  .somna-faq-cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 53px 57px;
    width: min(100% - 40px, 1259px);
    margin-inline: auto;
  }

  .somna-faq-cards__card {
    min-height: 441px;
    padding: 22px 28px 32px;
    border: 2.44px solid #000;
    border-radius: 21.12px;
    background: var(--sfc-card);
    box-shadow: 3.25px 4.06px 0 #000;
    scroll-margin-top: 120px;
  }

  .somna-faq-cards__title {
    margin: 0 0 22px;
    color: #000;
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    letter-spacing: -0.01em;
    font-weight: var(--font-accent--weight);
    line-height: 1.35;
  }

  .somna-faq-cards__list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .somna-faq-cards__item {
    border: 2.44px solid #000;
    border-radius: 8px;
    background: var(--sfc-card);
    box-shadow: 3.25px 4.06px 0 #000;
    transition: background-color 0.25s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .somna-faq-cards__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding: 8px 14px 8px 14px;
    cursor: pointer;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    list-style: none;
  }

  .somna-faq-cards__q::-webkit-details-marker {
    display: none;
  }

  .somna-faq-cards__arrow {
    flex: none;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .somna-faq-cards__item:hover {
    background: var(--sfc-accent);
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 5.5px 0 #000;
  }

  .somna-faq-cards__item:hover .somna-faq-cards__arrow {
    transform: translateX(4px);
  }

  .somna-faq-cards__item[open] {
    background: var(--sfc-accent);
  }

  .somna-faq-cards__item[open] .somna-faq-cards__q {
    font-weight: 700;
  }

  .somna-faq-cards__item[open] .somna-faq-cards__arrow {
    transform: rotate(90deg);
  }

  .somna-faq-cards__q:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
    border-radius: 6px;
  }

  .somna-faq-cards__a {
    padding: 0 14px 14px;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  .somna-faq-cards__a > :first-child {
    margin-top: 0;
  }

  .somna-faq-cards__a > :last-child {
    margin-bottom: 0;
  }

  .somna-faq-cards__a a {
    color: inherit;
  }

  @media screen and (max-width: 989px) {
    .somna-faq-cards__grid {
      gap: 32px 24px;
    }
  }

  @media screen and (max-width: 749px) {
    /* phones: tighter band like the other sections (the wave below already adds space) */
    .somna-faq-cards {
      padding-block: 12px 4px !important;
    }

    .somna-faq-cards__grid {
      grid-template-columns: 1fr;
      gap: 24px;
      width: min(100% - 32px, 1259px);
    }

    .somna-faq-cards__card {
      min-height: 0;
      padding: 18px 16px 24px;
      border-radius: 16px;
    }

    .somna-faq-cards__title {
      margin-bottom: 16px;
    }

    .somna-faq-cards__list {
      gap: 14px;
    }

    .somna-faq-cards__q {
      font-size: 0.875rem;
      letter-spacing: 0.05em;
    }

    .somna-faq-cards__arrow {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-faq-cards__item,
    .somna-faq-cards__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna FAQ cards",
  "tag": "section",
  "class": "section-somna-faq-cards",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4fef3" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Open / hover row", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic (new card)",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Products" },
        { "type": "text", "id": "anchor", "label": "Anchor id", "info": "For jump links, e.g. products → link to #products" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Somna FAQ cards" }]
}
{% endschema %}
