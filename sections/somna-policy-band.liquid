{%- doc -%}
  Somna V2 — centred colour band for policy pages: eyebrow, title, optional text and button, and
  optional pill links (one block per link). Used at the top of each policy page (title + links to every
  policy) and again at the bottom (contact). Leave the heading empty to show the page title.
{%- enddoc -%}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = page.title
  endif
-%}
<div
  class="somna-policy-band somna-policy-band--{{ s.size }}"
  style="--spb-bg: {{ s.background }}; --spb-fg: {{ s.text_color }}; --spb-accent: {{ s.accent }};"
>
  <div class="somna-policy-band__inner">
    {%- if s.eyebrow != blank -%}<p class="somna-policy-band__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.size == 'title' -%}
      <h1 class="somna-policy-band__heading">{{ heading | escape }}</h1>
    {%- else -%}
      <h2 class="somna-policy-band__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}<div class="somna-policy-band__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="somna-policy-band__button" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="somna-policy-band__pills" aria-label="{{ s.pills_label | escape }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign current = false -%}
          {%- if b.link != blank and b.link == request.path -%}{%- assign current = true -%}{%- endif -%}
          <a href="{{ b.link }}"{% if current %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ b.label | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .somna-policy-band {
    background: var(--spb-bg);
    color: var(--spb-fg);
    text-align: center;
  }

  .somna-policy-band__inner {
    width: min(100% - 40px, 1160px);
    margin-inline: auto;
    padding-block: 24px 32px;
  }

  .somna-policy-band--title .somna-policy-band__inner {
    padding-block: 56px 24px;
  }

  .somna-policy-band__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--spb-accent);
  }

  .somna-policy-band__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.3;
    text-transform: uppercase;
    color: inherit;
  }

  .somna-policy-band--title .somna-policy-band__heading {
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    line-height: 1.2;
  }

  .somna-policy-band__text {
    margin: 10px auto 22px;
    max-width: 60ch;
    opacity: 0.85;
  }

  .somna-policy-band__text p {
    margin: 0;
  }

  .somna-policy-band__text a {
    color: var(--spb-accent);
  }

  .somna-policy-band__button {
    display: inline-grid;
    place-items: center;
    min-height: 54px;
    padding: 0 36px;
    border-radius: 12px;
    background: var(--spb-accent);
    color: #000;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .somna-policy-band__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }

  .somna-policy-band__pills a {
    padding: 9px 16px;
    border: 1px solid color-mix(in srgb, var(--spb-accent) 45%, transparent);
    border-radius: 999px;
    color: var(--spb-fg);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: background 0.2s;
  }

  .somna-policy-band__pills a:hover {
    background: color-mix(in srgb, var(--spb-accent) 15%, transparent);
  }

  .somna-policy-band__pills a[aria-current='page'] {
    border-color: var(--spb-accent);
    background: var(--spb-accent);
    color: #0b0f1d;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .somna-policy-band__inner {
      width: min(100% - 32px, 1160px);
    }

    .somna-policy-band--title .somna-policy-band__inner {
      padding-block: 32px 12px;
    }

    /* pills scroll sideways on phones */
    .somna-policy-band__pills {
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-inline: -16px;
      padding-inline: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .somna-policy-band__pills::-webkit-scrollbar {
      display: none;
    }

    .somna-policy-band__pills a {
      flex: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna policy band",
  "tag": "section",
  "class": "section-somna-policy-band",
  "settings": [
    { "type": "select", "id": "size", "label": "Style", "options": [{ "value": "title", "label": "Page title (top)" }, { "value": "band", "label": "Band (e.g. contact)" }], "default": "title" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Somna policies" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to show the page title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "pills_label", "label": "Links label (screen readers)", "default": "Policies" },
    { "type": "color", "id": "background", "label": "Background", "default": "#0b0f1d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3feee" },
    { "type": "color", "id": "accent", "label": "Accent (eyebrow, button, current link)", "default": "#afbdf8" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Policy link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Policy" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Somna policy band" }]
}
{% endschema %}
