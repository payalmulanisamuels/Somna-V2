{%- comment -%}
  Somna V2 — "Built for bedtime" comparison with product tabs.
  Blocks:
  - Tab: name, plus image and name for the Somna column and the three comparison columns of that tab.
  - Row: which tab it belongs to (1 or 2), the feature, and yes/no for each of the four columns.
  A tab with no rows is hidden, so the section works with one or two tabs.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign row_blocks = section.blocks | where: 'type', 'row'
  assign uid = section.id | replace: '_', '-'
  assign only_tab = 0
  assign match_source = product | default: closest.product
  if s.match_product and match_source != blank
    assign product_name = match_source.title | downcase | strip
    for tab in tab_blocks
      assign tab_name = tab.settings.name | downcase | strip
      if tab_name == product_name
        assign only_tab = forloop.index
      endif
    endfor
  endif
  # a single tab needs no tab switcher
  if only_tab == 0 and tab_blocks.size == 1
    assign only_tab = 1
  endif

  # intro: the shown tab may bring its own eyebrow / heading / text (Season Bundle table)
  assign intro_eyebrow = s.eyebrow
  assign intro_heading = s.heading
  assign intro_text = s.text
  if only_tab > 0
    assign shown_index = only_tab | minus: 1
    assign shown_tab = tab_blocks[shown_index]
    if shown_tab.settings.heading != blank
      assign intro_from_tab = true
      assign intro_eyebrow = shown_tab.settings.eyebrow
      assign intro_heading = shown_tab.settings.heading
      assign intro_text = shown_tab.settings.text
    endif
  endif
-%}

{%- capture tabs_markup -%}
  {%- assign active_set = false -%}
  {%- for tab in tab_blocks -%}
    {%- if only_tab > 0 and forloop.index != only_tab -%}{%- continue -%}{%- endif -%}
    {%- if only_tab == 0 and tab.settings.only_on_match -%}{%- continue -%}{%- endif -%}
    {%- assign tab_index = forloop.index | append: '' -%}
    {%- assign row_count = 0 -%}
    {%- for row in row_blocks -%}{%- if row.settings.tab == tab_index -%}{%- assign row_count = row_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if row_count > 0 -%}
      <button
        type="button"
        role="tab"
        class="somna-compare__tab"
        id="{{ uid }}-tab-{{ forloop.index }}"
        aria-controls="{{ uid }}-panel-{{ forloop.index }}"
        aria-selected="{% if active_set == false %}true{% else %}false{% endif %}"
        {% if active_set %}tabindex="-1"{% endif %}
        {{ tab.shopify_attributes }}
      >{{ tab.settings.name }}</button>
      {%- assign active_set = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<somna-compare-tabs
  class="somna-compare"
  style="background: {{ s.background_color }}; color: {{ s.text_color }}; --somna-panel: {{ s.panel_color }}; --somna-highlight: {{ s.highlight_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-compare__inner somna-container">
    <div class="somna-compare__intro">
      {%- if intro_eyebrow != blank -%}<p class="somna-compare__eyebrow">{{ intro_eyebrow }}</p>{%- endif -%}
      {%- if intro_heading != blank -%}<h2 class="somna-compare__heading{% if intro_from_tab %} somna-compare__heading--tab{% endif %}">{{ intro_heading }}</h2>{%- endif -%}
      {%- if intro_text != blank -%}<p class="somna-compare__text">{{ intro_text }}</p>{%- endif -%}
    </div>

    <div class="somna-compare__body">
      <div class="somna-compare__tabs"{% if only_tab > 0 %} hidden{% endif %} role="tablist" aria-label="{{ s.tabs_label | escape }}">{{ tabs_markup }}</div>

      {%- assign first_panel = true -%}
      {%- for tab in tab_blocks -%}
        {%- if only_tab > 0 and forloop.index != only_tab -%}{%- continue -%}{%- endif -%}
        {%- if only_tab == 0 and tab.settings.only_on_match -%}{%- continue -%}{%- endif -%}
        {%- assign tab_index = forloop.index | append: '' -%}
        {%- comment -%} a text-only tab (no Somna image) always shows its column names {%- endcomment -%}
        {%- assign text_only = false -%}
        {%- if tab.settings.image == blank -%}{%- assign text_only = true -%}{%- endif -%}
        {%- assign row_count = 0 -%}
        {%- for row in row_blocks -%}{%- if row.settings.tab == tab_index -%}{%- assign row_count = row_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if row_count > 0 -%}
          {%- if tab.settings.sticker != blank -%}<p class="somna-compare__sticker" aria-hidden="true">{{ tab.settings.sticker }}</p>{%- endif -%}
          <div
            class="somna-compare__panel{% if s.drip_edges %} somna-edge-drip-bottom{% endif %}{% if tab.settings.show_names %} somna-compare__panel--named{% endif %}"
            role="tabpanel"
            id="{{ uid }}-panel-{{ forloop.index }}"
            aria-labelledby="{{ uid }}-tab-{{ forloop.index }}"
            tabindex="0"
            {% unless first_panel %}hidden{% endunless %}
            {% if tab.settings.highlight == false %}style="--somna-highlight: transparent;"{% endif %}
          >
            <div class="somna-compare__scroll">
              <table class="somna-compare__table">
                <caption class="visually-hidden">{{ tab.settings.name }}: {{ s.caption }}</caption>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col" class="is-somna">
                      {%- if tab.settings.image != blank -%}{{ tab.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 57, height: 80 }}{%- endif -%}
                      <span{% if tab.settings.image == blank %} class="somna-compare__col-name"{% endif %}>{{ tab.settings.label }}</span>
                    </th>
                    {%- comment -%} a column with neither a name nor an image is left out (e.g. a three-column table) {%- endcomment -%}
                    {%- assign cols = '' -%}
                    {%- for n in (2..4) -%}
                      {%- capture img_key -%}column_{{ n }}_image{%- endcapture -%}
                      {%- capture label_key -%}column_{{ n }}_label{%- endcapture -%}
                      {%- if tab.settings[img_key] == blank and tab.settings[label_key] == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign cols = cols | append: n | append: ',' -%}
                      <th scope="col">
                        {%- if tab.settings[img_key] != blank -%}{{ tab.settings[img_key] | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}{%- endif -%}
                        <span class="somna-compare__col-name{% unless s.show_column_names or text_only or tab.settings.show_names %} visually-hidden{% endunless %}">{{ tab.settings[label_key] }}</span>
                      </th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in row_blocks -%}
                    {%- unless row.settings.tab == tab_index -%}{%- continue -%}{%- endunless -%}
                    {%- assign r = row.settings -%}
                    <tr{% if r.total %} class="is-total"{% endif %} {{ row.shopify_attributes }}>
                      <th scope="row">{{ r.label }}</th>
                      <td class="is-somna">{% if r.column_1_text != blank %}<span class="somna-compare__value">{{ r.column_1_text }}</span>{% else %}{% render 'somna-mark', value: r.column_1 %}{% endif %}</td>
                      {%- for n in (2..4) -%}
                        {%- assign n_key = n | append: ',' -%}
                        {%- unless cols contains n_key -%}{%- continue -%}{%- endunless -%}
                        {%- capture mark_key -%}column_{{ n }}{%- endcapture -%}
                        {%- capture text_key -%}column_{{ n }}_text{%- endcapture -%}
                        <td>{% if r[text_key] != blank %}<span class="somna-compare__value">{{ r[text_key] }}</span>{% else %}{% render 'somna-mark', value: r[mark_key] %}{% endif %}</td>
                      {%- endfor -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          </div>
          {%- if tab.settings.note != blank -%}<p class="somna-compare__note">{{ tab.settings.note }}</p>{%- endif -%}
          {%- assign first_panel = false -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</somna-compare-tabs>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}

<script type="module">
  if (!customElements.get('somna-compare-tabs')) {
    customElements.define('somna-compare-tabs', class extends HTMLElement {
      connectedCallback() {
        this.tabs = [...this.querySelectorAll('[role="tab"]')];
        this.addEventListener('click', this.onClick);
        this.addEventListener('keydown', this.onKey);
      }
      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('keydown', this.onKey);
      }
      select(tab, focus) {
        this.tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = this.querySelector('#' + t.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
        if (focus) tab.focus();
      }
      onClick = (e) => {
        const tab = e.target.closest('[role="tab"]');
        if (tab) this.select(tab, false);
      };
      onKey = (e) => {
        const i = this.tabs.indexOf(document.activeElement);
        if (i < 0) return;
        let next = null;
        if (e.key === 'ArrowRight') next = this.tabs[(i + 1) % this.tabs.length];
        if (e.key === 'ArrowLeft') next = this.tabs[(i - 1 + this.tabs.length) % this.tabs.length];
        if (e.key === 'Home') next = this.tabs[0];
        if (e.key === 'End') next = this.tabs[this.tabs.length - 1];
        if (next) { e.preventDefault(); this.select(next, true); }
      };
    });
  }
</script>

{% stylesheet %}
  .somna-compare__inner {
    display: grid;
    gap: 28px;
  }

  .somna-compare__eyebrow {
    margin: 0 0 16px;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    letter-spacing: 0.15em;
  }

  .somna-compare__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(2.25rem, 4.44vw, 4rem);
    line-height: 1.4;
    color: inherit;
  }

  .somna-compare__body {
    display: grid;
    justify-items: center;
    gap: 18px;
    min-width: 0;
  }

  .somna-compare__heading em {
    font-style: normal;
    color: var(--somna-compare-accent, #afbdf8);
  }

  .somna-compare__text {
    max-width: 260px;
    margin: 12px 0 0;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .somna-compare__tabs[hidden] {
    display: none;
  }

  .somna-compare__tabs {
    display: inline-flex;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: var(--somna-panel);
  }

  .somna-compare__tabs:not(:has(.somna-compare__tab + .somna-compare__tab)) {
    display: none;
  }

  .somna-compare__tab {
    min-height: 44px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #6f6f6f;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .somna-compare__tab[aria-selected='true'] {
    background: #000;
    color: #fff;
  }

  .somna-compare__tab:focus-visible,
  .somna-compare__panel:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .somna-compare__panel {
    width: 100%;
    min-width: 0;
    padding: 16px 28px 16px;
    border-radius: 20px;
    background: var(--somna-panel);
    color: #000;
  }

  .somna-compare__scroll {
    overflow-x: auto;
  }

  .somna-compare__table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .somna-compare__table th,
  .somna-compare__table td {
    padding: 14px 8px;
    text-align: center;
    vertical-align: middle;
  }

  .somna-compare__table thead th {
    padding-block: 10px 12px;
  }

  .somna-compare__table thead img {
    display: block;
    width: auto;
    max-width: 80px;
    height: 80px;
    margin-inline: auto;
    object-fit: contain;
  }

  .somna-compare__table thead span {
    display: block;
    margin-top: 2px;
    color: #0a3fa8;
    font-weight: 800;
    font-size: 0.9375rem;
  }

  .somna-compare__table thead .somna-compare__col-name {
    color: #000;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .somna-compare__table tbody th {
    width: 32%;
    text-align: start;
    font-weight: 600;
    line-height: 1.2;
  }

  .somna-compare__table tbody tr + tr > * {
    border-top: 1px solid rgb(0 0 0 / 0.15);
  }

  .somna-compare__table tbody tr:first-child > * {
    border-top: 1px solid rgb(0 0 0 / 0.15);
  }

  .somna-compare__table td + td {
    border-left: 1px solid rgb(0 0 0 / 0.12);
  }

  .somna-compare__table .is-somna {
    background: var(--somna-highlight);
  }

  .somna-compare__table .somna-check,
  .somna-compare__table .somna-cross {
    --somna-mark-size: 34px;
  }

  /* text-only column names (Season Bundle table) read at Figma size (18px at 1440) */
  .somna-compare__table thead th:not(:has(img)) .somna-compare__col-name:not(.visually-hidden) {
    display: block;
    font-size: clamp(0.9375rem, 1.25vw, 1.125rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .somna-compare__value {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media screen and (min-width: 990px) {
    .somna-compare__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
      gap: 40px;
    }
  }

  /* final mobile design: centred heading, the table fits the screen (no sideways scroll) */
  /* small laptops / large tablets: let the table use the column it has instead of a 520px minimum */
  @media screen and (min-width: 990px) and (max-width: 1199px) {
    .somna-compare__inner {
      gap: 24px;
    }

    .somna-compare__table {
      min-width: 0;
    }
  }

  /* homepage, small laptops (990–1199px): the long heading left the table too little room
     (labels on 3–4 lines, sideways scroll), so the heading sits above a centred table */
  @media screen and (min-width: 990px) and (max-width: 1199px) {
    main[data-template='index'] .somna-compare__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    main[data-template='index'] .somna-compare__panel {
      max-width: 860px;
    }
  }

  @media screen and (max-width: 749px) {
    .somna-compare__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .somna-compare__intro {
      text-align: center;
    }

    .somna-compare__eyebrow {
      margin-bottom: 8px;
      font-size: 0.625rem;
    }

    .somna-compare__heading {
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .somna-compare__tab {
      padding: 0 20px;
      font-size: 0.75rem;
    }

    .somna-compare__panel {
      padding: 8px 12px 16px;
      border-radius: 12px;
    }

    .somna-compare__table {
      min-width: 0;
      font-size: 0.6875rem;
    }

    .somna-compare__table th,
    .somna-compare__table td {
      padding: 10px 4px;
    }

    .somna-compare__table thead img {
      max-width: 44px;
      height: 44px;
    }

    .somna-compare__table thead span {
      font-size: 0.6875rem;
    }

    .somna-compare__table .somna-check,
    .somna-compare__table .somna-cross {
      --somna-mark-size: 24px;
    }

    /* PDP (Figma mobile): intro on the left, "somna. / VS / others" stacked */
    main[data-template^='product'] .somna-compare__intro {
      text-align: left;
    }

    main[data-template^='product'] .somna-compare__eyebrow {
      margin-bottom: 10px;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    main[data-template^='product'] .somna-compare__heading {
      max-width: min-content;
      font-size: 1.625rem;
      line-height: 1.3;
    }

    main[data-template^='product'] .somna-compare__text {
      max-width: 300px;
      margin-top: 10px;
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-align: left;
    }

    main[data-template^='product'] .somna-compare__table tbody th {
      font-size: 0.625rem;
      font-weight: 600;
    }

    /* bundle tables (Figma 4781:9521 / 4767:8277 / 4759:7535): the tab's own heading runs in 2 lines,
       and the table fits the screen (text values wrap, smaller) instead of scrolling sideways */
    main[data-template^='product'] .somna-compare__heading--tab {
      max-width: none;
      font-size: 2rem;
      line-height: 1.15;
    }

    .somna-compare__value {
      font-size: 0.6875rem;
      white-space: normal;
    }

    .somna-compare__table thead .somna-compare__col-name {
      font-size: 0.625rem;
    }
  }

  @media screen and (max-width: 359px) {
    .somna-compare__table th,
    .somna-compare__table td {
      padding: 8px 2px;
    }
  }
  /* PDP desktop (Figma 1440): row labels 18px */
  @media screen and (min-width: 750px) {
    main[data-template^='product'] .somna-compare__table tbody th {
      font-size: clamp(1rem, 1.28vw, 1.15rem);
    }
  }

  /* per-tab sticker on the panel's top edge and a small note under it (Season Bundle "Do the maths");
     both follow their panel when tabs switch */
  .somna-compare__sticker {
    position: relative;
    z-index: 2;
    justify-self: end;
    margin: 0 18px -34px 0;
    padding: 8px 14px;
    border: 2px solid #000;
    border-radius: 10px;
    background: #0b0f1d;
    box-shadow: 2px 3px 0 #afbdf8;
    color: #f3feee;
    font-family: var(--font-accent--family);
    font-size: clamp(0.875rem, 1.2vw, 1.0625rem);
    line-height: 1.2;
    rotate: 2deg;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .somna-compare__sticker:has(+ .somna-compare__panel[hidden]),
  .somna-compare__panel[hidden] + .somna-compare__note {
    display: none;
  }

  .somna-compare__note {
    justify-self: start;
    max-width: 100%;
    margin: -6px 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    opacity: 0.7;
  }

  /* total row: bold, lightly shaded */
  .somna-compare__table tr.is-total > * {
    background: #f2f4fe;
    font-weight: 800;
  }

  .somna-compare__table tr.is-total > .is-somna {
    background: var(--somna-highlight);
  }

  /* named columns (Sleep Bundle, Season Bundle): every picture in the same 80px box on one line,
     every column name starts on the same line under it, one name style */
  .somna-compare__panel--named thead th {
    vertical-align: top;
  }

  .somna-compare__panel--named thead img {
    width: 80px;
    max-width: 100%;
    height: 80px;
    object-fit: contain;
  }

  .somna-compare__panel--named thead th > span,
  .somna-compare__panel--named thead .somna-compare__col-name {
    display: block;
    margin-top: 8px;
    color: #000;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .somna-compare__panel--named thead th.is-somna > span {
    color: #0a3fa8;
    font-weight: 800;
  }

  /* the three value columns share the width equally */
  .somna-compare__panel--named .somna-compare__table {
    table-layout: fixed;
  }

  .somna-compare__panel--named .somna-compare__table tbody th {
    width: 28%;
  }

  /* long values ("90 (3 deliveries)") wrap inside their column instead of pushing the table sideways */
  .somna-compare__panel--named .somna-compare__value {
    white-space: normal;
    text-wrap: balance;
  }

  @media screen and (max-width: 749px) {
    .somna-compare__panel--named thead img {
      width: 44px;
      height: 44px;
    }

    .somna-compare__panel--named thead th > span,
    .somna-compare__panel--named thead .somna-compare__col-name {
      margin-top: 4px;
      font-size: 0.625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna compare tabs",
  "tag": "section",
  "class": "section-somna-compare",
  "settings": [
    {
      "type": "checkbox",
      "id": "drip_edges",
      "label": "Drippy card edges",
      "info": "Drip shapes on the card edges, as in the Figma design.",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made for your nights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in <em></em> for the accent colour.",
      "default": "Built for Bedtime. Not the First-Aid Kit."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "match_product",
      "label": "On product pages, show only the tab named like the product",
      "info": "E.g. the \"Nasal Strips\" tab on the Nasal Strips page.",
      "default": false
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs label (screen readers)",
      "default": "Compare products"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Table caption (screen readers)",
      "default": "how Somna compares"
    },
    {
      "type": "checkbox",
      "id": "show_column_names",
      "label": "Show comparison column names",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#afbdf8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Table and tabs background",
      "default": "#f3feee"
    },
