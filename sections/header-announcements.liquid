

{%- liquid
  assign is_scroll = false
  if section.settings.display_style == 'scroll'
    assign is_scroll = true
  endif
-%}

{% if is_scroll %}
  {%- comment -%} Somna V2: the scrolling style reuses Horizon's marquee component. {%- endcomment -%}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{% if is_scroll %} announcement-bar--scroll{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% if is_scroll %}
    {%- comment -%}
      Screen readers and keyboard users get each announcement once, here.
      The moving copy below is decorative (it repeats the same text) and is hidden from them.
    {%- endcomment -%}
    <div class="announcement-bar__accessible-text">
      {% for block in section.blocks %}
        {%- assign plain_text = block.settings.text | strip_newlines | strip_html | strip -%}
        {%- if plain_text != '' -%}
          {%- if block.settings.link != blank -%}
            <a class="visually-hidden announcement-bar__accessible-link" href="{{ block.settings.link }}">{{ plain_text }}</a>
          {%- else -%}
            <p class="visually-hidden">{{ plain_text }}</p>
          {%- endif -%}
        {%- endif -%}
      {% endfor %}
    </div>

    <marquee-component
      class="announcement-bar__marquee"
      aria-hidden="true"
      data-speed-factor="{{ section.settings.scroll_speed }}"
      data-movement-direction="normal"
      style="--marquee-gap: {{ section.settings.scroll_gap }}px; --marquee-direction: normal;"
    >
      <div class="marquee__wrapper" ref="wrapper">
        <div class="marquee__content" ref="content">
          <div class="marquee__repeated-items" ref="marqueeItems[]">
            {% content_for 'blocks' %}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  /* Somna V2: scrolling announcement style (opt-in via "Display style") */
  .announcement-bar--scroll {
    position: relative;
    overflow: hidden;
  }

  /* the strip runs edge to edge whatever the section width setting */
  .announcement-bar--scroll > .announcement-bar__marquee {
    grid-column: 1 / -1;
  }

  .announcement-bar__marquee-item {
    position: relative;
    flex-shrink: 0;
  }

  .announcement-bar__marquee-item .announcement-bar__text {
    margin: 0;
    white-space: nowrap;
  }

  /* The accessible copy takes no space in the strip's grid */
  .announcement-bar__accessible-text {
    display: contents;
  }

  /* A focused keyboard link becomes visible over the strip */
  .announcement-bar__accessible-link:focus-visible {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    background: var(--color-background);
    color: var(--color-foreground);
    outline-offset: calc(var(--focus-outline-offset) * -1);
  }

  /* Reduced motion: no movement, one centred copy that may wrap */
  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee .marquee__wrapper,
    .announcement-bar__marquee .marquee__content,
    .announcement-bar__marquee .marquee__repeated-items {
      width: 100%;
      min-width: 0;
      justify-content: center;
    }

    .announcement-bar__marquee .marquee__content:not(:first-child),
    .announcement-bar__marquee .marquee__repeated-items:not(:first-child) {
      display: none;
    }

    .announcement-bar__marquee .marquee__repeated-items {
      flex-wrap: wrap;
      row-gap: var(--gap-2xs);
    }

    .announcement-bar__marquee .announcement-bar__marquee-item .announcement-bar__text {
      white-space: normal;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "options": [
        {
          "value": "slideshow",
          "label": "Rotate one at a time"
        },
        {
          "value": "scroll",
          "label": "Scroll continuously"
        }
      ],
      "default": "slideshow",
      "info": "Scrolling pauses on hover and stays still for visitors who turn off motion."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.display_style != 'scroll' }}"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll duration",
      "info": "Higher is slower.",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 25,
      "unit": "sec",
      "visible_if": "{{ section.settings.display_style == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "scroll_gap",
      "label": "Gap between repeats",
      "min": 16,
      "max": 160,
      "step": 8,
      "default": 64,
      "unit": "px",
      "visible_if": "{{ section.settings.display_style == 'scroll' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
