{%- comment -%}
  Somna V2 — wave divider section. Pick the colour of the section above and the one below.
{%- endcomment -%}
{%- render 'somna-wave',
  top: section.settings.top_color,
  bottom: section.settings.bottom_color,
  flip: section.settings.flip,
  drops: section.settings.drops,
  height: section.settings.height,
  height_mobile: section.settings.height_mobile
-%}

{% schema %}
{
  "name": "Somna wave",
  "tag": "div",
  "class": "section-somna-wave",
  "settings": [
    {
      "type": "color",
      "id": "top_color",
      "label": "Colour above",
      "default": "#0b0f1d"
    },
    {
      "type": "color",
      "id": "bottom_color",
      "label": "Colour below",
      "default": "#f3feee"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Flip horizontally",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "drops",
      "label": "Show drops",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Somna wave"
    }
  ]
}
{% endschema %}
