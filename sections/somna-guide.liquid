{%- doc -%}
  Somna V2 — "How to use" product guide. One section per product: photo (packaging + product),
  eyebrow, heading, how-it-works text and a shop link; then the application steps (one block per
  step: photo, title, text) numbered 01, 02, 03; then a note (removal / safety guidance).
  Step cards follow the PDP "Three steps" look.
{%- enddoc -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign steps = section.blocks | where: 'type', 'step'
-%}
<div
  {% if s.anchor != blank %}id="{{ s.anchor | handleize }}"{% endif %}
  class="somna-guide somna-guide--media-{{ s.media_side }}{% if s.layout == 'split' %} somna-guide--split{% endif %}"
  style="--sg-bg: {{ s.background_color }}; --sg-fg: {{ s.text_color }}; --sg-card: {{ s.card_color }}; --sg-card-fg: {{ s.card_text_color }}; --sg-accent: {{ s.accent_color }}; --sg-note: {{ s.note_color }}; --sg-note-fg: {{ s.note_text_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  {%- if s.layout == 'split' -%}
    {%- comment -%}
      Split (Figma 4859:1740): product cut-out on the left with the heading over its lower edge and the "How it works"
      text under it; numbered step rows (photo + number + text) and the note on the right. Without steps the heading,
      text and an optional product card sit on the right (Using them together); a second image adds "+" between the two.
    {%- endcomment -%}
    {%- liquid
      assign hop = false
      if s.cutout_motion == 'hop'
        assign hop = true
      endif
    -%}
    {%- if hop -%}<somna-guide-hop class="somna-container somna-guide__split{% if steps.size == 0 %} somna-guide__split--copy{% endif %}">{%- else -%}
    <div class="somna-container somna-guide__split{% if steps.size == 0 %} somna-guide__split--copy{% endif %}">
    {%- endif -%}
      <div class="somna-guide__left">
        <div class="somna-guide__figure somna-guide__figure--{{ s.image_align | default: 'right' }}">
          {%- if s.image != blank -%}{{ s.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 340px, 60vw', loading: 'lazy', class: 'somna-guide__cutout', alt: s.image.alt | default: '' }}{%- endif -%}
          {%- if s.image_2 != blank -%}
            <span class="somna-guide__plus" aria-hidden="true">+</span>
            {{ s.image_2 | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 300px, 50vw', loading: 'lazy', class: 'somna-guide__cutout somna-guide__cutout--2', alt: s.image_2.alt | default: '' }}
          {%- endif -%}
          {%- if steps.size > 0 and s.heading != blank -%}<h2 class="somna-guide__heading somna-guide__heading--over">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- if steps.size > 0 and s.text != blank -%}
          <div class="somna-guide__text somna-guide__text--split">{%- if s.label != blank -%}<strong>{{ s.label | escape }}: </strong>{%- endif -%}{{ s.text | remove: '<p>' | remove: '</p>' }}</div>
        {%- endif -%}
      </div>

      <div class="somna-guide__right">
        {%- if steps.size > 0 -%}
          <ol class="somna-guide__rows" role="list">
            {%- for block in steps -%}
              {%- assign b = block.settings -%}
              <li class="somna-guide__row" {{ block.shopify_attributes }}>
                <div class="somna-guide__row-photo">
                  {%- if b.image != blank -%}{{ b.image | image_url: width: 600 | image_tag: widths: '300, 600', sizes: '253px', loading: 'lazy', style: b.image_position, alt: b.title }}{%- endif -%}
                </div>
                <div class="somna-guide__row-body">
                  <p class="somna-guide__row-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                  <p class="somna-guide__row-text">{{ b.text | default: b.title | escape }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ol>
          {%- if s.note != blank -%}<div class="somna-guide__plain-note">{{ s.note }}</div>{%- endif -%}
        {%- else -%}
          {%- if s.heading != blank -%}<h2 class="somna-guide__heading">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<div class="somna-guide__plain-note">{{ s.text }}</div>{%- endif -%}
          {%- assign cp = s.card_product -%}
          {%- if cp != blank -%}
            {%- liquid
              assign cv = cp.selected_or_first_available_variant
              assign once_factor = 100 | minus: settings.somna_once_discount
              assign low = cv.price
              if cp.selling_plan_groups.size > 0
                assign low = cv.price | times: once_factor | divided_by: 100
                for a in cv.selling_plan_allocations
                  if a.price < low
                    assign low = a.price
                  endif
                endfor
              endif
              assign card_img = s.card_image | default: cp.featured_image
            -%}
            <div class="somna-guide__card">
              <a class="somna-guide__card-media" href="{{ cp.url }}" tabindex="-1" aria-hidden="true">
                {%- if card_img != blank -%}{{ card_img | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </a>
              <div class="somna-guide__card-body">
                {%- capture card_rating -%}{%- if s.card_rating contains '[rating]' -%}{%- render 'somna-rating', product: s.card_product, format: s.card_rating -%}{%- else -%}{{ s.card_rating }}{%- endif -%}{%- endcapture -%}{%- assign card_rating = card_rating | strip -%}
                {%- if card_rating != blank -%}<p class="somna-guide__card-rating"><span aria-hidden="true">★★★★★</span> {{ card_rating | escape }}</p>{%- endif -%}
                <p class="somna-guide__card-title"><a href="{{ cp.url }}">{{ s.card_title | default: cp.title | escape }}</a></p>
                {%- if s.card_text != blank -%}<p class="somna-guide__card-text">{%- capture low_money -%}{{ low | money }}{%- endcapture -%}{{ s.card_text | replace: '[price]', low_money | escape }}</p>{%- endif -%}
              </div>
              <a class="somna-guide__card-button" href="{{ cp.url }}">{{ s.card_button | escape }}<span class="visually-hidden">: {{ cp.title | escape }}</span></a>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- if hop -%}</somna-guide-hop>{%- else -%}</div>{%- endif -%}
  {%- else -%}
  <div class="somna-container">
    <div class="somna-guide__intro">
      <div class="somna-guide__media">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              class: 'somna-guide__image',
              style: s.image_position
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'somna-guide__image' }}
        {%- endif -%}
      </div>
      <div class="somna-guide__copy">
        {%- if s.eyebrow != blank -%}<p class="somna-guide__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="somna-guide__heading somna-accent">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.label != blank -%}<p class="somna-guide__label">{{ s.label | escape }}</p>{%- endif -%}
        {%- if s.text != blank -%}<div class="somna-guide__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank and s.button_link != blank -%}
          <a class="somna-guide__button" href="{{ s.button_link }}">{{ s.button_label | escape }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    </div>

    {%- if steps.size > 0 -%}
      {%- if s.steps_heading != blank -%}<h3 class="somna-guide__steps-heading">{{ s.steps_heading | escape }}</h3>{%- endif -%}
      <ol class="somna-guide__steps" role="list">
        {%- for block in steps -%}
          {%- assign b = block.settings -%}
          <li class="somna-guide__step" {{ block.shopify_attributes }}>
            <div class="somna-guide__photo">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '160px', loading: 'lazy', class: 'somna-guide__photo-img', style: b.image_position }}
              {%- endif -%}
            </div>
            <div class="somna-guide__step-body">
              <p class="somna-guide__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
              <h4 class="somna-guide__step-title">{{ b.title | escape }}</h4>
              {%- if b.text != blank -%}<p class="somna-guide__step-text">{{ b.text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if s.note != blank -%}
      <div class="somna-guide__note">
        <span class="somna-guide__note-icon">{%- render 'somna-line-icon', name: s.note_icon, class: 'somna-guide__svg', stroke: 1.6 -%}</span>
        <div class="somna-guide__note-text">{{ s.note }}</div>
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>


{%- if section.settings.cutout_motion == 'hop' -%}
<script type="module">
  /* How to use: the product cut-out hop-flips in (like the product page "Small strip. Simple routine." section),
     lands with a small squash and then floats; the step rows follow one by one. Plays when the section is a third
     up the screen, resets once it is completely below the screen. */
  if (!customElements.get('somna-guide-hop')) {
    customElements.define('somna-guide-hop', class extends HTMLElement {
      connectedCallback() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.cutouts = [...this.querySelectorAll('.somna-guide__cutout')];
        if (!this.cutouts.length) return;
        this.anims = [];
        this.classList.add('is-pending');
        this.io = new IntersectionObserver(([e]) => e.isIntersecting && this.play(), { rootMargin: '0px 0px -8% 0px', threshold: 0 });
        this.out = new IntersectionObserver(([e]) => !e.isIntersecting && e.boundingClientRect.top > 0 && this.reset());
        this.io.observe(this);
        this.out.observe(this);
      }
      disconnectedCallback() {
        this.io?.disconnect();
        this.out?.disconnect();
        this.anims?.forEach((a) => a.cancel());
      }
      reset() {
        if (!this.played) return;
        this.anims.forEach((a) => a.cancel());
        this.anims = [];
        this.played = false;
        this.classList.remove('is-done');
        this.classList.add('is-pending');
      }
      play() {
        if (this.played) return;
        this.played = true;
        const add = (el, kf, opt) => { const a = el.animate(kf, { fill: 'both', ...opt }); this.anims.push(a); return a; };
        this.classList.remove('is-pending');
        const two = this.cutouts.length > 1;
        this.cutouts.forEach((im, i) => {
          const dx = i === 0 ? -140 : 140;
          const delay = i * 120;
          add(im, [
            { transform: `translate3d(${dx}px, 0, 0) rotateY(0deg)`, opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.12 },
            { transform: `translate3d(${dx * 0.45}px, ${two ? -90 : -110}px, 0) rotateY(180deg)`, offset: 0.5 },
            { transform: 'translate3d(0, 0, 0) rotateY(360deg)', opacity: 1, offset: 1 },
          ], { duration: two ? 750 : 850, delay, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' });
          const squash = add(im, [{ scale: '1 1' }, { scale: '1.05 0.94' }, { scale: '0.99 1.02' }, { scale: '1 1' }], { duration: 320, delay: delay + (two ? 720 : 820), easing: 'ease-out', fill: 'none' });
          if (i === this.cutouts.length - 1) squash.finished.then(() => this.played && this.classList.add('is-done')).catch(() => {});
        });
        const plus = this.querySelector('.somna-guide__plus');
        if (plus) add(plus, [{ opacity: 0, transform: 'scale(0.3) rotate(-90deg)' }, { opacity: 1, transform: 'scale(1.15) rotate(0deg)', offset: 0.7 }, { opacity: 1, transform: 'scale(1)' }], { duration: 380, delay: 520, easing: 'ease-out' });
        const start = 150;
        [...this.querySelectorAll('.somna-guide__row')].forEach((row, i) => {
          add(row, [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], { duration: 380, delay: start + i * 120, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
        });
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-guide {
    scroll-margin-top: 90px;
    background: var(--sg-bg);
    color: var(--sg-fg);
  }

  .somna-guide__intro {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  .somna-guide__media {
    overflow: hidden;
    border-radius: 12px;
  }

  .somna-guide__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .somna-guide__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .somna-guide__eyebrow {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .somna-guide__heading {
    --somna-accent: var(--sg-accent);
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .somna-guide__label {
    margin: 4px 0 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--sg-accent);
  }

  .somna-guide__text {
    max-width: 36em;
    font-size: 1rem;
    letter-spacing: 0.06em;
    line-height: 1.45;
  }

  .somna-guide__text p {
    margin: 0;
  }

  .somna-guide__button {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 52px;
    margin-top: 6px;
    padding: 0 26px;
    border-radius: 12px;
    background: var(--sg-accent);
    color: #000;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .somna-guide__button:hover {
    background: #0b0f1d;
    color: #f3feee;
    transform: translateY(-2px);
  }

  .somna-guide__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .somna-guide__steps-heading {
    margin: 40px 0 18px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .somna-guide__steps {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .somna-guide__step {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 18px;
    border-radius: 12px;
    background: var(--sg-card);
    color: var(--sg-card-fg);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .somna-guide__photo {
    overflow: hidden;
    flex: none;
    width: 104px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sg-accent);
  }

  .somna-guide__photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .somna-guide__step-body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .somna-guide__num {
    justify-self: start;
    margin: 0 0 4px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--sg-accent);
    color: #000;
    font-family: var(--font-accent--family);
    font-size: 1rem;
    font-weight: var(--font-accent--weight);
    line-height: 1.2;
  }

  .somna-guide__step-title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-guide__step-text {
    margin: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  .somna-guide__note {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 20px;
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--sg-note);
    color: var(--sg-note-fg);
  }

  .somna-guide__note-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--sg-note-fg);
    color: var(--sg-note);
  }

  .somna-guide__svg {
    width: 22px;
    height: 22px;
  }

  .somna-guide__note-text {
    align-self: center;
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  .somna-guide__note-text p {
    margin: 0;
  }

  .somna-guide__note-text p + p {
    margin-top: 6px;
  }


  /* ---- Split layout (Figma 4859:1740) ---- */
  .somna-guide--split {
    --somna-content-width: 1232px;
  }

  .somna-guide__split {
    display: grid;
    gap: 28px;
  }

  .somna-guide__figure {
    position: relative;
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 260px;
  }

  .somna-guide__figure--right {
    justify-content: flex-end;
  }

  .somna-guide__cutout {
    display: block;
    width: auto;
    max-width: 62%;
    height: clamp(260px, 31vw, 448px);
    object-fit: contain;
  }

  .somna-guide__split--copy .somna-guide__cutout {
    max-width: 46%;
    height: clamp(240px, 28.6vw, 412px);
  }

  .somna-guide__plus {
    flex: none;
    font-family: var(--font-accent--family);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 1;
  }

  .somna-guide__heading--over {
    position: absolute;
    right: 4px;
    bottom: 16px;
    max-width: 300px;
    font-size: clamp(2rem, 3.2vw, 2.874rem);
    line-height: 1.35;
  }

  .somna-guide__text--split {
    max-width: 558px;
    margin-top: 24px;
    font-size: clamp(0.9375rem, 1.37vw, 1.2315rem);
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .somna-guide__rows {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-guide__row {
    display: grid;
    grid-template-columns: minmax(0, 253px) minmax(0, 1fr);
    gap: 19px;
    align-items: start;
  }

  .somna-guide__row-photo {
    overflow: hidden;
    aspect-ratio: 253 / 154;
    border-radius: 10px;
    background: #fff;
  }

  .somna-guide__row-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .somna-guide__row:hover .somna-guide__row-photo img {
    transform: scale(1.05);
  }

  .somna-guide__row-body {
    display: grid;
    gap: 2px;
    max-width: 335px;
  }

  .somna-guide__row-num {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, 2.7vw, 2.4525rem);
    line-height: 1.35;
  }

  .somna-guide__row-text {
    margin: 0;
    font-size: clamp(0.9375rem, 1.48vw, 1.3284rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .somna-guide__plain-note {
    max-width: 630px;
    margin-top: 26px;
    font-size: clamp(0.9375rem, 1.48vw, 1.3284rem);
    line-height: 1.18;
  }

  .somna-guide__plain-note p {
    margin: 0;
  }

  .somna-guide__split--copy .somna-guide__right .somna-guide__heading {
    font-size: clamp(2rem, 3.2vw, 2.874rem);
    line-height: 1.35;
  }

  .somna-guide__split--copy .somna-guide__plain-note {
    margin-top: 10px;
  }

  /* product card (Figma 4884:2021): navy pill with photo, rating, title, price and a lavender button */
  .somna-guide__card {
    display: grid;
    grid-template-columns: 126px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    max-width: 610px;
    margin-top: 36px;
    padding: 11px 19px 11px 19px;
    border: 1.4px solid rgb(0 0 0 / 0.1);
    border-radius: 23px;
    background: #0b0f1d;
    color: #f4fef3;
  }

  .somna-guide__card-media {
    overflow: hidden;
    display: block;
    height: 100px;
    border-radius: 8px;
  }

  .somna-guide__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-guide__card-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .somna-guide__card-rating {
    margin: 0;
    color: #7e7e7e;
    font-size: 0.9375rem;
    font-weight: 300;
  }

  .somna-guide__card-rating span {
    color: #efb400;
  }

  .somna-guide__card-title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.0625rem, 1.44vw, 1.294rem);
    line-height: 1.35;
  }

  .somna-guide__card-title a {
    color: inherit;
    text-decoration: none;
  }

  .somna-guide__card-text {
    margin: 0;
    color: rgb(244 254 243 / 0.75);
    font-size: 0.8125rem;
    font-weight: 300;
  }

  .somna-guide__card-button {
    display: grid;
    place-items: center;
    min-width: 152px;
    min-height: 91px;
    padding: 0 12px;
    border-radius: 13.5px;
    background: var(--sg-accent);
    color: #000;
    filter: drop-shadow(0 5.6px 8.4px rgb(0 0 0 / 0.25));
    font-size: clamp(1.0625rem, 1.6vw, 1.4346rem);
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    transition: translate 0.2s ease, background-color 0.2s ease;
  }

  .somna-guide__card-button:hover {
    background: #f3feee;
    translate: 0 -2px;
  }

  @media screen and (min-width: 990px) {
    .somna-guide__split {
      grid-template-columns: minmax(0, 558px) minmax(0, 633px);
      justify-content: space-between;
      gap: 48px;
      align-items: start;
    }

    .somna-guide__split--copy {
      align-items: center;
    }

    .somna-guide__figure {
      min-height: 448px;
    }

    .somna-guide__split--copy .somna-guide__figure {
      min-height: 412px;
    }
  }

  @media screen and (max-width: 749px) {
    /* phones: tight bands, the waves between sections already give the breathing room */
    .somna-guide {
      padding-block: 8px 12px !important;
    }

    /* phones: cut-out on the left, the heading over its lower right like desktop */
    .somna-guide__figure {
      justify-content: flex-start;
      min-height: 0;
    }

    .somna-guide__cutout {
      height: 240px;
    }

    .somna-guide__heading--over {
      right: 0;
      bottom: 8px;
      max-width: 55%;
    }

    .somna-guide__row {
      grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
      gap: 12px;
    }

    .somna-guide__card {
      grid-template-columns: 84px minmax(0, 1fr);
      padding: 10px;
      border-radius: 16px;
    }

    .somna-guide__card-media {
      height: 66px;
    }

    .somna-guide__card-button {
      grid-column: 1 / -1;
      min-height: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-guide__row-photo img,
    .somna-guide__card-button {
      transition: none;
    }
  }

  @media screen and (min-width: 750px) {
    .somna-guide__intro {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(28px, 4.5vw, 72px);
    }

    .somna-guide--media-right .somna-guide__media {
      order: 2;
    }

    .somna-guide__image {
      aspect-ratio: 5 / 4;
    }

    .somna-guide__eyebrow {
      font-size: clamp(15px, 1.25vw, 18px);
    }

    .somna-guide__text {
      font-size: clamp(1rem, 1.37vw, 1.2rem);
    }

    .somna-guide__steps-heading {
      margin-top: clamp(40px, 5vw, 72px);
    }

    .somna-guide__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .somna-guide__step {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: clamp(20px, 2.2vw, 32px);
    }

    .somna-guide__photo {
      width: clamp(120px, 11vw, 160px);
    }

    .somna-guide__step:hover {
      box-shadow: 0 14px 30px rgb(11 15 29 / 0.16);
      transform: translateY(-4px);
    }

    .somna-guide__step:hover .somna-guide__photo-img {
      transform: scale(1.06);
    }

    .somna-guide__note {
      align-items: center;
      margin-top: 24px;
      padding: 20px 28px;
    }

    .somna-guide__note-text {
      font-size: clamp(1rem, 1.25vw, 1.125rem);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-guide__step {
      padding: 18px;
    }

    .somna-guide__photo {
      width: 104px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-guide__step,
    .somna-guide__photo-img,
    .somna-guide__button {
      transition: none;
      transform: none !important;
    }
  }

  /* cut-out motion (setting "Product picture motion"): 3D flip, then a gentle float */
  somna-guide-hop .somna-guide__figure {
    perspective: 1100px;
  }

  somna-guide-hop.is-pending :is(.somna-guide__cutout, .somna-guide__plus, .somna-guide__row) {
    opacity: 0;
  }

  somna-guide-hop.is-done .somna-guide__cutout {
    animation: somnaGuideFloat 4s ease-in-out infinite;
  }

  somna-guide-hop.is-done .somna-guide__cutout--2 {
    animation-delay: -2s;
  }

  @keyframes somnaGuideFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    somna-guide-hop.is-done .somna-guide__cutout {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna how-to guide",
  "tag": "section",
  "class": "somna-guide-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Link to this section with #anchor, e.g. nasal-strips." },
    { "type": "select", "id": "cutout_motion", "label": "Product picture motion (split)", "options": [{ "value": "none", "label": "Still" }, { "value": "hop", "label": "Hop-flip in, then float" }], "default": "none" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "stacked", "label": "Photo + text, step cards below" }, { "value": "split", "label": "Split: product cut-out left, numbered steps right" }], "default": "stacked" },
    { "type": "image_picker", "id": "image_2", "label": "Second image (split)", "info": "Split layout without steps: shown after a \"+\" (Using them together)." },
    { "type": "select", "id": "image_align", "label": "Cut-out position (split)", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "right" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Packaging + product photo." },
    { "type": "text", "id": "image_position", "label": "Image focal point", "default": "object-position: center", "info": "CSS, e.g. object-position: 70% 50%" },
    { "type": "select", "id": "media_side", "label": "Image side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Italic words take the accent colour." },
    { "type": "text", "id": "label", "label": "Label", "default": "How it works" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "How to apply" },
    { "type": "richtext", "id": "note", "label": "Note", "info": "Removal or safety guidance under the steps." },
    { "type": "header", "content": "Product card (split, without steps)" },
    { "type": "product", "id": "card_product", "label": "Product" },
    { "type": "image_picker", "id": "card_image", "label": "Card image", "info": "Defaults to the product image." },
    { "type": "text", "id": "card_rating", "label": "Rating text", "default": "[rating]/5 · [count] reviews", "info": "[rating] and [count] come from Judge.me for the card product." },
    { "type": "text", "id": "card_title", "label": "Title", "info": "Defaults to the product name." },
    { "type": "text", "id": "card_text", "label": "Price line", "default": "Both, from [price]", "info": "[price] is the lowest price (Subscribe & Save or the one-time sale price)." },
    { "type": "text", "id": "card_button", "label": "Button", "default": "Shop now" },
    {
      "type": "select",
      "id": "note_icon",
      "label": "Note icon",
      "options": [{ "value": "moon", "label": "Moon" }, { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" }, { "value": "question", "label": "Question" }],
      "default": "moon"
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3feee" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "card_color", "label": "Step card", "default": "#0b0f1d" },
    { "type": "color", "id": "card_text_color", "label": "Step card text", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#afbdf8" },
    { "type": "color", "id": "note_color", "label": "Note background", "default": "#afbdf8" },
    { "type": "color", "id": "note_text_color", "label": "Note text", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_position", "label": "Photo focal point", "default": "object-position: center" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Somna how-to guide", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
