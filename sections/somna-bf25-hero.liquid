{%- comment -%}
  Somna V2 — Black Friday 2026 homepage hero (Figma "DESKTOP VER BLACKFRIDAY", nodes 5376:1267 desktop / 5387:2448 phones).
  Full-bleed foggy night photo with the two pouches (black ribbon) behind a transparent header; on the left the
  "70% OFF" tag + "BLACK FRIDAY" lettering (image), "WITH SUBSCRIBE & SAVE", tagline, live price line, three icons,
  SHOP NOW button and a proof row (30-night seal, stars, quote, customer photos, rating line).
  Phones: everything centred, then the pouches photo (its fog rises behind the button), then the proof row.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign p = s.price_product
  assign sub = nil
  if p != blank
    for v in p.variants
      for a in v.selling_plan_allocations
        if sub == nil or a.price < sub
          assign sub = a.price
        endif
      endfor
    endfor
    if sub != nil and s.first_box_off > 0
      assign sub = s.first_box_off | times: 100 | round | times: -1 | plus: sub
    endif
  endif
  # real review numbers: average of the chosen products, weighted by each product's count
  assign rev_total = 0
  assign rev_weighted = 0.0
  for rp in s.review_products
    capture one
      render 'somna-review-summary', product: rp
    endcapture
    assign one = one | strip
    if one != blank
      assign one_count = one | split: '|' | last | plus: 0
      assign one_rating = one | split: '|' | first | times: 1.0
      assign rev_total = rev_total | plus: one_count
      assign rev_weighted = one_rating | times: one_count | plus: rev_weighted
    endif
  endfor
  assign rev_rating = ''
  if rev_total > 0
    assign rev_rating = rev_weighted | divided_by: rev_total | round: 1
  endif
  # three real customer photos (Judge.me) for the little avatar stack
  assign faces = ''
  assign face_n = 0
  for rp in s.review_products
    for rv in rp.metafields.judgeme.review_widget_data.value.photo_gallery
      for pic in rv.pictures_urls limit: 1
        if face_n < 3
          assign pic_src = pic.original | default: pic.huge | split: '&width=' | first
          assign faces = faces | append: pic_src | append: '^'
          assign face_n = face_n | plus: 1
        endif
      endfor
      if face_n >= 3
        break
      endif
    endfor
    if face_n >= 3
      break
    endif
  endfor
  assign faces = faces | split: '^'
  assign accent = settings.type_accent_font
-%}
<style>{{ accent | font_face: font_display: 'swap' }}</style>
<div class="somna-bf25" style="--bf25-bg: {{ s.background_color }}; --bf25-cond: {{ accent.family }}, {{ accent.fallback_families }};">
  <div class="somna-bf25__bg" aria-hidden="true">
    {%- if s.image != blank -%}
      <div class="somna-bf25__bg-box">{{ s.image | image_url: width: 2400 | image_tag: class: 'somna-bf25__bg-img', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '990, 1440, 1920, 2400', alt: '' }}</div>
    {%- endif -%}
  </div>

  <div class="somna-bf25__inner somna-container">
    <div class="somna-bf25__copy">
      <h1 class="somna-bf25__title">
        {%- assign t_mob = s.title_image_mobile | default: s.title_image -%}
        {%- if s.title_image != blank -%}
          <picture>
            {%- if t_mob != blank -%}<source media="(max-width: 989px)" srcset="{{ t_mob | image_url: width: 760 }} 2x, {{ t_mob | image_url: width: 380 }} 1x">{%- endif -%}
            {{ s.title_image | image_url: width: 1040 | image_tag: class: 'somna-bf25__title-img', loading: 'eager', fetchpriority: 'high', widths: '520, 1040', sizes: '(min-width: 990px) 520px, 95vw', alt: s.title_alt }}
          </picture>
        {%- else -%}
          {{ s.title_alt }}
        {%- endif -%}
      </h1>
      {%- if s.subheading != blank -%}<p class="somna-bf25__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.tagline != blank -%}<div class="somna-bf25__tagline">{{ s.tagline }}</div>{%- endif -%}
      {%- if s.price_line != blank and sub -%}
        {%- capture sub_html -%}<b>{{ sub | money }}{% if s.price_suffix != blank %} {{ s.price_suffix | strip }}{% endif %}</b>{%- endcapture -%}
        <p class="somna-bf25__price">{{ s.price_line | replace: '[price]', sub_html }}</p>
      {%- endif -%}

      {%- if s.benefits != blank -%}
        {%- assign perks = s.benefits | newline_to_br | split: '<br />' -%}
        <ul class="somna-bf25__perks" role="list">
          {%- for t in perks -%}
            {%- assign t = t | strip -%}
            {%- if t == blank -%}{%- continue -%}{%- endif -%}
            {%- assign low = t | downcase -%}
            <li>
              {%- if low contains 'gift' -%}
                <svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="5" y="11" width="22" height="6" rx="1.2"/><path d="M7 17v10h18V17M16 11v16M16 11c-1.6-4-7-4.8-7-1.6C9 11 13 11 16 11zm0 0c1.6-4 7-4.8 7-1.6 0 1.6-4 1.6-7 1.6z"/></svg>
              {%- elsif low contains 'night' or low contains 'guarantee' -%}
                <svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M16 4l10 4v7c0 6.5-4.3 11.4-10 13-5.7-1.6-10-6.5-10-13V8z"/><path d="M11.5 16l3.2 3.2 6-6.4" stroke-linecap="round"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 25C7 14 14 7 26 6c0 12-6 19-16 19z"/><path d="M7 25c4-6 8-10 13-13"/><path d="M5 18c-1-5 1-9 5-11"/></svg>
              {%- endif -%}
              <span>{{ t }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a class="somna-bf25__btn" href="{{ s.button_link | default: '/pages/black-friday-sale' }}">{{ s.button_label }} <svg viewBox="0 0 24 20" aria-hidden="true" fill="none"><path d="M2 10h19M13 2.5L21 10l-8 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {%- endif -%}

      {%- if s.image_mobile != blank -%}
        <div class="somna-bf25__mob-media" aria-hidden="true">
          {{ s.image_mobile | image_url: width: 900 | image_tag: class: 'somna-bf25__mob-img', loading: 'eager', sizes: '100vw', widths: '450, 800, 900', alt: '' }}
        </div>
      {%- endif -%}

      <div class="somna-bf25__proof">
        {% render 'somna-night-seal' %}
        <div class="somna-bf25__proof-txt">
          <p class="somna-bf25__stars" aria-label="5 out of 5 stars">★★★★★</p>
          {%- if s.quote != blank -%}<p class="somna-bf25__quote">{{ s.quote }}</p>{%- endif -%}
          {%- if s.quote_name != blank -%}<p class="somna-bf25__who">{{ s.quote_name }} <span>{{ s.quote_badge }}</span></p>{%- endif -%}
          {%- if s.reviews_line != blank -%}
            <p class="somna-bf25__join">
              {%- if faces.size > 0 -%}
                <span class="somna-bf25__faces" aria-hidden="true">
                  {%- for f in faces -%}<img src="{{ f }}&width=64" alt="" width="18" height="18" loading="lazy" decoding="async">{%- endfor -%}
                </span>
              {%- endif -%}
              <span>{{ s.reviews_line | replace: '[rating]', rev_rating | replace: '[count]', rev_total }}</span>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .somna-bf25 { --somna-content-width: 1360px; position: relative; isolation: isolate; overflow: hidden; background: var(--bf25-bg); color: #f3feee; }
  /* the photo is the whole Figma frame (1440 × 918), header area included */
  .somna-bf25__bg { position: absolute; inset: 0; z-index: -1; }
  /* like the live hero: the photo sits inside the content width (1360px, same as the header), 64% wide, its right edge on the content edge, starting under the header and never taller than the first screen */
  .somna-bf25__bg-box { position: absolute; top: var(--header-group-height, 0px); right: max(var(--page-margin, 16px), calc((100% - var(--somna-content-width)) / 2)); width: calc(min(100% - var(--page-margin, 16px) * 2, var(--somna-content-width)) * 0.64); height: min(100% - var(--header-group-height, 0px), 100svh - var(--header-group-height, 0px)); }
  .somna-bf25__bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 100% 70%; -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%, #000 90%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 10%, #000 86%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0%, #000 30%, #000 90%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 10%, #000 86%, transparent 100%); mask-composite: intersect; }
  .somna-bf25__bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgb(10 14 28 / 0.9) 0%, rgb(10 14 28 / 0) 34%),
      linear-gradient(to top, rgb(11 15 29 / 0.85) 0%, rgb(11 15 29 / 0) 30%),
      linear-gradient(to right, rgb(11 15 29 / 0.55) 0%, rgb(11 15 29 / 0) 45%);
  }
  .somna-bf25__inner {
    display: flex; align-items: center; min-height: clamp(600px, min(63.75vw, 100svh), 1020px);
    padding-block: calc(var(--header-group-height, 0px) + clamp(12px, 2vw, 32px)) clamp(32px, 4vw, 72px);
  }
  .somna-bf25__copy { width: min(100%, clamp(430px, 38vw, 600px)); }
  @media screen and (min-width: 1200px) { .somna-bf25__copy { margin-left: clamp(24px, 4vw, 72px); } }
  @media screen and (min-width: 1600px) { .somna-bf25__copy { margin-left: clamp(72px, 8vw, 180px); } }
  @media screen and (min-width: 990px) and (max-width: 1199px) { .somna-bf25__bg-box { width: 46%; } .somna-bf25__copy { width: 52%; } }
  .somna-bf25__title { margin: 0; font-size: 0; line-height: 0; }
  /* the lettering image starts with the tag, which hangs ~9% to the left of the text column */
  .somna-bf25__title-img { display: block; width: clamp(320px, 29vw, 480px); height: auto; margin-left: calc(clamp(320px, 29vw, 480px) * -0.09); mix-blend-mode: lighten; }
  .somna-bf25__sub {
    margin: calc(clamp(320px, 29vw, 480px) * -0.12) 0 0; color: #afbdf8; font-family: var(--bf25-cond); font-size: clamp(2rem, 3.2vw, 3.25rem); font-weight: 700;
    line-height: 1; letter-spacing: -0.01em; text-transform: uppercase; white-space: nowrap;
  }
  .somna-bf25__tagline { max-width: 30em; margin: clamp(10px, 1vw, 16px) 0 0; color: rgb(255 255 255 / 0.67); font-size: clamp(0.9375rem, 1.15vw, 1.125rem); font-weight: 700; line-height: 1.25; text-transform: none; }
  .somna-bf25__tagline strong, .somna-bf25__tagline b { color: inherit; font-weight: 700; }
  .somna-bf25__tagline p { margin: 0; }
  .somna-bf25__price { margin: clamp(8px, 0.8vw, 14px) 0 0; color: rgb(255 255 255 / 0.67); font-size: clamp(1rem, 1.3vw, 1.25rem); line-height: 1.3; }
  .somna-bf25__price b { color: #afbdf8; font-weight: 700; }
  .somna-bf25__perks { display: flex; gap: clamp(14px, 2vw, 34px); margin: clamp(14px, 1.3vw, 22px) 0 0; padding: 0; list-style: none; }
  .somna-bf25__perks li { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 56px; color: #fff; font-size: clamp(0.6875rem, 0.72vw, 0.75rem); line-height: 1.2; text-align: center; }
  .somna-bf25__perks svg { width: clamp(28px, 2.3vw, 34px); height: auto; }
  .somna-bf25__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 14px; width: auto; min-width: clamp(240px, 18.4vw, 280px); height: clamp(46px, 3.5vw, 52px); padding-inline: clamp(24px, 2.2vw, 34px); white-space: nowrap; margin-top: clamp(22px, 2.6vw, 40px);
    border-radius: 13px; background: #afbdf8; color: #0b0f1d; box-shadow: 0 4px 6px rgb(0 0 0 / 0.25);
    font: 800 clamp(1.25rem, 1.55vw, 1.5rem)/1 var(--font-body--family, sans-serif); letter-spacing: -0.01em; text-decoration: none; text-transform: uppercase;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .somna-bf25__btn svg { width: 24px; height: 20px; }
  .somna-bf25__btn:hover { transform: translateY(-2px); background: #c3cdfb; }
  .somna-bf25__mob-media { display: none; }
  .somna-bf25__proof { display: flex; align-items: center; gap: 12px; margin-top: clamp(16px, 1.6vw, 24px); }
  .somna-bf25__proof .somna-seal { width: 60px; height: 60px; }
  .somna-bf25__proof .somna-seal b { font-size: 22px; }
  .somna-bf25__proof .somna-seal small { font-size: 8px; }
  .somna-bf25__proof p { margin: 0; }
  .somna-bf25__stars { color: #f5c84c; font-size: 12px; letter-spacing: 0.18em; line-height: 1.2; }
  .somna-bf25__quote { margin-top: 4px !important; color: #f3feee; font-size: 12px; font-style: italic; line-height: 1.3; }
  .somna-bf25__who { margin-top: 3px !important; color: rgb(255 255 255 / 0.8); font-size: 10px; }
  .somna-bf25__who span { color: #6fbf73; }
  .somna-bf25__join { display: flex; align-items: center; gap: 8px; margin-top: 8px !important; color: rgb(255 255 255 / 0.82); font-size: clamp(0.8125rem, 1vw, 0.9375rem); }
  .somna-bf25__faces { display: inline-flex; }
  .somna-bf25__faces img { width: 18px; height: 18px; border: 1.5px solid #0b0f1d; border-radius: 50%; object-fit: cover; }
  .somna-bf25__faces img + img { margin-left: -6px; }

  /* tablets and phones: centred stack, then the pouches photo, then the proof row */
  @media screen and (max-width: 989px) {
    .somna-bf25__bg { display: none; }
    .somna-bf25__inner { display: block; min-height: 0; padding: calc(var(--header-group-height, 0px) + 12px) var(--page-margin, 16px) 28px; }
    .somna-bf25__copy { display: flex; flex-direction: column; align-items: center; width: 100%; margin: 0; text-align: center; }
    .somna-bf25__title-img { width: min(380px, 95vw); margin: 0 auto; }
    .somna-bf25__sub { margin-top: 4px; font-size: clamp(1.875rem, 8.4vw, 2.5rem); }
    .somna-bf25__tagline { max-width: 270px; margin-top: 10px; font-size: 13px; line-height: 1.3; }
    .somna-bf25__price { margin-top: 10px; font-size: 18px; }
    .somna-bf25__perks { display: grid; grid-template-columns: repeat(3, minmax(0, 104px)); justify-content: center; gap: 6px; margin-top: 16px; }
    .somna-bf25__perks li { min-width: 0; font-size: 9.5px; }
    .somna-bf25__perks svg { width: 24px; }
    .somna-bf25__btn { position: relative; z-index: 2; width: auto; min-width: 195px; height: 40px; padding-inline: 22px; margin-top: 30px; border-radius: 8px; font-size: 16px; gap: 10px; }
    .somna-bf25__btn svg { width: 20px; height: 17px; }
    /* the photo's fog rises behind the price, icons and button */
    .somna-bf25__mob-media { display: block; position: relative; z-index: 0; width: calc(100% + var(--page-margin, 16px) * 2); max-width: 520px; margin: -46vw 0 0; pointer-events: none; }
    .somna-bf25__mob-img { display: block; width: 100%; height: auto; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 88%, transparent 100%), linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 88%, transparent 100%), linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%); mask-composite: intersect; }
    .somna-bf25__copy > :not(.somna-bf25__mob-media):not(.somna-bf25__title) { position: relative; z-index: 1; }
    .somna-bf25__proof { align-self: stretch; justify-content: center; margin-top: -10px; text-align: left; }
    .somna-bf25__join { font-size: 11.5px; white-space: nowrap; }
  }
  @media screen and (min-width: 600px) and (max-width: 989px) {
    .somna-bf25__tagline { max-width: 400px; font-size: 15px; }
    .somna-bf25__price { font-size: 20px; }
    .somna-bf25__perks { grid-template-columns: repeat(3, 120px); gap: 12px; margin-top: 20px; }
    .somna-bf25__perks li { font-size: 11px; }
    .somna-bf25__perks svg { width: 28px; }
    .somna-bf25__btn { width: auto; min-width: 240px; height: 46px; padding-inline: 28px; margin-top: 32px; border-radius: 10px; font-size: 18px; }
    .somna-bf25__mob-media { max-width: 560px; margin-top: -250px; }
    .somna-bf25__quote, .somna-bf25__join { font-size: 13px; }
  }
  @media screen and (max-width: 359px) {
    .somna-bf25__join { white-space: normal; }
  }
</style>

{% schema %}
{
  "name": "Somna BF hero 2026",
  "tag": "section",
  "class": "section-somna-bf25-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo (desktop)", "info": "Full width, behind the header. Pouches on the right." },
    { "type": "image_picker", "id": "image_mobile", "label": "Pouches photo (phones)" },
    { "type": "image_picker", "id": "title_image", "label": "Black Friday lettering (desktop)" },
    { "type": "image_picker", "id": "title_image_mobile", "label": "Black Friday lettering (phones)" },
    { "type": "text", "id": "title_alt", "label": "Heading text (for search engines and screen readers)", "default": "Black Friday — 70% off" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "With Subscribe & Save" },
    { "type": "richtext", "id": "tagline", "label": "Tagline", "default": "<p>Small change, softer nights. Strips for your nose and tape for your lips.</p>" },
    { "type": "product", "id": "price_product", "label": "Price from this product", "info": "[price] = its lowest Subscribe & Save price." },
    { "type": "number", "id": "first_box_off", "label": "First-box discount ($)", "info": "Taken off [price] (e.g. 3 → $19.95)." },
    { "type": "text", "id": "price_line", "label": "Price line", "default": "From [price]" },
    { "type": "text", "id": "price_suffix", "label": "After the price (inside the colour)", "default": "a bag" },
    { "type": "textarea", "id": "benefits", "label": "Icons", "info": "One per line. \"gift\" → gift icon, \"night\"/\"guarantee\" → shield, anything else → leaf.", "default": "Drug-free\n30-Nights guarantee\n3 Free gifts" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product_list", "id": "review_products", "label": "Review numbers and customer photos from these products", "info": "[rating] = average, [count] = total reviews." },
    { "type": "text", "id": "quote", "label": "Quote", "default": "\"Easy to put on and it stays on all night.\"" },
    { "type": "text", "id": "quote_name", "label": "Quote name", "default": "Sarah M." },
    { "type": "text", "id": "quote_badge", "label": "Badge after the name", "default": "Verified Buyer" },
    { "type": "text", "id": "reviews_line", "label": "Rating line", "default": "[rating], Join 1,000+ people sleeping with SOMNA." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0b0f1d" }
  ],
  "presets": [{ "name": "Somna BF hero 2026" }]
}
{% endschema %}
