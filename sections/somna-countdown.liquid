{%- comment -%}
  Somna V2 — sale countdown bar (header group, between the announcement bar and the header). Clock tiles, digits roll up (option B), (days / hrs / min / sec) counting
  down to the real end time (setting, ISO 8601 with offset, e.g. 2026-12-02T23:59:00-08:00 = Wed 2 Dec, 11:59 PM PT).
  Desktop: moon phases · label · tiles · end date. Phones: two-line label (Sale ends / date) · tiles.
  The bar hides itself once the end time has passed (and stays hidden if the setting is empty or invalid).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cd_id = 'somna-cd-' | append: section.id
-%}
{%- if s.end_at != blank -%}
<somna-countdown
  class="somna-cd"
  id="{{ cd_id }}"
  data-end="{{ s.end_at | escape }}"
  data-moon-cycle="{{ s.moon_cycle | default: 10 }}"
  hidden
  style="--cd-bg: {{ s.bg_color }}; --cd-text: {{ s.text_color }}; --cd-accent: {{ s.accent_color }}; --cd-tile: {{ s.tile_color }}; --cd-muted: {{ s.muted_color }};"
  role="timer"
  aria-live="off"
>
  <div class="somna-cd__inner">
    <span class="somna-cd__moons" aria-hidden="true">
      {%- comment -%} five realistic moons (shaded sphere + craters) that wax from new to full in turn, all five every
        10 seconds by default (setting; approved option E2); drawn by the script below {%- endcomment -%}
      <svg viewBox="0 -2 92 20" focusable="false" data-moons></svg>
    </span>
    <p class="somna-cd__label">
      <span class="somna-cd__label-desk">{{ s.label }}{% if s.offer != blank %}<strong class="somna-cd__offer">{{ s.offer }}</strong>{% endif %}</span>
      <span class="somna-cd__label-mob"><b class="somna-cd__mob-top">{{ s.label_mobile }}{% if s.date_mobile != blank %} <span>{{ s.date_mobile }}</span>{% endif %}</b>{% if s.offer != blank %}<strong class="somna-cd__offer">{{ s.offer }}</strong>{% endif %}</span>
    </p>
    <div class="somna-cd__clock">
      {%- for unit in (1..4) -%}
        {%- liquid
          case unit
            when 1
              assign u_key = 'd'
              assign u_label = 'Days'
            when 2
              assign u_key = 'h'
              assign u_label = 'Hrs'
            when 3
              assign u_key = 'm'
              assign u_label = 'Min'
            else
              assign u_key = 's'
              assign u_label = 'Sec'
          endcase
        -%}
        {%- unless forloop.first -%}<span class="somna-cd__colon" aria-hidden="true">:</span>{%- endunless -%}
        <span class="somna-cd__unit">
          <span class="somna-cd__tile"><span class="somna-cd__num" data-cd="{{ u_key }}"><span class="somna-cd__dg"><i>0</i></span><span class="somna-cd__dg"><i>0</i></span></span></span>
          <span class="somna-cd__unit-label">{{ u_label }}</span>
        </span>
      {%- endfor -%}
    </div>
    {%- if s.date_text != blank -%}<p class="somna-cd__date">{{ s.date_text }}</p>{%- endif -%}
    <span class="somna-cd__sr" data-cd-sr></span>
  </div>
</somna-countdown>

{%- if template.name == 'product' and section.settings.pdp_land_scroll -%}
  <script>
    /* product pages: on arrival, scroll past the announcement bar so the countdown sits right under the sticky
       header and more of the product shows (like ryzesuperfoods.com). Skipped when the visitor came with a #link,
       is returning to a scrolled position, or has already scrolled. */
    (function () {
      if (location.hash || (history.state && history.state.somnaLanded)) return;
      var go = function () {
        if (window.scrollY > 5) return;
        var cd = document.querySelector('.somna-cd'); if (!cd || cd.closest('[hidden]') || !cd.offsetHeight) return;
        var hdr = document.querySelector('#header-component'); hdr = hdr && (hdr.closest('.shopify-section') || hdr);
        var off = hdr && getComputedStyle(hdr).position === 'sticky' ? hdr.getBoundingClientRect().height : 0;
        var y = cd.getBoundingClientRect().top + window.scrollY - off;
        if (y > 2) window.scrollTo({ top: y, behavior: 'auto' });
        try { history.replaceState(Object.assign({}, history.state, { somnaLanded: true }), ''); } catch (e) {}
      };
      if (document.readyState === 'complete') requestAnimationFrame(go); else window.addEventListener('load', function () { requestAnimationFrame(go); }, { once: true });
    })();
  </script>
{%- endif -%}

<script>
  if (!customElements.get('somna-countdown')) {
    customElements.define('somna-countdown', class extends HTMLElement {
      connectedCallback() {
        this.end = Date.parse(this.dataset.end);
        if (isNaN(this.end)) return;
        this.nums = {};
        this.querySelectorAll('[data-cd]').forEach((n) => { this.nums[n.dataset.cd] = n; });
        this.reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.buildMoons();
        this.tick();
        if (!this.hidden) {
          this.timer = setInterval(() => this.tick(), 1000);
          if (!this.reduce && this.phs) { const loop = () => { this.drawMoons(); this.raf = requestAnimationFrame(loop); }; this.raf = requestAnimationFrame(loop); }
        }
        // the bar's height, for pages whose first section sits under a transparent header (homepage hero)
        this.setHeight = () => document.body.style.setProperty('--somna-cd-height', (this.hidden ? 0 : this.offsetHeight) + 'px');
        this.setHeight();
        if ('ResizeObserver' in window) { this.ro = new ResizeObserver(this.setHeight); this.ro.observe(this); }
      }
      // ---- moons: realistic spheres, each waxes new → full in turn over the minute (approved option E2) ----
      buildMoons() {
        const sv = this.querySelector('[data-moons]'); if (!sv) return;
        const g = 'scd' + Math.random().toString(36).slice(2, 8), X = [8, 27, 46, 65, 84], R = 6.5;
        const CR = [[-2.2, -1.6, 1.4], [2.1, 1.4, 1.1], [-0.6, 2.6, 0.8], [1.6, -2.6, 0.7], [-3.2, 1.2, 0.6]];
        const sphere = (cx, lit) => '<circle cx="' + cx + '" cy="8" r="' + R + '" fill="url(#' + g + (lit ? 'l' : 'd') + ')"/>' +
          CR.map((c) => '<circle cx="' + (cx + c[0]) + '" cy="' + (8 + c[1]) + '" r="' + c[2] + '" fill="url(#' + g + (lit ? 'cl' : 'cd') + ')"/>').join('') +
          '<circle cx="' + cx + '" cy="8" r="' + (R - 0.2) + '" fill="none" stroke="' + (lit ? 'rgba(255,255,255,.55)' : 'rgba(175,189,248,.28)') + '" stroke-width=".4"/>';
        sv.innerHTML = '<defs>' +
          '<radialGradient id="' + g + 'l" cx="38%" cy="34%" r="70%"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#e9edff"/><stop offset=".75" stop-color="#b9c3f5"/><stop offset="1" stop-color="#7f8ad0"/></radialGradient>' +
          '<radialGradient id="' + g + 'd" cx="38%" cy="34%" r="70%"><stop offset="0" stop-color="#343b66"/><stop offset=".7" stop-color="#232945"/><stop offset="1" stop-color="#171b33"/></radialGradient>' +
          '<radialGradient id="' + g + 'cl" cx="60%" cy="60%" r="60%"><stop offset="0" stop-color="#c6cdf2"/><stop offset=".8" stop-color="#9ea9e3"/><stop offset="1" stop-color="#eef1ff" stop-opacity=".6"/></radialGradient>' +
          '<radialGradient id="' + g + 'cd" cx="60%" cy="60%" r="60%"><stop offset="0" stop-color="#151a31"/><stop offset="1" stop-color="#2b3258" stop-opacity=".6"/></radialGradient>' +
          '<filter id="' + g + 'glow" x="-30%" y="-80%" width="160%" height="260%"><feGaussianBlur stdDeviation="1.1" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>' +
          X.map((x, i) => '<clipPath id="' + g + 'c' + i + '"><path class="somna-cd__ph" d="M0 0Z"/></clipPath>').join('') + '</defs>' +
          '<g>' + X.map((x) => sphere(x, false)).join('') + '</g>' +
          '<g filter="url(#' + g + 'glow)">' + X.map((x, i) => '<g clip-path="url(#' + g + 'c' + i + ')">' + sphere(x, true) + '</g>').join('') + '</g>' +
          X.map((x) => '<circle class="somna-cd__halo" cx="' + x + '" cy="8" r="7.2" fill="none" stroke="#dfe5ff" stroke-width=".6"/>').join('');
        this.X = X; this.R = R;
        this.phs = [...sv.querySelectorAll('.somna-cd__ph')];
        this.halos = [...sv.querySelectorAll('.somna-cd__halo')];
        this.moonsBox = sv.parentElement;
        this.drawMoons();
      }
      // lit part of a moon at phase f (0 new, 1 full), light from the right, curved shadow line
      phase(cx, f) {
        const R = this.R;
        if (f <= 0) return 'M0 0Z';
        if (f >= 1) return 'M' + (cx - R) + ' 8a' + R + ' ' + R + ' 0 1 0 ' + 2 * R + ' 0a' + R + ' ' + R + ' 0 1 0 ' + -2 * R + ' 0Z';
        const rx = Math.abs(1 - 2 * f) * R;
        return 'M' + cx + ' ' + (8 - R) + 'A' + R + ' ' + R + ' 0 0 1 ' + cx + ' ' + (8 + R) + 'A' + rx + ' ' + R + ' 0 0 ' + (f < 0.5 ? 0 : 1) + ' ' + cx + ' ' + (8 - R) + 'Z';
      }
      drawMoons() {
        if (!this.phs || !this.moonsBox || this.moonsBox.offsetParent === null) return;   // hidden (phones): skip
        const leftF = Math.max(0, (this.end - Date.now()) / 1000);
        const cyc = Math.max(5, parseInt(this.dataset.moonCycle, 10) || 10);   // seconds for all five moons to fill
        let prog = 1 - (leftF % cyc) / cyc;                   // 0 → 1 over the current cycle
        if (this.reduce) prog = Math.ceil(prog * cyc) / cyc;
        this.phs.forEach((ph, i) => ph.setAttribute('d', this.phase(this.X[i], Math.min(1, Math.max(0, prog * 5 - i)))));
        const full = Math.floor(prog * 5 + 1e-6);
        if (this.lastFull !== undefined && full > this.lastFull && !this.reduce) {
          const h = this.halos[full - 1];
          if (h) { h.classList.remove('is-pop'); void h.getBBox(); h.classList.add('is-pop'); }
        }
        this.lastFull = full;
      }
      // "Roll up" (approved option B): each digit that changes rolls up like a counter; unchanged digits stay still
      roll(n, v, animate) {
        let dgs = [...n.querySelectorAll('.somna-cd__dg')];
        if (dgs.length !== v.length) {
          n.innerHTML = [...v].map((ch) => '<span class="somna-cd__dg"><i>' + ch + '</i></span>').join('');
          return;
        }
        dgs.forEach((dg, i) => {
          // keep exactly one digit per slot: drop finished/leftover ones first (a background tab pauses animation
          // frames but not the clock, which used to leave several digits stacked on top of each other)
          dg.querySelectorAll('i.is-out').forEach((e) => e.remove());
          const live = [...dg.querySelectorAll('i')];
          const cur = live.pop();
          live.forEach((e) => e.remove());
          if (cur && cur.textContent === v[i]) { cur.className = ''; return; }
          if (!animate || !cur || document.hidden) { dg.innerHTML = '<i>' + v[i] + '</i>'; return; }
          const next = document.createElement('i');
          next.className = 'is-in'; next.textContent = v[i];
          dg.appendChild(next);
          void next.offsetWidth;                       // start the roll now, without waiting for animation frames
          next.className = ''; cur.className = 'is-out';
          setTimeout(() => { if (cur.isConnected) cur.remove(); }, 520);
        });
      }
      disconnectedCallback() { clearInterval(this.timer); cancelAnimationFrame(this.raf); if (this.ro) this.ro.disconnect(); document.body.style.removeProperty('--somna-cd-height'); }
      tick() {
        let left = Math.max(0, Math.floor((this.end - Date.now()) / 1000));
        if (left <= 0) { this.hidden = true; clearInterval(this.timer); cancelAnimationFrame(this.raf); if (this.setHeight) this.setHeight(); return; }
        this.hidden = false;
        const parts = { d: Math.floor(left / 86400), h: Math.floor(left / 3600) % 24, m: Math.floor(left / 60) % 60, s: left % 60 };
        for (const k in parts) {
          const n = this.nums[k]; if (!n) continue;
          const v = String(parts[k]).padStart(2, '0');
          if (n.dataset.v !== v) { this.roll(n, v, this.started && !this.reduce); n.dataset.v = v; }
        }
        if (this.reduce) this.drawMoons();   // no animation: moons step once a second
        this.started = true;
        const sr = this.querySelector('[data-cd-sr]');
        if (sr && parts.s === 0) sr.textContent = parts.d + ' days ' + parts.h + ' hours ' + parts.m + ' minutes left';
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-cd {
    display: block;
    background: var(--cd-bg, #141832);
    color: var(--cd-text, #f3feee);
    border-bottom: 1px solid rgba(175, 189, 248, 0.18);
  }
  .somna-cd[hidden] { display: none; }
  /* transparent header (homepage): the first section is pulled up under the whole header group, so its content must
     also clear this bar, not only the header (Horizon only offsets by the header when a section follows it) */
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset).spacing-style,
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset) .spacing-style {
    --section-top-offset: calc(var(--header-height, 0px) + var(--somna-cd-height, 0px));
  }
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset) .spacing-style .spacing-style {
    --section-top-offset: 0px;
  }
  .somna-cd__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 8px 20px 6px;
  }
  .somna-cd__moons { display: inline-flex; color: var(--cd-accent, #afbdf8); }
  .somna-cd__moons svg { width: 104px; height: 22px; overflow: visible; }
  .somna-cd__halo { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .somna-cd__halo.is-pop { animation: somna-cd-halo 1.1s ease-out; }
  @keyframes somna-cd-halo { 0% { opacity: 0.9; transform: scale(0.9); } 100% { opacity: 0; transform: scale(1.9); } }
  .somna-cd__label {
    margin: 0;
    font: 800 1rem/1.2 var(--font-body--family, Inter, sans-serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cd-text, #f3feee);
  }
  .somna-cd__label-mob { display: none; }
  /* offer line under the label (e.g. 60% OFF + FREE GIFTS) */
  .somna-cd__label-desk { display: grid; gap: 2px; text-align: center; }
  .somna-cd__offer { display: block; color: var(--cd-accent, #afbdf8); font-size: 1.375rem; font-weight: 900; line-height: 1.1; letter-spacing: 0.03em; }
  .somna-cd__clock { display: flex; align-items: flex-start; gap: 8px; }
  .somna-cd__unit { display: grid; justify-items: center; gap: 4px; }
  .somna-cd__tile {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 60px;
    height: 52px;
    padding: 0 8px;
    border: 1px solid rgba(175, 189, 248, 0.35);
    border-radius: 8px;
    background: var(--cd-tile, #262c52);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
    perspective: 300px;
    overflow: hidden;
  }
  .somna-cd__num {
    display: flex;
    height: 100%;
    font: 800 2.125rem/1 var(--font-body--family, Inter, sans-serif);
    font-variant-numeric: tabular-nums;
    color: var(--cd-accent, #afbdf8);
  }
  /* each digit rolls up on its own (only the digits that change) */
  .somna-cd__dg { position: relative; width: 0.62em; height: 100%; overflow: hidden; }
  .somna-cd__dg i {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-style: normal;
    transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.3, 1), opacity 0.45s;
  }
  .somna-cd__dg i.is-in { transform: translateY(100%); opacity: 0; }
  .somna-cd__dg i.is-out { transform: translateY(-100%); opacity: 0; }
  .somna-cd__unit-label {
    font: 800 0.6875rem/1 var(--font-body--family, Inter, sans-serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cd-muted, #c3c9e8);
  }
  .somna-cd__colon {
    align-self: flex-start;
    height: 52px;
    display: grid;
    place-items: center;
    font: 800 1.5rem/1 var(--font-body--family, Inter, sans-serif);
    color: var(--cd-muted, #c3c9e8);
  }
  .somna-cd__date {
    margin: 0;
    font: 500 1rem/1.2 var(--font-body--family, Inter, sans-serif);
    color: var(--cd-muted, #c3c9e8);
    white-space: nowrap;
  }
  .somna-cd__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media screen and (max-width: 749px) {
    .somna-cd__inner { gap: 10px; padding: 5px 12px 4px; }
    .somna-cd__moons, .somna-cd__date, .somna-cd__label-desk { display: none; }
    .somna-cd__label-mob { display: grid; gap: 2px; font-size: 0.75rem; letter-spacing: 0.04em; }
    .somna-cd__label-mob span { color: var(--cd-accent, #afbdf8); }
    .somna-cd__label-mob .somna-cd__mob-top { font-weight: inherit; white-space: nowrap; }
    .somna-cd__label-mob .somna-cd__offer { margin-top: 1px; font-size: inherit; font-weight: 900; letter-spacing: inherit; white-space: nowrap; }
    .somna-cd__clock { gap: 4px; }
    .somna-cd__tile { min-width: 32px; height: 28px; padding: 0 4px; border-radius: 5px; }
    .somna-cd__num { font-size: 1.0625rem; }
    .somna-cd__colon { height: 28px; font-size: 0.875rem; }
    .somna-cd__unit-label { font-size: 0.5rem; }
  }
  /* desktop: slim bar (about 45px tall) */
  @media screen and (min-width: 750px) {
    .somna-cd__inner { gap: 14px; padding: 5px 20px; }
    .somna-cd__moons svg { width: 84px; height: 18px; }
    .somna-cd__label { font-size: 0.8125rem; }
    .somna-cd__label-desk { gap: 0; }
    .somna-cd__offer { font-size: 1.0625rem; }
    .somna-cd__clock { gap: 6px; }
    .somna-cd__unit { gap: 2px; }
    .somna-cd__tile { min-width: 40px; height: 32px; padding: 0 5px; border-radius: 6px; }
    .somna-cd__num { font-size: 1.3125rem; }
    .somna-cd__colon { height: 32px; font-size: 1rem; }
    .somna-cd__unit-label { font-size: 0.5625rem; }
    .somna-cd__date { font-size: 0.875rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .somna-cd__dg i { transition: none; }
    .somna-cd__halo.is-pop { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna countdown",
  "tag": "div",
  "class": "section-somna-countdown",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "end_at",
      "label": "Sale ends at",
      "info": "Date and time with time zone, e.g. 2026-12-02T23:59:00-08:00 (Wed 2 Dec, 11:59 PM PT). The bar hides itself after this time.",
      "default": "2026-12-02T23:59:00-08:00"
    },
    { "type": "text", "id": "label", "label": "Label (desktop)", "default": "Black Friday sale ends in" },
    { "type": "checkbox", "id": "pdp_land_scroll", "label": "Product pages: scroll to this bar on arrival", "default": true },
    { "type": "text", "id": "offer", "label": "Offer line under the label", "default": "60% OFF + FREE GIFTS" },
    { "type": "range", "id": "moon_cycle", "label": "Moons: seconds to fill all five", "min": 5, "max": 60, "step": 5, "unit": "s", "default": 10 },
    { "type": "text", "id": "date_text", "label": "End date shown (desktop)", "default": "Wed 2 Dec, 11:59 PM PT" },
    { "type": "text", "id": "label_mobile", "label": "Label (phones)", "default": "Sale ends" },
    { "type": "text", "id": "date_mobile", "label": "End date shown (phones)", "default": "Wed 2 Dec" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#141832" },
    { "type": "color", "id": "text_color", "label": "Label text", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Numbers and moons", "default": "#afbdf8" },
    { "type": "color", "id": "tile_color", "label": "Number tiles", "default": "#262c52" },
    { "type": "color", "id": "muted_color", "label": "Small text and colons", "default": "#c3c9e8" }
  ],
  "presets": [{ "name": "Somna countdown" }]
}
{% endschema %}
