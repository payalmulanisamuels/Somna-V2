{%- comment -%}
  Somna V2 — sale countdown bar (header group, between the announcement bar and the header). Clock tiles, digits roll up (option B), (days / hrs / min / sec) counting
  down to the real end time (setting, ISO 8601 with offset, e.g. 2026-12-02T23:59:00-08:00 = Wed 2 Dec, 11:59 PM PT).
  Desktop: moon phases · label · tiles · end date. Phones: two-line label (Sale ends / date) · tiles.
  The bar hides itself once the end time has passed (and stays hidden if the setting is empty or invalid).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cd_id = 'somna-cd-' | append: section.id
-%}
{%- if s.end_at != blank -%}
<somna-countdown
  class="somna-cd"
  id="{{ cd_id }}"
  data-end="{{ s.end_at | escape }}"
  hidden
  style="--cd-bg: {{ s.bg_color }}; --cd-text: {{ s.text_color }}; --cd-accent: {{ s.accent_color }}; --cd-tile: {{ s.tile_color }}; --cd-muted: {{ s.muted_color }};"
  role="timer"
  aria-live="off"
>
  <div class="somna-cd__inner">
    <span class="somna-cd__moons" aria-hidden="true">
      <svg viewBox="0 0 92 16" focusable="false">
        <g class="somna-cd__moon" data-moon><circle cx="8" cy="8" r="6.5" fill="currentColor"/></g>
        <g class="somna-cd__moon" data-moon><circle cx="27" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M27 1.5a6.5 6.5 0 0 1 0 13a4.2 6.5 0 0 1 0-13z" fill="currentColor"/></g>
        <g class="somna-cd__moon" data-moon><circle cx="46" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M46 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></g>
        <g class="somna-cd__moon" data-moon><circle cx="65" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M65 1.5a6.5 6.5 0 0 1 0 13a3 6.5 0 0 0 0-13z" fill="currentColor"/></g>
        <g class="somna-cd__moon" data-moon><circle cx="84" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/></g>
      </svg>
    </span>
    <p class="somna-cd__label">
      <span class="somna-cd__label-desk">{{ s.label }}</span>
      <span class="somna-cd__label-mob">{{ s.label_mobile }}{% if s.date_mobile != blank %}<span>{{ s.date_mobile }}</span>{% endif %}</span>
    </p>
    <div class="somna-cd__clock">
      {%- for unit in (1..4) -%}
        {%- liquid
          case unit
            when 1
              assign u_key = 'd'
              assign u_label = 'Days'
            when 2
              assign u_key = 'h'
              assign u_label = 'Hrs'
            when 3
              assign u_key = 'm'
              assign u_label = 'Min'
            else
              assign u_key = 's'
              assign u_label = 'Sec'
          endcase
        -%}
        {%- unless forloop.first -%}<span class="somna-cd__colon" aria-hidden="true">:</span>{%- endunless -%}
        <span class="somna-cd__unit">
          <span class="somna-cd__tile"><span class="somna-cd__num" data-cd="{{ u_key }}"><span class="somna-cd__dg"><i>0</i></span><span class="somna-cd__dg"><i>0</i></span></span></span>
          <span class="somna-cd__unit-label">{{ u_label }}</span>
        </span>
      {%- endfor -%}
    </div>
    {%- if s.date_text != blank -%}<p class="somna-cd__date">{{ s.date_text }}</p>{%- endif -%}
    <span class="somna-cd__sr" data-cd-sr></span>
  </div>
</somna-countdown>

<script>
  if (!customElements.get('somna-countdown')) {
    customElements.define('somna-countdown', class extends HTMLElement {
      connectedCallback() {
        this.end = Date.parse(this.dataset.end);
        if (isNaN(this.end)) return;
        this.nums = {};
        this.querySelectorAll('[data-cd]').forEach((n) => { this.nums[n.dataset.cd] = n; });
        this.reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.tick();
        if (!this.hidden) this.timer = setInterval(() => this.tick(), 1000);
        // the bar's height, for pages whose first section sits under a transparent header (homepage hero)
        this.setHeight = () => document.body.style.setProperty('--somna-cd-height', (this.hidden ? 0 : this.offsetHeight) + 'px');
        this.setHeight();
        if ('ResizeObserver' in window) { this.ro = new ResizeObserver(this.setHeight); this.ro.observe(this); }
      }
      // "Roll up" (approved option B): each digit that changes rolls up like a counter; unchanged digits stay still
      roll(n, v, animate) {
        let dgs = [...n.querySelectorAll('.somna-cd__dg')];
        if (dgs.length !== v.length) {
          n.innerHTML = [...v].map((ch) => '<span class="somna-cd__dg"><i>' + ch + '</i></span>').join('');
          return;
        }
        dgs.forEach((dg, i) => {
          const cur = dg.querySelector('i:not(.is-out)');
          if (cur && cur.textContent === v[i]) return;
          if (!animate || !cur) { dg.innerHTML = '<i>' + v[i] + '</i>'; return; }
          const next = document.createElement('i');
          next.className = 'is-in'; next.textContent = v[i];
          dg.appendChild(next);
          requestAnimationFrame(() => requestAnimationFrame(() => { next.className = ''; cur.className = 'is-out'; }));
          setTimeout(() => cur.remove(), 520);
        });
      }
      disconnectedCallback() { clearInterval(this.timer); if (this.ro) this.ro.disconnect(); document.body.style.removeProperty('--somna-cd-height'); }
      tick() {
        let left = Math.max(0, Math.floor((this.end - Date.now()) / 1000));
        if (left <= 0) { this.hidden = true; clearInterval(this.timer); if (this.setHeight) this.setHeight(); return; }
        this.hidden = false;
        const parts = { d: Math.floor(left / 86400), h: Math.floor(left / 3600) % 24, m: Math.floor(left / 60) % 60, s: left % 60 };
        for (const k in parts) {
          const n = this.nums[k]; if (!n) continue;
          const v = String(parts[k]).padStart(2, '0');
          if (n.dataset.v !== v) { this.roll(n, v, this.started && !this.reduce); n.dataset.v = v; }
        }
        // moons keep time with the clock: each second the next moon (left to right) lights up
        if (!this.moons) this.moons = [...this.querySelectorAll('[data-moon]')];
        const on = (59 - parts.s) % this.moons.length;
        this.moons.forEach((m, i) => m.classList.toggle('is-on', i === on));
        this.started = true;
        const sr = this.querySelector('[data-cd-sr]');
        if (sr && parts.s === 0) sr.textContent = parts.d + ' days ' + parts.h + ' hours ' + parts.m + ' minutes left';
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-cd {
    display: block;
    background: var(--cd-bg, #141832);
    color: var(--cd-text, #f3feee);
    border-bottom: 1px solid rgba(175, 189, 248, 0.18);
  }
  .somna-cd[hidden] { display: none; }
  /* transparent header (homepage): the first section is pulled up under the whole header group, so its content must
     also clear this bar, not only the header (Horizon only offsets by the header when a section follows it) */
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset).spacing-style,
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset) .spacing-style {
    --section-top-offset: calc(var(--header-height, 0px) + var(--somna-cd-height, 0px));
  }
  #header-group:has(#header-component[transparent]):has(.somna-cd:not([hidden])) ~ .content-for-layout > .shopify-section:first-child .section:not(.disable-section-top-offset) .spacing-style .spacing-style {
    --section-top-offset: 0px;
  }
  .somna-cd__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 8px 20px 6px;
  }
  .somna-cd__moons { display: inline-flex; color: var(--cd-accent, #afbdf8); }
  .somna-cd__moons svg { width: 96px; height: 17px; overflow: visible; }
  .somna-cd__moon {
    opacity: 0.45;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1), filter 0.45s ease;
  }
  .somna-cd__moon.is-on {
    opacity: 1;
    transform: scale(1.22);
    filter: drop-shadow(0 0 4px rgba(175, 189, 248, 0.9));
  }
  .somna-cd__label {
    margin: 0;
    font: 800 1rem/1.2 var(--font-body--family, Inter, sans-serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cd-text, #f3feee);
  }
  .somna-cd__label-mob { display: none; }
  .somna-cd__clock { display: flex; align-items: flex-start; gap: 8px; }
  .somna-cd__unit { display: grid; justify-items: center; gap: 4px; }
  .somna-cd__tile {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 60px;
    height: 52px;
    padding: 0 8px;
    border: 1px solid rgba(175, 189, 248, 0.35);
    border-radius: 8px;
    background: var(--cd-tile, #262c52);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
    perspective: 300px;
    overflow: hidden;
  }
  /* the flip-clock split line */
  .somna-cd__tile::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(11, 15, 29, 0.75);
  }
  .somna-cd__num {
    display: flex;
    height: 100%;
    font: 800 2.125rem/1 var(--font-body--family, Inter, sans-serif);
    font-variant-numeric: tabular-nums;
    color: var(--cd-accent, #afbdf8);
  }
  /* each digit rolls up on its own (only the digits that change) */
  .somna-cd__dg { position: relative; width: 0.62em; height: 100%; overflow: hidden; }
  .somna-cd__dg i {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-style: normal;
    transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.3, 1), opacity 0.45s;
  }
  .somna-cd__dg i.is-in { transform: translateY(100%); opacity: 0; }
  .somna-cd__dg i.is-out { transform: translateY(-100%); opacity: 0; }
  .somna-cd__unit-label {
    font: 800 0.6875rem/1 var(--font-body--family, Inter, sans-serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cd-muted, #c3c9e8);
  }
  .somna-cd__colon {
    align-self: flex-start;
    height: 52px;
    display: grid;
    place-items: center;
    font: 800 1.5rem/1 var(--font-body--family, Inter, sans-serif);
    color: var(--cd-muted, #c3c9e8);
  }
  .somna-cd__date {
    margin: 0;
    font: 500 1rem/1.2 var(--font-body--family, Inter, sans-serif);
    color: var(--cd-muted, #c3c9e8);
    white-space: nowrap;
  }
  .somna-cd__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media screen and (max-width: 749px) {
    .somna-cd__inner { gap: 12px; padding: 7px 12px 5px; }
    .somna-cd__moons, .somna-cd__date, .somna-cd__label-desk { display: none; }
    .somna-cd__label-mob { display: grid; gap: 2px; font-size: 0.8125rem; letter-spacing: 0.04em; }
    .somna-cd__label-mob span { color: var(--cd-accent, #afbdf8); }
    .somna-cd__clock { gap: 5px; }
    .somna-cd__tile { min-width: 40px; height: 36px; padding: 0 5px; border-radius: 6px; }
    .somna-cd__num { font-size: 1.375rem; }
    .somna-cd__colon { height: 36px; font-size: 1.125rem; }
    .somna-cd__unit-label { font-size: 0.5625rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .somna-cd__dg i { transition: none; }
    .somna-cd__moon { transition: none; }
    .somna-cd__moon.is-on { transform: none; filter: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna countdown",
  "tag": "div",
  "class": "section-somna-countdown",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "end_at",
      "label": "Sale ends at",
      "info": "Date and time with time zone, e.g. 2026-12-02T23:59:00-08:00 (Wed 2 Dec, 11:59 PM PT). The bar hides itself after this time.",
      "default": "2026-12-02T23:59:00-08:00"
    },
    { "type": "text", "id": "label", "label": "Label (desktop)", "default": "Black Friday sale ends in" },
    { "type": "text", "id": "date_text", "label": "End date shown (desktop)", "default": "Wed 2 Dec, 11:59 PM PT" },
    { "type": "text", "id": "label_mobile", "label": "Label (phones)", "default": "Sale ends" },
    { "type": "text", "id": "date_mobile", "label": "End date shown (phones)", "default": "Wed 2 Dec" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#141832" },
    { "type": "color", "id": "text_color", "label": "Label text", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Numbers and moons", "default": "#afbdf8" },
    { "type": "color", "id": "tile_color", "label": "Number tiles", "default": "#262c52" },
    { "type": "color", "id": "muted_color", "label": "Small text and colons", "default": "#c3c9e8" }
  ],
  "presets": [{ "name": "Somna countdown" }]
}
{% endschema %}
