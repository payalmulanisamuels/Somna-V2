{%- comment -%}
  Somna V2 — "Pair it with …" on the product page (Figma 4557:857 / 4557:44).
  The paired product comes from the product metafield custom.pdp_pair_product; "Also trending"
  is a product chosen in the theme editor. Per-night price uses the trending product's
  custom.nights metafield when it has one.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = closest.product
  endif
  if product == blank
    assign product = all_products[s.preview_product.handle]
  endif
  assign mf = product.metafields.custom
  assign pair = mf.pdp_pair_product.value
  assign trend = s.trending_product
  # no "Also trending" when it is this product or the same product as the pair card (Color Set / Sleep Bundle → Season Bundle)
  if trend != blank and trend.id == product.id
    assign trend = nil
  endif
  if trend != blank and pair != blank and trend.id == pair.id
    assign trend = nil
  endif
  # optional per-product wording and a landscape card image (Season Bundle: "Not ready for 90 nights?")
  assign heading_lines = mf.pdp_pair_heading.value | newline_to_br | split: '<br />'
  assign card_image = mf.pdp_pair_image.value
  assign card_style = 'compact'
  if card_image != blank
    assign card_style = 'wide'
  endif
-%}
{%- if pair != blank or trend != blank -%}
<div class="somna-pdp-pair somna-pdp-pair--{{ card_style }}" style="--somna-pair-bg: {{ s.background_color }}; --somna-pair-accent: {{ s.accent_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="somna-pdp-pair__inner somna-container">
    <div class="somna-pdp-pair__copy">
      {%- if pair != blank -%}
        {%- if mf.pdp_pair_eyebrow != blank -%}<p class="somna-pdp-pair__eyebrow">{{ mf.pdp_pair_eyebrow.value }}</p>{%- endif -%}
        {%- if mf.pdp_pair_heading != blank -%}
          <h2 class="somna-pdp-pair__heading">{{ heading_lines[0] | strip }}{% if heading_lines.size > 1 %} <span>{{ heading_lines[1] | strip }}</span>{% endif %}</h2>
        {%- else -%}
          <h2 class="somna-pdp-pair__heading">{{ s.heading }} <span>{{ pair.title }}</span></h2>
        {%- endif -%}
        {%- if mf.pdp_pair_text != blank -%}<p class="somna-pdp-pair__text">{{ mf.pdp_pair_text.value | newline_to_br }}</p>{%- endif -%}
        <svg class="somna-pdp-pair__arrow" viewBox="0 0 180 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path class="somna-pdp-pair__arrow-line" pathLength="420" d="M8 4c-4 46 8 96 66 106 26 4 48-6 48-24 0-17-22-22-30-8-10 18 18 34 82 24"/><path class="somna-pdp-pair__arrow-head" d="M158 88l18 14-22 10" fill="currentColor"/></svg>
      {%- endif -%}

      {%- if trend != blank -%}
        <div class="somna-pdp-pair__trend">
          {%- if s.trending_label != blank -%}<p class="somna-pdp-pair__trend-label">{{ s.trending_label }}</p>{%- endif -%}
          <a class="somna-pdp-pair__trend-card" href="{{ trend.url }}">
            {%- if trend.featured_image -%}{{ trend.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', width: 117, height: 89 }}{%- endif -%}
            <span>
              {%- render 'somna-rating', product: trend, format: '[rating]/5 · [count] reviews', tag: 'span', class: 'somna-pdp-pair__rating' -%}
              <span class="somna-pdp-pair__trend-title">{{ trend.title }}</span>
              {%- liquid
                # lowest price: Subscribe & Save plan, else the one-time sale price; regular price struck
                assign tv = trend.selected_or_first_available_variant
                assign t_regular = tv.compare_at_price | default: 0
                if tv.price > t_regular
                  assign t_regular = tv.price
                endif
                assign t_price = tv.price
                if trend.selling_plan_groups.size > 0
                  assign t_factor = 100 | minus: settings.somna_once_discount
                  assign t_price = tv.price | times: t_factor | divided_by: 100
                  assign t_alloc = tv.selling_plan_allocations | first
                  if t_alloc and t_alloc.price < t_price
                    assign t_price = t_alloc.price
                  endif
                endif
              -%}
              <span class="somna-pdp-pair__trend-price">
                {{ t_price | money }}
                {%- if t_regular > t_price %} · <s>{{ t_regular | money_without_trailing_zeros }}</s>{% endif -%}
                {%- assign nights = trend.metafields.custom.nights.value | default: 0 -%}
                {%- if nights > 0 %} · <em>{{ t_price | times: 1.0 | divided_by: nights | round | money }}{{ s.night_label }}</em>{% endif -%}
              </span>
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if pair != blank -%}
      {%- liquid
        assign pair_alloc = pair.selected_or_first_available_variant.selling_plan_allocations | first
        assign from_price = pair.price_min
        if pair_alloc and pair_alloc.price < from_price
          assign from_price = pair_alloc.price
        endif
      -%}
      <a class="somna-pdp-pair__card" href="{{ pair.url }}">
        {%- assign card_image = card_image | default: pair.featured_image -%}
        {%- if card_style == 'wide' -%}{%- assign sizes_attr = '(min-width: 750px) 488px, 90vw' -%}{%- else -%}{%- assign sizes_attr = '(min-width: 750px) 185px, 60vw' -%}{%- endif -%}
        {%- if card_image -%}{{ card_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: card_image.alt | default: pair.title, widths: '300, 450, 600, 800, 1000', sizes: sizes_attr }}{%- endif -%}
        {%- render 'somna-rating', product: pair, format: '[rating]/5 · [count] reviews', tag: 'span', class: 'somna-pdp-pair__rating' -%}
        <span class="somna-pdp-pair__name">{{ pair.title }}</span>
        {%- if mf.pdp_pair_note != blank -%}<span class="somna-pdp-pair__note">{{ mf.pdp_pair_note.value }}</span>{%- endif -%}
        {%- capture from_money -%}{{ from_price | money }}{%- endcapture -%}
        <span class="somna-pdp-pair__meta">{{ s.from_label | replace: '[price]', from_money }}{% if pair_alloc and s.sub_note != blank %} <span>{{ s.sub_note }}</span>{% endif %}</span>
        <span class="somna-pdp-pair__button">{{ s.button_label }}</span>
      </a>
    {%- endif -%}
  </div>
</div>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}
{%- endif -%}

{% stylesheet %}
  .somna-pdp-pair {
    background: var(--somna-pair-bg);
    color: #0b0f1d;
  }

  .somna-pdp-pair__text {
    max-width: 30em;
    margin: 4px 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .somna-pdp-pair__inner {
    --somna-content-width: 1200px;
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .somna-pdp-pair__copy {
    position: relative;
    display: grid;
    gap: 24px;
  }

  .somna-pdp-pair__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.9vw, 3.5rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-pdp-pair__heading span {
    color: var(--somna-pair-accent);
  }

  .somna-pdp-pair__arrow {
    justify-self: end;
    width: 180px;
    margin-right: 6%;
  }

  /* arrow: the line draws itself, the head pokes towards the product, then it redraws (approved demo 5B) */
  .somna-pdp-pair__arrow-line {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: somnaPairDraw 2.4s ease-in-out infinite;
  }

  .somna-pdp-pair__arrow-head {
    opacity: 0;
    animation: somnaPairHead 2.4s ease-in-out infinite;
  }

  .somna-pdp-pair__inner:hover :is(.somna-pdp-pair__arrow-line, .somna-pdp-pair__arrow-head) {
    animation-duration: 1.6s;
  }

  @keyframes somnaPairDraw {
    0% { stroke-dashoffset: 420; }
    40%, 85% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -420; }
  }

  @keyframes somnaPairHead {
    0%, 35% { opacity: 0; transform: translate(-6px, -2px); }
    42%, 82% { opacity: 1; transform: translate(0, 0); }
    60% { transform: translate(6px, 2px); }
    90%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-pdp-pair__arrow-line,
    .somna-pdp-pair__arrow-head {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  .somna-pdp-pair__trend-label {
    margin: 0 0 6px;
    font-family: var(--font-accent--family);
    font-size: 1.125rem;
  }

  .somna-pdp-pair__trend-card {
    display: inline-flex;
    gap: 16px;
    align-items: center;
    padding: 8px 16px 8px 8px;
    border: 3px solid #0b0f1d;
    border-radius: 12px;
    background: var(--somna-pair-accent);
    color: inherit;
    text-decoration: none;
    transition: translate 0.2s;
  }

  .somna-pdp-pair__trend-card:hover {
    translate: 0 -2px;
  }

  .somna-pdp-pair__trend-card img {
    width: 117px;
    height: 89px;
    border-radius: 8px;
    object-fit: cover;
  }

  .somna-pdp-pair__trend-title {
    display: block;
    font-family: var(--font-accent--family);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .somna-pdp-pair__trend-price {
    font-size: 0.9375rem;
  }

  .somna-pdp-pair__trend-price s {
    opacity: 0.6;
  }

  .somna-pdp-pair__trend-price em {
    color: #498525;
    font-style: normal;
  }

  .somna-pdp-pair__card {
    display: grid;
    gap: 6px;
    width: min(100%, 309px);
    justify-self: center;
    padding: 18px 12px 12px;
    border-radius: 16px;
    background: #0b0f1d;
    color: #f3feee;
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.2);
    text-decoration: none;
  }

  .somna-pdp-pair__card img {
    width: 100%;
    aspect-ratio: 185 / 247;
    margin-bottom: 14px;
    border-radius: 12px;
    object-fit: cover;
  }

  .somna-pdp-pair__rating {
    display: block;
    padding-inline: 6px;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__rating {
    padding-inline: 0;
    font-size: 0.9375rem;
  }

  .somna-pdp-pair__trend .somna-pdp-pair__rating {
    padding-inline: 0;
    margin-bottom: 2px;
  }

  .somna-pdp-pair__name {
    padding-inline: 6px;
    font-size: 1.3125rem;
    font-weight: 500;
  }

  .somna-pdp-pair__meta {
    padding-inline: 6px;
    font-size: 0.775rem;
    font-weight: 300;
    opacity: 0.85;
  }

  .somna-pdp-pair__meta span {
    margin-left: 6px;
  }

  .somna-pdp-pair__button {
    display: grid;
    place-items: center;
    min-height: 48px;
    margin-top: 10px;
    border-radius: 8px;
    background: var(--somna-pair-accent);
    color: #0b0f1d;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    transition: background-color 0.2s, color 0.2s;
  }

  .somna-pdp-pair__card:hover .somna-pdp-pair__button {
    background: #f3feee;
    color: #0b0f1d;
  }

  .somna-pdp-pair__card:focus-visible,
  .somna-pdp-pair__trend-card:focus-visible {
    outline: 2px solid #0b0f1d;
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .somna-pdp-pair__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 309px);
      gap: 48px;
    }

    .somna-pdp-pair__card {
      justify-self: end;
    }
  }

  /* wide card (Season Bundle, Figma 4654:113 "Not ready for 90 nights?"): landscape photo, bigger type */
  .somna-pdp-pair__eyebrow {
    margin: 0 0 -12px;
    font-size: 0.9375rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__heading span {
    display: block;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__card {
    width: min(100%, 543px);
    padding: 22px 28px 30px;
    border-radius: 28px;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__card img {
    aspect-ratio: 488 / 285;
    margin-bottom: 18px;
    border-radius: 6px;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__name {
    padding-inline: 0;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
  }

  .somna-pdp-pair__note {
    font-size: 1.125rem;
    font-weight: 300;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__meta {
    padding-inline: 0;
    font-size: 1.125rem;
  }

  .somna-pdp-pair--wide .somna-pdp-pair__button {
    min-height: 82px;
    margin-top: 12px;
    border-radius: 14px;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .somna-pdp-pair--wide .somna-pdp-pair__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 543px);
    }
  }

  @media screen and (min-width: 990px) {
    .somna-pdp-pair--wide .somna-pdp-pair__arrow {
      top: auto;
      bottom: -40px;
      right: 2%;
    }
  }

  @media screen and (min-width: 990px) {
    .somna-pdp-pair__arrow {
      position: absolute;
      top: 70px;
      right: 0;
      margin: 0;
    }

    .somna-pdp-pair__trend {
      margin-top: 150px;
    }

    /* Figma 4557:704: 540 × 140 card, 167 × 125 photo */
    .somna-pdp-pair__trend-card {
      display: flex;
      width: 540px;
      max-width: 100%;
      gap: 20px;
      padding: 7px 20px 7px 7px;
    }

    .somna-pdp-pair__trend-card img {
      flex: none;
      width: 167px;
      height: 125px;
    }

    .somna-pdp-pair__trend-title {
      font-size: 2.5rem;
      line-height: 1.25;
    }

    .somna-pdp-pair__trend-price {
      font-size: 1.0625rem;
    }
  }

  /* mobile: design to come (Figma pending) */
  /* Mobile (Figma): heading + arrow, the product card, then "Also Trending" */
  @media screen and (max-width: 749px) {
    /* padding is an inline style from the section settings */
    .somna-pdp-pair {
      padding-block: 16px 32px !important;
    }

    .somna-pdp-pair__inner {
      gap: 16px;
    }

    .somna-pdp-pair__copy {
      display: contents;
    }

    /* eyebrow, heading, then the text under it (Figma 4759:7535 "More nights, fewer orders") */
    .somna-pdp-pair__eyebrow {
      order: 1;
    }

    .somna-pdp-pair__heading {
      order: 1;
      padding-right: 84px;
      font-size: 1.625rem;
    }

    .somna-pdp-pair__text {
      order: 1;
      margin-top: -6px;
      padding-right: 72px;
      font-size: 0.75rem;
    }

    .somna-pdp-pair__arrow {
      order: 2;
      width: 80px;
      margin: -64px 4px -12px 0;
      rotate: 60deg;
    }

    .somna-pdp-pair__card {
      order: 3;
      width: min(100%, 340px);
    }

    .somna-pdp-pair__trend {
      order: 4;
    }

    .somna-pdp-pair__trend-card {
      display: flex;
      width: 100%;
    }

    .somna-pdp-pair__trend-card img {
      width: 96px;
      height: 72px;
    }

    .somna-pdp-pair__trend-title {
      font-size: 1.125rem;
    }

    .somna-pdp-pair__trend-price {
      font-size: 0.8125rem;
    }

    .somna-pdp-pair__name {
      font-size: 1.25rem;
      font-weight: 500;
    }

    /* Figma: a near-square product photo on mobile */
    .somna-pdp-pair__card img {
      aspect-ratio: 1;
    }

    .somna-pdp-pair__meta {
      font-size: 0.8125rem;
      font-weight: 300;
    }
  }

  /* Mobile, wide card (Figma 4759:7535 / 4781:9521): compact card, ~44px button */
  @media screen and (max-width: 749px) {
    .somna-pdp-pair--wide .somna-pdp-pair__card {
      padding: 14px 14px 16px;
      border-radius: 20px;
    }

    .somna-pdp-pair--wide .somna-pdp-pair__card img {
      margin-bottom: 12px;
    }

    .somna-pdp-pair--wide .somna-pdp-pair__name {
      font-size: 1.25rem;
    }

    .somna-pdp-pair--wide .somna-pdp-pair__note,
    .somna-pdp-pair--wide .somna-pdp-pair__meta {
      font-size: 0.8125rem;
    }

    .somna-pdp-pair--wide .somna-pdp-pair__button {
      min-height: 44px;
      margin-top: 12px;
      border-radius: 10px;
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna pair it with",
  "tag": "section",
  "class": "section-somna-pdp-pair",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Set per product: PDP – Pair it with (product), and optionally PDP – Pair: eyebrow / heading / line under the product name / card image (a card image makes the card wide)." },
    { "type": "product", "id": "preview_product", "label": "Product for the theme editor", "info": "Only used where there is no product." },
    { "type": "text", "id": "heading", "label": "Heading before the product name", "default": "Pair it with" },
    { "type": "text", "id": "from_label", "label": "Price line", "info": "[price] is the lowest price, subscription included.", "default": "From [price]" },
    { "type": "text", "id": "sub_note", "label": "Subscription note", "default": "Subscribe & Save" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "header", "content": "Also trending" },
    { "type": "product", "id": "trending_product", "label": "Product" },
    { "type": "text", "id": "trending_label", "label": "Label", "default": "Also Trending" },
    { "type": "text", "id": "night_label", "label": "Per-night suffix", "default": " / night" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3feee" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
  ],
  "presets": [{ "name": "Somna pair it with" }]
}
{% endschema %}
