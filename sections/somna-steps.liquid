{%- comment -%}
  Somna V2 — social proof strip + "Three steps" how-to.
  Left: large image with a wavy bottom edge. Right: heading, sub-text, step list (optional thumbnail
  strip beside the steps) and a button. The proof row (eyebrow, avatars, rating text) sits on top.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
-%}
<div
  class="somna-steps"
  style="background: {{ s.background_color }}; color: {{ s.text_color }}; --somna-btn: {{ s.button_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-container">
    {%- if s.eyebrow != blank or s.avatars != blank or s.rating_text != blank -%}
      <div class="somna-steps__proof">
        {%- if s.eyebrow != blank -%}<p class="somna-steps__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.avatars != blank -%}
          {{ s.avatars | image_url: width: 240 | image_tag: class: 'somna-steps__avatars', alt: '', loading: 'lazy', width: 120 }}
        {%- endif -%}
        {%- if s.rating_text != blank -%}<p class="somna-steps__rating">{{ s.rating_text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="somna-steps__grid">
      <div class="somna-steps__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 546px, 100vw', loading: 'lazy', class: 'somna-steps__image' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'somna-steps__image' }}
        {%- endif -%}
        <svg class="somna-steps__edge" viewBox="0 0 546 80" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 22c38-20 58 6 92-4s48-20 82-2 46 20 80 8 56-26 96-12 50 20 86 6 72-24 110-6V80H0z" fill="{{ s.background_color }}"/></svg>
      </div>

      <div class="somna-steps__content">
        {%- if s.heading != blank -%}<h2 class="somna-steps__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="somna-steps__text">{{ s.text }}</div>{%- endif -%}

        <div class="somna-steps__list-wrap{% if s.thumbs != blank %} has-thumbs{% endif %}">
          {%- if s.thumbs != blank -%}
            {{ s.thumbs | image_url: width: 400 | image_tag: class: 'somna-steps__thumbs', alt: '', loading: 'lazy' }}
          {%- endif -%}
          <ol class="somna-steps__list" role="list">
            {%- for block in section.blocks -%}
              <li class="somna-steps__step" {{ block.shopify_attributes }}>
                <h3 class="somna-steps__step-title">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        </div>

        {%- if s.button_label != blank and s.button_link != blank -%}
          <a class="somna-steps__button" href="{{ s.button_link }}">
            <svg class="somna-steps__play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12"/><path d="M9.5 7.5v9l7-4.5z" fill="#fff"/></svg>
            <span>{{ s.button_label }}</span>
          </a>
          {%- if s.button_note != blank -%}<p class="somna-steps__note">{{ s.button_note }}</p>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}

{% stylesheet %}
  .somna-steps__proof {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-bottom: 20px;
    text-align: center;
  }

  .somna-steps__eyebrow {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .somna-steps__avatars {
    width: 104px;
    height: auto;
  }

  .somna-steps__rating {
    margin: 0;
    font-size: 1rem;
  }

  .somna-steps__grid {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .somna-steps__media {
    position: relative;
    overflow: hidden;
  }

  .somna-steps__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 546 / 640;
    object-fit: cover;
  }

  .somna-steps__edge {
    position: absolute;
    inset: auto 0 -1px;
    width: 100%;
    height: 12%;
  }

  .somna-steps__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(2rem, 3.44vw, 3.1rem);
    line-height: 1.35;
    color: inherit;
    text-wrap: balance;
  }

  .somna-steps__text {
    margin-top: 12px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .somna-steps__text p {
    margin: 0;
  }

  .somna-steps__list-wrap {
    margin-top: 36px;
  }

  .somna-steps__list-wrap.has-thumbs {
    display: grid;
    grid-template-columns: minmax(0, 175px) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .somna-steps__thumbs {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .somna-steps__list {
    display: grid;
    align-content: space-around;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-steps__step-title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.25rem, 1.91vw, 1.72rem);
    line-height: 1.35;
    text-transform: uppercase;
    color: inherit;
  }

  .somna-steps__step p {
    margin: 4px 0 0;
    max-width: 260px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .somna-steps__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 72px;
    margin-top: 14px;
    padding: 0 24px;
    border-radius: 18px;
    background: var(--somna-btn);
    color: #000;
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.15);
  }

  .somna-steps__play {
    flex: none;
    width: 1.4em;
    height: 1.4em;
    fill: #000;
  }

  /* shown under the button on phones only (mobile Figma) */
  .somna-steps__note {
    display: none;
    margin: 8px 0 0;
    font-size: 0.6875rem;
    text-align: center;
  }

  .somna-steps__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (min-width: 990px) {
    .somna-steps__grid {
      grid-template-columns: minmax(0, 546px) minmax(0, 544px);
      justify-content: space-between;
    }
  }

  /* tablet: photo and steps side by side instead of a full-width photo taller than the screen */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-steps__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
      align-items: center;
    }
  }

  /* final mobile design: small proof row, full-bleed photo, centred heading, compact step list */
  @media screen and (max-width: 749px) {
    .somna-steps {
      overflow-x: clip;
    }

    .somna-steps__proof {
      gap: 8px;
      margin-bottom: 16px;
    }

    .somna-steps__eyebrow {
      font-size: 0.5625rem;
    }

    .somna-steps__avatars {
      width: 72px;
    }

    .somna-steps__rating {
      font-size: 0.75rem;
    }

    .somna-steps__grid {
      gap: 24px;
    }

    .somna-steps__media {
      margin-inline: calc(50% - 50vw);
    }

    .somna-steps__image {
      aspect-ratio: 398 / 410;
    }

    .somna-steps__heading,
    .somna-steps__text {
      text-align: center;
    }

    .somna-steps__text {
      margin-top: 8px;
      font-size: 0.6875rem;
    }

    .somna-steps__list-wrap {
      margin-top: 24px;
    }

    .somna-steps__list-wrap.has-thumbs {
      grid-template-columns: minmax(0, 125px) minmax(0, 1fr);
      gap: 12px;
    }

    .somna-steps__step-title {
      font-size: 1.625rem;
      line-height: 1.1;
    }

    .somna-steps__step p {
      font-size: 0.6875rem;
    }

    .somna-steps__button {
      min-height: 46px;
      border-radius: 12px;
      font-size: 0.8125rem;
    }

    .somna-steps__note {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna steps",
  "tag": "section",
  "class": "section-somna-steps",
  "settings": [
    { "type": "header", "content": "Social proof" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "image_picker", "id": "avatars", "label": "Avatars image" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "info": "Only use a figure you can verify." },
    { "type": "header", "content": "Steps" },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Zero fuss." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "thumbs", "label": "Step thumbnails", "info": "Shown beside the step list." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_note", "label": "Note under the button (phones)", "default": "✓ 30-Night Money-Back Guarantee" },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3feee" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Bottom wave" },
    { "type": "color", "id": "wave_color", "label": "Colour below the wave", "info": "Draws a wave into the next section. Leave empty for a straight edge." },
    { "type": "select", "id": "wave_shape", "label": "Wave shape", "info": "Drip and Soft shapes are traced from the Figma design.", "options": [{ "value": "drip-1", "label": "Drip 1" }, { "value": "drip-2", "label": "Drip 2" }, { "value": "drip-3", "label": "Drip 3" }, { "value": "drip-4", "label": "Drip 4" }, { "value": "drip-5", "label": "Drip 5" }, { "value": "drip-6", "label": "Drip 6" }, { "value": "drip-7", "label": "Drip 7" }, { "value": "drip-8", "label": "Drip 8" }, { "value": "drip-9", "label": "Drip 9" }, { "value": "drip-10", "label": "Drip 10" }, { "value": "drip-11", "label": "Drip 11" }, { "value": "soft-1", "label": "Soft 1" }, { "value": "soft-2", "label": "Soft 2" }, { "value": "sine", "label": "Rolling wave (animated)" }], "default": "drip-1" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "01 Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "Somna steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
