{%- doc -%}
  Somna V2 — hero for content pages (Contact, How to use, Support). Same language as the PDP hero:
  lavender band, rounded photo on one side, navy panel with a drip edge on the other holding a
  breadcrumb, eyebrow, display heading, tagline, text and up to two buttons (blocks).
  Leave the heading empty to show the page title.
{%- enddoc -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: page.title
  assign crumb = s.breadcrumb_label | default: page.title
  # Collection (Figma 4823:999): "open" style without a photo — the tagline and the buttons (filter chips) sit in a
  # column on the right instead
  assign aside = false
  if s.style == 'aside'
    assign aside = true
  endif
  # Support (Figma 4927:1231): open text column with a search field and jump pills, black help card on the right
  assign card = false
  if s.style == 'card'
    assign card = true
  endif
-%}
<div
  class="somna-page-hero somna-page-hero--image-{{ s.image_side }} somna-page-hero--{{ s.style | default: 'panel' }}{% if aside or card %} somna-page-hero--open{% endif %}"
  style="--sph-bg: {{ s.background_color }}; --sph-panel: {{ s.panel_color }}; --sph-media: {{ s.media_color | default: s.panel_color }}; --sph-fit: {{ s.image_fit }}; --sph-accent: {{ s.accent_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-container somna-page-hero__grid">
    {%- unless aside or card -%}
    <div class="somna-page-hero__media{% if s.style == 'open' and s.drip_edge %} somna-edge-drip-bottom{% endif %}">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'somna-page-hero__image',
            style: s.image_position
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'somna-page-hero__image somna-page-hero__image--placeholder' }}
      {%- endif -%}
    </div>
    {%- endunless -%}

    <div class="somna-page-hero__panel{% if s.drip_edge and s.style == 'panel' %} somna-edge-drip-bottom{% endif %}">
      {%- if s.show_breadcrumb -%}
        <nav class="somna-page-hero__crumbs" aria-label="{{ 'accessibility.breadcrumbs' | t | default: 'Breadcrumb' }}">
          <a href="{{ routes.root_url }}">{{ s.home_label | escape }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ crumb | escape }}</span>
        </nav>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="somna-page-hero__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="somna-page-hero__title somna-accent">{{ heading }}</h1>
      {%- capture hero_rest -%}
      {%- if s.tagline != blank -%}<p class="somna-page-hero__tagline">{{ s.tagline | escape }}</p>{%- endif -%}
      {%- if s.text != blank -%}<div class="somna-page-hero__text">{{ s.text }}</div>{%- endif -%}
      {%- if card and s.search_placeholder != blank -%}
        <somna-faq-search class="somna-page-hero__search-wrap" data-empty="{{ s.search_empty | default: 'No answers for “[q]”. Try another word, or contact us below.' | escape }}" data-count="{{ s.search_count | default: '[n] matching questions' | escape }}">
        <form class="somna-page-hero__search" action="{{ routes.search_url }}" method="get" role="search">
          <svg class="somna-page-hero__search-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7"/><path d="M15.8 15.8L21 21"/></svg>
          <label class="visually-hidden" for="SupportSearch-{{ section.id }}">{{ s.search_placeholder | escape }}</label>
          <input id="SupportSearch-{{ section.id }}" type="search" name="q" placeholder="{{ s.search_placeholder | escape }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="button" class="somna-page-hero__search-clear" hidden aria-label="Clear search">×</button>
        </form>
        <p class="somna-page-hero__search-status" role="status" aria-live="polite"></p>
        </somna-faq-search>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="somna-page-hero__actions">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <a
              class="somna-page-hero__button somna-page-hero__button--{{ b.style }}{% if b.active %} is-active{% endif %}"
              {%- if b.active %} aria-current="page"{% endif %}
              href="{{ b.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {{- b.label | escape -}}
              {%- if b.style == 'pill' -%}<span class="somna-page-hero__pill-arrow" aria-hidden="true">↓</span>{%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- endcapture -%}
      {%- unless aside -%}{{ hero_rest }}{%- endunless -%}
    </div>
    {%- if aside -%}<div class="somna-page-hero__aside">{{ hero_rest }}</div>{%- endif -%}
    {%- if card and s.card_heading != blank -%}
      <div class="somna-page-hero__card somna-edge-drip-bottom">
        {%- if s.card_image != blank -%}
          {%- comment -%} Figma 4927:380: the pin picture. "Remove background" keeps only its light lines, so it sits on the black card {%- endcomment -%}
          <span class="somna-page-hero__card-icon somna-page-hero__card-pin{% if s.pin_motion %} is-animated{% endif %}" aria-hidden="true">
            <span class="somna-page-hero__pin-ping"></span>
            <span class="somna-page-hero__pin-body">
              {%- if s.card_image_key -%}
                <svg viewBox="0 0 {{ s.card_image.width }} {{ s.card_image.height }}" focusable="false">
                  <filter id="PinKey-{{ section.id }}" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0 0 0 0 0.953  0 0 0 0 0.996  0 0 0 0 0.933  0 4.25 0 0 -3.17"/></filter>
                  <image href="{{ s.card_image | image_url: width: 400 }}" width="{{ s.card_image.width }}" height="{{ s.card_image.height }}" filter="url(#PinKey-{{ section.id }})"/>
                </svg>
              {%- else -%}
                {{ s.card_image | image_url: width: 400 | image_tag: alt: '', loading: 'eager', width: 125, height: 125 }}
              {%- endif -%}
            </span>
          </span>
        {%- elsif s.card_icon != 'none' -%}{%- render 'somna-line-icon', name: s.card_icon, class: 'somna-page-hero__card-icon', stroke: 1.1 -%}{%- endif -%}
        {%- if s.card_eyebrow != blank -%}<p class="somna-page-hero__card-eyebrow">{{ s.card_eyebrow | escape }}</p>{%- endif -%}
        <h2 class="somna-page-hero__card-title">{{ s.card_heading | escape }}</h2>
        {%- if s.card_text != blank -%}<p class="somna-page-hero__card-text">{{ s.card_text | escape }}</p>{%- endif -%}
        {%- if s.card_button != blank -%}<a class="somna-page-hero__card-button" href="{{ s.card_link | default: '#' }}">{{ s.card_button | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>


{%- if card and s.search_placeholder != blank -%}
<script type="module">
  /* Support search (Figma 4927:290): typing filters the FAQ cards on this page — only questions whose question or
     answer contain every typed word stay visible (the words are highlighted), cards with no match hide. Enter jumps
     to the results; × or Escape clears. */
  if (!customElements.get('somna-faq-search')) {
    customElements.define('somna-faq-search', class extends HTMLElement {
      connectedCallback() {
        this.input = this.querySelector('input[type="search"]');
        this.clear = this.querySelector('.somna-page-hero__search-clear');
        this.status = this.querySelector('.somna-page-hero__search-status');
        this.form = this.querySelector('form');
        this.items = [...document.querySelectorAll('.somna-faq-cards__item')].map((d) => {
          const q = d.querySelector('.somna-faq-cards__q > span');
          return {
            d,
            host: d.closest('accordion-custom') || d,
            q,
            label: q.textContent,
            text: (d.textContent || '').toLowerCase().replace(/\s+/g, ' '),
          };
        });
        if (!this.items.length) return;
        let t;
        this.input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => this.run(), 120); });
        this.input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.input.value) { e.preventDefault(); this.reset(); }
        });
        this.form.addEventListener('submit', (e) => {
          e.preventDefault();
          this.run();
          const first = this.items.find((i) => !i.host.classList.contains('is-search-hidden'));
          first?.d.closest('.somna-faq-cards__card')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        });
        this.clear.addEventListener('click', () => { this.reset(); this.input.focus(); });
      }
      reset() {
        this.input.value = '';
        this.run();
      }
      esc(s) {
        return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
      }
      run() {
        const raw = this.input.value.trim();
        const words = raw.toLowerCase().split(/\s+/).filter((w) => w.length > 0);
        const on = words.length > 0;
        this.clear.hidden = !on;
        let n = 0;
        const re = on ? new RegExp('(' + words.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'gi') : null;
        this.items.forEach((i) => {
          const hit = !on || words.every((w) => i.text.includes(w));
          i.host.classList.toggle('is-search-hidden', !hit);
          if (hit && on) n++;
          i.q.innerHTML = hit && on ? this.esc(i.label).replace(re, '<mark>$1</mark>') : this.esc(i.label);
          if (!hit && i.d.open) i.d.open = false;
        });
        document.querySelectorAll('.somna-faq-cards').forEach((g) => g.classList.toggle('is-filtering', on));
        document.querySelectorAll('.somna-faq-cards__card').forEach((c) => {
          const any = c.querySelector('.somna-faq-cards__item') && [...c.querySelectorAll('.somna-faq-cards__item')].some((d) => !(d.closest('accordion-custom') || d).classList.contains('is-search-hidden'));
          c.classList.toggle('is-search-hidden', !any);
        });
        document.querySelectorAll('.somna-faq-cards__noresult').forEach((e) => e.remove());
        if (!on) { this.status.textContent = ''; return; }
        if (n === 0) {
          this.status.textContent = this.dataset.empty.replace('[q]', raw);
          const grid = document.querySelector('.somna-faq-cards__grid');
          if (grid) {
            const p = document.createElement('p');
            p.className = 'somna-faq-cards__noresult';
            p.textContent = this.status.textContent;
            grid.append(p);
          }
        } else {
          this.status.textContent = this.dataset.count.replace('[n]', n).replace('questions', n === 1 ? 'question' : 'questions');
        }
      }
    });
  }
</script>
{%- endif -%}

{% stylesheet %}
  .somna-page-hero {
    background: var(--sph-bg);
    overflow: hidden;
  }

  .somna-page-hero__grid {
    display: grid;
    gap: 20px;
  }

  .somna-page-hero__media {
    overflow: hidden;
    border-radius: 12px;
    background: var(--sph-media);
  }

  .somna-page-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: var(--sph-fit, cover);
  }

  .somna-page-hero__panel {
    --somna-drip-h: 60px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 28px 24px 40px;
    border-radius: 12px;
    background: var(--sph-panel);
    color: #fff;
  }

  .somna-page-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #9a9a9a;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }

  .somna-page-hero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .somna-page-hero__crumbs a:hover {
    color: #f3feee;
    text-decoration: underline;
  }

  .somna-page-hero__eyebrow {
    margin: 0;
    color: var(--sph-accent);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .somna-page-hero__title {
    --somna-accent: var(--sph-accent);
    margin: 0;
    color: #f3feee;
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .somna-page-hero__tagline {
    margin: 0;
    color: #f3feee;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .somna-page-hero__text {
    max-width: 34em;
    color: rgb(255 255 255 / 0.82);
    font-size: 1rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  .somna-page-hero__text :is(p, ul) {
    margin: 0;
  }

  .somna-page-hero__text a {
    color: #f3feee;
  }

  .somna-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .somna-page-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border: 2px solid var(--sph-accent);
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .somna-page-hero__button--primary {
    background: var(--sph-accent);
    color: #000;
  }

  .somna-page-hero__button--secondary {
    background: transparent;
    color: #f3feee;
  }

  .somna-page-hero__button:hover {
    border-color: #f3feee;
    background: #f3feee;
    color: #0b0f1d;
    transform: translateY(-2px);
  }

  .somna-page-hero__button:focus-visible {
    outline: 2px solid #f3feee;
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 24px;
    }

    .somna-page-hero--image-right .somna-page-hero__media {
      order: 2;
    }

    .somna-page-hero__image {
      min-height: clamp(360px, 36vw, 520px);
    }

    .somna-page-hero__panel {
      padding: 40px clamp(28px, 3.5vw, 56px) 64px;
    }

    .somna-page-hero__eyebrow {
      font-size: clamp(15px, 1.25vw, 18px);
    }

    .somna-page-hero__text {
      font-size: clamp(1rem, 1.25vw, 1.125rem);
    }

    /* Entrance: photo and panel fade up once on load (the global reveal skips the first section). */
    .somna-page-hero__media,
    .somna-page-hero__panel > *,
    .somna-page-hero__aside > * {
      animation: somna-page-hero-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .somna-page-hero__panel > :nth-child(2) { animation-delay: 0.06s; }
    .somna-page-hero__panel > :nth-child(3) { animation-delay: 0.12s; }
    .somna-page-hero__panel > :nth-child(4) { animation-delay: 0.18s; }
    .somna-page-hero__panel > :nth-child(5) { animation-delay: 0.24s; }
    .somna-page-hero__panel > :nth-child(n + 6) { animation-delay: 0.3s; }
    .somna-page-hero__aside > * { animation-delay: 0.18s; }

    .somna-page-hero__media img {
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .somna-page-hero__media:hover img {
      transform: scale(1.03);
    }
  }

  /* "Open" style (Figma 4859:1355 Contact, 4859:1740 How to use): text straight on the lavender band,
     heading with the second line in mint, photo on the right with a navy drip hanging under it. */
  /* Figma content runs 104 → 1336 at 1440 */
  .somna-page-hero--open {
    --somna-content-width: 1232px;
  }

  .somna-page-hero--open .somna-page-hero__panel {
    gap: 0;
    padding: 0;
    border-radius: 0;
    background: none;
    color: #000;
  }

  .somna-page-hero--open .somna-page-hero__eyebrow {
    margin-bottom: 6px;
    color: #0a1a4a;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1.3;
  }

  .somna-page-hero--open .somna-page-hero__title {
    color: #000;
    font-size: clamp(2.25rem, 3.86vw, 3.4766rem);
    line-height: 1.35;
    text-wrap: initial;
  }

  .somna-page-hero--open .somna-page-hero__title em {
    display: block;
    color: var(--sph-accent);
    font-style: normal;
  }

  .somna-page-hero--open .somna-page-hero__tagline {
    color: #000;
  }

  .somna-page-hero--open .somna-page-hero__text {
    max-width: 503px;
    margin-top: 6px;
    color: #000;
    font-size: clamp(1rem, 1.37vw, 1.2315rem);
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .somna-page-hero--open .somna-page-hero__text a {
    color: inherit;
  }

  .somna-page-hero--open .somna-page-hero__media {
    --somna-drip-h: clamp(40px, 6.4vw, 92px);
    align-self: center;
    border-radius: 0;
    background: var(--sph-media);
  }

  .somna-page-hero--open .somna-page-hero__image {
    min-height: 0;
    aspect-ratio: 523 / 305;
  }

  /* jump links under the text (How to use: "Nasal Strips ↓") */
  /* Figma 4859:1909: mint pill, thin black border */
  .somna-page-hero__button--pill {
    gap: 6px;
    min-height: 48px;
    padding: 0 15px;
    border: 1px solid #000;
    border-radius: 29px;
    background: #f3feee;
    color: #000;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .somna-page-hero__button--pill:hover {
    border-color: #000;
    background: #000;
    color: #f3feee;
  }

  /* phones: text first, then the photo; the band's padding is an inline style from the settings */
  @media screen and (max-width: 749px) {
    .somna-page-hero.somna-page-hero--open {
      padding-block: 40px 16px !important;
    }

    .somna-page-hero--open .somna-page-hero__grid {
      gap: 24px;
    }

    .somna-page-hero--open .somna-page-hero__media {
      order: 2;
    }
  }

  @media screen and (min-width: 750px) {
    .somna-page-hero--open .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 523px);
      align-items: center;
      gap: 48px;
    }

    .somna-page-hero--open .somna-page-hero__media {
      order: 2;
    }
  }

  /* "Aside" style (Figma 4823:999 Collection): heading on the left, tagline + filter chips centred in a right column */
  .somna-page-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .somna-page-hero--aside .somna-page-hero__tagline {
    color: #000;
    font-size: clamp(1rem, 1.37vw, 1.2315rem);
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .somna-page-hero--aside .somna-page-hero__actions {
    justify-content: center;
    gap: 9px;
    margin-top: 0;
  }

  /* Figma 4823:1034–1045: 56px chips, mint with a 1px black border, Inter Bold 19.7px; current one black */
  .somna-page-hero__button--chip {
    min-height: 56px;
    padding: 0 12px;
    border: 1px solid #000;
    border-radius: 34px;
    background: #f3feee;
    color: #000;
    font-size: clamp(1rem, 1.37vw, 1.2315rem);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .somna-page-hero__button--chip.is-active {
    min-width: 98px;
    background: #000;
    color: #f3feee;
    text-transform: uppercase;
  }

  .somna-page-hero__button--chip:hover {
    border-color: #000;
    background: #000;
    color: #f3feee;
  }

  @media screen and (min-width: 750px) {
    .somna-page-hero--aside .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 618px);
      align-items: start;
      gap: 32px;
    }

    .somna-page-hero--aside .somna-page-hero__aside {
      padding-top: clamp(40px, 5.8vw, 82px);
    }
  }

  @media screen and (max-width: 749px) {
    .somna-page-hero--aside .somna-page-hero__aside {
      align-items: flex-start;
      text-align: left;
    }

    .somna-page-hero--aside .somna-page-hero__actions {
      justify-content: flex-start;
      gap: 8px;
    }

    .somna-page-hero__button--chip {
      min-height: 42px;
      padding: 0 14px;
      font-size: 0.875rem;
      letter-spacing: 0.04em;
    }
  }

  /* "Card" style (Figma 4927:1231 Support): open text column + search + jump pills, black help card with a drip on the right */
  .somna-page-hero__search {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 649px;
    min-height: 69px;
    margin-top: 24px;
    border: 2.44px solid #000;
    border-radius: 68px;
    background: #fff;
    box-shadow: 3.25px 4.06px 0 #000;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .somna-page-hero__search:hover,
  .somna-page-hero__search:focus-within {
    box-shadow: 5px 6px 0 #000;
    transform: translate(-1px, -1px);
  }

  .somna-page-hero__search-icon {
    position: absolute;
    left: 48px;
    color: #000;
    opacity: 0.5;
    pointer-events: none;
  }

  .somna-page-hero__search input[type='search'] {
    width: 100%;
    min-height: 64px;
    padding: 0 28px 0 116px;
    border: 0;
    border-radius: 68px;
    background: none;
    color: #000;
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 1.52vw, 1.367rem);
    font-weight: 500;
    outline: none;
    box-shadow: none;
  }

  .somna-page-hero__search input::placeholder {
    color: #808080;
    opacity: 1;
  }

  .somna-page-hero--card .somna-page-hero__text {
    max-width: 616px;
  }

  .somna-page-hero--card .somna-page-hero__actions {
    gap: 12px;
    margin-top: 50px;
  }

  /* Figma 4927:1305: white pill, 2.44px border, hard shadow, Inter Medium 21.9px */
  .somna-page-hero--card .somna-page-hero__button--pill {
    gap: 4px;
    min-height: 48px;
    padding: 0 12px;
    border: 2.44px solid #000;
    border-radius: 68px;
    background: #fff;
    box-shadow: 3.25px 4.06px 0 #000;
    font-size: clamp(1rem, 1.52vw, 1.367rem);
    font-weight: 500;
    letter-spacing: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .somna-page-hero--card .somna-page-hero__button--pill:hover {
    border-color: #000;
    background: #000;
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 5.5px 0 #000;
  }

  .somna-page-hero--card .somna-page-hero__button--pill:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 #000;
  }

  .somna-page-hero--card .somna-page-hero__pill-arrow {
    transition: transform 0.25s ease;
  }

  .somna-page-hero--card .somna-page-hero__button--pill:hover .somna-page-hero__pill-arrow {
    transform: translateY(3px);
  }

  .somna-page-hero__card {
    --somna-drip-h: clamp(36px, 3.4vw, 48px);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px 20px 26px;
    background: #000;
    color: #f3feee;
  }

  .somna-page-hero__card-icon {
    position: absolute;
    top: 20px;
    right: 18px;
    width: clamp(72px, 8.65vw, 124.5px);
    height: auto;
    color: #f3feee;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .somna-page-hero__card:hover .somna-page-hero__card-icon {
    transform: translateY(-6px) rotate(-4deg);
  }

  .somna-page-hero__card-eyebrow {
    margin: 0;
    font-size: clamp(0.9375rem, 1.3vw, 1.1658rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .somna-page-hero__card-title {
    margin: 4px 0 0;
    padding-right: 120px;
    color: inherit;
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.24vw, 2.9143rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .somna-page-hero__card-text {
    margin: 0 0 14px;
    font-size: 0.8743rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  /* Figma 4927:1319: lavender, 2.84px border, hard shadow, Inter Bold 18.65 / 0.18em */
  .somna-page-hero__card-button {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 58px;
    border: 2.84px solid #000;
    border-radius: 9.33px;
    background: #afbdf8;
    box-shadow: 3.79px 4.73px 0 #000;
    color: #000;
    font-size: clamp(1rem, 1.3vw, 1.1658rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .somna-page-hero__card-button:hover {
    background: #f3feee;
    transform: translate(-1px, -1px);
    box-shadow: 5px 6px 0 #000;
  }

  .somna-page-hero__card-button:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 #000;
  }

  .somna-page-hero__card-button:focus-visible,
  .somna-page-hero__search:has(input:focus-visible) {
    outline: 2px solid #f3feee;
    outline-offset: 3px;
  }

  .somna-page-hero__search:has(input:focus-visible) {
    outline-color: #000;
  }

  /* tablets: the help card sits under the text (two columns from 990px) */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-page-hero--card .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .somna-page-hero--card .somna-page-hero__card {
      width: min(100%, 549px);
    }
  }

  @media screen and (min-width: 990px) {
    .somna-page-hero--card .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 549px);
      align-items: start;
      gap: 32px;
    }

    .somna-page-hero--card .somna-page-hero__card {
      margin-top: 50px;
      animation: somna-page-hero-in 0.7s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @media screen and (max-width: 749px) {
    .somna-page-hero__search {
      min-height: 56px;
      margin-top: 18px;
    }

    .somna-page-hero__search-icon {
      left: 20px;
      width: 22px;
    }

    .somna-page-hero__search input[type='search'] {
      min-height: 52px;
      padding-left: 54px;
    }

    .somna-page-hero--card .somna-page-hero__actions {
      gap: 10px;
      margin-top: 22px;
    }

    .somna-page-hero--card .somna-page-hero__button--pill {
      min-height: 42px;
      font-size: 0.9375rem;
    }

    .somna-page-hero__card-title {
      padding-right: 76px;
      font-size: 1.75rem;
    }

    .somna-page-hero__card-icon {
      top: 16px;
      width: 64px;
    }
  }

  @keyframes somna-page-hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-page-hero__media,
    .somna-page-hero__panel > *,
    .somna-page-hero__aside > * {
      animation: none;
    }

    .somna-page-hero__media img,
    .somna-page-hero__button {
      transition: none;
    }
  }

  /* search filter: clear button, live count, highlighted words, hidden questions (sections/somna-faq-cards) */
  .somna-page-hero__search-wrap {
    display: block;
    max-width: 649px;
  }

  .somna-page-hero__search-clear {
    position: absolute;
    right: 18px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #000;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .somna-page-hero__search-clear:hover {
    background: #afbdf8;
  }

  .somna-page-hero__search-clear[hidden] {
    display: none;
  }

  .somna-page-hero__search-status {
    min-height: 1.3em;
    margin: 10px 0 0 24px;
    color: #000;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .somna-page-hero__search-status:empty {
    display: none;
  }

  .is-search-hidden {
    display: none !important;
  }

  .somna-faq-cards.is-filtering .somna-faq-cards__card {
    min-height: 0;
    animation: somna-page-hero-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .somna-faq-cards__q mark {
    padding: 0 2px;
    border-radius: 3px;
    background: #afbdf8;
    color: inherit;
    font-weight: 700;
  }

  .somna-faq-cards__noresult {
    grid-column: 1 / -1;
    margin: 0;
    padding: 32px 0;
    text-align: center;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
  }

  /* map pin (setting "Animate the pin"): drops in, then hops every few seconds while a ping ring spreads under it */
  .somna-page-hero__card-pin {
    display: block;
    aspect-ratio: 1;
  }

  .somna-page-hero__pin-body,
  .somna-page-hero__pin-body :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .somna-page-hero__pin-body {
    position: relative;
    transform-origin: 45% 92%;
  }

  .somna-page-hero__pin-ping {
    position: absolute;
    left: 22%;
    bottom: 2%;
    width: 46%;
    height: 14%;
    border: 2px solid #f3feee;
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .somna-page-hero__card-pin.is-animated .somna-page-hero__pin-body {
    animation:
      somnaPinDrop 0.9s 0.5s cubic-bezier(0.34, 1.4, 0.64, 1) both,
      somnaPinHop 3.2s 1.6s ease-in-out infinite;
  }

  .somna-page-hero__card-pin.is-animated .somna-page-hero__pin-ping {
    animation: somnaPinPing 3.2s 1.6s ease-out infinite;
  }

  .somna-page-hero__card:hover .somna-page-hero__card-pin {
    transform: none;
  }

  .somna-page-hero__card:hover .somna-page-hero__card-pin .somna-page-hero__pin-body {
    animation-duration: 0.9s, 1.2s;
  }

  .somna-page-hero__card:hover .somna-page-hero__card-pin .somna-page-hero__pin-ping {
    animation-duration: 1.2s;
  }

  @keyframes somnaPinDrop {
    0% { opacity: 0; transform: translateY(-60px) rotate(-8deg); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @keyframes somnaPinHop {
    0%, 55%, 100% { transform: none; }
    63% { transform: scale(1.06, 0.92); }
    75% { transform: translateY(-16px) rotate(-5deg); }
    86% { transform: translateY(0) scale(1.04, 0.95); }
    93% { transform: scale(0.99, 1.02); }
  }

  @keyframes somnaPinPing {
    0%, 84% { opacity: 0; transform: scale(0.4); }
    87% { opacity: 0.9; transform: scale(0.5); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-page-hero__card-pin.is-animated :is(.somna-page-hero__pin-body, .somna-page-hero__pin-ping) {
      animation: none;
    }
  }

  /* desktop: text column 682px like Figma so the four jump pills sit in one row */
  @media screen and (min-width: 990px) {
    .somna-page-hero--card .somna-page-hero__grid {
      grid-template-columns: minmax(0, 682px) minmax(0, 549px);
      justify-content: space-between;
    }

    .somna-page-hero--card .somna-page-hero__actions {
      flex-wrap: nowrap;
      gap: 15px;
    }

    .somna-page-hero--card .somna-page-hero__button--pill {
      flex: none;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna page hero",
  "tag": "section",
  "class": "somna-page-hero-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "home_label", "label": "Breadcrumb home label", "default": "Home" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb page label", "info": "Empty uses the page title." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Empty uses the page title. Italic words take the accent colour." },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_position", "label": "Image focal point", "default": "object-position: center", "info": "CSS, e.g. object-position: 60% 40%" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill" }, { "value": "contain", "label": "Fit (cut-outs)" }], "default": "cover" },
    { "type": "color", "id": "media_color", "label": "Image background", "info": "Shows around cut-out images. Empty uses the panel colour." },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "panel", "label": "Navy panel beside the photo" }, { "value": "open", "label": "Open: text on the background, photo on the right" }, { "value": "aside", "label": "Aside: no photo, buttons in a right column" }, { "value": "card", "label": "Card: search, help card on the right" }], "default": "panel", "info": "Open: italic words in the heading start a new line in the accent colour; the drip hangs under the photo." },
    { "type": "header", "content": "Card style (Support)" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "info": "Empty hides the search field." },
    { "type": "text", "id": "card_eyebrow", "label": "Card eyebrow" },
    { "type": "text", "id": "card_heading", "label": "Card heading" },
    { "type": "text", "id": "card_text", "label": "Card text" },
    { "type": "text", "id": "search_count", "label": "Search: results line", "default": "[n] matching questions", "info": "[n] = number of questions found. Typing in the search filters the FAQ cards on the page." },
    { "type": "text", "id": "search_empty", "label": "Search: nothing found", "default": "No answers for “[q]”. Try another word, or contact us below.", "info": "[q] = what was typed" },
    { "type": "image_picker", "id": "card_image", "label": "Card picture (replaces the icon)" },
    { "type": "checkbox", "id": "card_image_key", "label": "Remove the picture's background (light lines only)", "default": true },
    { "type": "checkbox", "id": "pin_motion", "label": "Animate the picture (pin drop + hop)", "default": true },
    { "type": "select", "id": "card_icon", "label": "Card icon", "options": [{ "value": "none", "label": "None" }, { "value": "pin", "label": "Location pin" }, { "value": "truck", "label": "Truck" }, { "value": "box", "label": "Box" }, { "value": "chat", "label": "Chat" }], "default": "pin" },
    { "type": "text", "id": "card_button", "label": "Card button" },
    { "type": "url", "id": "card_link", "label": "Card button link" },
    { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "checkbox", "id": "drip_edge", "label": "Drip edge on panel", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#afbdf8" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#0b0f1d" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Filled" }, { "value": "secondary", "label": "Outline" }, { "value": "pill", "label": "Small pill with ↓ (jump link)" }, { "value": "chip", "label": "Chip (filter links)" }], "default": "primary" },
        { "type": "checkbox", "id": "active", "label": "Current (black chip)", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Somna page hero" }]
}
{% endschema %}
