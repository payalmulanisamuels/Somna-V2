{%- doc -%}
  Somna V2 — hero for content pages (Contact, How to use, Support). Same language as the PDP hero:
  lavender band, rounded photo on one side, navy panel with a drip edge on the other holding a
  breadcrumb, eyebrow, display heading, tagline, text and up to two buttons (blocks).
  Leave the heading empty to show the page title.
{%- enddoc -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: page.title
  assign crumb = s.breadcrumb_label | default: page.title
-%}
<div
  class="somna-page-hero somna-page-hero--image-{{ s.image_side }} somna-page-hero--{{ s.style | default: 'panel' }}"
  style="--sph-bg: {{ s.background_color }}; --sph-panel: {{ s.panel_color }}; --sph-media: {{ s.media_color | default: s.panel_color }}; --sph-fit: {{ s.image_fit }}; --sph-accent: {{ s.accent_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <div class="somna-container somna-page-hero__grid">
    <div class="somna-page-hero__media{% if s.style == 'open' and s.drip_edge %} somna-edge-drip-bottom{% endif %}">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'somna-page-hero__image',
            style: s.image_position
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'somna-page-hero__image somna-page-hero__image--placeholder' }}
      {%- endif -%}
    </div>

    <div class="somna-page-hero__panel{% if s.drip_edge and s.style != 'open' %} somna-edge-drip-bottom{% endif %}">
      {%- if s.show_breadcrumb -%}
        <nav class="somna-page-hero__crumbs" aria-label="{{ 'accessibility.breadcrumbs' | t | default: 'Breadcrumb' }}">
          <a href="{{ routes.root_url }}">{{ s.home_label | escape }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ crumb | escape }}</span>
        </nav>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="somna-page-hero__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="somna-page-hero__title somna-accent">{{ heading }}</h1>
      {%- if s.tagline != blank -%}<p class="somna-page-hero__tagline">{{ s.tagline | escape }}</p>{%- endif -%}
      {%- if s.text != blank -%}<div class="somna-page-hero__text">{{ s.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="somna-page-hero__actions">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <a
              class="somna-page-hero__button somna-page-hero__button--{{ b.style }}"
              href="{{ b.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {{- b.label | escape -}}
              {%- if b.style == 'pill' -%}<span class="somna-page-hero__pill-arrow" aria-hidden="true">↓</span>{%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .somna-page-hero {
    background: var(--sph-bg);
    overflow: hidden;
  }

  .somna-page-hero__grid {
    display: grid;
    gap: 20px;
  }

  .somna-page-hero__media {
    overflow: hidden;
    border-radius: 12px;
    background: var(--sph-media);
  }

  .somna-page-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: var(--sph-fit, cover);
  }

  .somna-page-hero__panel {
    --somna-drip-h: 60px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 28px 24px 40px;
    border-radius: 12px;
    background: var(--sph-panel);
    color: #fff;
  }

  .somna-page-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #9a9a9a;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }

  .somna-page-hero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .somna-page-hero__crumbs a:hover {
    color: #f3feee;
    text-decoration: underline;
  }

  .somna-page-hero__eyebrow {
    margin: 0;
    color: var(--sph-accent);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .somna-page-hero__title {
    --somna-accent: var(--sph-accent);
    margin: 0;
    color: #f3feee;
    font-family: var(--font-accent--family);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.3;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .somna-page-hero__tagline {
    margin: 0;
    color: #f3feee;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .somna-page-hero__text {
    max-width: 34em;
    color: rgb(255 255 255 / 0.82);
    font-size: 1rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  .somna-page-hero__text :is(p, ul) {
    margin: 0;
  }

  .somna-page-hero__text a {
    color: #f3feee;
  }

  .somna-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .somna-page-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border: 2px solid var(--sph-accent);
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .somna-page-hero__button--primary {
    background: var(--sph-accent);
    color: #000;
  }

  .somna-page-hero__button--secondary {
    background: transparent;
    color: #f3feee;
  }

  .somna-page-hero__button:hover {
    border-color: #f3feee;
    background: #f3feee;
    color: #0b0f1d;
    transform: translateY(-2px);
  }

  .somna-page-hero__button:focus-visible {
    outline: 2px solid #f3feee;
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 24px;
    }

    .somna-page-hero--image-right .somna-page-hero__media {
      order: 2;
    }

    .somna-page-hero__image {
      min-height: clamp(360px, 36vw, 520px);
    }

    .somna-page-hero__panel {
      padding: 40px clamp(28px, 3.5vw, 56px) 64px;
    }

    .somna-page-hero__eyebrow {
      font-size: clamp(15px, 1.25vw, 18px);
    }

    .somna-page-hero__text {
      font-size: clamp(1rem, 1.25vw, 1.125rem);
    }

    /* Entrance: photo and panel fade up once on load (the global reveal skips the first section). */
    .somna-page-hero__media,
    .somna-page-hero__panel > * {
      animation: somna-page-hero-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .somna-page-hero__panel > :nth-child(2) { animation-delay: 0.06s; }
    .somna-page-hero__panel > :nth-child(3) { animation-delay: 0.12s; }
    .somna-page-hero__panel > :nth-child(4) { animation-delay: 0.18s; }
    .somna-page-hero__panel > :nth-child(5) { animation-delay: 0.24s; }
    .somna-page-hero__panel > :nth-child(n + 6) { animation-delay: 0.3s; }

    .somna-page-hero__media img {
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .somna-page-hero__media:hover img {
      transform: scale(1.03);
    }
  }

  /* "Open" style (Figma 4859:1355 Contact, 4859:1740 How to use): text straight on the lavender band,
     heading with the second line in mint, photo on the right with a navy drip hanging under it. */
  /* Figma content runs 104 → 1336 at 1440 */
  .somna-page-hero--open {
    --somna-content-width: 1232px;
  }

  .somna-page-hero--open .somna-page-hero__panel {
    gap: 0;
    padding: 0;
    border-radius: 0;
    background: none;
    color: #000;
  }

  .somna-page-hero--open .somna-page-hero__eyebrow {
    margin-bottom: 6px;
    color: #0a1a4a;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1.3;
  }

  .somna-page-hero--open .somna-page-hero__title {
    color: #000;
    font-size: clamp(2.25rem, 3.86vw, 3.4766rem);
    line-height: 1.35;
    text-wrap: initial;
  }

  .somna-page-hero--open .somna-page-hero__title em {
    display: block;
    color: var(--sph-accent);
    font-style: normal;
  }

  .somna-page-hero--open .somna-page-hero__tagline {
    color: #000;
  }

  .somna-page-hero--open .somna-page-hero__text {
    max-width: 503px;
    margin-top: 6px;
    color: #000;
    font-size: clamp(1rem, 1.37vw, 1.2315rem);
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .somna-page-hero--open .somna-page-hero__text a {
    color: inherit;
  }

  .somna-page-hero--open .somna-page-hero__media {
    --somna-drip-h: clamp(40px, 6.4vw, 92px);
    align-self: center;
    border-radius: 0;
    background: var(--sph-media);
  }

  .somna-page-hero--open .somna-page-hero__image {
    min-height: 0;
    aspect-ratio: 523 / 305;
  }

  /* jump links under the text (How to use: "Nasal Strips ↓") */
  /* Figma 4859:1909: mint pill, thin black border */
  .somna-page-hero__button--pill {
    gap: 6px;
    min-height: 48px;
    padding: 0 15px;
    border: 1px solid #000;
    border-radius: 29px;
    background: #f3feee;
    color: #000;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .somna-page-hero__button--pill:hover {
    border-color: #000;
    background: #000;
    color: #f3feee;
  }

  /* phones: text first, then the photo; the band's padding is an inline style from the settings */
  @media screen and (max-width: 749px) {
    .somna-page-hero.somna-page-hero--open {
      padding-block: 40px 16px !important;
    }

    .somna-page-hero--open .somna-page-hero__grid {
      gap: 24px;
    }

    .somna-page-hero--open .somna-page-hero__media {
      order: 2;
    }
  }

  @media screen and (min-width: 750px) {
    .somna-page-hero--open .somna-page-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 523px);
      align-items: center;
      gap: 48px;
    }

    .somna-page-hero--open .somna-page-hero__media {
      order: 2;
    }
  }

  @keyframes somna-page-hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-page-hero__media,
    .somna-page-hero__panel > * {
      animation: none;
    }

    .somna-page-hero__media img,
    .somna-page-hero__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Somna page hero",
  "tag": "section",
  "class": "somna-page-hero-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "home_label", "label": "Breadcrumb home label", "default": "Home" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb page label", "info": "Empty uses the page title." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Empty uses the page title. Italic words take the accent colour." },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_position", "label": "Image focal point", "default": "object-position: center", "info": "CSS, e.g. object-position: 60% 40%" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill" }, { "value": "contain", "label": "Fit (cut-outs)" }], "default": "cover" },
    { "type": "color", "id": "media_color", "label": "Image background", "info": "Shows around cut-out images. Empty uses the panel colour." },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "panel", "label": "Navy panel beside the photo" }, { "value": "open", "label": "Open: text on the background, photo on the right" }], "default": "panel", "info": "Open: italic words in the heading start a new line in the accent colour; the drip hangs under the photo." },
    { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "checkbox", "id": "drip_edge", "label": "Drip edge on panel", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#afbdf8" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#0b0f1d" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#afbdf8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Filled" }, { "value": "secondary", "label": "Outline" }, { "value": "pill", "label": "Small pill with ↓ (jump link)" }], "default": "primary" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Somna page hero" }]
}
{% endschema %}
