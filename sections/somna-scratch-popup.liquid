<script>
  (() => {
    const config = {
      delayMs: {{ s.delay_seconds | times: 1000 | json }},
      code: {{ popup_code | json }},
      klaviyoCompanyId: {{ s.klaviyo_company_id | strip | json }},
      klaviyoListId: {{ s.klaviyo_list_id | strip | json }},
      excludedPaths: {{ s.excluded_paths | newline_to_br | split: '<br />' | json }},
      unwrapping: {{ s.unwrapping | json }},
      copied: 'Copied',
      copyLabel: {{ s.copy_label | json }},
      invalid: 'Enter a valid email address.',
    };

    const KEYS = {
      dismissedAt: 'somna_popup_dismissed_at', // legacy 14-day cooldown key, cleared on load
      signedUp: 'somna_popup_signed_up',       // localStorage: signed up, never show again
      suppressed: 'somna_popup_suppressed',    // localStorage: arrived from Klaviyo / known profile
      scratched: 'somna_popup_scratched',      // legacy localStorage key, cleared on load
      closed: 'somna_popup_closed',            // session cookie: closed this browser session
    };
    const storage = {
      get(store, key) { try { return window[store].getItem(key); } catch (e) { return null; } },
      set(store, key, value) { try { window[store].setItem(key, value); } catch (e) {} },
      remove(store, key) { try { window[store].removeItem(key); } catch (e) {} }
    };

    // "Closed" lives in a session cookie (no expiry): every page and tab shares it, and the
    // browser clears it when it is closed, so the popup comes back on the next visit.
    const closedForSession = {
      get() { try { return document.cookie.split('; ').includes(KEYS.closed + '=1'); } catch (e) { return false; } },
      set() { try { document.cookie = KEYS.closed + '=1; path=/; SameSite=Lax'; } catch (e) {} },
    };

    function track(name, data = {}) {
      const eventName = 'somna_popup_' + name;
      const payload = { ...data, source: 'Scratch Popup' };
      try { (window.dataLayer = window.dataLayer || []).push({ event: eventName, ...payload }); } catch (e) {}
      try { window.Shopify?.analytics?.publish?.(eventName, payload); } catch (e) {}
      try { window.klaviyo?.push?.(['track', 'Scratch Popup ' + name.replace(/_/g, ' '), payload]); } catch (e) {}
    }

    function isSuppressed() {
      const path = window.location.pathname;
      const excluded = config.excludedPaths.map((p) => p.trim()).filter(Boolean);
      if (excluded.some((p) => path.includes(p))) return true;
      if (storage.get('localStorage', KEYS.signedUp) || storage.get('localStorage', KEYS.suppressed)) return true;
      const params = new URLSearchParams(window.location.search);
      const fromKlaviyo =
        params.has('_kx') ||
        /klaviyo/i.test(params.get('utm_source') || '') ||
        (params.get('utm_medium') || '').toLowerCase() === 'email';
      let knownToKlaviyo = false;
      try {
        const cookie = document.cookie.split('; ').find((c) => c.startsWith('__kla_id='));
        if (cookie) {
          const data = JSON.parse(atob(decodeURIComponent(cookie.split('=')[1])));
          knownToKlaviyo = Boolean(data.$exchange_id || data.$email);
        }
      } catch (e) {}
      if (fromKlaviyo || knownToKlaviyo) {
        storage.set('localStorage', KEYS.suppressed, '1');
        return true;
      }
      return false;
    }

    function init() {
      const overlay = document.getElementById('somna-overlay');
      const teaserTab = document.getElementById('somna-teaser-tab');
      if (!overlay || overlay.dataset.somnaReady) return;
      overlay.dataset.somnaReady = 'true';

      const card = overlay.querySelector('.sgp__card');
      const screens = ['1', 'reveal', '2', '3'].map((n) => document.getElementById('somna-screen-' + n));
      const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let isOpen = false;
      let lastFocus = null;
      let openTimer = null;
      let closeTimer = null;
      const CLOSE_MS = 240;

      // theme editor: open straight away so the popup can be styled
      const inEditor = {{ request.design_mode | json }};

      function lockScroll() {
        const root = document.documentElement;
        const scrollbar = window.innerWidth - root.clientWidth;
        root.style.setProperty('--somna-scrollbar-width', scrollbar > 0 ? scrollbar + 'px' : '0px');
        root.classList.add('somna-popup-open');
      }

      function unlockScroll() {
        const root = document.documentElement;
        root.classList.remove('somna-popup-open');
        root.style.removeProperty('--somna-scrollbar-width');
      }

      storage.remove('localStorage', KEYS.scratched);
      storage.remove('localStorage', KEYS.dismissedAt);

      if (!inEditor && isSuppressed()) return;

      const closedThisSession = closedForSession.get();
      if (closedThisSession && !inEditor) teaserTab?.classList.remove('somna-hidden');

      function showScreen(index) {
        screens.forEach((screen, i) => screen?.classList.toggle('somna-hidden', i !== index));
        const screen = screens[index];
        screen?.classList.remove('sgp__screen-enter', 'is-entering');
        void screen?.offsetWidth;
        screen?.classList.add('sgp__screen-enter', 'is-entering');
        card.scrollTop = 0;
        overlay.setAttribute('aria-labelledby', screen?.querySelector('h2')?.id || 'somna-screen-1-title');
      }

      function focusables() {
        return [...overlay.querySelectorAll('button, [href], input, [tabindex="0"]')].filter(
          (el) => !el.disabled && el.offsetParent !== null
        );
      }

      function onKeydown(event) {
        if (!isOpen) return;
        if (event.key === 'Escape') { event.preventDefault(); closePopup(); return; }
        if (event.key === 'Tab') {
          const items = focusables();
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      }

      function openPopup(trigger) {
        if (isOpen) return;
        // Automatic triggers (timer, exit intent) never reopen it after a close or a sign-up;
        // only the visitor's own click on the side tab can.
        if (trigger !== 'teaser' && trigger !== 'editor' && (closedForSession.get() || storage.get('localStorage', KEYS.signedUp))) return;
        isOpen = true;
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
        lastFocus = document.activeElement;
        teaserTab?.classList.add('somna-hidden');
        overlay.classList.remove('somna-hidden');
        overlay.setAttribute('aria-hidden', 'false');
        lockScroll();
        void overlay.offsetWidth;
        overlay.classList.add('somna-visible');
        document.addEventListener('keydown', onKeydown);
        setTimeout(() => {
          const unwrapBtn = screens[0].querySelector('.sgp__unwrap');
          if (!screens[0].classList.contains('somna-hidden') && unwrapBtn && unwrapBtn.offsetParent) unwrapBtn.focus({ preventScroll: true });
          else card.focus({ preventScroll: true });
        }, 60);
        track('view', { trigger });
      }

      function closePopup() {
        if (!isOpen) return;
        isOpen = false;
        overlay.classList.remove('somna-visible');
        overlay.setAttribute('aria-hidden', 'true');
        document.removeEventListener('keydown', onKeydown);
        const signedUp = storage.get('localStorage', KEYS.signedUp);
        if (!signedUp && !inEditor) closedForSession.set();
        clearTimeout(openTimer);
        closeTimer = setTimeout(() => {
          overlay.classList.add('somna-hidden');
          unlockScroll();
          if (!signedUp) teaserTab?.classList.remove('somna-hidden');
          if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus({ preventScroll: true });
        }, CLOSE_MS);
        track('close');
      }

      overlay.querySelectorAll('.somna-close-btn, .somna-close-trigger').forEach((el) => el.addEventListener('click', closePopup));
      overlay.addEventListener('click', (event) => { if (event.target === overlay) closePopup(); });
      teaserTab?.addEventListener('click', () => openPopup('teaser'));
      // demo: ?sgp_tab=side|bubble|pill|peek previews another reopen-button look
      if (new URLSearchParams(location.search).get('sgp_desktop') === 'split') card.classList.add('sgp__card--split');
      const demoTab = new URLSearchParams(location.search).get('sgp_tab');
      if (demoTab && teaserTab) teaserTab.className = teaserTab.className.replace(/sgp-tab--\w+/, 'sgp-tab--' + demoTab.replace(/\W/g, ''));

      // ---------- Unwrap the box (replaces the scratch card) ----------
      let unwrapped = false;
      function unwrap() {
        if (unwrapped) return;
        unwrapped = true;
        const screen = screens[0];
        const status = screen.querySelector('.sgp__unwrapping');
        screen.classList.add('is-unwrapping');
        if (status) status.textContent = config.unwrapping;
        screen.querySelector('.sgp__box')?.setAttribute('aria-disabled', 'true');
        track('scratch_complete', { method: 'unwrap' });
        const fast = reduceMotion();
        setTimeout(() => screen.classList.add('is-opened'), fast ? 0 : 900);
        setTimeout(() => {
          screen.classList.add('sgp__screen-leave');
          setTimeout(() => {
            screen.classList.remove('sgp__screen-leave');
            showScreen(1);
            setTimeout(() => screens[1].querySelector('[data-claim]')?.focus({ preventScroll: true }), 350);
          }, fast ? 0 : 300);
        }, fast ? 500 : 1700);
      }
      screens[0].querySelectorAll('[data-unwrap]').forEach((el) => el.addEventListener('click', unwrap));

      // ---------- Email capture (Klaviyo) ----------
      const form = document.getElementById('somna-signup-form');
      const emailInput = document.getElementById('somna-email-input');
      const errorBox = document.getElementById('somna-error-container');
      const submitBtn = document.getElementById('somna-submit-btn');
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      function showError(message) {
        errorBox.textContent = message;
        emailInput.setAttribute('aria-invalid', message ? 'true' : 'false');
        if (message) emailInput.focus();
      }

      function showAlreadySubscribed() {
        form?.classList.add('somna-hidden');
        overlay.querySelector('#somna-screen-2 .sgp__consent')?.classList.add('somna-hidden');
        const message = document.getElementById('somna-already-subscribed');
        message?.classList.remove('somna-hidden');
        message?.setAttribute('tabindex', '-1');
        message?.focus();
      }

      screens[1]?.querySelector('[data-claim]')?.addEventListener('click', () => showClaimScreen());

      function showClaimScreen() {
        showScreen(2);
        if (storage.get('localStorage', KEYS.signedUp)) showAlreadySubscribed();
        else setTimeout(() => emailInput?.focus({ preventScroll: true }), 350);
      }

      function success() {
        storage.set('localStorage', KEYS.signedUp, '1');
        showScreen(3);
        card.focus({ preventScroll: true });
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = emailInput.value.trim();
        showError('');
        if (!EMAIL_RE.test(email)) { showError(config.invalid); return; }
        if (storage.get('localStorage', KEYS.signedUp)) { showAlreadySubscribed(); return; }

        submitBtn.disabled = true;
        track('email_submit');
        const payload = {
          data: {
            type: 'subscription',
            attributes: {
              custom_source: 'Scratch Popup',
              profile: {
                data: {
                  type: 'profile',
                  attributes: { email, subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } } },
                },
              },
            },
            relationships: { list: { data: { type: 'list', id: config.klaviyoListId } } },
          },
        };

        try {
          const response = await fetch(
            `https://a.klaviyo.com/client/subscriptions/?company_id=${encodeURIComponent(config.klaviyoCompanyId)}`,
            {
              method: 'POST',
              headers: { Accept: 'application/vnd.api+json', 'Content-Type': 'application/vnd.api+json', Revision: '2026-01-15' },
              body: JSON.stringify(payload),
            }
          );
          if (response.ok) success();
          else if (response.status === 400) showError(config.invalid);
          else success();
        } catch (error) {
          success();
        } finally {
          submitBtn.disabled = false;
        }
      });

      // ---------- Code screen ----------
      const copyBtn = document.getElementById('somna-copy-btn');
      copyBtn?.addEventListener('click', async () => {
        const codeEl = document.getElementById('somna-discount-code-text');
        const code = codeEl?.textContent.trim() || config.code;
        try {
          await navigator.clipboard.writeText(code);
        } catch (e) {
          const range = document.createRange();
          range.selectNodeContents(codeEl);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          try { document.execCommand('copy'); } catch (err) {}
          selection.removeAllRanges();
        }
        const label = copyBtn.querySelector('.sgp__copy-label') || copyBtn;
        label.textContent = config.copied;
        track('code_copied');
        setTimeout(() => { label.textContent = config.copyLabel; }, 2000);
      });

      document.getElementById('somna-shop-btn')?.addEventListener('click', () => {
        track('shop_now_click');
        storage.set('localStorage', KEYS.signedUp, '1');
      });

      function consentBannerOpen() {
        const banner = document.getElementById('shopify-pc__banner');
        if (!banner) return false;
        const style = getComputedStyle(banner);
        return style.display !== 'none' && style.visibility !== 'hidden' && banner.getBoundingClientRect().height > 0;
      }

      function openWhenClear(trigger) {
        if (!consentBannerOpen()) { openPopup(trigger); return; }
        const check = () => {
          if (consentBannerOpen()) return;
          clearInterval(poll);
          document.removeEventListener('visitorConsentCollected', check);
          setTimeout(() => openPopup(trigger), 1000);
        };
        const poll = setInterval(check, 1000);
        document.addEventListener('visitorConsentCollected', check);
      }

      if (inEditor) {
        if ({{ s.editor_preview | json }}) openPopup('editor');
        return;
      }
      if (closedThisSession) return;
      openTimer = setTimeout(() => openWhenClear('timer'), config.delayMs);

      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const onExitIntent = (event) => {
          if (!event.relatedTarget && event.clientY <= 0) {
            document.removeEventListener('mouseout', onExitIntent);
            openWhenClear('exit_intent');
          }
        };
        document.addEventListener('mouseout', onExitIntent);
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
{%- endif -%}

