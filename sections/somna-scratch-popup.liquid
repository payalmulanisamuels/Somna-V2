{%- comment -%}
  SOMNA welcome popup — "What's in the box?" (Figma 4954:2911 → 2935 → 3012 → 2959).
  Same rules as the live scratch popup (live theme sections/somna-scratch-popup.liquid); the scratch card is
  now a gift box the visitor taps to unwrap.

  - Shows on homepage, collections and product pages only; never for logged-in customers.
  - Opens after N seconds (default 10); on desktop also on exit intent before that. Waits for the cookie banner.
  - Closing hides it for the rest of the browser session (session cookie); the side tab then lets the
    visitor reopen it on every page.
  - Never shows again after a successful sign-up (localStorage).
  - Suppressed for visitors arriving from a Klaviyo email link or already known to Klaviyo.
  - Unwrap: tap / click the box or the button, or Enter / Space.
  - Email goes to the Klaviyo list (client subscriptions API) — same list and company as live.
  - Fixed discount code (default WELCOME10), auto-applied via /discount/CODE.
  - Tracking events (dataLayer, Shopify customer events, Klaviyo): somna_popup_view,
    somna_popup_scratch_complete (method: unwrap), somna_popup_email_submit, somna_popup_code_copied,
    somna_popup_shop_now_click, somna_popup_close — the same names as live, so reports keep working.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign popup_page_allowed = false
  if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product'
    assign popup_page_allowed = true
  endif
  if request.design_mode
    assign popup_page_allowed = true
  endif

  assign popup_code = s.discount_code | strip | default: 'WELCOME10'
  assign popup_redirect = s.shop_redirect | strip | default: '/collections/all'
  assign popup_shop_url = '/discount/' | append: popup_code | append: '?redirect=' | append: popup_redirect
-%}

{%- capture sgp_gift -%}
  <svg class="sgp-gift" viewBox="0 0 180 170" aria-hidden="true" focusable="false">
    <g class="sgp-gift__lid">
      <path d="M90 50C79 27 58 14 44 20c-12 5-11 20 1 27 10 6 28 5 45 3z" fill="currentColor"/>
      <path d="M90 50c11-23 32-36 46-30 12 5 11 20-1 27-10 6-28 5-45 3z" fill="currentColor"/>
      <path d="M86 46C77 32 64 25 55 28c-6 3-5 10 2 13 7 3 17 4 29 5z" fill="#000" opacity=".9"/>
      <path d="M94 46c9-14 22-21 31-18 6 3 5 10-2 13-7 3-17 4-29 5z" fill="#000" opacity=".9"/>
      <circle cx="90" cy="47" r="12" fill="currentColor"/>
      <rect x="10" y="56" width="160" height="38" rx="10" fill="currentColor"/>
      <rect x="82" y="56" width="16" height="38" fill="#000"/>
    </g>
    <g class="sgp-gift__body">
      <rect x="24" y="100" width="132" height="68" rx="10" fill="currentColor"/>
      <rect x="82" y="100" width="16" height="68" fill="#000"/>
    </g>
  </svg>
{%- endcapture -%}

{%- capture sgp_wave -%}
  <svg class="sgp-wave" viewBox="0 0 340 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 40C26 22 52 10 86 8c38-2 58 18 96 22 40 4 64-24 104-24 26 0 42 8 54 16v88H0z" fill="currentColor"/>
    <ellipse cx="58" cy="52" rx="15" ry="9" transform="rotate(-36 58 52)" fill="currentColor"/>
    <ellipse cx="48" cy="58" rx="10" ry="6" transform="rotate(36 48 58)" fill="currentColor"/>
    <ellipse cx="290" cy="40" rx="15" ry="10" transform="rotate(-36 290 40)" fill="currentColor"/>
    <ellipse cx="264" cy="52" rx="11" ry="7" transform="rotate(28 264 52)" fill="currentColor"/>
  </svg>
{%- endcapture -%}

{%- if s.enabled and popup_page_allowed and customer == blank -%}
<div
  id="somna-overlay"
  class="sgp somna-hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="somna-screen-1-title"
  aria-hidden="true"
>
  <div class="sgp__card{% if s.desktop_layout == 'split' %} sgp__card--split{% endif %}" tabindex="-1">
    <div class="sgp__top">
      <span class="sgp__logo">{{ s.logo_text | default: 'somna.' }}</span>
      <button type="button" class="sgp__close somna-close-btn" aria-label="Close popup">
        <svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false"><path d="M2 2l18 18M20 2L2 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- SCREEN 1: the box (Figma 4954:2911, unwrapping 4954:2935) -->
    <div id="somna-screen-1" class="sgp__screen sgp__screen--box">
      {%- if s.pill != blank -%}<p class="sgp__pill">{{ s.pill }}</p>{%- endif -%}
      <h2 class="sgp__title" id="somna-screen-1-title"><span>{{ s.title_1 }}</span> <em>{{ s.title_2 }}</em></h2>
      <p class="sgp__text">{{ s.box_text }}</p>
      <button type="button" class="sgp__box" data-unwrap aria-label="{{ s.button | escape }}">
        {{ sgp_gift }}
        <span class="sgp__sparks" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      </button>
      <div class="sgp__box-foot">
        <button type="button" class="sgp__unwrap" data-unwrap>{{ s.button }}</button>
        <p class="sgp__unwrapping" role="status" aria-live="polite"></p>
      </div>
      {%- if s.footnote != blank -%}<p class="sgp__fine">{{ s.footnote }}</p>{%- endif -%}
    </div>

    <!-- SCREEN 1b: reveal (Figma 4954:2986) — the burst pops out of the open box -->
    <div id="somna-screen-reveal" class="sgp__screen sgp__screen--reveal somna-hidden">
      {%- if s.pill != blank -%}<p class="sgp__pill">{{ s.pill }}</p>{%- endif -%}
      <h2 class="sgp__title sgp__title--reveal" id="somna-screen-reveal-title"><span>{{ s.reveal_1 }}</span> <em>{{ s.reveal_2 }}</em></h2>
      <div class="sgp__reveal">
        <svg class="sgp__reveal-box" viewBox="0 0 180 80" aria-hidden="true" focusable="false"><rect x="24" y="0" width="132" height="80" rx="10" fill="currentColor"/><rect x="82" y="0" width="16" height="80" fill="#000"/></svg>
        <div class="sgp__burst sgp__burst--reveal">
          <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false"><path d="M150 13 L171 33 L201 16 L213 38 L252 36 L242 59 L275 64 L256 82 L295 95 L261 107 L277 129 L243 133 L253 153 L212 151 L204 172 L171 157 L150 186 L128 158 L94 176 L87 152 L50 155 L58 131 L25 127 L39 107 L16 95 L43 82 L20 63 L55 59 L51 36 L88 41 L97 13 L129 30Z" fill="#fff" stroke="#000" stroke-width="5" stroke-linejoin="round"/></svg>
          <span class="sgp__burst-text"><span class="sgp__burst-big">{{ s.burst_1 }}</span><span class="sgp__burst-big">{{ s.burst_2 }}</span><span class="sgp__burst-small">{{ s.burst_3 }}</span></span>
        </div>
      </div>
      <p class="sgp__text sgp__text--reveal">{{ s.reveal_text }}</p>
      <button type="button" class="sgp__unwrap sgp__unwrap--claim" data-claim>{{ s.reveal_button }}</button>
    </div>

    <!-- SCREEN 2: claim (Figma 4954:3012) -->
    <div id="somna-screen-2" class="sgp__screen sgp__screen--claim somna-hidden">
      <div class="sgp__burst">
        <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false"><path d="M150 13 L171 33 L201 16 L213 38 L252 36 L242 59 L275 64 L256 82 L295 95 L261 107 L277 129 L243 133 L253 153 L212 151 L204 172 L171 157 L150 186 L128 158 L94 176 L87 152 L50 155 L58 131 L25 127 L39 107 L16 95 L43 82 L20 63 L55 59 L51 36 L88 41 L97 13 L129 30Z" fill="#fff" stroke="#000" stroke-width="5" stroke-linejoin="round"/></svg>
        <span class="sgp__burst-text"><span class="sgp__burst-big">{{ s.burst_1 }}</span><span class="sgp__burst-big">{{ s.burst_2 }}</span><span class="sgp__burst-small">{{ s.burst_3 }}</span></span>
      </div>
      <h2 class="sgp__title sgp__title--claim" id="somna-screen-2-title"><em>{{ s.claim_1 }}</em> <span>{{ s.claim_2 }}</span></h2>
      <p class="sgp__text">{{ s.claim_text }}</p>

      <p id="somna-already-subscribed" class="sgp__notice somna-hidden" role="status">{{ s.already_text }}</p>

      <form id="somna-signup-form" class="sgp__form" novalidate>
        <label for="somna-email-input" class="sgp__label">{{ s.email_label }}</label>
        <input type="email" id="somna-email-input" class="sgp__input" name="email" placeholder="{{ s.email_placeholder | escape }}" required autocomplete="email" aria-describedby="somna-error-container">
        <div class="sgp__error" id="somna-error-container" role="alert" aria-live="assertive"></div>
        <button type="submit" class="sgp__btn sgp__btn--accent" id="somna-submit-btn">{{ s.submit_label }}</button>
      </form>

      <p class="sgp__consent">{{ s.consent }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" target="_blank" rel="noopener">Privacy Policy</a></p>
      <button type="button" class="sgp__decline somna-close-trigger">{{ s.decline }}</button>
    </div>

    <!-- SCREEN 3: code (Figma 4954:2959) -->
    <div id="somna-screen-3" class="sgp__screen sgp__screen--code somna-hidden">
      <div class="sgp__gift-small">{{ sgp_gift }}</div>
      <h2 class="sgp__title sgp__title--code" id="somna-screen-3-title">{{ s.code_title }}</h2>
      <div class="sgp__code"><span id="somna-discount-code-text">{{ popup_code | escape }}</span></div>
      <button type="button" id="somna-copy-btn" class="sgp__copy">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false"><rect x="1" y="7" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 4V3a2 2 0 012-2h10a2 2 0 012 2v10a2 2 0 01-2 2h-1" stroke="currentColor" stroke-width="2"/></svg>
        <span class="sgp__copy-label">{{ s.copy_label }}</span>
      </button>
      <a href="{{ popup_shop_url }}" class="sgp__btn sgp__btn--shop" id="somna-shop-btn">{{ s.shop_label }} <span aria-hidden="true">→</span></a>
      <p class="sgp__fine sgp__fine--code">{{ s.small_print }}</p>
    </div>

    <div class="sgp__wave-wrap" aria-hidden="true">{{ sgp_wave }}</div>
  </div>
</div>

<!-- Minimised side tab -->
<button type="button" id="somna-teaser-tab" class="sgp-tab sgp-tab--{{ s.teaser_style | default: 'side' }} somna-hidden" aria-label="{{ s.teaser_label | escape }}">
  <span class="sgp-tab__icon" aria-hidden="true">
    <svg viewBox="0 0 180 170" width="18" height="17" focusable="false"><path d="M90 50C79 27 58 14 44 20c-12 5-11 20 1 27 10 6 28 5 45 3zM90 50c11-23 32-36 46-30 12 5 11 20-1 27-10 6-28 5-45 3z" fill="currentColor"/><rect x="10" y="56" width="160" height="38" rx="10" fill="currentColor"/><rect x="24" y="100" width="132" height="68" rx="10" fill="currentColor"/></svg>
  </span>
  <span class="sgp-tab__label">{{ s.teaser_label }}</span>
  <span class="sgp-tab__badge" aria-hidden="true">{{ s.teaser_badge }}</span>
</button>

<style>
  .somna-hidden { display: none !important; }

  html.somna-popup-open { overflow: hidden; }
  html.somna-popup-open body { padding-right: var(--somna-scrollbar-width, 0px); }

  .sgp {
    --sgp-mint: #f3feee;
    --sgp-lav: #afbdf8;
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: grid;
    place-items: center;
    padding: 12px;
    background: rgb(5 7 20 / 0.62);
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  .sgp.somna-visible { opacity: 1; }

  /* the card: Figma 340 × 709. Everything inside is sized against the card width (cqw), so phones
     from 320px up and the desktop card keep the same proportions; heights also shrink on short screens */
  .sgp__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(380px, 100%);
    max-height: calc(100dvh - 24px);
    overflow: hidden auto;
    overscroll-behavior: contain;
    border: 1.7px solid var(--sgp-lav);
    border-radius: 25px;
    background: #000;
    color: var(--sgp-mint);
    font-family: var(--font-body--family, Inter, sans-serif);
    text-align: center;
    container-type: inline-size;
    --sgp-u: 1cqw;
    scrollbar-width: none;
    transform: translateY(24px) scale(0.96);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sgp__card::-webkit-scrollbar { display: none; }
  .sgp.somna-visible .sgp__card { transform: none; }
  .sgp__card:focus { outline: none; }

  .sgp__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(6.5 * var(--sgp-u)) calc(5.4 * var(--sgp-u)) 0 calc(4.7 * var(--sgp-u));
  }

  .sgp__logo {
    font-size: clamp(1.25rem, calc(7.3 * var(--sgp-u)), 1.625rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .sgp__close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -8px -8px -8px 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--sgp-mint);
    cursor: pointer;
    transition: transform 0.3s ease, background-color 0.2s ease;
  }

  .sgp__close:hover { background: rgb(243 254 238 / 0.12); transform: rotate(90deg); }

  .sgp__screen {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding: 0 calc(4.7 * var(--sgp-u)) calc(calc(20 * var(--sgp-u)) + 8px);
  }

  .sgp__screen-enter { animation: sgpIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .sgp__screen-leave { animation: sgpOut 0.3s ease both; }

  @keyframes sgpIn { from { opacity: 0; transform: translateY(14px); } }
  @keyframes sgpOut { to { opacity: 0; transform: translateY(-10px); } }

  .sgp__pill {
    margin: calc(4.4 * var(--sgp-u)) 0 0;
    padding: 0.55em 1.6em;
    border: 2px solid var(--sgp-mint);
    border-radius: 7.5px;
    background: var(--sgp-lav);
    color: #000;
    font-size: clamp(0.625rem, calc(3.25 * var(--sgp-u)), 0.75rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sgp__title {
    margin: calc(2.4 * var(--sgp-u)) 0 0;
    color: var(--sgp-mint);
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, calc(10.6 * var(--sgp-u)), 2.5rem);
    font-weight: var(--font-accent--weight);
    line-height: 1.32;
    text-transform: uppercase;
  }

  .sgp__title > * { display: block; }
  .sgp__title em { color: var(--sgp-lav); font-style: normal; }

  .sgp__text {
    margin: calc(3 * var(--sgp-u)) 0 0;
    font-size: clamp(0.8125rem, calc(3.9 * var(--sgp-u)), 0.9375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
    text-wrap: balance;
  }

  /* gift */
  .sgp__box {
    position: relative;
    display: grid;
    place-items: center;
    width: min(calc(54 * var(--sgp-u)), 26dvh);
    margin: calc(5 * var(--sgp-u)) 0 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sgp-lav);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .sgp__box:focus-visible { outline: 2px solid var(--sgp-mint); outline-offset: 6px; border-radius: 12px; }

  .sgp-gift { display: block; width: 100%; height: auto; overflow: visible; }
  .sgp-gift__lid { transform-box: fill-box; transform-origin: 50% 100%; }

  /* idle: a small hop every few seconds says "tap me" */
  .sgp__screen--box:not(.is-unwrapping) .sgp-gift { animation: sgpIdle 3s 1s ease-in-out infinite; }
  .sgp__box:hover .sgp-gift { animation-duration: 1.2s; }

  @keyframes sgpIdle {
    0%, 70%, 100% { transform: none; }
    76% { transform: translateY(-6px) rotate(-3deg); }
    84% { transform: translateY(0) rotate(2deg); }
    90% { transform: rotate(-1deg); }
  }

  /* unwrapping (Figma 4954:2935): shake, then the lid pops off and sparks fly */
  .is-unwrapping .sgp-gift { animation: sgpShake 0.9s ease-in-out both; }
  .is-opened .sgp-gift__lid { animation: sgpLid 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) both; }

  @keyframes sgpShake {
    0%, 100% { transform: none; }
    15% { transform: rotate(-7deg) scale(1.02); }
    30% { transform: rotate(6deg) scale(1.03); }
    45% { transform: rotate(-5deg) scale(1.03); }
    60% { transform: rotate(4deg) scale(1.02); }
    75% { transform: rotate(-2deg); }
  }

  @keyframes sgpLid {
    to { transform: translate(18px, -46px) rotate(18deg); opacity: 0; }
  }

  .sgp__sparks { position: absolute; inset: 0; pointer-events: none; }
  .sgp__sparks i {
    position: absolute;
    top: 45%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--sgp-mint);
    opacity: 0;
  }
  .sgp__sparks i:nth-child(even) { background: var(--sgp-lav); width: 6px; height: 12px; }
  .is-opened .sgp__sparks i { animation: sgpSpark 0.9s ease-out both; }
  .sgp__sparks i:nth-child(1) { --x: -90px; --y: -80px; }
  .sgp__sparks i:nth-child(2) { --x: 90px; --y: -86px; }
  .sgp__sparks i:nth-child(3) { --x: -120px; --y: -10px; }
  .sgp__sparks i:nth-child(4) { --x: 118px; --y: -16px; }
  .sgp__sparks i:nth-child(5) { --x: -40px; --y: -120px; }
  .sgp__sparks i:nth-child(6) { --x: 48px; --y: -116px; }
  .sgp__sparks i:nth-child(7) { --x: -100px; --y: 40px; }
  .sgp__sparks i:nth-child(8) { --x: 104px; --y: 36px; }

  @keyframes sgpSpark {
    0% { opacity: 1; transform: translate(-50%, -50%) scale(0.4); }
    100% { opacity: 0; transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) rotate(220deg) scale(1); }
  }

  .sgp__box-foot {
    display: grid;
    place-items: center;
    min-height: 48px;
    margin-top: calc(6 * var(--sgp-u));
  }

  /* Figma 4954:2927: 208 × 39 mint button, lavender border + glow, Boldonse 16 */
  .sgp__unwrap {
    min-width: calc(61 * var(--sgp-u));
    min-height: 44px;
    padding: 0.5em 1.4em;
    border: 2px solid var(--sgp-lav);
    border-radius: 9px;
    background: var(--sgp-mint);
    box-shadow: 0 1.5px 5px 1px var(--sgp-lav);
    color: #000;
    font-family: var(--font-accent--family);
    font-size: clamp(0.875rem, calc(4.7 * var(--sgp-u)), 1.0625rem);
    font-weight: var(--font-accent--weight);
    letter-spacing: 0.02em;
    line-height: 1.4;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sgp__unwrap:hover { transform: translateY(-2px); box-shadow: 0 4px 14px 2px var(--sgp-lav); }
  .sgp__unwrap:active { transform: translateY(1px); }
  .sgp__unwrap:focus-visible { outline: 2px solid var(--sgp-mint); outline-offset: 3px; }

  .sgp__unwrapping {
    display: none;
    margin: 0;
    font-size: clamp(0.875rem, calc(4.4 * var(--sgp-u)), 1rem);
    font-weight: 500;
  }

  .is-unwrapping .sgp__unwrap { display: none; }
  .is-unwrapping .sgp__unwrapping { display: block; }
  .is-unwrapping .sgp__fine { visibility: hidden; }

  .sgp__fine {
    margin: calc(3.5 * var(--sgp-u)) 0 0;
    color: var(--sgp-mint);
    font-size: clamp(0.625rem, calc(2.95 * var(--sgp-u)), 0.6875rem);
    font-weight: 300;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* reveal (Figma 4954:2986) */
  .sgp__title--reveal { margin-top: calc(3 * var(--sgp-u)); }

  .sgp__reveal {
    position: relative;
    display: grid;
    justify-items: center;
    width: 100%;
    margin-top: calc(2 * var(--sgp-u));
  }

  .sgp__reveal-box {
    grid-area: 1 / 1;
    align-self: end;
    width: min(calc(46 * var(--sgp-u)), 22dvh);
    height: auto;
    margin-top: calc(40 * var(--sgp-u));
    color: var(--sgp-lav);
  }

  .sgp__burst--reveal {
    grid-area: 1 / 1;
    align-self: start;
    width: min(calc(92 * var(--sgp-u)), 48dvh);
    margin-top: 0;
  }

  .is-entering .sgp__burst--reveal { animation: sgpPopOut 0.75s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  .is-entering .sgp__reveal-box { animation: sgpIn 0.4s ease both; }

  @keyframes sgpPopOut {
    0% { opacity: 0; transform: translateY(40%) scale(0.2) rotate(-14deg); }
    100% { opacity: 1; transform: none; }
  }

  .sgp__text--reveal { margin-top: calc(4 * var(--sgp-u)); font-size: clamp(0.875rem, calc(4.7 * var(--sgp-u)), 1.0625rem); font-weight: 600; }

  .sgp__unwrap--claim { margin-top: calc(3 * var(--sgp-u)); text-transform: none; }

  /* claim */
  .sgp__burst {
    position: relative;
    width: min(calc(84 * var(--sgp-u)), 30dvh * 1.5);
    margin-top: calc(2 * var(--sgp-u));
  }

  .sgp__burst svg { display: block; width: 100%; height: auto; }

  .sgp__burst-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 2%;
    color: #000;
