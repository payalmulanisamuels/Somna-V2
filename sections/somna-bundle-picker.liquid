{%- comment -%}
  Somna V2 — "Never run out again." bundle picker.
  - Purchase toggle: one-time (no selling plan) or subscribe (the variant's first selling plan).
    Prices are the live variant prices / selling-plan allocation prices; nothing is hardcoded.
    Products without a selling plan show the one-time price in both modes.
  - The first product block is featured. Choosing another product card swaps the featured card
    (image, title, description, price, variant) without a page reload.
  - Add to cart uses Shopify's cart API and the theme's CartLinesUpdateEvent, so the existing
    cart drawer opens and updates. Double clicks are ignored while a request is running.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign perk_blocks = section.blocks | where: 'type', 'perk'
-%}

{%- capture data -%}
  [
  {%- for block in product_blocks -%}
    {%- assign p = block.settings.product -%}
    {%- if p == blank -%}{%- continue -%}{%- endif -%}
    {%- assign img = block.settings.image | default: p.featured_image -%}
    {
      "block": {{ block.id | json }},
      "title": {{ p.title | json }},
      "subtitle": {{ block.settings.subtitle | json }},
      "badge": {{ block.settings.badge | json }},
      "url": {{ p.url | json }},
      "nights": {{ block.settings.nights | default: 0 }},
      "image": {{ img | image_url: width: 1100 | json }},
      "thumb": {{ img | image_url: width: 300 | json }},
      "alt": {{ img.alt | default: p.title | json }},
      "variants": [
        {%- for v in p.variants -%}
          {%- assign alloc = v.selling_plan_allocations | first -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "available": {{ v.available | json }},
            "once": {{ v.price }},
            "onceCompare": {{ v.compare_at_price | default: 0 }},
            "sub": {% if alloc %}{{ alloc.price }}{% else %}null{% endif %},
            "plan": {% if alloc %}{{ alloc.selling_plan.id }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]
{%- endcapture -%}

<somna-bundle-picker
  class="somna-bundle"
  data-mode="{{ s.default_mode }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  style="background: {{ s.background_color }}; color: {{ s.text_color }}; --somna-accent: {{ s.accent_color }}; --somna-card: {{ s.card_color }}; --somna-chip: {{ s.chip_color }}; --somna-btn: {{ s.button_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;"
>
  <script type="application/json" data-products>{{ data | strip_newlines }}</script>
  <div class="somna-bundle__inner somna-container">
    {%- if s.heading != blank -%}<h2 class="somna-bundle__heading">{{ s.heading }}</h2>{%- endif -%}

    <div class="somna-bundle__toggle" role="radiogroup" aria-label="{{ s.mode_label | escape }}">
      <button type="button" role="radio" data-set-mode="once" aria-checked="{% if s.default_mode == 'once' %}true{% else %}false{% endif %}">{{ s.once_label }}</button>
      <button type="button" role="radio" data-set-mode="sub" aria-checked="{% if s.default_mode == 'sub' %}true{% else %}false{% endif %}">{{ s.sub_label }}</button>
    </div>

    {%- if perk_blocks.size > 0 -%}
      <ul class="somna-bundle__perks" role="list">
        {%- for block in perk_blocks -%}
          <li class="somna-bundle__perk" {{ block.shopify_attributes }}>
            <span class="somna-bundle__perk-icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                <span class="somna-bundle__perk-mask" style="--mask: url('{{ block.settings.icon | image_url: width: 120 }}');"></span>
              {%- else -%}
                {{ block.settings.icon_text }}
              {%- endif -%}
            </span>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="somna-bundle__grid">
      <div class="somna-bundle__featured-wrap">
      <article class="somna-bundle__featured{% if s.drip_edges %} somna-edge-drip-bottom{% endif %}" aria-live="polite" data-featured>
        <header class="somna-bundle__featured-head">
          <h3 class="somna-bundle__title" data-f-title></h3>
          <p class="somna-bundle__subtitle" data-f-subtitle></p>
        </header>
        <div class="somna-bundle__media"><img data-f-image alt="" width="1100" height="700" loading="lazy" decoding="async"></div>
        <div class="somna-bundle__buy">
          <label class="somna-bundle__variant" data-f-variant-wrap hidden>
            <span class="visually-hidden">{{ s.variant_label }}</span>
            <select data-f-variant></select>
          </label>
          <div class="somna-bundle__prices">
            <span class="somna-bundle__price" data-f-price></span>
            <s class="somna-bundle__compare" data-f-compare></s>
            <span class="somna-bundle__night" data-f-night></span>
          </div>
          <p class="somna-bundle__note" data-f-note>{{ s.note }}</p>
          <button type="button" class="somna-bundle__add" data-add>
            <span data-add-label>{{ s.add_label }}</span>
          </button>
          <p class="somna-bundle__status" role="status" data-status></p>
        </div>
      </article>
        <span class="somna-bundle__badge" data-f-badge hidden></span>
      </div>

      <ul class="somna-bundle__others" role="list" data-others></ul>
    </div>

    {%- if s.bar_title != blank -%}
      <a class="somna-bundle__bar{% if s.drip_edges %} somna-edge-drip-bottom{% endif %}" href="{{ s.bar_link | default: '#' }}">
        <span class="somna-bundle__bar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6"/><path d="M18 3v4h-4M6 21v-4h4"/></svg></span>
        <span class="somna-bundle__bar-text"><strong>{{ s.bar_title }}</strong>{% if s.bar_text != blank %}<span>{{ s.bar_text }}</span>{% endif %}</span>
        <span class="somna-bundle__bar-arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</somna-bundle-picker>
{%- if section.settings.wave_color != blank -%}
  {%- render 'somna-wave', top: section.settings.background_color, bottom: section.settings.wave_color, shape: section.settings.wave_shape -%}
{%- endif -%}

<script type="module">
  import { somnaAddToCart, somnaMoney } from '{{ 'somna-cart.js' | asset_url }}';

  if (!customElements.get('somna-bundle-picker')) {
    customElements.define('somna-bundle-picker', class extends HTMLElement {
      connectedCallback() {
        try { this.products = JSON.parse(this.querySelector('[data-products]').textContent); } catch (e) { this.products = []; }
        if (!this.products.length) return;
        this.mode = this.dataset.mode === 'once' ? 'once' : 'sub';
        this.active = 0;
        this.variantIndex = this.products.map((p) => Math.max(0, p.variants.findIndex((v) => v.available)));
        this.labels = {
          add: this.querySelector('[data-add-label]').textContent.trim(),
          added: {{ s.added_label | json }},
          error: {{ s.error_label | json }},
          soldOut: {{ s.sold_out_label | json }},
          night: {{ s.night_label | json }},
          noPlan: {{ s.no_plan_label | json }}
        };
        this.addEventListener('click', this.onClick);
        this.querySelector('[data-f-variant]').addEventListener('change', this.onVariant);
        this.render();
      }
      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
      }
      money(cents) { return somnaMoney(cents, this.dataset.currency || 'USD', this.dataset.locale || 'en'); }
      variant(i = this.active) { return this.products[i].variants[this.variantIndex[i]]; }
      priceFor(v) {
        const sub = this.mode === 'sub' && v.plan != null;
        return { price: sub ? v.sub : v.once, compare: sub ? (v.sub < v.once ? v.once : 0) : (v.onceCompare > v.once ? v.onceCompare : 0), plan: sub ? v.plan : null };
      }
      render() {
        const p = this.products[this.active];
        const v = this.variant();
        const pr = this.priceFor(v);
        const q = (sel) => this.querySelector(sel);
        q('[data-f-title]').textContent = p.title;
        q('[data-f-subtitle]').textContent = p.subtitle || '';
        const badge = q('[data-f-badge]');
        badge.textContent = p.badge || '';
        badge.hidden = !p.badge;
        const img = q('[data-f-image]');
        if (p.image) { img.src = p.image; img.alt = p.alt || ''; }
        const sel = q('[data-f-variant]');
        q('[data-f-variant-wrap]').hidden = p.variants.length < 2;
        sel.innerHTML = p.variants.map((x, i) => `<option value="${i}"${i === this.variantIndex[this.active] ? ' selected' : ''}${x.available ? '' : ' disabled'}>${x.title.replace(/</g, '&lt;')}</option>`).join('');
        q('[data-f-price]').textContent = this.money(pr.price);
        q('[data-f-compare]').textContent = pr.compare ? this.money(pr.compare) : '';
        q('[data-f-night]').textContent = p.nights > 0 ? `${this.money(Math.round(pr.price / p.nights))} ${this.labels.night}` : '';
        const note = q('[data-f-note]');
        note.dataset.noPlan = String(this.mode === 'sub' && v.plan == null);
        if (this.mode === 'sub' && v.plan == null) note.textContent = this.labels.noPlan;
        else note.textContent = {{ s.note | json }};
        const add = q('[data-add]');
        add.disabled = !v.available;
        q('[data-add-label]').textContent = v.available ? `${this.labels.add} · ${this.money(pr.price)}` : this.labels.soldOut;
        this.querySelectorAll('[data-set-mode]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.setMode === this.mode)));
        q('[data-others]').innerHTML = this.products.map((o, i) => {
          if (i === this.active) return '';
          const ov = this.variant(i);
          const op = this.priceFor(ov);
          const night = o.nights > 0 ? ` · ${this.money(Math.round(op.price / o.nights))} ${this.labels.night}` : '';
          return `<li><button type="button" class="somna-bundle__other" data-pick="${i}">
            ${o.thumb ? `<img src="${o.thumb}" alt="" width="146" height="110" loading="lazy">` : ''}
            <span class="somna-bundle__other-text"><span class="somna-bundle__other-title">${o.title.replace(/</g, '&lt;')}</span>
            <span class="somna-bundle__other-price">${this.money(op.price)}${op.compare ? ` · <s>${this.money(op.compare)}</s>` : ''}${night}</span></span>
          </button></li>`;
        }).join('');
      }
      onVariant = (e) => {
        this.variantIndex[this.active] = Number(e.target.value) || 0;
        this.render();
      };
      onClick = (e) => {
        const mode = e.target.closest('[data-set-mode]');
        if (mode) { this.mode = mode.dataset.setMode; this.render(); return; }
        const pick = e.target.closest('[data-pick]');
        if (pick) {
          this.active = Number(pick.dataset.pick);
          this.render();
          this.querySelector('[data-f-title]').scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          return;
        }
        if (e.target.closest('[data-add]')) this.add();
      };
      async add() {
        if (this.busy) return;
        const btn = this.querySelector('[data-add]');
        const status = this.querySelector('[data-status]');
        const v = this.variant();
        const pr = this.priceFor(v);
        if (!v.available) return;
        this.busy = true;
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        status.textContent = '';
        try {
          await somnaAddToCart(this, { id: v.id, quantity: 1, selling_plan: pr.plan });
          status.textContent = this.labels.added;
        } catch (err) {
          status.textContent = err && err.message ? err.message : this.labels.error;
        } finally {
          this.busy = false;
          btn.removeAttribute('aria-busy');
          btn.disabled = !v.available;
        }
      }
    });
  }
</script>

{% stylesheet %}
  .somna-bundle__inner {
    display: grid;
    justify-items: center;
    gap: 20px;
  }

  .somna-bundle__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(2.25rem, 4.44vw, 4rem);
    line-height: 1.39;
    text-align: center;
    color: inherit;
  }

  .somna-bundle__heading em {
    font-style: normal;
    color: var(--somna-accent);
  }

  .somna-bundle__heading p {
    margin: 0;
  }

  .somna-bundle__toggle {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    background: var(--somna-card);
  }

  .somna-bundle__toggle button {
    min-height: 36px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #383434;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .somna-bundle__toggle [aria-checked='true'] {
    background: var(--somna-chip);
    color: #0a1a4a;
  }

  .somna-bundle__toggle button:focus-visible,
  .somna-bundle__other:focus-visible,
  .somna-bundle__add:focus-visible,
  .somna-bundle__bar:focus-visible {
    outline: 2px solid var(--somna-chip);
    outline-offset: 3px;
  }

  .somna-bundle__perks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-bundle__perk {
    display: flex;
    align-items: center;
    gap: 16px;
    font-weight: 500;
    min-height: 76px;
    padding: 10px 16px;
    border-radius: 4px;
    background: var(--somna-chip);
    color: #000;
    font-size: 1rem;
    line-height: 1.2;
  }

  .somna-bundle__perk-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--somna-card);
    font-size: 1.6rem;
    font-weight: 500;
  }

  .somna-bundle__perk-mask {
    width: 30px;
    height: 30px;
    background: #000;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
  }

  .somna-bundle__grid {
    display: grid;
    gap: 24px;
    width: 100%;
    align-items: start;
  }

  /* the badge sits outside the card so the card's edge mask doesn't clip its overhang (Figma) */
  .somna-bundle__featured-wrap {
    position: relative;
    min-width: 0;
  }

  .somna-bundle__featured {
    position: relative;
    border-radius: 4px 4px 28px 28px;
    background: var(--somna-card);
    color: #000;
    overflow: hidden;
  }

  .somna-bundle__featured-head {
    padding: 14px 16px 10px;
  }

  .somna-bundle__title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.5rem, 2.22vw, 2rem);
    line-height: 1.3;
  }

  .somna-bundle__subtitle {
    margin: 4px 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .somna-bundle__badge {
    position: absolute;
    top: -31px;
    right: -22px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 118px;
    height: 118px;
    padding: 0 17px;
    border-radius: 50%;
    background: var(--somna-chip);
    color: #000;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.3rem;
    line-height: 1.5;
    text-transform: uppercase;
    text-align: center;
    rotate: 7.6deg;
  }

  .somna-bundle__badge[hidden] {
    display: none;
  }

  .somna-bundle__media {
    aspect-ratio: 536 / 311;
    background: #0b0f1d;
  }

  .somna-bundle__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-bundle__buy {
    display: grid;
    gap: 6px;
    padding: 14px 16px 24px;
  }

  .somna-bundle__variant select {
    width: 100%;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: 8px;
    background: #fff;
    font: inherit;
  }

  .somna-bundle__prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .somna-bundle__price {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .somna-bundle__compare {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .somna-bundle__compare:empty {
    display: none;
  }

  .somna-bundle__night {
    margin-left: auto;
    color: #5e9a3f;
    font-weight: 500;
  }

  .somna-bundle__note {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.7;
  }

  .somna-bundle__add {
    min-height: 46px;
    margin-top: 8px;
    border: 0;
    border-radius: 8px;
    background: var(--somna-chip);
    color: #000;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
  }

  .somna-bundle__add[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .somna-bundle__add:disabled:not([aria-busy]) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .somna-bundle__status {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.8125rem;
  }

  .somna-bundle__others {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .somna-bundle__other {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 6px 10px;
    border: 0;
    border-radius: 6px;
    background: var(--somna-card);
    color: #0a1a4a;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .somna-bundle__other:hover {
    transform: translateY(-2px);
  }

  .somna-bundle__other img {
    flex: none;
    width: 146px;
    height: 110px;
    object-fit: cover;
  }

  .somna-bundle__other-text {
    display: grid;
    gap: 6px;
  }

  .somna-bundle__other-title {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.125rem, 1.76vw, 1.58rem);
    line-height: 1.3;
    color: #000;
  }

  .somna-bundle__other-price {
    font-size: 1rem;
  }

  .somna-bundle__other-price s {
    opacity: 0.6;
  }

  .somna-bundle__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    width: min(100%, 468px);
    padding: 14px 20px;
    border-radius: 6px;
    background: var(--somna-card);
    color: #000;
    text-decoration: none;
  }

  .somna-bundle__bar-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 80px;
    height: 80px;
    margin-block: -20px;
    border-radius: 50%;
    background: var(--somna-chip);
  }

  .somna-bundle__bar-icon svg {
    width: 44px;
    height: 44px;
  }

  .somna-bundle__bar-text {
    display: grid;
    flex: 1;
  }

  .somna-bundle__bar-text strong {
    font-size: 1.375rem;
    font-weight: 600;
  }

  .somna-bundle__bar-text span {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .somna-bundle__bar-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #000;
    color: #fff;
  }

  @media screen and (min-width: 990px) {
    .somna-bundle__grid {
      grid-template-columns: minmax(0, 536px) minmax(0, 472px);
      justify-content: center;
      gap: 80px;
      margin-top: 20px; /* Figma: room for the badge under the perks */
    }
  }

  /* tablet: bundle card and the other sets side by side, as on desktop */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .somna-bundle__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 24px;
    }
  }

  /* final mobile design: smaller heading, perks in a 2 × 2 grid */
  @media screen and (max-width: 749px) {
    /* mobile Figma: the bundle card and the Subscribe bar keep straight edges */
    .somna-bundle__featured.somna-edge-drip-bottom,
    .somna-bundle__bar.somna-edge-drip-bottom {
      border-bottom-width: 0 !important;
      -webkit-mask: none;
      mask: none;
    }

    .somna-bundle__featured.somna-edge-drip-bottom {
      border-end-start-radius: 28px !important;
      border-end-end-radius: 28px !important;
    }

    .somna-bundle__bar.somna-edge-drip-bottom {
      border-end-start-radius: 6px !important;
      border-end-end-radius: 6px !important;
    }

    .somna-bundle__heading {
      font-size: 2.125rem;
      line-height: 1.15;
    }

    .somna-bundle__toggle button {
      padding: 0 14px;
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .somna-bundle__perks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .somna-bundle__perk {
      gap: 8px;
      min-height: 48px;
      padding: 6px 8px;
      font-size: 0.6875rem;
    }

    .somna-bundle__perk-icon {
      width: 32px;
      height: 32px;
      font-size: 1rem;
    }

    .somna-bundle__perk-mask {
      width: 20px;
      height: 20px;
    }

    .somna-bundle__badge {
      width: 82px;
      height: 82px;
      top: 6px;
      right: 6px;
      padding: 0 12px;
      font-size: 0.9rem;
    }
  }

  /* very small phones (320–359px): keep the toggle and perks inside the screen */
  @media screen and (max-width: 359px) {
    .somna-bundle__heading {
      font-size: 1.75rem;
    }

    .somna-bundle__toggle button {
      padding: 0 10px;
      font-size: 0.6875rem;
    }

    .somna-bundle__perk {
      font-size: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .somna-bundle__other {
      transition: none;
    }
  }
{% endstylesheet %}

