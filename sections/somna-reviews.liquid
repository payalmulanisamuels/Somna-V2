        { "type": "text", "id": "alt", "label": "Description (alt text)", "info": "Leave empty to use the image's own alt text." }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "richtext", "id": "heading", "label": "Heading", "info": "Italic words use the accent colour.", "default": "<p>What <em>sleepers</em> are saying</p>" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#afbdf8" },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3feee" },
    { "type": "color", "id": "card_color", "label": "Cards", "default": "#f3feee" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#0b1a45" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#f5c242" },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1000 },
    { "type": "checkbox", "id": "show_edges", "label": "Wavy edge between the featured review and the summary", "default": true },
