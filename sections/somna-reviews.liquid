  .somna-rv-lb__fig img {
    display: block; max-width: 100%; max-height: calc(100dvh - 150px); width: auto; height: auto;
    border-radius: 14px; background: rgb(255 255 255 / 0.06); opacity: 0; transform: scale(0.98);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .somna-rv-lb__fig img.is-in { opacity: 1; transform: none; }
  .somna-rv-lb__count { font-size: 0.8125rem; letter-spacing: 0.08em; opacity: 0.8; }
  .somna-rv-lb__close, .somna-rv-lb__nav {
    position: absolute; display: grid; place-items: center; width: 46px; height: 46px; padding: 0;
    border: 0; border-radius: 50%; background: #f3feee; color: #0b0f1d; cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .somna-rv-lb__close:hover, .somna-rv-lb__nav:hover { background: #afbdf8; transform: scale(1.06); }
  .somna-rv-lb__close:focus-visible, .somna-rv-lb__nav:focus-visible { outline: 2px solid #afbdf8; outline-offset: 3px; }
  .somna-rv-lb svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .somna-rv-lb__close { top: 16px; right: 16px; width: 42px; height: 42px; }
  .somna-rv-lb__nav { top: 50%; translate: 0 -50%; }
  .somna-rv-lb__nav--prev { left: 16px; }
  .somna-rv-lb__nav--next { right: 16px; }
  .somna-rv-lb.is-single .somna-rv-lb__nav, .somna-rv-lb.is-single .somna-rv-lb__count { display: none; }
  @keyframes somnaRvLbIn { from { opacity: 0; } }
  @media screen and (max-width: 749px) {
    .somna-rv-lb { padding: 64px 12px 84px; }
    .somna-rv-lb__fig img { max-height: calc(100dvh - 190px); border-radius: 10px; }
    .somna-rv-lb__nav { top: auto; bottom: 18px; translate: none; width: 44px; height: 44px; }
    .somna-rv-lb__nav--prev { left: calc(50% - 82px); }
    .somna-rv-lb__nav--next { right: calc(50% - 82px); }
    .somna-rv-lb__count { position: absolute; bottom: 32px; left: 0; right: 0; text-align: center; pointer-events: none; }
