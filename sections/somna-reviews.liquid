{%- comment -%}
  Somna V2 — reviews: heading, a featured review and a rating summary (both set in the theme
  editor), then customer reviews loaded from a Google Sheet (assets/somna-reviews.js) with
  filters and "Show more". The sheet only feeds the review list; the featured review, the
  summary numbers and the photo gallery never change from it.
{%- endcomment -%}
{%- render 'somna-shared-styles' -%}
{%- liquid
  assign s = section.settings
  assign photo_blocks = section.blocks | where: 'type', 'photo'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign use_app = false
  if app_blocks.size > 0
    assign use_app = true
  endif

  # Real Judge.me numbers / featured review for this product (metafield kept up to date by Judge.me)
  assign rv_product = product | default: closest.product
  assign jm = nil
  if rv_product
    assign jm = rv_product.metafields.judgeme.review_widget_data.value
  endif
  assign jm_ok = false
  if jm and jm.number_of_reviews > 0
    assign jm_ok = true
  endif

  assign sum_avg = s.average
  assign sum_count = s.count
  assign sum_p5 = s.pct_5
  assign sum_p4 = s.pct_4
  assign sum_p3 = s.pct_3
  assign sum_p2 = s.pct_2
  assign sum_p1 = s.pct_1
  if s.summary_source == 'judgeme' and jm_ok
    assign sum_avg = jm.average_rating | times: 1.0 | round: 1
    assign sum_count = s.count_label | default: '[count] reviews' | replace: '[count]', jm.number_of_reviews
    for h in jm.histogram
      case h.rating
        when 5
          assign sum_p5 = h.percentage
        when 4
          assign sum_p4 = h.percentage
        when 3
          assign sum_p3 = h.percentage
        when 2
          assign sum_p2 = h.percentage
        when 1
          assign sum_p1 = h.percentage
      endcase
    endfor
  endif

  # several products (homepage): total count, average and bars weighted by each product's review count
  if s.summary_source == 'judgeme_products' and s.summary_products != blank
    assign t_count = 0
    assign t_rating = 0.0
    assign t5 = 0.0
    assign t4 = 0.0
    assign t3 = 0.0
    assign t2 = 0.0
    assign t1 = 0.0
    for sp in s.summary_products
      assign pj = sp.metafields.judgeme.review_widget_data.value
      if pj and pj.number_of_reviews > 0
        assign pc = pj.number_of_reviews | plus: 0
        assign t_count = t_count | plus: pc
        assign t_rating = pj.average_rating | times: pc | plus: t_rating
        for h in pj.histogram
          assign hw = h.percentage | times: pc
          case h.rating
            when 5
              assign t5 = t5 | plus: hw
            when 4
              assign t4 = t4 | plus: hw
            when 3
              assign t3 = t3 | plus: hw
            when 2
              assign t2 = t2 | plus: hw
            when 1
              assign t1 = t1 | plus: hw
          endcase
        endfor
      endif
    endfor
    if t_count > 0
      assign sum_avg = t_rating | divided_by: t_count | round: 1
      assign sum_count = s.count_label | default: '[count] reviews' | replace: '[count]', t_count
      assign sum_p5 = t5 | divided_by: t_count | round
      assign sum_p4 = t4 | divided_by: t_count | round
      assign sum_p3 = t3 | divided_by: t_count | round
      assign sum_p2 = t2 | divided_by: t_count | round
      assign sum_p1 = t1 | divided_by: t_count | round
    endif
  endif

  assign f_title = s.featured_title
  assign f_text = s.featured_text
  assign f_name = s.featured_name
  assign f_avatar = s.featured_avatar
  assign f_verified = s.featured_verified
  assign f_product = s.featured_product
  assign f_rating = s.featured_rating
  if s.featured_source == 'judgeme' and jm_ok
    assign f_pick = nil
    assign f_tagged = nil
    for rv in jm.reviews
      assign rv_body = rv.body | strip_html
      if rv.rating >= 5 and rv.is_anonymous_reviewer != true
        if rv_body contains '(Review #'
          if f_tagged == nil
            assign f_tagged = rv
          endif
        else
          assign f_pick = rv
          break
        endif
      endif
    endfor
    if f_pick == nil
      assign f_pick = f_tagged | default: jm.reviews.first
    endif
    if f_pick
      assign f_title = f_pick.title
      assign f_text = f_pick.body | strip_html | split: '(Review #' | first | strip
      assign f_parts = f_pick.reviewer_name | strip | split: ' '
      assign f_name = f_parts | first
      if f_parts.size > 1
        assign f_last = f_parts | last | slice: 0 | upcase
        assign f_name = f_name | append: ' ' | append: f_last | append: '.'
      endif
      assign f_avatar = nil
      assign f_verified = ''
      if f_pick.verified_buyer
        assign f_verified = s.featured_verified | default: 'Verified buyer.'
      endif
      assign f_product = rv_product.title
      assign f_rating = f_pick.rating
    endif
  endif
  assign joined = false
  if s.show_edges and s.show_featured and s.show_summary
    assign joined = true
  endif
-%}
{%- capture star_svg -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}

{%- if s.top_wave and s.top_wave_color != blank -%}
  {%- render 'somna-wave', top: s.top_wave_color, bottom: s.background_color, shape: s.top_wave_shape -%}
{%- endif -%}

<somna-reviews
  {% if template.name == 'product' %}id="reviews"{% endif %}
  class="somna-reviews"
  style="
    --somna-rv-bg: {{ s.background_color }};
    --somna-rv-fg: {{ s.text_color }};
    --somna-accent: {{ s.accent_color }};
    --somna-rv-card: {{ s.card_color }};
    --somna-rv-card-fg: {{ s.card_text_color }};
    --somna-rv-star: {{ s.star_color }};
    --somna-rv-bar: {{ s.bar_color }};
    --somna-rv-track: {{ s.track_color }};
    --somna-rv-chip: {{ s.chip_active_color }};
    --somna-content-width: {{ s.max_width }}px;
    --somna-rv-pt: {{ s.padding_top }}px;
    --somna-rv-pb: {{ s.padding_bottom }}px;
    --somna-rv-pt-m: {{ s.padding_top_mobile }}px;
    --somna-rv-pb-m: {{ s.padding_bottom_mobile }}px;
  "
  data-src="{{ s.sheet_url | escape }}"
  data-initial="{{ s.initial_count }}"
  data-batch="{{ s.batch_size }}"
  data-photos="{{ s.show_review_photos }}"
  data-verified="{{ s.show_verified }}"
  data-product="{{ s.show_product }}"
  data-dates="{{ s.show_dates }}"
  data-names="{{ s.name_format }}"
  data-samples="{{ s.samples_in_preview }}"
  data-verified-label="{{ s.verified_label | escape }}"
  data-empty="{{ s.empty_text | escape }}"
  data-error="{{ s.error_text | escape }}"
  data-retry="{{ s.retry_label | escape }}"
  data-sample-note="{{ s.sample_note | escape }}"
  data-more="{{ s.more_label | escape }}"
>
  <div class="somna-container somna-reviews__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <header class="somna-reviews__head">
        {%- if s.eyebrow != blank -%}<p class="somna-reviews__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="somna-reviews__heading somna-display">{{ s.heading | remove: '<p>' | replace: '</p>', '<br>' | remove: '<h2>' | remove: '</h2>' | strip | split: '<br>' | join: ' ' }}</h2>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if s.show_featured -%}
      {%- assign fr = f_rating | times: 1.0 -%}
      <article
        class="somna-reviews__featured{% if joined %} is-joined{% endif %}"
        style="{% if s.featured_bg != blank %}--somna-rv-card: {{ s.featured_bg }};{% endif %}{% if s.featured_fg != blank %} --somna-rv-card-fg: {{ s.featured_fg }};{% endif %}"
      >
        {%- if f_title != blank -%}<h3 class="somna-reviews__title somna-reviews__title--lg">“{{ f_title | strip_html }}”</h3>{%- endif -%}
        {%- if f_text != blank -%}<p class="somna-reviews__text">“{{ f_text | strip_html }}”</p>{%- endif -%}
        <div class="somna-reviews__byline">
          {%- if f_avatar != blank -%}
            {{ f_avatar | image_url: width: 120, height: 120, crop: 'center' | image_tag: class: 'somna-reviews__avatar somna-reviews__avatar--lg', alt: f_name, loading: 'lazy', width: 56, height: 56, widths: '60, 120', sizes: '56px' }}
          {%- elsif f_name != blank -%}
            <span class="somna-reviews__avatar somna-reviews__avatar--lg somna-reviews__avatar--initials" aria-hidden="true">{{ f_name | slice: 0 }}</span>
          {%- endif -%}
          <p class="somna-reviews__who">
            {%- if f_name != blank -%}<strong>{{ f_name | escape }}</strong>{%- endif -%}
            {%- if f_verified != blank or f_product != blank -%}
              <span class="somna-reviews__meta">
                {%- if f_verified != blank -%}<em>{{ f_verified | escape }}</em>{%- endif -%}
                {%- if f_product != blank -%}{% if f_verified != blank %}&nbsp;{% endif %}{{ f_product | escape }}{%- endif -%}
              </span>
            {%- endif -%}
          </p>
          <span class="somna-reviews__stars" role="img" aria-label="{{ fr }} out of 5 stars">
            {%- for i in (1..5) -%}<span class="somna-reviews__star{% if fr < i %}{% assign below = i | minus: 1 %}{% if fr > below %} is-half{% else %} is-empty{% endif %}{% endif %}">{{ star_svg }}</span>{%- endfor -%}
          </span>
        </div>
      </article>
    {%- endif -%}

    {%- if joined -%}
      {%- comment -%} Figma: the black tear between the featured review and the summary, traced from the design {%- endcomment -%}
      <div class="somna-reviews__tear" aria-hidden="true">
        <svg viewBox="0 0 1000 109.5" preserveAspectRatio="none" focusable="false">
          <path fill="{{ s.featured_bg | default: s.card_color }}" d="M0,0 L0.0,14.9 L6.6,14.9 L13.3,23.2 L19.9,29.9 L26.5,36.5 L33.2,41.5 L39.8,46.4 L46.4,49.8 L53.1,53.1 L59.7,54.7 L66.3,56.4 L73.0,54.7 L79.6,54.7 L86.2,53.1 L92.9,51.4 L99.5,48.1 L106.1,46.4 L112.8,43.1 L119.4,39.8 L126.0,36.5 L132.7,34.8 L139.3,33.2 L145.9,33.2 L152.6,38.1 L159.2,49.8 L165.8,58.0 L172.5,59.7 L179.1,56.4 L185.7,53.1 L192.4,46.4 L199.0,41.5 L205.6,36.5 L212.3,34.8 L218.9,33.2 L225.5,33.2 L232.2,34.8 L238.8,34.8 L245.4,34.8 L252.1,34.8 L258.7,33.2 L265.3,31.5 L272.0,28.2 L278.6,26.5 L285.2,23.2 L291.9,21.6 L298.5,26.5 L305.1,33.2 L311.8,38.1 L318.4,44.8 L325.0,48.1 L331.7,49.8 L338.3,48.1 L344.9,44.8 L351.6,41.5 L358.2,36.5 L364.8,33.2 L371.5,29.9 L378.1,28.2 L384.7,28.2 L391.4,28.2 L398.0,29.9 L404.6,31.5 L411.3,34.8 L417.9,34.8 L424.5,36.5 L431.2,36.5 L437.8,38.1 L444.4,38.1 L451.1,38.1 L457.7,36.5 L464.3,31.5 L471.0,21.6 L477.6,10.0 L484.2,8.3 L490.9,14.9 L497.5,21.6 L504.1,28.2 L510.8,33.2 L517.4,38.1 L524.0,43.1 L530.7,46.4 L537.3,48.1 L543.9,49.8 L550.6,49.8 L557.2,49.8 L563.8,48.1 L570.5,48.1 L577.1,44.8 L583.7,43.1 L590.4,41.5 L597.0,38.1 L603.6,34.8 L610.3,31.5 L616.9,28.2 L623.5,26.5 L630.2,24.9 L636.8,24.9 L643.4,31.5 L650.1,43.1 L656.7,51.4 L663.3,53.1 L670.0,53.1 L676.6,48.1 L683.3,43.1 L689.9,38.1 L696.5,33.2 L703.2,28.2 L709.8,26.5 L716.4,26.5 L723.1,26.5 L729.7,26.5 L736.3,26.5 L743.0,26.5 L749.6,26.5 L756.2,26.5 L762.9,24.9 L769.5,23.2 L776.1,19.9 L782.8,16.6 L789.4,13.3 L796.0,13.3 L802.7,18.2 L809.3,24.9 L815.9,31.5 L822.6,36.5 L829.2,41.5 L835.8,43.1 L842.5,43.1 L849.1,41.5 L855.7,36.5 L862.4,33.2 L869.0,28.2 L875.6,24.9 L882.3,21.6 L888.9,19.9 L895.5,19.9 L902.2,19.9 L908.8,21.6 L915.4,23.2 L922.1,26.5 L928.7,28.2 L935.3,28.2 L942.0,28.2 L948.6,29.9 L955.2,31.5 L961.9,31.5 L968.5,31.5 L975.1,29.9 L981.8,24.9 L988.4,16.6 L995.0,5.0 L1000,1.7 L1000,0 Z"/>
          <path fill="{{ s.card_color }}" d="M0,109.5 L0.0,77.9 L6.6,81.3 L13.3,87.9 L19.9,92.9 L26.5,96.2 L33.2,99.5 L39.8,102.8 L46.4,104.5 L53.1,104.5 L59.7,104.5 L66.3,104.5 L73.0,102.8 L79.6,101.2 L86.2,97.8 L92.9,96.2 L99.5,92.9 L106.1,89.6 L112.8,86.2 L119.4,84.6 L126.0,81.3 L132.7,81.3 L139.3,81.3 L145.9,87.9 L152.6,99.5 L159.2,107.8 L165.8,109.5 L172.5,106.1 L179.1,101.2 L185.7,96.2 L192.4,91.2 L199.0,86.2 L205.6,82.9 L212.3,82.9 L218.9,82.9 L225.5,82.9 L232.2,82.9 L238.8,82.9 L245.4,82.9 L252.1,82.9 L258.7,81.3 L265.3,79.6 L272.0,76.3 L278.6,74.6 L285.2,74.6 L291.9,74.6 L298.5,74.6 L305.1,79.6 L311.8,86.2 L318.4,92.9 L325.0,96.2 L331.7,99.5 L338.3,97.8 L344.9,96.2 L351.6,91.2 L358.2,86.2 L364.8,82.9 L371.5,79.6 L378.1,76.3 L384.7,76.3 L391.4,76.3 L398.0,76.3 L404.6,77.9 L411.3,81.3 L417.9,82.9 L424.5,84.6 L431.2,84.6 L437.8,84.6 L444.4,86.2 L451.1,86.2 L457.7,87.9 L464.3,86.2 L471.0,82.9 L477.6,74.6 L484.2,74.6 L490.9,77.9 L497.5,84.6 L504.1,89.6 L510.8,94.5 L517.4,97.8 L524.0,101.2 L530.7,104.5 L537.3,104.5 L543.9,104.5 L550.6,104.5 L557.2,104.5 L563.8,102.8 L570.5,99.5 L577.1,97.8 L583.7,96.2 L590.4,92.9 L597.0,89.6 L603.6,86.2 L610.3,82.9 L616.9,81.3 L623.5,79.6 L630.2,79.6 L636.8,82.9 L643.4,91.2 L650.1,102.8 L656.7,109.5 L663.3,109.5 L670.0,106.1 L676.6,101.2 L683.3,94.5 L689.9,89.6 L696.5,84.6 L703.2,82.9 L709.8,81.3 L716.4,81.3 L723.1,81.3 L729.7,81.3 L736.3,81.3 L743.0,81.3 L749.6,81.3 L756.2,79.6 L762.9,77.9 L769.5,76.3 L776.1,74.6 L782.8,74.6 L789.4,74.6 L796.0,74.6 L802.7,74.6 L809.3,76.3 L815.9,82.9 L822.6,89.6 L829.2,94.5 L835.8,97.8 L842.5,97.8 L849.1,96.2 L855.7,92.9 L862.4,89.6 L869.0,84.6 L875.6,79.6 L882.3,76.3 L888.9,74.6 L895.5,74.6 L902.2,74.6 L908.8,74.6 L915.4,76.3 L922.1,77.9 L928.7,81.3 L935.3,81.3 L942.0,82.9 L948.6,82.9 L955.2,84.6 L961.9,84.6 L968.5,86.2 L975.1,86.2 L981.8,84.6 L988.4,81.3 L995.0,76.3 L1000,76.3 L1000,109.5 Z"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if s.show_summary -%}
      {%- assign avg = sum_avg | plus: 0.0 -%}
      {%- comment -%}
        Customer photos: on product pages, the real photos customers attached to their Judge.me reviews of this
        product (Judge.me keeps them in the product's review metafield). The "Summary photo" blocks are only the
        fallback (homepage, or a product without photo reviews).
      {%- endcomment -%}
      {%- comment -%}
        Only this product's own photo reviews (Judge.me's photo gallery for the product), every photo of each
        review, the same picture never twice. Each entry: image URL (without width) | reviewer's first name.
      {%- endcomment -%}
      {%- assign jm_photos = '' -%}
      {%- assign jm_keys = '' -%}
      {%- assign jm_sources = nil -%}
      {%- if s.gallery_source == 'judgeme' and rv_product -%}
        {%- assign jm_sources = rv_product | sort -%}
      {%- elsif s.gallery_source == 'judgeme_store' -%}
        {%- comment -%} every product's Judge.me photo reviews (store-wide), e.g. for the homepage {%- endcomment -%}
        {%- assign jm_sources = collections.all.products -%}
      {%- endif -%}
      {%- assign skip_words = s.gallery_skip | split: ',' -%}
      {%- assign photo_count = 0 -%}
      {%- comment -%} with the "+N more" tile, keep collecting (up to 40) so the popup can show them all {%- endcomment -%}
      {%- assign photo_cap = s.gallery_limit -%}
      {%- if s.gallery_more and s.photo_popup -%}{%- assign photo_cap = 40 -%}{%- endif -%}
      {%- for jm_src in jm_sources limit: 50 -%}
        {%- if photo_count >= photo_cap -%}{%- break -%}{%- endif -%}
        {%- assign jm_src_data = jm_src.metafields.judgeme.review_widget_data.value -%}
        {%- for photo_rv in jm_src_data.photo_gallery -%}
          {%- for pic in photo_rv.pictures_urls -%}
            {%- if photo_count >= photo_cap -%}{%- break -%}{%- endif -%}
            {%- assign pic_src = pic.original | default: pic.huge | split: '&width=' | first -%}
            {%- comment -%} same picture uploaded twice: compare the file name without its upload number {%- endcomment -%}
            {%- assign pic_file = pic_src | split: '?' | first | split: '/' | last -%}
            {%- assign pic_head = pic_file | split: '-' | first -%}
            {%- assign pic_key = pic_file | remove_first: pic_head -%}
            {%- comment -%} "Leave out photos": skip any photo whose file name contains one of the listed words {%- endcomment -%}
            {%- assign pic_skip = false -%}
            {%- for skip_word in skip_words -%}
              {%- assign skip_word_clean = skip_word | strip -%}
              {%- if skip_word_clean != blank and pic_file contains skip_word_clean -%}{%- assign pic_skip = true -%}{%- endif -%}
            {%- endfor -%}
            {%- if pic_skip -%}{%- continue -%}{%- endif -%}
            {%- unless jm_keys contains pic_key -%}
              {%- assign rv_first = photo_rv.reviewer_name | split: ' ' | first | replace: '|', '' | replace: '^', '' -%}
              {%- assign jm_photos = jm_photos | append: pic_src | append: '|' | append: rv_first | append: '^' -%}
              {%- assign jm_keys = jm_keys | append: pic_key | append: '^' -%}
              {%- assign photo_count = photo_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- assign jm_photo_list = jm_photos | split: '^' -%}
      {%- assign has_photo_block = false -%}
      {%- for block in photo_blocks limit: s.gallery_limit -%}
        {%- if block.settings.image != blank -%}
          {%- assign has_photo_block = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign has_gallery = false -%}
      {%- if s.show_gallery -%}
        {%- comment -%} Only show the gallery when an actual review photo or configured gallery image exists. {%- endcomment -%}
        {%- if jm_photo_list.size > 0 -%}
          {%- assign has_gallery = true -%}
        {%- elsif has_photo_block -%}
          {%- if rv_product == blank or s.gallery_source == 'blocks' -%}{%- assign has_gallery = true -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      <div class="somna-reviews__summary{% if joined %} is-joined{% endif %}{% unless has_gallery %} somna-reviews__summary--no-photos{% endunless %}">
        <div class="somna-reviews__score">
          <p class="somna-reviews__average">{{ sum_avg | escape }}</p>
          {%- if s.show_summary_stars -%}
            <span class="somna-reviews__stars" role="img" aria-label="{{ avg }} out of 5 stars">
              {%- for i in (1..5) -%}<span class="somna-reviews__star{% if avg < i %}{% assign below = i | minus: 1 %}{% if avg > below %} is-half{% else %} is-empty{% endif %}{% endif %}">{{ star_svg }}</span>{%- endfor -%}
            </span>
          {%- endif -%}
          {%- comment -%} product pages: that product's real review count; elsewhere (homepage) 1000+ {%- endcomment -%}
          {%- if sum_count != blank -%}<p class="somna-reviews__count">{% if request.page_type == 'product' %}{{ sum_count | replace: ' reviews', ' Reviews' }}{% else %}1000+ Reviews{% endif %}</p>{%- endif -%}
        </div>

        <ul class="somna-reviews__bars" role="list">
          {%- for i in (1..5) -%}
            {%- assign stars = 6 | minus: i -%}
            {%- case stars -%}{%- when 5 -%}{%- assign p = sum_p5 -%}{%- when 4 -%}{%- assign p = sum_p4 -%}{%- when 3 -%}{%- assign p = sum_p3 -%}{%- when 2 -%}{%- assign p = sum_p2 -%}{%- else -%}{%- assign p = sum_p1 -%}{%- endcase -%}
            <li>
              <span class="somna-reviews__bar-label">{{ stars }}★</span>
              <span class="somna-reviews__bar" aria-hidden="true"><span style="width: {{ p }}%;"></span></span>
              <span class="somna-reviews__bar-pct">{{ p }}%<span class="visually-hidden"> of reviews are {{ stars }} stars</span></span>
            </li>
          {%- endfor -%}
        </ul>

        {%- if has_gallery and jm_photo_list.size > 0 -%}
          <ul class="somna-reviews__gallery" role="list"{% if s.photo_popup %} data-photo-popup{% endif %}>
            {%- assign more_count = jm_photo_list.size | minus: s.gallery_limit | plus: 1 -%}
            {%- for entry in jm_photo_list -%}
              {%- assign pic_src = entry | split: '|' | first -%}
              {%- assign rv_first = entry | split: '|' | last -%}
              {%- comment -%} photos past the limit stay hidden (not downloaded) and only show in the popup; the last visible one reads "+N" {%- endcomment -%}
              <li{% if forloop.index > s.gallery_limit %} hidden{% elsif forloop.index == s.gallery_limit and jm_photo_list.size > s.gallery_limit %} class="somna-reviews__more-tile"{% endif %}>
                {%- if forloop.index == s.gallery_limit and jm_photo_list.size > s.gallery_limit -%}<span class="somna-reviews__more-count" aria-hidden="true">+{{ more_count }}</span>{%- endif -%}
                <img src="{{ pic_src }}&width=240" srcset="{{ pic_src }}&width=160 160w, {{ pic_src }}&width=240 240w" sizes="120px" alt="{{ s.photo_alt | replace: '[name]', rv_first | escape }}"{% if s.photo_popup %} tabindex="0" role="button"{% endif %} width="120" height="120" loading="lazy" decoding="async">
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif has_gallery -%}
          <ul class="somna-reviews__gallery" role="list"{% if s.photo_popup %} data-photo-popup{% endif %}>
            {%- for block in photo_blocks limit: s.gallery_limit -%}
              {%- if block.settings.image != blank -%}
                <li {{ block.shopify_attributes }}>
                  {%- assign photo_alt_text = block.settings.alt | default: block.settings.image.alt -%}
                  {%- if s.photo_popup -%}
                    {{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: photo_alt_text, width: 120, height: 120, tabindex: '0', role: 'button' }}
                  {%- else -%}
                    {{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: photo_alt_text, width: 120, height: 120 }}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if s.summary_wave -%}
        {%- comment -%} wavy bottom edge under the rating summary (the same tear shape, card colour dripping down) {%- endcomment -%}
        <div class="somna-reviews__tear somna-reviews__tear--bottom" aria-hidden="true">
          <svg viewBox="0 0 1000 60" preserveAspectRatio="none" focusable="false"><path fill="{{ s.card_color }}" d="M0,0 L0.0,14.9 L13.3,23.2 L26.5,36.5 L39.8,46.4 L53.1,53.1 L66.3,56.4 L79.6,54.7 L92.9,51.4 L106.1,46.4 L119.4,39.8 L132.7,34.8 L145.9,33.2 L159.2,49.8 L172.5,59.7 L185.7,53.1 L199.0,41.5 L212.3,34.8 L225.5,33.2 L245.4,34.8 L265.3,31.5 L285.2,23.2 L298.5,26.5 L318.4,44.8 L331.7,49.8 L351.6,41.5 L371.5,29.9 L391.4,28.2 L411.3,34.8 L437.8,38.1 L457.7,36.5 L471.0,21.6 L484.2,8.3 L504.1,28.2 L524.0,43.1 L543.9,49.8 L563.8,48.1 L583.7,43.1 L603.6,34.8 L623.5,26.5 L636.8,24.9 L650.1,43.1 L663.3,53.1 L683.3,43.1 L703.2,28.2 L723.1,26.5 L756.2,26.5 L776.1,19.9 L796.0,13.3 L815.9,31.5 L835.8,43.1 L855.7,36.5 L875.6,24.9 L895.5,19.9 L915.4,23.2 L942.0,28.2 L968.5,31.5 L988.4,16.6 L1000,1.7 L1000,0 Z"/></svg>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if s.show_filters and use_app == false -%}
      <div class="somna-reviews__chips" role="group" aria-label="{{ s.filters_label | escape }}" hidden data-chips>
        <button type="button" class="somna-reviews__chip" data-filter="all" aria-pressed="true">{{ s.chip_all | escape }}</button>
        <button type="button" class="somna-reviews__chip" data-filter="5" aria-pressed="false">{{ s.chip_5 | escape }}</button>
        <button type="button" class="somna-reviews__chip" data-filter="4" aria-pressed="false">{{ s.chip_4 | escape }}</button>
        <button type="button" class="somna-reviews__chip" data-filter="low" aria-pressed="false">{{ s.chip_low | escape }}</button>
        {%- if s.show_review_photos -%}<button type="button" class="somna-reviews__chip" data-filter="photos" aria-pressed="false">{{ s.chip_photos | escape }}</button>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if use_app -%}
      {%- comment -%} mobile: first two reviews, then "Show more reviews" (a label for a hidden checkbox, no JS) {%- endcomment -%}
      {%- if s.app_mobile_more -%}<input type="checkbox" class="somna-reviews__more-toggle" id="{{ section.id }}-more" aria-label="{{ s.more_label | escape }}">{%- endif -%}
      <div class="somna-reviews__app">
        {%- for block in app_blocks -%}{% render block %}{%- endfor -%}
      </div>
      {%- if s.app_mobile_more -%}<label class="somna-reviews__more somna-reviews__more--app" for="{{ section.id }}-more" aria-hidden="true">{{ s.more_label | escape }}</label>{%- endif -%}
    {%- else -%}
    <p class="somna-reviews__note" data-note hidden></p>
    <ul class="somna-reviews__list" role="list" data-list data-no-reveal aria-live="polite" aria-busy="true">
      {%- if s.sheet_url != blank -%}
        {%- for i in (1..2) -%}<li class="somna-reviews__card somna-reviews__card--skeleton" aria-hidden="true"><span></span><span></span></li>{%- endfor -%}
      {%- endif -%}
    </ul>
    <p class="somna-reviews__status" data-status role="status" hidden></p>
    <button type="button" class="somna-reviews__more" data-more hidden>{{ s.more_label | escape }}</button>
    {%- if s.sheet_url == blank and request.design_mode -%}
      <p class="somna-reviews__status">Add the Google Sheet link in “Customer reviews (Google Sheet)” to show reviews here.</p>
    {%- endif -%}
    {%- endif -%}
  </div>
</somna-reviews>

{%- if s.bottom_wave and s.bottom_wave_color != blank -%}
  {%- render 'somna-wave', top: s.background_color, bottom: s.bottom_wave_color, shape: s.bottom_wave_shape -%}
{%- endif -%}

{%- if s.sheet_url != blank and use_app == false -%}
  <template data-somna-review-star>{{ star_svg }}</template>
  <script src="{{ 'somna-reviews.js' | asset_url }}" defer></script>
{%- endif -%}

