  .somna-reviews__gallery[data-photo-popup] img:focus-visible { outline: 2px solid #afbdf8; outline-offset: 2px; }
  html.somna-rv-lb-open { overflow: hidden; }
  .somna-rv-lb {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 56px 72px; border: 0; background: transparent; color: #fff;
    display: none; align-items: center; justify-content: center;
  }
  .somna-rv-lb[open] { display: flex; animation: somnaRvLbIn 0.2s ease; }
