{%- comment -%}
  SOMNA quiz v6 (SOMNA_Quiz_Flow_v2_Result_Pages_Updated.pdf, 4 Nov 2026).
  Q1, Q2, Q3, Q4, reviews break, Q5, Q6 → "Finding your match…" (2 s) → result page with the matched product:
  match + image + rating, buy box (bags, Autoship / one-time, Add to Cart → cart drawer), How It Works, reviews,
  main benefit, benefits, how to use, results + guarantee, FAQ, sticky Add to Cart.
  Q1–Q4 decide the product (strips / tape / bundle). Result copy and images: "Result page" blocks (one per product).
  Logic: snippets/somna-quiz-script.liquid · styles: snippets/somna-quiz-styles.liquid (quiz page only).
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  # Fall back to the live product handles if a product setting is empty (e.g. template out of sync)
  assign p_strips = section.settings.product_strips | default: all_products['nasal-strips']
  assign p_tape = section.settings.product_tape | default: all_products['mouth-tape']
  assign p_bundle = section.settings.product_bundle | default: all_products['sleep-bundle']
  # Sale % for one-time purchases (automatic discount), shared with the product page: snippets/somna-sale.liquid
  capture sq_once_off
    render 'somna-sale', get: 'once_off'
  endcapture
  assign sq_once_off = sq_once_off | plus: 0
  assign sq_once_keep = 100 | minus: sq_once_off
-%}

<section class="sq{% if section.settings.design == 'v2' %} sq--v2{% endif %}{% if section.settings.result_extras %} sq--extras{% endif %}" id="sq-{{ sid }}" data-sq aria-label="Sleep quiz">
  <div class="sq-wrap">
    <a class="sq-logo" href="{{ routes.root_url }}" aria-label="SOMNA home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '160px', alt: '', class: 'sq-logo-img', loading: 'eager' }}
      {%- else -%}som<span>na.</span>{%- endif -%}
    </a>

    <div class="sq-top" data-sq-top>
      <div class="sq-prog" role="progressbar" aria-label="Quiz progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="12" data-sq-prog>
        <div class="sq-prog-f" data-sq-progf></div>
      </div>
      <div class="sq-top-row">
        <button type="button" class="sq-back" data-sq-back hidden><span aria-hidden="true">←</span> Back</button>
        <p class="sq-step" data-sq-step>Question 1 of 6</p>
      </div>
    </div>
    <p class="sq-sr" aria-live="polite" data-sq-live></p>

    {% render 'somna-quiz-screens', qs: section.settings, sid: sid, blocks: section.blocks %}

    {%- comment -%} 8 · Matching (2 seconds, ticks off their own answers, then straight to the result) {%- endcomment -%}
    <div class="sq-s sq-center" data-type="analyze">
      <h2 class="sq-q" tabindex="-1">{{ section.settings.analyze_heading }}</h2>
      <div class="sq-ring" aria-hidden="true">
        <svg viewBox="0 0 120 120"><circle class="sq-ring-bg" cx="60" cy="60" r="52"/><circle class="sq-ring-f" cx="60" cy="60" r="52" data-sq-ring/></svg>
        <span class="sq-ring-pct" data-sq-pct>0%</span>
      </div>
      <ul class="sq-checks" data-sq-checks></ul>
      {%- if section.settings.analyze_foot != blank -%}<p class="sq-fine">{{ section.settings.analyze_foot }}</p>{%- endif -%}
    </div>

    {%- comment -%} 9 · Result: the matched product's page (one per product, the script shows the match) {%- endcomment -%}
    <div class="sq-s sq-result" data-type="result">
      {%- for r in (1..3) -%}
        {%- liquid
          case r
            when 1
              assign rk = 'strips'
              assign rp = p_strips
              assign rimg_pick = section.settings.strips_result_image
            when 2
              assign rk = 'tape'
              assign rp = p_tape
              assign rimg_pick = section.settings.tape_result_image
            when 3
              assign rk = 'bundle'
              assign rp = p_bundle
              assign rimg_pick = section.settings.bundle_result_image
          endcase
          assign rb = nil
          for b in section.blocks
            if b.type == 'result' and b.settings.product == rk
              assign rb = b
              break
            endif
          endfor
          assign rbs = rb.settings
          # "4.6 <svg…> (248)" → 4.6 and 248 (same field as the product page rating)
          assign r_rating = ''
          assign r_count = ''
          assign r_raw = rp.metafields.custom.custom_review_rating_review_count.value | strip_html | strip
          if r_raw != blank
            assign r_rating = r_raw | split: ' ' | first
            assign r_count = r_raw | split: '(' | last | split: ')' | first | strip
          endif
        -%}
        {%- if rp != blank -%}
        <div class="sq-res" data-res="{{ rk }}" hidden {% if rb %}{{ rb.shopify_attributes }}{% endif %}>
          {%- comment -%} Match + product {%- endcomment -%}
          <div class="sq-res-top">
            <div class="sq-res-intro">
              <p class="sq-pill">✓ {{ section.settings.match_pill }}</p>
              <h2 class="sq-q sq-res-h" tabindex="-1">{{ section.settings.fix_prefix }} <em>SOMNA {{ rp.title }}</em></h2>
              <p class="sq-res-why" data-sq-why></p>
              <div class="sq-res-img{% if rimg_pick != blank %} sq-res-img--pack{% endif %}" data-sq-res-img>
                {%- assign rimg = rimg_pick | default: rp.selected_or_first_available_variant.featured_image | default: rp.featured_image -%}
                {%- if rimg != blank -%}{{ rimg | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 480px, (min-width: 750px) 560px, 92vw', loading: 'lazy', alt: rp.title }}{%- endif -%}
              </div>
              {%- if section.settings.result_extras and rimg != blank -%}
                {%- comment -%} thumbnails: the result image + the product's own photos (as the product page gallery); tap = main image {%- endcomment -%}
                {%- capture thumbs -%}
                  {%- assign tn = 0 -%}
                  {%- for m in rp.media -%}
                    {%- if m.media_type == 'image' and m.preview_image.src != rimg.src and tn < 5 -%}
                      {%- assign tn = tn | plus: 1 -%}
                      <button type="button" class="sq-thumb" data-sq-thumb data-src="{{ m.preview_image | image_url: width: 900 }}" aria-label="{{ rp.title | escape }} photo {{ tn | plus: 1 }}">{{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}</button>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if tn > 0 -%}
                  <div class="sq-thumbs" role="group" aria-label="{{ rp.title | escape }} photos">
                    <button type="button" class="sq-thumb" data-sq-thumb data-first data-src="{{ rimg | image_url: width: 900 }}" aria-current="true" aria-label="{{ rp.title | escape }} photo 1">{{ rimg | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}</button>
                    {{- thumbs -}}
                  </div>
                {%- endif -%}
              {%- endif -%}
              {%- if r_rating != blank -%}
                <p class="sq-res-rating"><span class="sq-stars" aria-hidden="true">★★★★★</span> {{ r_rating }}{% if r_count != blank %} · {{ r_count }} reviews{% endif %}<span class="sq-sr"> out of 5</span></p>
              {%- endif -%}
              <ul class="sq-res-perks">
                {%- if rbs.emoji_1 != blank -%}<li>{{ rbs.emoji_1 }}</li>{%- endif -%}
                {%- if rbs.emoji_2 != blank -%}<li>{{ rbs.emoji_2 }}</li>{%- endif -%}
                {%- if rbs.emoji_3 != blank -%}<li>{{ rbs.emoji_3 }}</li>{%- endif -%}
              </ul>
            </div>

            {%- comment -%} Buy box: built by the script from the product data below (bags, Autoship / one-time, Add to Cart) {%- endcomment -%}
            <div class="sq-buy" data-sq-buy>
              <div data-sq-buy-ui></div>
              <button type="button" class="sq-cta sq-atc" data-sq-atc><span aria-hidden="true">🛒</span> {{ section.settings.atc_label }}</button>
              <p class="sq-err" role="alert" data-sq-atc-err hidden></p>
              {%- if section.settings.result_extras and section.settings.ship_note != blank -%}<p class="sq-buy-ship"><span aria-hidden="true">🚚</span> {{ section.settings.ship_note }}</p>{%- endif -%}
              {%- if section.settings.atc_note != blank -%}<p class="sq-buy-note">↻ {{ section.settings.atc_note }}</p>{%- endif -%}
              {%- if section.settings.view_product_label != blank -%}<p class="sq-buy-view"><a href="{{ rp.url }}">{{ section.settings.view_product_label }} →</a></p>{%- endif -%}
              {%- if rbs.how_it_works != blank -%}
                <details class="sq-acc sq-acc--box" open>
                  <summary>{{ section.settings.how_it_works_heading }}</summary>
                  <p>{{ rbs.how_it_works }}</p>
                </details>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Reviews: the product quote + the "Story review" blocks for this product {%- endcomment -%}
          <section class="sq-res-sec sq-res-revs">
            <h3 class="sq-res-h3">{{ section.settings.reviews_heading }}</h3>
            <div class="sq-rv-track{% if section.settings.result_extras %} sq-rv-track--photos{% endif %}" data-sq-rv tabindex="0" role="region" aria-label="Customer reviews">
              {%- if section.settings.result_extras -%}
                {%- comment -%} photo reviews first (photo left, as the reviews break), then the quote from the result block with initials {%- endcomment -%}
                {%- for b in section.blocks -%}
                  {%- if b.type == 'review' and b.settings.product == rk and b.settings.text != blank -%}
                    <figure class="sq-rv-card sq-rv-card--pic">
                      {%- if b.settings.image != blank -%}<div class="sq-rv-photo">{{ b.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: b.settings.name }}</div>{%- else -%}<span class="sq-rv-av" aria-hidden="true">{{ b.settings.name | slice: 0 }}</span>{%- endif -%}
                      <div class="sq-rv-body"><p class="sq-rv-stars"><span class="sq-stars" aria-hidden="true">{% for st in (1..b.settings.rating) %}★{% endfor %}</span>{% if b.settings.verified %} <span>✓ Verified buyer</span>{% endif %}</p><blockquote>“{{ b.settings.text | escape }}”</blockquote><figcaption>– {{ b.settings.name }}</figcaption></div>
                    </figure>
                  {%- endif -%}
                {%- endfor -%}
                {%- if rbs.review_quote != blank -%}
                  <figure class="sq-rv-card sq-rv-card--pic">
                    {%- if rbs.review_image != blank -%}<div class="sq-rv-photo">{{ rbs.review_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: rbs.review_name }}</div>{%- else -%}<span class="sq-rv-av" aria-hidden="true">{{ rbs.review_name | default: 'S' | slice: 0 }}</span>{%- endif -%}
                    <div class="sq-rv-body"><p class="sq-rv-stars"><span class="sq-stars" aria-hidden="true">★★★★★</span> <span>✓ Verified buyer</span></p><blockquote>“{{ rbs.review_quote }}”</blockquote>{% if rbs.review_name != blank %}<figcaption>– {{ rbs.review_name }}</figcaption>{% endif %}</div>
                  </figure>
                {%- endif -%}
              {%- else -%}
              {%- if rbs.review_quote != blank -%}
                <figure class="sq-rv-card"><p class="sq-rv-stars"><span class="sq-stars" aria-hidden="true">★★★★★</span> <span>✓ Verified buyer</span></p><blockquote>“{{ rbs.review_quote }}”</blockquote>{% if rbs.review_name != blank %}<figcaption>– {{ rbs.review_name }}</figcaption>{% endif %}</figure>
              {%- endif -%}
              {%- for b in section.blocks -%}
                {%- if b.type == 'review' and b.settings.product == rk and b.settings.text != blank -%}
                  <figure class="sq-rv-card"><p class="sq-rv-stars"><span class="sq-stars" aria-hidden="true">{% for st in (1..b.settings.rating) %}★{% endfor %}</span>{% if b.settings.verified %} <span>✓ Verified buyer</span>{% endif %}</p><blockquote>“{{ b.settings.text | escape }}”</blockquote><figcaption>– {{ b.settings.name }}</figcaption></figure>
                {%- endif -%}
              {%- endfor -%}
              {%- endif -%}
            </div>
            <div class="sq-rc-nav"><div class="sq-rc-dots" data-sq-rv-dots></div><span class="sq-rc-hint" aria-hidden="true">swipe for more</span></div>
          </section>

          {%- comment -%} Main benefit {%- endcomment -%}
          {%- if rbs.benefit_heading != blank -%}
            <section class="sq-res-sec sq-res-split">
              <div>
                <h3 class="sq-res-h3 sq-res-h3--lg">{{ rbs.benefit_heading }}</h3>
                {%- if rbs.benefit_text != blank -%}<p class="sq-res-p">{{ rbs.benefit_text }}</p>{%- endif -%}
                <ul class="sq-res-points">
                  {%- if rbs.point_1 != blank -%}<li>{{ rbs.point_1 }}</li>{%- endif -%}
                  {%- if rbs.point_2 != blank -%}<li>{{ rbs.point_2 }}</li>{%- endif -%}
                  {%- if rbs.point_3 != blank -%}<li>{{ rbs.point_3 }}</li>{%- endif -%}
                </ul>
              </div>
              {%- comment -%} Right side of the V2 product page "What it's made of" section: the stacked layer picture + numbered list
                (Sleep Bundle: the two products' cards), read from the product's own pdp_layers entry; else the image {%- endcomment -%}
              {%- liquid
                assign lay = blank
                if section.settings.v2_sections
                  assign lay = rp.metafields.custom.pdp_layers.value
                endif
                assign lay_rel = lay.related.value
                assign lay_feats = lay.features.value
                assign lay_stack = true
                if lay_feats == blank or lay_feats.size < 2
                  assign lay_stack = false
                endif
                for f in lay_feats
                  if f.image == blank
                    assign lay_stack = false
                  endif
                endfor
              -%}
              {%- if lay_rel != blank -%}
                <somna-quiz-layers class="sq-lay sq-lay--pair">
                  {%- for entry in lay_rel limit: 2 -%}
                    {%- assign card_title = entry.admin_name.value | split: ' – ' | first | split: ' - ' | first -%}
                    {%- unless forloop.first -%}<span class="sq-lay-plus" aria-hidden="true"></span>{%- endunless -%}
                    <div class="sq-lay-card">
                      {%- if card_title != blank -%}<p class="sq-lay-title">{{ card_title }}</p>{%- endif -%}
                      <div class="sq-lay-body">
                        {%- assign entry_image = entry.image.value -%}
                        {%- if entry_image -%}{{ entry_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 1000px) 220px, 45vw', alt: card_title }}{%- endif -%}
                        {%- assign entry_features = entry.features.value -%}
                        {%- if entry_features != blank -%}
                          <ol class="sq-lay-list">
                            {%- for f in entry_features -%}<li><p class="sq-lay-h">{{ f.title.value }}</p>{%- if f.text != blank -%}<p class="sq-lay-t">{{ f.text.value }}</p>{%- endif -%}</li>{%- endfor -%}
                          </ol>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </somna-quiz-layers>
              {%- elsif lay_feats != blank -%}
                <somna-quiz-layers class="sq-lay">
                  {%- if lay_stack -%}
                    {%- for f in lay_feats limit: 1 -%}{%- assign first_layer = f.image.value -%}{%- endfor -%}
                    <div class="sq-lay-stack" style="aspect-ratio: {{ first_layer.width }} / {{ first_layer.height }};">
                      {%- for f in lay_feats -%}
                        {%- assign li = f.image.value -%}
                        {%- assign probe = li | image_url: width: 120 -%}
                        {{ li | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 1000px) 300px, 55vw', class: 'sq-lay-layer', alt: f.title.value, data-probe: probe }}
                      {%- endfor -%}
                    </div>
                  {%- elsif lay.image.value -%}
                    <div class="sq-lay-stack">{{ lay.image.value | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 1000px) 300px, 55vw' }}</div>
                  {%- endif -%}
                  <ol class="sq-lay-list">
                    {%- for f in lay_feats -%}<li><p class="sq-lay-h">{{ f.title.value }}</p>{%- if f.text != blank -%}<p class="sq-lay-t">{{ f.text.value }}</p>{%- endif -%}</li>{%- endfor -%}
                  </ol>
                </somna-quiz-layers>
              {%- elsif rbs.benefit_image != blank -%}<div class="sq-res-pic">{{ rbs.benefit_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 520px, 92vw', loading: 'lazy' }}</div>{%- endif -%}
            </section>
          {%- endif -%}

          {%- comment -%} How to use {%- endcomment -%}
          {%- if rbs.howto_heading != blank -%}
            <section class="sq-res-sec sq-res-split sq-res-split--rev">
              <div>
                <h3 class="sq-res-h3">{{ rbs.howto_heading }}</h3>
                {%- if rbs.howto_text != blank -%}<p class="sq-res-p">{{ rbs.howto_text }}</p>{%- endif -%}
              </div>
              {%- liquid
                assign steps = blank
                if section.settings.v2_sections
                  assign steps = rp.metafields.custom.pdp_steps.value.features.value
                endif
              -%}
              {%- if steps != blank -%}
              <ol class="sq-steps" role="list">
                {%- for f in steps -%}
                  {%- assign photo = f.image.value -%}
                  {%- assign crop = f.image_crop.value | downcase | default: 'center' -%}
                  <li class="sq-howstep">
                    {%- if photo -%}{{ photo | image_url: width: 506, height: 308, crop: crop | image_tag: loading: 'lazy', alt: photo.alt, width: 253, height: 154 }}{%- endif -%}
                    <div>
                      <p class="sq-howstep-h"><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ f.title.value }}</p>
                      {%- if f.text != blank -%}<p class="sq-howstep-t">{{ f.text.value }}</p>{%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ol>
              {%- else -%}
              <div class="sq-res-steps">
                {%- if rbs.howto_image != blank -%}
                  {%- if rbs.howto_label_1 != blank -%}<p class="sq-res-step-l">{{ rbs.howto_label_1 }}</p>{%- endif -%}
                  <div class="sq-res-pic">{{ rbs.howto_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 520px, 92vw', loading: 'lazy' }}</div>
                {%- endif -%}
                {%- if rbs.howto_image_2 != blank -%}
                  {%- if rbs.howto_label_2 != blank -%}<p class="sq-res-step-l">{{ rbs.howto_label_2 }}</p>{%- endif -%}
                  <div class="sq-res-pic">{{ rbs.howto_image_2 | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 520px, 92vw', loading: 'lazy' }}</div>
                {%- endif -%}
              </div>
              {%- endif -%}
            </section>
          {%- endif -%}

          {%- comment -%} Results + guarantee {%- endcomment -%}
          {%- if rbs.results_heading != blank -%}
            <section class="sq-res-sec sq-res-split">
              <div>
                <h3 class="sq-res-h3">{{ rbs.results_heading }}</h3>
                {%- if rbs.results_text != blank -%}<p class="sq-res-p">{{ rbs.results_text }}</p>{%- endif -%}
                <ul class="sq-stats">
                  {%- for n in (1..3) -%}
                    {%- liquid
                      assign st_p = 'stat_' | append: n | append: '_pct'
                      assign st_t = 'stat_' | append: n | append: '_text'
                    -%}
                    {%- if rbs[st_t] != blank -%}
                      <li><p><strong>{{ rbs[st_p] }}%</strong> {{ rbs[st_t] }}</p><span class="sq-stat-bar" aria-hidden="true"><i style="width: {{ rbs[st_p] }}%"></i></span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if section.settings.guarantee_heading != blank -%}
                  <div class="sq-guar"><span class="sq-guar-n" aria-hidden="true">30</span><div><p class="sq-guar-h">{{ section.settings.guarantee_heading }}</p><p>{{ section.settings.guarantee_text }}</p></div></div>
                {%- endif -%}
              </div>
              {%- liquid
                assign rnd = blank
                if section.settings.v2_sections
                  assign rnd = rp.metafields.custom.pdp_how.value.image.value
                  assign rv = rp.variants.first
                  assign ralloc = rv.selling_plan_allocations | first
                  assign rprice = rv.price
                  if ralloc
                    assign rprice = ralloc.price
                  endif
                  assign rbags = rv.title | split: ' ' | first | plus: 0
                  if rbags < 1
                    assign rbags = 1
                  endif
                  assign rnights = rp.metafields.custom.nights.value | default: 30
                  assign rnight = rprice | divided_by: rbags | divided_by: rnights
                  assign rsticker = rp.metafields.custom.pdp_cta_sticker.value | default: '[night] a night'
                endif
              -%}
              {%- capture rnight_money -%}{{ rnight | money }}{%- endcapture -%}
              {%- if rnd -%}
                <somna-quiz-float class="sq-render">
                  <div class="sq-render-prod">{{ rnd | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1000px) 260px, 50vw', alt: rp.title }}</div>
                  {%- if rnight > 0 -%}<p class="sq-render-sticker sq-shake--pop">{{ rsticker | replace: '[night]', rnight_money }}</p>{%- endif -%}
                </somna-quiz-float>
              {%- elsif rbs.results_image != blank -%}<div class="sq-res-pic sq-res-pic--wide">{{ rbs.results_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 520px, 92vw', loading: 'lazy' }}</div>{%- endif -%}
            </section>
          {%- endif -%}

          {%- comment -%} FAQ {%- endcomment -%}
          <section class="sq-res-sec sq-res-faq">
            <h3 class="sq-res-h3">{{ section.settings.faq_heading }}</h3>
            {%- for n in (1..6) -%}
              {%- liquid
                assign fq = 'faq_' | append: n | append: '_q'
                assign fa = 'faq_' | append: n | append: '_a'
              -%}
              {%- if rbs[fq] != blank -%}
                <details class="sq-acc"{% if forloop.first %} open{% endif %}><summary>{{ rbs[fq] }}</summary><p>{{ rbs[fa] }}</p></details>
              {%- endif -%}
            {%- endfor -%}
            <p class="sq-res-links">{% if section.settings.retake_label != blank %}<button type="button" class="sq-linkbtn" data-sq-retake>↻ {{ section.settings.retake_label }}</button> · {% endif %}<a href="{{ routes.all_products_collection_url }}">{{ section.settings.all_products_label }}</a></p>
          </section>
        </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Sticky Add to Cart (shows once the main button scrolls out of view) {%- endcomment -%}
      <div class="sq-sticky" data-sq-sticky hidden>
        <button type="button" class="sq-cta" data-sq-sticky-atc><span aria-hidden="true">🛒</span> {{ section.settings.atc_label }} · <span data-sq-sticky-price></span></button>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Product data for the buy box (prices in cents). One-time price = variant price minus the sale % (snippets/somna-sale.liquid). {%- endcomment -%}
<script type="application/json" data-sq-products>
  {
  {%- for r in (1..3) -%}
    {%- liquid
      case r
        when 1
          assign rk = 'strips'
          assign rp = p_strips
        when 2
          assign rk = 'tape'
          assign rp = p_tape
        when 3
          assign rk = 'bundle'
          assign rp = p_bundle
      endcase
      assign size_pos = 0
      assign color_pos = 0
      for o in rp.options_with_values
        assign on = o.name | downcase
        if on contains 'size'
          assign size_pos = forloop.index
        elsif on contains 'color' or on contains 'colour'
          assign color_pos = forloop.index
        endif
      endfor
    -%}
    {{ rk | json }}: {
      "id": {{ rp.id | json }}, "title": {{ rp.title | json }}, "url": {{ rp.url | json }},
      "variants": [
        {%- for v in rp.variants -%}
          {%- liquid
            assign v_size = ''
            assign v_color = ''
            if size_pos > 0
              assign sk = 'option' | append: size_pos
              assign v_size = v[sk]
            endif
            if color_pos > 0
              assign ck = 'option' | append: color_pos
              assign v_color = v[ck]
            endif
            assign v_bags = v_size | split: ' ' | first | plus: 0
            if v_bags < 1
              assign v_bags = 1
            endif
            assign v_nights = v_bags | times: 30
            assign v_once = v.price | times: sq_once_keep | divided_by: 100.0 | round
            # Autoship plan whose interval is closest to the supply (30 / 60 / 120 nights), as on the product page
            assign v_plan = nil
            assign v_diff = 99999
            for alloc in v.selling_plan_allocations
              capture pd
                render 'somna-plan-label', selling_plan: alloc.selling_plan, days_only: true
              endcapture
              assign pd = pd | plus: 0
              assign dd = pd | minus: v_nights | abs
              if dd < v_diff
                assign v_diff = dd
                assign v_plan = alloc
                assign v_plan_days = pd
              endif
            endfor
          -%}
          { "id": {{ v.id }}, "size": {{ v_size | json }}, "color": {{ v_color | json }}, "bags": {{ v_bags }}, "nights": {{ v_nights }}, "available": {{ v.available | json }},
            "price": {{ v.price }}, "once": {{ v_once }},
            "sub": {% if v_plan %}{{ v_plan.price }}{% else %}null{% endif %}, "plan": {% if v_plan %}{{ v_plan.selling_plan.id }}{% else %}null{% endif %}, "days": {% if v_plan %}{{ v_plan_days }}{% else %}0{% endif %},
            "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }
</script>
