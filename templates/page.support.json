            "open": false
          }
        },
        "q_orders_3": {
          "type": "question",
          "settings": {
            "question": "How do I change my order before it ships?",
            "answer": "<p>Visit <a href=\"/pages/manage-subscriptions\">Manage my subscription →</a> from your account, or contact us at <a href=\"mailto:hello@somnasleep.com\">hello@somnasleep.com</a> if your order hasn't shipped yet.</p>",
