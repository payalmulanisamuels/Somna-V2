        "q_orders_1": {
          "type": "question",
          "settings": {
            "question": "How does Subscribe & Save work?",
            "answer": "<p>It's up to 50% off every order, delivered automatically on a schedule based on the size you choose. Skip, pause, swap, or cancel anytime from your account.</p>",
            "open": false
          }
        },
        "q_orders_2": {
          "type": "question",
