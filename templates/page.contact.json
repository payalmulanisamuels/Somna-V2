        "tagline": "We're here to help.",
        "text": "<p>Questions about your order, your subscription, or how to use your Somna? Send us a message — we read every one.</p>",
        "image": "shopify://shop_images/contact-banner.jpg",
        "image_position": "object-position: 50% 60%",
        "image_side": "left",
        "drip_edge": true,
        "background_color": "#afbdf8",
        "panel_color": "#0b0f1d",
        "accent_color": "#afbdf8",
        "padding_top": 24,
        "padding_bottom": 48
      }
    },
