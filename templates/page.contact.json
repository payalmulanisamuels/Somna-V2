      "settings": {
        "layout": "badges",
        "eyebrow": "",
        "heading": "",
        "text": "",
        "background_color": "#afbdf8",
        "text_color": "#000000",
        "card_color": "#0b0f1d",
        "card_text_color": "#f3feee",
        "accent_color": "#afbdf8",
        "padding_top": 8,
        "padding_bottom": 40
