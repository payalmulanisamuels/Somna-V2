      "type": "somna-wave",
      "settings": {
        "top_color": "#afbdf8",
        "bottom_color": "#000000",
        "shape": "drip-11",
        "overlap": false,
        "flip": false,
        "drops": true,
        "animate": true,
        "height": 140,
        "height_mobile": 48
      }
    },
    "newsletter": {
      "type": "section",
      "settings": {
        "content_direction": "row",
        "gap": 40,
        "section_width": "page-width",
        "background_color": "#000000",
        "padding-block-start": 24,
        "padding-block-end": 32,
        "horizontal_alignment": "space-between",
        "vertical_alignment": "center"
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Get <em>10% off</em><br>your first order</h2>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "2.5rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "uppercase",
