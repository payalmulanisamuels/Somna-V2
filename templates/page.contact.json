        "email": "hello@somnasleep.com",
        "response_time": "Typically within 1 business day.",
        "form_heading": "How can we help?",
        "drip_edge": true,
        "background_color": "#f3feee",
        "panel_color": "#0b0f1d",
        "card_color": "#afbdf8",
        "accent_color": "#afbdf8",
