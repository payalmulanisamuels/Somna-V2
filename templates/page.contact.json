        "text": "<p>Check the links below before sending a message.</p>",
        "background_color": "#f3feee",
        "text_color": "#000000",
        "card_color": "#0b0f1d",
        "card_text_color": "#f3feee",
        "accent_color": "#afbdf8",
        "padding_top": 16,
        "padding_bottom": 56
      }
    },
    "form": {
      "type": "somna-contact",
      "settings": {
        "anchor": "contact-form",
        "eyebrow": "Contact form",
        "heading": "Send us a <em>message</em>",
