

{% liquid
  assign block_settings = block.settings
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_inverse_logo == true
    assign use_inverse_logo = true
  endif

  if use_inverse_logo
    if settings.logo_inverse != blank
      assign inverse_logo = settings.logo_inverse
    else
      assign inverse_logo = settings.logo
    endif
  endif

  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name

  # Somna V2: text logo options, used only when no logo image is set in Theme settings
  assign logo_text = block_settings.logo_text | strip | default: shop.name
  assign logo_text_weight = block_settings.logo_text_weight | default: '600'
%}

{%- if settings.logo == blank and settings.logo_inverse == blank -%}
  {%- comment -%}
    The body font file only includes the weights the theme already loads. For any other weight,
    add that one face so the logo renders in its real weight instead of the nearest one.
  {%- endcomment -%}
  {%- assign loaded_weights = settings.type_body_font.weight
    | append: ','
    | append: settings.type_subheading_font.weight
    | append: ','
    | append: settings.type_heading_font.weight
    | split: ','
  -%}
  {%- unless loaded_weights contains logo_text_weight -%}
    {%- assign logo_font = settings.type_body_font | font_modify: 'weight', logo_text_weight -%}
    {%- if logo_font -%}
      <style>
        {{ logo_font | font_face: font_display: 'swap' }}
      </style>
    {%- endif -%}
  {%- endunless -%}
{%- endif -%}

{% comment %}
  Output all logo variants, use CSS to hide/show the appropriate one
  based on the .header[transparent] selector
{% endcomment %}
<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="size-style spacing-style header-logo"
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --font-family: var(--font-body--family);
    --font-style: var(--font-body--style);
    --font-weight: {{ logo_text_weight }};
    {% if block_settings.logo_text_size > 0 %}--header-logo-text-size: {{ block_settings.logo_text_size }}px;{% endif %}
    {% if block_settings.logo_text_size_mobile > 0 %}--header-logo-text-size-mobile: {{ block_settings.logo_text_size_mobile }}px;{% endif %}
    {% if block_settings.logo_text_color != blank %}--header-logo-text-color: {{ block_settings.logo_text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% liquid
    assign logo_width = settings.logo_height | times: settings.logo.aspect_ratio | ceil
    assign logo_width_mobile = settings.logo_height_mobile | times: settings.logo.aspect_ratio | ceil
    assign inverse_logo_width = settings.logo_height | times: inverse_logo.aspect_ratio | ceil
    assign inverse_logo_width_mobile = settings.logo_height_mobile | times: inverse_logo.aspect_ratio | ceil
    assign logo_style = '--header-logo-image-width: ' | append: logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
    assign inverse_logo_style = '--header-logo-image-width: ' | append: inverse_logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: inverse_logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
  %}

  <span
    {% if use_inverse_logo %}
      class="header-logo__solid-header-image-container"
    {% endif %}
    data-testid="header-logo"
  >
    {% render 'image',
      image: settings.logo,
      class: 'header-logo__image',
      height: settings.logo_height,
      alt_text_fallback: alt_text_fallback,
      text_fallback: logo_text,
      style: logo_style
    %}
  </span>

  {% if use_inverse_logo %}
    <span
      class="header-logo__transparent-header-image-container"
      data-testid="header-logo-inverse"
    >
      {% render 'image',
        image: inverse_logo,
        class: 'header-logo__image',
        height: settings.logo_height,
        alt_text_fallback: alt_text_fallback,
        text_fallback: logo_text,
        style: inverse_logo_style
      %}
    </span>
  {% endif %}
</a>

{% stylesheet %}
  .header-logo {
    display: flex;
    height: 100%;
    font-size: var(--header-logo-text-size-mobile, var(--header-logo-text-size, var(--font-size--md)));
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    font-style: var(--font-style);
    color: var(--header-logo-text-color, var(--color-foreground));
    justify-content: center;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;

    @media screen and (min-width: 750px) {
      font-size: var(--header-logo-text-size, var(--font-size--md));
    }

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: flex;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo__image {
    object-fit: contain;
    height: var(--header-logo-image-height-mobile);
    width: var(--header-logo-image-width-mobile);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-image-height);
      width: var(--header-logo-image-width);
    }
  }

  .header-logo__solid-header-image-container {
    display: var(--header-logo-display, block);
  }

  .header-logo__transparent-header-image-container {
    display: var(--header-logo-inverse-display, none);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "Text logo"
    },
    {
      "type": "paragraph",
      "content": "Shown when no logo image is set in Theme settings."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text",
      "info": "Leave blank to use the store name."
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Size on desktop",
      "info": "0 uses the theme default.",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_text_size_mobile",
      "label": "Size on mobile",
      "info": "0 uses the desktop size.",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "logo_text_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "logo_text_color",
      "label": "Color",
      "info": "Leave blank to follow the header text color. A set color is kept on a transparent header too."
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
