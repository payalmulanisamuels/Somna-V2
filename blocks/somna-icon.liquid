{%- comment -%}
  Somna V2 — icon block for groups.
  Shows either a built-in line icon or an uploaded silhouette (PNG/SVG with transparency).
  Uploaded silhouettes are drawn as a CSS mask, so they take the colour set here.
  Optional backdrop: a circle, or a second silhouette (e.g. a gift box) drawn behind the icon.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign size = s.size
  assign box = s.backdrop_size | default: size
  if s.backdrop == 'none'
    assign box = size
  endif
-%}
<span
  class="somna-icon somna-icon--{{ s.backdrop }}"
  style="--somna-icon-size: {{ size }}px; --somna-icon-box: {{ box }}px; --somna-icon-color: {{ s.color | default: 'currentColor' }}; --somna-icon-backdrop: {{ s.backdrop_color | default: 'transparent' }};{% if s.backdrop == 'image' and s.backdrop_image != blank %} --somna-icon-backdrop-mask: url('{{ s.backdrop_image | image_url: width: 300 }}');{% endif %} --somna-icon-offset: {{ s.icon_offset }}px;"
  {{ block.shopify_attributes }}
>
  {%- if s.drawing != blank and s.drawing != 'none' -%}
    {%- if s.backdrop == 'image' -%}<span class="somna-icon__patch" aria-hidden="true"></span>{%- endif -%}
    {%- liquid
      assign draw_class = 'somna-icon__glyph somna-icon__drawing'
      if s.draw_animation
        assign draw_class = draw_class | append: ' somna-icon__drawing--pen'
      endif
    -%}
    {%- render 'somna-gift-drawing', name: s.drawing, class: draw_class -%}
  {%- elsif s.image != blank -%}
    {%- if s.backdrop == 'image' -%}<span class="somna-icon__patch" aria-hidden="true"></span>{%- endif -%}
    <span
      class="somna-icon__glyph somna-icon__glyph--mask"
      style="--somna-icon-mask: url('{{ s.image | image_url: width: 200 }}');"
      aria-hidden="true"
    ></span>
  {%- elsif s.icon != 'none' -%}
    {%- render 'somna-line-icon', name: s.icon, class: 'somna-icon__glyph' -%}
  {%- endif -%}
</span>

{% stylesheet %}
  .somna-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--somna-icon-box);
    height: var(--somna-icon-box);
    color: var(--somna-icon-color);
  }

  .somna-icon--circle {
    border-radius: 50%;
    background: var(--somna-icon-backdrop);
  }

  .somna-icon--image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--somna-icon-backdrop);
    -webkit-mask: var(--somna-icon-backdrop-mask) center / contain no-repeat;
    mask: var(--somna-icon-backdrop-mask) center / contain no-repeat;
  }

  .somna-icon__glyph {
    position: relative;
    width: var(--somna-icon-size);
    height: var(--somna-icon-size);
    translate: 0 var(--somna-icon-offset, 0px);
  }

  /* Figma: a cream panel over the box body hides the lid gap behind the icon */
  .somna-icon__patch {
    position: absolute;
    top: 35.5%;
    left: 12.9%;
    width: 74.2%;
    height: 58%;
    background: var(--somna-icon-backdrop);
  }

  .somna-icon__drawing {
    display: block;
    overflow: visible;
  }

  .somna-icon__glyph--mask {
    background: currentColor;
    -webkit-mask: var(--somna-icon-mask) center / contain no-repeat;
    mask: var(--somna-icon-mask) center / contain no-repeat;
  }
{% endstylesheet %}

{% javascript %}
  /* Pen draw: line drawings in one section draw one after another (0.8s each) with a small pen tip,
     when the section scrolls into view. Desktop/tablet only; reduced motion shows them complete. */
  (() => {
    const SLOT = 800;
    const MIN = 25;
    const groups = new WeakMap();

    function arm(svg) {
      svg.querySelectorAll('path').forEach((p) => {
        const L = p.getTotalLength();
        p._len = L;
        p.style.strokeDasharray = `${L} ${L + 20}`;
        p.style.strokeDashoffset = L;
        p.style.opacity = 0;
      });
    }

    function plan(svgs) {
      const items = [];
      svgs.forEach((svg, i) => {
        const paths = [...svg.querySelectorAll('path')];
        const total = paths.reduce((sum, p) => sum + Math.max(p._len, MIN), 0);
        let t = i * SLOT;
        paths.forEach((p) => {
          const d = (SLOT * Math.max(p._len, MIN)) / total;
          items.push({ p, nib: svg.querySelector('.somna-icon__nib'), t, d });
          t += d;
        });
      });
      return items;
    }

    function play(g) {
      cancelAnimationFrame(g.raf);
      g.svgs.forEach(arm);
      const items = plan(g.svgs);
      const end = g.svgs.length * SLOT;
      const t0 = performance.now();
      const tick = (now) => {
        const e = now - t0;
        items.forEach((it) => {
          if (e < it.t || it.done) return;
          const k = Math.min(1, (e - it.t) / it.d);
          it.p.style.opacity = 1;
          it.p.style.strokeDashoffset = it.p._len * (1 - k);
          if (it.nib) {
            const pt = it.p.getPointAtLength(it.p._len * k);
            it.nib.setAttribute('cx', pt.x);
            it.nib.setAttribute('cy', pt.y);
            it.nib.setAttribute('opacity', 1);
          }
          if (k === 1) it.done = true;
        });
        g.svgs.forEach((svg, i) => {
          if (e >= (i + 1) * SLOT) svg.querySelector('.somna-icon__nib')?.setAttribute('opacity', 0);
        });
        if (e < end) g.raf = requestAnimationFrame(tick);
        else items.forEach((it) => (it.p.style.strokeDasharray = 'none'));
      };
      g.raf = requestAnimationFrame(tick);
    }

    function reset(g) {
      cancelAnimationFrame(g.raf);
      g.svgs.forEach((svg) => {
        arm(svg);
        svg.querySelector('.somna-icon__nib')?.setAttribute('opacity', 0);
      });
      g.played = false;
    }

    function init() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(min-width: 750px)').matches) return;
      const sections = new Set();
      document.querySelectorAll('.somna-icon__drawing--pen:not([data-armed])').forEach((svg) => {
        svg.setAttribute('data-armed', '');
        sections.add(svg.closest('.shopify-section') || svg.parentElement);
      });
      sections.forEach((sec) => {
        const g = { svgs: [...sec.querySelectorAll('.somna-icon__drawing--pen')], played: false, raf: 0 };
        groups.set(sec, g);
        g.svgs.forEach(arm);
        g.io = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting && !g.played) {
              g.played = true;
              play(g);
            }
          },
          { rootMargin: '0px 0px -25% 0px' }
        );
        // reset only when the section is completely below the screen (never un-draw visible icons)
        g.out = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting && entry.boundingClientRect.top > 0) reset(g);
        });
        g.io.observe(sec);
        g.out.observe(sec);
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', init);
    document.addEventListener('shopify:section:unload', (e) => {
      const g = groups.get(e.target);
      if (!g) return;
      cancelAnimationFrame(g.raf);
      g.io?.disconnect();
      g.out?.disconnect();
      groups.delete(e.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Somna icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None (use image)" },
        { "value": "users", "label": "People" },
        { "value": "star", "label": "Star" },
        { "value": "shield", "label": "Shield" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "moon", "label": "Moon" },
        { "value": "refresh", "label": "Refresh" },
        { "value": "play", "label": "Play" },
        { "value": "truck", "label": "Truck" },
        { "value": "question", "label": "Question" },
        { "value": "mail", "label": "Mail" },
        { "value": "lock", "label": "Lock" },
        { "value": "gift", "label": "Gift" },
        { "value": "chat", "label": "Chat" },
        { "value": "clock", "label": "Clock" },
        { "value": "box", "label": "Box" }
      ],
      "default": "star"
    },
    {
      "type": "select",
      "id": "drawing",
      "label": "Line drawing",
      "info": "Replaces the icon with a line drawing that takes the icon colour.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sleep_guide_1", "label": "Sleep guide 1" },
        { "value": "sleep_guide_2", "label": "Sleep guide 2" },
        { "value": "sleep_tracker", "label": "Sleep tracker" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "draw_animation",
      "label": "Draw on scroll",
      "info": "Drawings in the same section draw one after another when it comes into view.",
      "default": true,
      "visible_if": "{{ block.settings.drawing != 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom icon",
      "info": "A silhouette on a transparent background. It takes the icon colour below."
    },
    {
      "type": "range",
      "id": "size",
      "label": "Icon size",
      "min": 12,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "color",
      "label": "Icon colour",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "backdrop",
      "label": "Backdrop",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "circle", "label": "Circle" },
        { "value": "image", "label": "Custom shape" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "backdrop_image",
      "label": "Backdrop shape",
      "visible_if": "{{ block.settings.backdrop == 'image' }}"
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop colour",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.backdrop != 'none' }}"
    },
    {
      "type": "range",
      "id": "backdrop_size",
      "label": "Backdrop size",
      "min": 16,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ block.settings.backdrop != 'none' }}"
    },
    {
      "type": "range",
      "id": "icon_offset",
      "label": "Icon vertical offset",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.backdrop != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Somna icon"
    }
  ]
}
{% endschema %}
