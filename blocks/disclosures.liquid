{{ 'block-disclosures.css' | asset_url | stylesheet_tag }}

{%- assign disclosures = closest.product.metafields.shopify.disclosure.value | applicable_disclosures -%}
{%- assign has_visible_disclosures = false -%}
{%- assign disclosures_symbol_aspect_ratio = 1 -%}
{%- if disclosures != blank -%}
  {%- for disclosure in disclosures -%}
    {%- if disclosure.display_preferences.value.surfaces contains 'product_page' -%}
      {%- assign has_visible_disclosures = true -%}
      {%- assign symbol_aspect_ratio = disclosure.symbol.value.aspect_ratio | default: 1 -%}
      {%- if symbol_aspect_ratio > disclosures_symbol_aspect_ratio -%}
        {%- assign disclosures_symbol_aspect_ratio = symbol_aspect_ratio -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<div
  class="disclosures__container"
  {{ block.shopify_attributes }}
>
  {%- if has_visible_disclosures -%}
    <script
      src="{{ 'disclosures-summary-fit.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>

    <disclosures-summary-fit
      class="disclosures accordion--{{ block.settings.icon }}{% if block.settings.dividers %} accordion--dividers{% endif %} spacing-style"
      data-summary-layout="stacked"
      style="--disclosures-icon-size: calc(var(--font-{{ block.settings.disclosure_heading_preset | default: 'h5' }}--size) * 1.2); --disclosures-symbol-aspect-ratio: {{ disclosures_symbol_aspect_ratio }}; {% render 'spacing-style', settings: block.settings %}{% if block.settings.text_color != blank %} --color: {{ block.settings.text_color }}; --color-rgb: {{ block.settings.text_color.rgb }};{% endif %}{% if block.settings.divider_color != blank %} --color-border: {{ block.settings.divider_color }};{% endif %}"
    >
      {%- if block.settings.heading != blank -%}
        <h2 class="disclosures__heading {{ block.settings.heading_preset }}">
          {{ block.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- capture summary_html -%}
        <span class="disclosures__summary-item">
          {%- assign visible_disclosure_index = 0 -%}
          {%- for disclosure in disclosures -%}
            {%- if disclosure.display_preferences.value.surfaces contains 'product_page' -%}
              {%- assign title = disclosure.title.value -%}
              {%- assign img = disclosure.symbol.value -%}
              {%- capture row_content -%}
                <span class="disclosures__summary-item-row">
                  {%- if img != blank -%}
                    {{-
                      img
                      | image_url: width: 200
                      | image_tag:
                        class: 'details__icon',
                        widths: '20, 40, 80',
                        width: img.width,
                        height: img.height,
                        alt: title
                    -}}
                  {%- else -%}
                    <span class="details__icon details__icon--fallback">
                      {{- 'icon-info.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                  <span class="disclosures__summary-item-title {{ block.settings.disclosure_heading_preset }}">{{ title }}</span>
                </span>
              {%- endcapture -%}
              {%- if visible_disclosure_index == 0 -%}
                {{ row_content }}
              {%- else -%}
                <span class="disclosures__summary-item-extra">
                  <span class="disclosures__separator {{ block.settings.disclosure_heading_preset }}">&bull;</span>
                  {{ row_content }}
                </span>
              {%- endif -%}
              {%- assign visible_disclosure_index = visible_disclosure_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </span>
      {%- endcapture -%}

      {%- assign details_html = '' -%}
      {%- assign visible_disclosure_index = 0 -%}
      {%- for disclosure in disclosures -%}
        {%- if disclosure.display_preferences.value.surfaces contains 'product_page' -%}
          {%- assign title = disclosure.title.value -%}
          {%- assign img = disclosure.symbol.value -%}
          {%- assign content = disclosure.content -%}
          {%- capture details_item -%}
            <div class="disclosures__item">
              <div class="disclosures__item-left">
                {%- if visible_disclosure_index != 0 -%}
                  {%- if title != blank or img != blank -%}
                    <div class="disclosures__item-header">
                      {%- if img != blank -%}
                        {{-
                          img
                          | image_url: width: 200
                          | image_tag:
                            class: 'details__icon',
                            widths: '20, 40, 80',
                            width: img.width,
                            height: img.height,
                            alt: title
                        -}}
                      {%- else -%}
                        <span class="details__icon details__icon--fallback">
                          {{- 'icon-info.svg' | inline_asset_content -}}
                        </span>
                      {%- endif -%}
                      {%- if title != blank -%}
                        <h3 class="disclosures__item-title {{ block.settings.disclosure_heading_preset }}">{{ title }}</h3>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                <div class="disclosures__item-content">
                  {{ content | metafield_tag }}
                </div>
              </div>
              <div class="disclosures__item-right" data-accordion-close></div>
            </div>
          {%- endcapture -%}
          {%- capture details_html -%}{{ details_html }}{{ details_item }}{%- endcapture -%}
          {%- assign visible_disclosure_index = visible_disclosure_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- capture disclosures_accordion_children -%}
        <details
          class="details"
          data-testid="accordion-details"
          {% if block.settings.open_by_default %}
            open
          {% endif %}
        >
          <summary class="details__header">
            <div class="disclosures__summary-content">
              {{ summary_html }}
            </div>
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
            <span class="svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>

          <div class="details-content disclosures__details-content">
            {{ details_html }}
          </div>
        </details>
      {%- endcapture -%}
      {% render 'accordion-custom-component',
        children: disclosures_accordion_children,
        close_with_escape: true,
        open_by_default_on_desktop: block.settings.open_by_default,
        open_by_default_on_mobile: block.settings.open_by_default
      %}
    </disclosures-summary-fit>
  {%- else -%}
    <div
      hidden
      shopify-block-empty
    ></div>
  {%- endif -%}

  {% render 'accordion-styles' %}
  
</div>

