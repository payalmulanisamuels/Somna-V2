{%- comment -%}
  Somna V2 — email signup. Since 2026-11-17 it is a real Shopify customer form (newsletter): the
  email is subscribed to Shopify email marketing, which starts the Shopify Messaging welcome flow.
  The Klaviyo company / list settings are kept but no longer used.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign uid = block.id | replace: '_', '-'
-%}
<somna-klaviyo-signup
  class="somna-signup"
  data-company="{{ s.company_id | escape }}"
  data-list="{{ s.list_id | escape }}"
  data-source="{{ s.source | escape }}"
  data-ok="{{ s.success | escape }}"
  data-err="{{ s.error | escape }}"
  data-bad="{{ s.invalid | escape }}"
  data-signup="{{ uid }}"
  style="--signup-width: {{ s.width }}%; --signup-input-bg: {{ s.input_background }}; --signup-input-text: {{ s.input_text }}; --signup-btn-bg: {{ s.button_background }}; --signup-btn-text: {{ s.button_text }}; --signup-note: {{ s.note_color }};"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Real Shopify customer form: Shopify adds its spam check (CAPTCHA). After signing up Shopify reloads this page with ?customer_posted=true, and the script below shows the message. {%- endcomment -%}
  {%- assign form_id = 'somna-signup-' | append: uid -%}
  {%- form 'customer', id: form_id, class: 'somna-signup__form', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<span data-form-errors hidden></span>{%- endif -%}
    <input type="hidden" name="contact[tags]" value="newsletter, signup-newsletter-block">
    <label class="visually-hidden" for="{{ uid }}-email">{{ s.placeholder }}</label>
    <input
      class="somna-signup__input"
      id="{{ uid }}-email"
      type="email"
      name="contact[email]"
      autocomplete="email"
      inputmode="email"
      required
      placeholder="{{ s.placeholder | escape }}"
      aria-describedby="{{ uid }}-msg"
      data-email
    >
    <button class="somna-signup__button" type="submit" data-submit>{{ s.button_label }}</button>
  {%- endform -%}
  <p class="somna-signup__msg" id="{{ uid }}-msg" role="status" aria-live="polite" data-msg></p>
  {%- if s.consent != blank -%}<div class="somna-signup__consent">{{ s.consent }}</div>{%- endif -%}
</somna-klaviyo-signup>
{%- if s.row_max_width > 0 -%}
  {%- comment -%} keeps the row this signup sits in (e.g. heading + form) within the page's content width on desktop {%- endcomment -%}
  <style>
    @media screen and (min-width: 750px) {
      .layout-panel-flex:has(> [data-signup='{{ uid }}']) {
        width: 100%;
        max-width: {{ s.row_max_width }}px;
        margin-inline: auto;
      }
    }
  </style>
{%- endif -%}

<script type="module">
  if (!customElements.get('somna-klaviyo-signup')) {
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const FROM_KEY = 'somna_signup_from';
    customElements.define('somna-klaviyo-signup', class extends HTMLElement {
      connectedCallback() {
        this.labels = { ok: this.dataset.ok, err: this.dataset.err, bad: this.dataset.bad };
        this.form = this.querySelector('form.somna-signup__form');
        this.input = this.querySelector('[data-email]');
        this.btn = this.querySelector('[data-submit]');
        this.msg = this.querySelector('[data-msg]');
        this.form.addEventListener('submit', this.onSubmit);
        this.showResult();
      }
      disconnectedCallback() { this.form.removeEventListener('submit', this.onSubmit); }
      say(text, state) { this.msg.textContent = text; this.dataset.state = state || ''; this.input.setAttribute('aria-invalid', String(state === 'error')); }
      // After the page comes back from Shopify: show the result on the form that was used.
      showResult() {
        let from = null;
        try { from = sessionStorage.getItem(FROM_KEY); } catch (e) {}
        if (!from || from !== this.form.id) return;
        try { sessionStorage.removeItem(FROM_KEY); } catch (e) {}
        if (new URLSearchParams(location.search).get('customer_posted') === 'true') this.say(this.labels.ok, 'success');
        else if (this.querySelector('[data-form-errors]')) this.say(this.labels.err, 'error');
      }
      // Shopify email marketing (Messaging welcome flow), was Klaviyo list before 2026-11-17.
      // A valid email is not prevented: the real form submits (Shopify adds its CAPTCHA).
      onSubmit = (e) => {
        const email = this.input.value.trim();
        if (this.busy) { e.preventDefault(); return; }
        if (!EMAIL.test(email)) { e.preventDefault(); this.say(this.labels.bad, 'error'); this.input.focus(); return; }
        this.input.value = email;
        try { sessionStorage.setItem(FROM_KEY, this.form.id); } catch (err) {}
        this.busy = true; this.btn.disabled = true; this.btn.setAttribute('aria-busy', 'true'); this.say('', '');
        // If the visitor closes Shopify's spam check, the page stays here: let them try again.
        clearTimeout(this.resetTimer);
        this.resetTimer = setTimeout(() => { this.busy = false; this.btn.disabled = false; this.btn.removeAttribute('aria-busy'); }, 15000);
      };
    });
  }
</script>

{% stylesheet %}
  .somna-signup {
    display: block;
    width: 100%;
    max-width: var(--signup-width, 100%);
  }

  .somna-signup__form {
    display: flex;
    align-items: stretch;
    min-height: 80px;
    border-radius: 999px;
    background: var(--signup-input-bg);
    overflow: hidden;
  }

  .somna-signup__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 28px;
    border: 0;
    background: transparent;
    color: var(--signup-input-text);
    font: inherit;
    font-size: 1.25rem;
  }

  .somna-signup__input::placeholder {
    color: color-mix(in srgb, var(--signup-input-text) 45%, transparent);
  }

  .somna-signup__input:focus-visible {
    outline: none;
  }

  .somna-signup__form:focus-within {
    outline: 2px solid var(--signup-btn-bg);
    outline-offset: 3px;
  }

  .somna-signup__button {
    flex: none;
    padding: 0 40px;
    border: 0;
    border-radius: 0 999px 999px 0;
    background: var(--signup-btn-bg);
    color: var(--signup-btn-text);
    font: inherit;
    font-size: 1.25rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .somna-signup__button:hover:not([aria-busy='true']) {
    background: #f3feee;
    color: #0b0f1d;
  }

  .somna-signup__button[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .somna-signup__msg {
    min-height: 1.4em;
    margin: 10px 0 0;
    padding-inline: 28px;
    color: var(--signup-note);
    font-size: 0.875rem;
  }

  .somna-signup[data-state='error'] .somna-signup__msg {
    color: #ffb4a8;
  }

  .somna-signup__consent {
    padding-inline: 28px;
    color: var(--signup-note);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .somna-signup__consent p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .somna-signup {
      max-width: 100%;
    }

    .somna-signup__form {
      min-height: 56px;
    }

    .somna-signup__input,
    .somna-signup__button {
      font-size: 1rem;
    }

    .somna-signup__input {
      padding-inline: 20px;
    }

    .somna-signup__button {
      padding-inline: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Klaviyo email signup",
  "tag": null,
  "settings": [
    { "type": "text", "id": "company_id", "label": "Klaviyo public key (company ID)", "default": "Tr7JSM" },
    { "type": "text", "id": "list_id", "label": "Klaviyo list ID", "default": "XyWydk", "info": "XyWydk is the list the live footer form uses (\"Email List\")." },
    { "type": "text", "id": "source", "label": "Signup source", "default": "Footer Signup - 10% Off" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe →" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You’re on the list! New here? Your code is on its way." },
    { "type": "text", "id": "error", "label": "Error message", "default": "We couldn’t sign you up. Please try again." },
    { "type": "text", "id": "invalid", "label": "Invalid email message", "default": "Enter a valid email address." },
    { "type": "richtext", "id": "consent", "label": "Consent text" },
    { "type": "range", "id": "width", "label": "Width", "min": 30, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "range", "id": "row_max_width", "label": "Row maximum width (desktop)", "info": "Keeps the heading and form together within this width on wide screens. 0 = full width.", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 0 },
    { "type": "color", "id": "input_background", "label": "Field background", "default": "#ffffff" },
    { "type": "color", "id": "input_text", "label": "Field text", "default": "#000000" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#afbdf8" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "note_color", "label": "Message text", "default": "#f3feee" }
  ],
  "presets": [{ "name": "Klaviyo email signup" }]
}
{% endschema %}
